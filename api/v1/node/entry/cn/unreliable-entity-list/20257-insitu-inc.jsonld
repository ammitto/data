    },
    {
      "@id": "https://www.ammitto.org/modification/cn/2025-11-05-17-00-20257",
      "@type": "SanctionPeriodModification",
      "targetType": "announcement",
      "targetAnnouncementId": "https://www.ammitto.org/announcement/cn/20257",
