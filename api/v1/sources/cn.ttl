  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ; schema:description """{"value":"冻结在我国境内的动产、不动产和其他各类财产","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Freeze all assets in China, including movable and immovable property and other types of assets","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_transactions" ; ammitto:scope "full" ; schema:description """{"value":"禁止我国境内的组织、个人与其进行有关交易、合作等活动","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"美国近日宣布向中国台湾地区提供大额武器援助，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"The US recently announced the provision of large-scale military aid to China's Taiwan region, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2024-10-10"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "13-edge-autonomy-operations-llc" ;
  ammitto:groupId <https://www.ammitto.org/group/cn/13> ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第五条" ; ammitto:articles "第六条" ; ammitto:articles "第九条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对美国军工企业及高级管理人员采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202412/t20241217_11494912.shtml> ; ammitto:publishDate "2024-10-10"^^xsd:date ; ammitto:publishTime "17:00" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第13号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "（2024年10月10日中华人民共和国外交部令第13号公布，自2024年10月10日起施行）\n\n美国近日宣布向中国台湾地区提供大额武器援助，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。依据《中华人民共和国反外国制裁法》第三条、第四条、第五条、第六条、第九条、第十五条规定，中方决定对以下美国军工企业及高级管理人员采取反制措施：\n\n一、对边缘自治运营公司、亨廷顿·英格尔斯工业公司、斯凯迪奥公司等3家后附《反制清单》列明的企业，冻结在我国境内的动产、不动产和其他各类财产；禁止我国境内的组织、个人与其进行有关交易、合作等活动。\n\n二、对史蒂文·鲁德（摇杆舵公司创始人）、詹姆斯·伊克斯（内华达山脉公司副总裁）、大卫·萨顿（洛克希德·马丁公司亚洲区主任）、朴英泰（宇航环境公司副总裁）、帕特里克·扬科夫斯基（诺斯罗普·格鲁曼公司印太项目主任）、约翰·普维斯（边缘自治运营公司前首席执行官）、乔什·布伦加特（边缘自治运营公司首席运营官）、克里斯托弗·卡斯特纳（亨廷顿·英格尔斯工业公司总裁、首席执行官）、亚当·布赖（斯凯迪奥公司联合创始人、首席执行官）、汤姆·莫斯（斯凯迪奥公司亚太区总经理）等10名后附《反制清单》列明的企业高级管理人员，冻结在我国境内的动产、不动产和其他各类财产；禁止我国境内的组织、个人与其本人进行有关交易、合作等活动；对其本人不予签发签证、不准入境（包括香港、澳门）。\n\n本决定自2024年10月10日起施行。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"边缘自治运营公司","cn:english_name":"Edge Autonomy Operations LLC"}""" ] .
