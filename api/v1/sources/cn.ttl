  ammitto:groupId <https://www.ammitto.org/group/cn/202611> ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-export-control-law> ; ammitto:citationType "legal_basis" ] ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/mofcom-dual-use-export-control-regulation> ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "公布将20家日本实体列入出口管制管控名单" ; ammitto:url <https://www.mofcom.gov.cn/zwgk/zcfb/art/2026/art_b5159a773124428a9813884015d1b8b3.html> ; ammitto:publishDate "2026-02-24"^^xsd:date ; ammitto:documentType "cn/ministry-of-commerce-announcement" ; ammitto:documentId "2026年第11号" ; ammitto:signatory "cn/ministry-of-commerce" ; ammitto:publisher "cn/ministry-of-commerce" ; ammitto:hasAuthority "cn/ministry-of-commerce" ; ammitto:content "根据《中华人民共和国出口管制法》和《中华人民共和国两用物项出口管制条例》等法律法规有关规定，为维护国家安全和利益，履行防扩散等国际义务，决定将三菱造船株式会社等参与提升日本军事实力的20家日本实体列入出口管制管控名单（见附件），并采取以下措施：\n\n一、禁止出口经营者向上述20家实体出口两用物项，禁止境外组织和个人将原产于中华人民共和国的两用物项转移或提供给上述20家实体；正在开展的相关活动应当立即停止。\n二、特殊情况下确需出口的，出口经营者应当向商务部提出申请。\n\n本公告自公布之日起正式实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unknown","cn:sanction_list":"cn/export-control-list","cn:chinese_name":"日本海洋联合株式会社","cn:english_name":"Japan Marine United Corporation"}""" ] .
