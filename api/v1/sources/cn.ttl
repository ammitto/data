  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "不可靠实体清单工作机制关于将美国PVH集团和因美纳公司列入不可靠实体清单的公告" ; ammitto:url <https://www.mofcom.gov.cn/zwgk/zcfb/art/2025/art_ab15d2258dda4e93b8ad1ec4776d37c3.html> ; ammitto:publishDate "2025-02-04"^^xsd:date ; ammitto:publishTime "13:02" ; ammitto:documentType "cn/unreliable-entity-list-working-mechanism-announcement" ; ammitto:documentId "〔2025〕4号" ; ammitto:signatory "cn/unreliable-entity-list-working-mechanism" ; ammitto:publisher "cn/ministry-of-commerce-industry-security-and-import-export-control" ; ammitto:hasAuthority "cn/unreliable-entity-list-working-mechanism" ; ammitto:content "为维护国家主权、安全和发展利益，根据《中华人民共和国对外贸易法》《中华人民共和国国家安全法》《中华人民共和国反外国制裁法》等有关法律，依据《不可靠实体清单规定》有关规定，不可靠实体清单工作机制决定将美国PVH集团、因美纳公司（Illumina, Inc.）列入不可靠实体清单。\n\n上述两家实体违反正常的市场交易原则，中断与中国企业的正常交易，对中国企业采取歧视性措施，严重损害中国企业合法权益。不可靠实体清单工作机制将依据相关法律法规，对上述实体采取相应措施。\n\n本公告未尽事宜，按《不可靠实体清单规定》执行。\n本公告自公布之日起实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unreliable_entity","cn:sanction_list":"cn/unreliable-entity-list","cn:chinese_name":"PVH集团","cn:english_name":"PVH Corp."}""" ] .
