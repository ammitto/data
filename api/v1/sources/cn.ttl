  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/mofcom-unreliable-entity-list-provisions> ; ammitto:articles "第二条" ; ammitto:articles "第八条" ; ammitto:articles "第十条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "不可靠实体清单工作机制关于对通用原子航空系统公司等三家美国企业采取不可靠实体清单措施的公告" ; ammitto:url <https://aqygzj.mofcom.gov.cn/flzc/gzjgfxwj/art/2024/art_e78af9c314b2466daa7f96b49766a158.html> ; ammitto:publishDate "2024-05-20"^^xsd:date ; ammitto:publishTime "09:00" ; ammitto:documentType "cn/unreliable-entity-list-working-mechanism-announcement" ; ammitto:documentId "〔2024〕1号" ; ammitto:signatory "cn/unreliable-entity-list-working-mechanism" ; ammitto:publisher "cn/ministry-of-commerce-industry-security-and-import-export-control" ; ammitto:hasAuthority "cn/unreliable-entity-list-working-mechanism" ; ammitto:content "为维护国家主权、安全和发展利益，根据《中华人民共和国对外贸易法》《中华人民共和国国家安全法》等有关法律，不可靠实体清单工作机制依据《不可靠实体清单规定》第二条、第八条和第十条等有关规定，决定将参与对台湾地区军售的美国通用原子航空系统公司（General Atomics Aeronautical Systems）、美国通用动力陆地系统公司（General Dynamics Land Systems）列入不可靠实体清单，并采取以下处理措施：\n\n（一）禁止上述企业从事与中国有关的进出口活动；\n（二）禁止上述企业在中国境内新增投资；\n（三）禁止上述企业高级管理人员入境；\n（四）不批准并取消上述企业高级管理人员在中国境内工作许可、停留或者居留资格。\n\n本公告未尽事宜，按《不可靠实体清单规定》执行。\n本公告自公布之日起实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unreliable_entity","cn:sanction_list":"cn/unreliable-entity-list","cn:chinese_name":"通用原子航空系统公司","cn:english_name":"General Atomics Aeronautical Systems"}""" ] .
