  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "不可靠实体清单工作机制关于将斯凯迪奥公司等11家美国企业列入不可靠实体清单的公告" ; ammitto:url <https://www.mofcom.gov.cn/zwgk/zcfb/art/2025/art_e4f474d3aeba4672913db1042d845d78.html> ; ammitto:publishDate "2025-04-04"^^xsd:date ; ammitto:publishTime "18:00" ; ammitto:documentType "cn/unreliable-entity-list-working-mechanism-announcement" ; ammitto:documentId "〔2025〕7号" ; ammitto:signatory "cn/unreliable-entity-list-working-mechanism" ; ammitto:publisher "cn/ministry-of-commerce-industry-security-and-import-export-control" ; ammitto:hasAuthority "cn/unreliable-entity-list-working-mechanism" ; ammitto:content "为维护国家主权、安全和发展利益，根据《中华人民共和国对外贸易法》《中华人民共和国国家安全法》《中华人民共和国反外国制裁法》等有关法律，不可靠实体清单工作机制依据《不可靠实体清单规定》第二条、第八条和第十条等有关规定，决定将斯凯迪奥公司等11家实体列入不可靠实体清单，并采取以下处理措施：\n\n一、禁止上述企业从事与中国有关的进出口活动；\n二、禁止上述企业在中国境内新增投资。\n\n本公告未尽事宜，按《不可靠实体清单规定》执行。\n本公告自公布之日起实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unreliable_entity","cn:sanction_list":"cn/unreliable-entity-list","cn:chinese_name":"浩劫人工智能公司","cn:english_name":"HavocAI"}""" ] .
