  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第四条" ; ammitto:articles "第五条" ; ammitto:articles "第六条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对余茂春、托德·斯坦恩采取反制裁措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202212/t20221222_10993979.shtml> ; ammitto:publishDate "2022-12-23"^^xsd:date ; ammitto:publishTime "08:00" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第4号" ; ammitto:signatory "王毅" ; ammitto:signatoryTitle "部长" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "现公布《关于对余茂春、托德·斯坦恩采取反制裁措施的决定》，自2022年12月23日起施行。\n\n部长 王毅\n\n2022年12月23日\n\n12月9日，美方借口所谓“西藏人权”问题，对两名中方官员进行非法制裁。依据《中华人\n民共和国反外国制裁法》第四条、第五条、第六条规定，中方决定对余茂春、托德·斯坦\n恩等后附《反制裁清单》列明的个人采取以下反制裁措施：\n\n一、冻结在我国境内的动产、不动产和其他各类财产；\n二、禁止我国境内的组织、个人与其进行有关交易活动；\n三、对其本人及直系亲属不予签发签证、不准入境。\n\n本决定自2022年12月23日起施行。\n\n附件：反制裁清单\n\n外交部\n2022年12月23日\n\n附件\n反制裁清单\n\n一、余茂春，男\n二、托德·斯坦恩（Todd Stein），男\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"余茂春","cn:english_name":null}""" ] .
