  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-export-control-law> ; ammitto:citationType "legal_basis" ] ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/mofcom-dual-use-export-control-regulation> ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "公布将15家美国实体列入出口管制管控名单" ; ammitto:url <https://www.mofcom.gov.cn/zwgk/zcfb/art/2025/art_e1ea9512b1f84dc6b1a17f703fa4cf56.html> ; ammitto:publishDate "2025-03-04"^^xsd:date ; ammitto:documentType "cn/ministry-of-commerce-announcement" ; ammitto:documentId "2025年第13号" ; ammitto:signatory "cn/ministry-of-commerce" ; ammitto:publisher "cn/ministry-of-commerce" ; ammitto:hasAuthority "cn/ministry-of-commerce" ; ammitto:content "根据《中华人民共和国出口管制法》和《中华人民共和国两用物项出口管制条例》等法律法规有关规定，为维护国家安全和利益，履行防扩散等国际义务，决定将莱多斯公司等15家美国实体列入出口管制管控名单（见附件），并采取以下措施：\n\n一、禁止向上述15家美国实体出口两用物项；正在开展的相关出口活动应当立即停止。\n二、特殊情况下确需出口的，出口经营者应当向商务部提出申请。\n\n本公告自公布之日起正式实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unknown","cn:sanction_list":"cn/export-control-list","cn:chinese_name":"护盾人工智能公司","cn:english_name":"Shield AI, Inc."}""" ] .
