  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ; schema:description """{"value":"冻结在我国境内的动产、不动产和其他各类财产","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Freeze all assets in China, including movable and immovable property and other types of assets","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "visa_ban" ; ammitto:scope "full" ; schema:description """{"value":"对高级管理人员不予签发签证、不准入境","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Visa ban and entry prohibition for senior management personnel","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"美国持续向中国台湾地区出售武器，严重违反一个中国原则和中美三个联合公报规定，严重干涉中国内政，严重损害中国主权和领土完整。中方决定对参与向中国台湾地区出售武器的美国企业采取反制措施。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"The US continues to sell weapons to China's Taiwan region, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity. China has decided to take countermeasures against US companies involved in selling weapons to China's Taiwan region.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2024-04-11"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
