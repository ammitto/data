  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ; schema:description """{"value":"冻结在我国境内的动产、不动产和其他各类财产","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Freeze all assets in China, including movable and immovable property and other types of assets","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_transactions" ; ammitto:scope "full" ; schema:description """{"value":"禁止我国境内的组织、个人与其进行有关交易、合作等活动","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"美国近日再次宣布向中国台湾地区提供大额武器援助并出售武器，美国\"2025财年国防授权法案\"包括多项涉华消极条款，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"The US recently announced providing large-scale weapons assistance and selling weapons to China's Taiwan region, and the US \"2025 National Defense Authorization Act\" includes multiple negative provisions related to China, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2024-12-27"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "16-insitu-inc" ;
  ammitto:groupId <https://www.ammitto.org/group/cn/16> ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第五条" ; ammitto:articles "第六条" ; ammitto:articles "第九条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对美国军工企业及高级管理人员采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202412/t20241227_11520050.shtml> ; ammitto:publishDate "2024-12-27"^^xsd:date ; ammitto:publishTime "15:00" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第16号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "（2024年12月27日中华人民共和国外交部令第16号公布，自2024年12月27日起施行）\n\n美国近日再次宣布向中国台湾地区提供大额武器援助并出售武器，美国\"2025财年国防授权法案\"包括多项涉华消极条款，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。\n\n依据《中华人民共和国反外国制裁法》第三条、第四条、第五条、第六条、第九条、第十五条规定，中方决定对英斯图公司、哈德森技术公司、萨罗尼克科技公司、雷神加拿大公司、雷神澳大利亚公司、爱尔康公司、国际海洋工程公司等7家后附《反制清单》列明的企业及相关高级管理人员采取以下反制措施：\n\n一、冻结在我国境内的动产、不动产和其他各类财产；\n二、禁止我国境内的组织、个人与其进行有关交易、合作等活动。\n\n本决定自2024年12月27日起施行。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"英斯图公司","cn:english_name":"Insitu, Inc."}""" ] .
