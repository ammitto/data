  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_transactions" ; ammitto:scope "full" ; schema:description """{"value":"禁止我国境内的组织、个人与其进行有关交易、合作等活动","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"美国近日宣布向中国台湾地区大规模出售武器，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"The US recently announced large-scale arms sales to China's Taiwan region, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2025-12-26"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "19-dedrone-holdings-inc" ;
  ammitto:groupId <https://www.ammitto.org/group/cn/19> ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第五条" ; ammitto:articles "第六条" ; ammitto:articles "第九条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对美国军工相关企业及高级管理人员采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202512/t20251226_11787617.shtml> ; ammitto:publishDate "2025-12-26"^^xsd:date ; ammitto:publishTime "17:00" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第19号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "（2025年12月26日中华人民共和国外交部令第19号公布，自2025年12月26日起施行）\n\n美国近日宣布向中国台湾地区大规模出售武器，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。依据《中华人民共和国反外国制裁法》第三条、第四条、第五条、第六条、第九条、第十五条规定，中方决定对以下美国军工相关企业及高级管理人员采取反制措施：\n\n一、对诺斯罗普·格鲁曼系统公司、L3哈里斯海事服务公司、波音密苏里州圣路易斯市分公司、吉布斯与考克斯公司、先进声学概念有限责任公司、VSE公司、塞拉技术服务公司、红猫控股公司、蒂尔无人机公司、侦察艇有限责任公司、高点航空技术公司、伊庇鲁斯公司、迪德罗恩公司、I领域公司、蓝力技术公司、潜航技术公司、万拓公司、英特磊公司、菱形力量公司、拉撒路人工智能公司等20家后附《反制清单》列明的企业，冻结在我国境内的动产、不动产和其他各类财产；禁止我国境内的组织、个人与其进行有关交易、合作等活动。\n\n二、对帕尔默·卢基（安杜里尔公司创始人）、约翰·坎蒂伦（L3哈里斯技术公司副总裁、L3哈里斯海事服务公司副总裁兼首席会计官）、迈克尔·卡诺维尔（先进声学概念有限责任公司总裁兼首席执行官）、约翰·库默（VSE公司总裁兼首席执行官）、米奇·麦克唐纳（蒂尔无人机公司总裁）、安舒曼·罗伊（菱形力量公司创始人兼首席执行官）、丹·斯穆特（万拓公司总裁兼首席执行官）、阿迪亚·德瓦拉孔达（迪德罗恩公司首席执行官）、安·伍德（高点航空技术公司总裁）、杰伊·霍夫利奇（侦察艇有限责任公司联合创始人兼首席执行官）等10名后附《反制清单》列明的企业高级管理人员，冻结在我国境内的动产、不动产和其他各类财产；禁止我国境内的组织、个人与其本人进行有关交易、合作等活动；对其本人不予签发签证、不准入境（包括香港、澳门）。\n\n本决定自2025年12月26日起施行。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"迪德罗恩公司","cn:english_name":"Dedrone Holdings Inc."}""" ] .
