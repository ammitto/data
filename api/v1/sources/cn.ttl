  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ; schema:description """{"value":"冻结在我国境内的动产、不动产和其他各类财产","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Freeze all assets in China, including movable and immovable property and other types of assets","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_transactions" ; ammitto:scope "full" ; schema:description """{"value":"禁止我国境内的组织、个人与其进行有关交易、合作等活动","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit transactions, cooperation, and other activities with Chinese organizations and individuals","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "entry_ban" ; ammitto:scope "full" ; schema:description """{"value":"对其本人不予签发签证、不准入境。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Visa ban for the individual, prohibiting entry","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"美方不顾中方反复交涉和坚决反对，执意允许台湾地区领导人蔡英文于2023年3月29日\n至31日和4月4日至6日“过境”窜美从事政治活动。美国哈德逊研究所、里根图书馆为蔡\n英文在美从事“台独”分裂活动提供平台和便利，严重违反一个中国原则和中美三个联合\n公报规定，严重损害中方主权和领土完整。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"The US allowed Taiwan's leader Tsai Ing-wen to \"transit\" through the\nUS for political activities from March 29 to 31 and April 4 to 6,\ndespite repeated Chinese protests and strong opposition. The Hudson\nInstitute and the Reagan Library provided platforms and convenience\nfor Tsai Ing-wen's \"Taiwan independence\" activities in the US,\nseriously violating the One-China principle and the three China-US\njoint communiqués, seriously damaging China's sovereignty and\nterritorial integrity.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2023-04-07"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
