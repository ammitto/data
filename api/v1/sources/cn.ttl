  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ; schema:description """{"value":"冻结其在我国境内的动产、不动产及其他各类财产","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Freeze all assets in China, including movable and immovable property and other types of assets","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_transactions" ; ammitto:scope "full" ; schema:description """{"value":"禁止我国境内的组织、个人与其进行有关交易、合作等活动","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity with the individual","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "visa_ban" ; ammitto:scope "full" ; schema:description """{"value":"对其本人及直系亲属不予签发签证、不准入境（包括香港、澳门）","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Visa ban and entry prohibition for the individual and immediate family (including Hong Kong and Macao)","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"长期在台湾、钓鱼岛、历史、涉疆、涉藏、涉港等问题上散布谬论，公然参拜靖国神社，严重违背中日四个政治文件精神和一个中国原则，严重干涉中国内政，严重损害中国主权和领土完整。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Long-term dissemination of fallacies on issues such as Taiwan, Diaoyu Islands, history, Xinjiang, Tibet, and Hong Kong, openly visiting the Yasukuni Shrine, seriously violating the spirit of the four political documents between China and Japan and the One-China principle, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2025-09-08"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "17-ishihara-ping" ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第五条" ; ammitto:articles "第六条" ; ammitto:articles "第九条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对石平采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202509/t20250908_11704050.shtml> ; ammitto:publishDate "2025-09-08"^^xsd:date ; ammitto:publishTime "10:00" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第17号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "（2025年9月8日中华人民共和国外交部令第17号公布，自2025年9月8日起施行）\n\n日本参议员石平长期在台湾、钓鱼岛、历史、涉疆、涉藏、涉港等问题上散布谬论，公然参拜靖国神社，严重违背中日四个政治文件精神和一个中国原则，严重干涉中国内政，严重损害中国主权和领土完整。依据《中华人民共和国反外国制裁法》第三条、第四条、第五条、第六条、第九条、第十五条规定，中方决定对石平采取以下反制措施：\n\n一、冻结其在我国境内的动产、不动产及其他各类财产；\n二、禁止我国境内的组织、个人与其进行有关交易、合作等活动；\n三、对其本人及直系亲属不予签发签证、不准入境（包括香港、澳门）。\n\n本决定自2025年9月8日起施行。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"石平","cn:english_name":"Ishihara Ping"}""" ] .
<https://www.ammitto.org/entity/cn/18-iwasaki-shigeru>
  a ammitto:PersonEntity ;
