  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_export_dual_use_items" ; ammitto:scope "full" ; schema:description """{"value":"禁止向上述美国实体出口两用物项；正在开展的相关出口活动应当立即停止","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit the export of dual-use items to the above US entity; ongoing related export activities should be immediately ceased","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "export_license_requirement" ; ammitto:scope "full" ; schema:description """{"value":"特殊情况下确需出口的，出口经营者应当向商务部提出申请","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"In special circumstances where export is necessary, exporters should apply to the Ministry of Commerce for approval","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"为维护国家安全和利益，履行防扩散等国际义务","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"To safeguard national security and interests, and to fulfill international obligations such as non-proliferation","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2025-04-10"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "202522-insitu-inc" ;
  ammitto:groupId <https://www.ammitto.org/group/cn/202522> ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-export-control-law> ; ammitto:citationType "legal_basis" ] ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/mofcom-dual-use-export-control-regulation> ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "公布将12家美国实体列入出口管制管控名单" ; ammitto:url <https://www.mofcom.gov.cn/zwgk/zcfb/art/2025/art_c6b190344a154e6f831e0fdfc190e41e.html> ; ammitto:publishDate "2025-04-09"^^xsd:date ; ammitto:documentType "cn/ministry-of-commerce-announcement" ; ammitto:documentId "2025年第22号" ; ammitto:signatory "cn/ministry-of-commerce" ; ammitto:publisher "cn/ministry-of-commerce" ; ammitto:hasAuthority "cn/ministry-of-commerce" ; ammitto:content "根据《中华人民共和国出口管制法》和《中华人民共和国两用物项出口管制条例》等法律法规有关规定，为维护国家安全和利益，履行防扩散等国际义务，决定将美国光子公司等12家美国实体列入出口管制管控名单（见附件），并采取以下措施：\n\n一、禁止向上述12家美国实体出口两用物项；正在开展的相关出口活动应当立即停止。\n二、特殊情况下确需出口的，出口经营者应当向商务部提出申请。\n\n本公告自2025年4月10日12时01分起正式实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unknown","cn:sanction_list":"cn/export-control-list","cn:chinese_name":"英斯图公司","cn:english_name":"Insitu, Inc."}""" ] .
