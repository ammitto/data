  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unknown","cn:sanction_list":"cn/export-control-list","cn:chinese_name":"仲硕科技股份有限公司","cn:english_name":"JC Technology Inc."}""" ] .
