  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第六条" ; ammitto:articles "第九条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对美国国会前议员加拉格尔采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202405/t20240521_11308990.shtml> ; ammitto:publishDate "2024-05-21"^^xsd:date ; ammitto:publishTime "16:30" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第6号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "（2024年5月21日中华人民共和国外交部令第6号公布，自2024年5月21日起施行）\n\n美国威斯康星州前联邦众议员麦克·加拉格尔近年来频繁采取干涉中国内政、损害中国主权和领土完整、侵犯中方利益的言行。依据《中华人民共和国反外国制裁法》第三条、第四条、第六条、第九条、第十五条规定，中方决定对加拉格尔采取以下反制措施：\n\n一、冻结在我国境内的动产、不动产和其他各类财产；\n二、禁止我国境内的组织、个人与其本人进行有关交易、合作等活动；\n三、对其本人不予签发签证、不准入境。\n\n本决定自2024年5月21日起施行。\n\n附件：反制清单\n\n外交部\n2024年5月21日\n\n附件\n反制清单\n\n美国国会众议院\"中国特设委\"前任主席、威斯康星州前联邦众议员麦克·加拉格尔（Mike Gallagher）\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"麦克·加拉格尔","cn:english_name":"Mike Gallagher"}""" ] .
