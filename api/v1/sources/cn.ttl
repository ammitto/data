<https://www.ammitto.org/entry/cn/anti-sanction-list/3-michael-mccaul>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/cn/3-michael-mccaul> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/cn> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/cn_anti_sanctions> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ; schema:description """{"value":"冻结在我国境内的动产、不动产和其他各类财产","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Freeze all assets in China, including movable and immovable property and other types of assets","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "prohibit_transactions" ; ammitto:scope "full" ; schema:description """{"value":"禁止我国境内的组织、个人与其进行有关交易、合作等活动","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "entry_ban" ; ammitto:scope "full" ; schema:description """{"value":"对其本人不予签发签证、不准入境","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Visa ban for the individual, prohibiting entry","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"近年来频繁采取干涉中国内政、损害中方利益的言行，并于近期率团窜访中国台湾地区，严重违反一个中国原则和中美三个联合公报规定，严重损害中国主权和领土完整，向\"台独\"分裂势力发出严重错误信号。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Frequently engaged in actions interfering in China's internal affairs and harming China's interests, and recently led a delegation to visit China's Taiwan region, seriously violating the One-China principle and the three China-US joint communiqués, seriously damaging China's sovereignty and territorial integrity, and sending seriously wrong signals to \"Taiwan independence\" separatist forces.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2023-04-13"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "3-michael-mccaul" ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第六条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对美国反华议员迈克·麦考尔采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202304/t20230413_11058780.shtml> ; ammitto:publishDate "2023-04-13"^^xsd:date ; ammitto:publishTime "17:36" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第3号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "美国得克萨斯州共和党联邦众议员迈克·麦考尔（Michael McCaul）近年来频繁采取干涉中国内政、损害中方利益的言行，并于近期率团窜访中国台湾地区，严重违反一个中国原则和中美三个联合公报规定，严重损害中国主权和领土完整，向\"台独\"分裂势力发出严重错误信号。\n\n依据《中华人民共和国反外国制裁法》第三条、第四条、第六条、第十五条规定，中方决定对麦考尔采取以下反制措施：\n\n一、冻结在我国境内的动产、不动产和其他各类财产；\n二、禁止我国境内的组织、个人与其进行有关交易、合作等活动；\n三、对其本人不予签发签证、不准入境。\n\n本决定自2023年4月13日起施行。\n\n附件：反制清单\n\n外交部\n2023年4月13日\n\n附件\n反制清单\n\n美国得克萨斯州共和党联邦众议员迈克·麦考尔（Michael McCaul），男\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"迈克·麦考尔","cn:english_name":"Michael McCaul"}""" ] .
