  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"违反正常的市场交易原则，中断与中国企业的正常交易，对中国企业采取歧视性措施，严重损害中国企业合法权益。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Violating normal market transaction principles, disrupting normal transactions with Chinese enterprises, taking discriminatory measures against Chinese enterprises, and seriously damaging the legitimate rights and interests of Chinese enterprises.","lang":"en","script":"Latn","is_primary":false}""" ] ;
