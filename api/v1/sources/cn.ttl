  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "entry_ban" ; ammitto:scope "full" ; schema:description """{"value":"禁止上述企业高级管理人员入境","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Entry ban for senior executives","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "visa_ban" ; ammitto:scope "full" ; schema:description """{"value":"不批准并取消上述企业高级管理人员在中国境内工作许可、停留以及居留资格","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Visa ban and cancellation of work permit, stay and residence qualifications in China for senior executives","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "fine" ; ammitto:scope "full" ; schema:description """{"value":"对上述企业分别处以罚款，金额为《不可靠实体清单规定》实施以来各企业对台军售合同金额的两倍。上述企业应当自本公告公布之日起15日内，按照相关法律法规办理缴款。若逾期不履行本决定，不可靠实体清单工作机制将依法采取加处罚款等措施。","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Impose fines on the above companies, with the amount being twice the contract amount of arms sales to Taiwan region since the implementation of the Unreliable Entity List Provisions. The above companies should complete the payment in accordance with relevant laws and regulations within 15 days from the date of this announcement. If they fail to comply with this decision within the time limit, the Unreliable Entity List Provisions Mechanism will take additional measures such as imposing additional fines in accordance with the law.","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasReason [ a ammitto:SanctionReason ; ammitto:category "other" ; schema:description """{"value":"参与对台湾地区军售","lang":"zh","script":"Hani","is_primary":true}""" ; schema:description """{"value":"Participating in arms sales to Taiwan region","lang":"en","script":"Latn","is_primary":false}""" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:effectiveDate "2023-02-16"^^xsd:date ; ammitto:isIndefinite "false"^^xsd:boolean ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "20231-lockheed-martin-corporation" ;
  ammitto:groupId <https://www.ammitto.org/group/cn/20231> ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-foreign-trade-law-2025> ; ammitto:citationType "legal_basis" ] ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-national-security-law-2015> ; ammitto:citationType "legal_basis" ] ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/mofcom-unreliable-entity-list-provisions> ; ammitto:articles "第二条" ; ammitto:articles "第八条" ; ammitto:articles "第十条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "不可靠实体清单工作机制关于将洛克希德·马丁公司、雷神导弹与防务公司列入不可靠实体清单的公告" ; ammitto:url <https://www.mofcom.gov.cn/zwgk/zcfb/art/2023/art_123456.html> ; ammitto:publishDate "2023-02-16"^^xsd:date ; ammitto:publishTime "17:00" ; ammitto:documentType "cn/unreliable-entity-list-working-mechanism-announcement" ; ammitto:documentId "〔2023〕1号" ; ammitto:signatory "cn/unreliable-entity-list-working-mechanism" ; ammitto:publisher "cn/ministry-of-commerce-industry-security-and-import-export-control" ; ammitto:hasAuthority "cn/unreliable-entity-list-working-mechanism" ; ammitto:content "为维护国家主权、安全和发展利益，根据《中华人民共和国对外贸易法》《中华人民共和国国家安全法》等有关法律，不可靠实体清单工作机制依据《不可靠实体清单规定》第二条、第八条和第十条等有关规定，决定将参与对台湾地区军售的洛克希德·马丁公司（Lockheed Martin Corporation）、雷神导弹与防务公司（Raytheon Missiles & Defense）列入不可靠实体清单，并采取以下处理措施：\n\n一、禁止上述企业从事与中国有关的进出口活动；\n二、禁止上述企业在中国境内新增投资；\n三、禁止上述企业高级管理人员入境；\n四、不批准并取消上述企业高级管理人员在中国境内工作许可、停留以及居留资格；\n五、对上述企业分别处以罚款，金额为《不可靠实体清单规定》实施以来各企业对台军售合同金额的两倍。上述企业应当自本公告公布之日起15日内，按照相关法律法规办理缴款。若逾期不履行本决定，不可靠实体清单工作机制将依法采取加处罚款等措施。\n\n本公告未尽事宜，按《不可靠实体清单规定》执行。\n本公告自公布之日起实施。\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"unreliable_entity","cn:sanction_list":"cn/unreliable-entity-list","cn:chinese_name":"洛克希德·马丁公司","cn:english_name":"Lockheed Martin Corporation"}""" ] .
