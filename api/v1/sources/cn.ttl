  ammitto:referenceNumber "11-jim-mcgovern" ;
  ammitto:legalCitations [ a ammitto:LegalCitation ; ammitto:legalInstrumentId <https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law> ; ammitto:articles "第三条" ; ammitto:articles "第四条" ; ammitto:articles "第五条" ; ammitto:articles "第六条" ; ammitto:articles "第九条" ; ammitto:articles "第十五条" ; ammitto:citationType "legal_basis" ] ;
  ammitto:announcement [ a ammitto:OfficialAnnouncement ; ammitto:title "关于对美国国会议员麦戈文采取反制措施的决定" ; ammitto:url <https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202407/t20240731_11463924.shtml> ; ammitto:publishDate "2024-07-31"^^xsd:date ; ammitto:publishTime "18:21" ; ammitto:documentType "cn/ministry-of-foreign-affairs-order" ; ammitto:documentId "第11号" ; ammitto:signatory "cn/ministry-of-foreign-affairs" ; ammitto:publisher "cn/ministry-of-foreign-affairs" ; ammitto:hasAuthority "cn/ministry-of-foreign-affairs" ; ammitto:content "（2024年7月31日中华人民共和国外交部令第11号公布，自2024年7月31日起施行）\n\n美国马萨诸塞州民主党联邦众议员吉姆·麦戈文近年来频繁采取干涉中国内政、损害中国主权安全发展利益的言行。依据《中华人民共和国反外国制裁法》第三条、第四条、第五条、第六条、第九条、第十五条规定，中方决定对麦戈文采取以下反制措施：\n\n一、冻结在我国境内的动产、不动产和其他各类财产；\n二、禁止我国境内的组织、个人与其本人进行有关交易、合作等活动；\n三、对其本人及其配偶、子女不予签发签证、不准入境。\n\n本决定自2024年7月31日起施行。\n\n附件：反制清单\n\n外交部\n2024年7月31日\n\n附件\n反制清单\n\n美国马萨诸塞州民主党联邦众议员吉姆·麦戈文（Jim McGovern）\n" ; ammitto:language "zh-CN" ] ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "yaml" ; ammitto:sourceSpecificFields """{"cn:list_type":"anti_sanctions","cn:sanction_list":"cn/anti-sanction-list","cn:chinese_name":"吉姆·麦戈文","cn:english_name":"Jim McGovern"}""" ] .
