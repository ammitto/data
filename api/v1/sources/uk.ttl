  ammitto:status "active" ;
  ammitto:referenceNumber "RUS2926" ;
  ammitto:remarks "\nShanlik SHUKUROV is an involved person under the Russia (EU Exit) (Sanctions) Regulations 2019 on the basis of the following ground:  Shanlik SHUKUROV is or has been destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine by owning or controlling\n \ndirectly or indirectly (within the meaning of regulation 7), or is working as a director (whether executive or non-executive), trustee, or other manager or equivalent of Mastel Makina Ithalat Ihracat Limited Sirketi, a person that is making available funds, economic resources, goods or technology that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17051","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
