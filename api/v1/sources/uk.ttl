  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/lib0072> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_libya_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-05-07"^^xsd:date ; ammitto:effectiveDate "2021-05-07"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "LIB0072" ;
  ammitto:remarks "\nMohamed al-Kani is designated on the basis that there are reasonable grounds to suspect that he was head of the Al-Kaniyat militia and involved in the activities of the militia in Tarhuna, including in serious human rights abuses, and violations of international humanitarian law. Under the leadership of Mohamed al-Kani, there are reasonable grounds to suspect that the al-Kaniyat militia was responsible for enforced disappearances, torture and killings which resulted in eight mass graves being uncovered in Tarhouna. There are reasonable grounds to suspect that he is involved in the activities of the militia and that those activities threatened the peace, stability, and security of Libya and undermined its transition to a democratic, peaceful and independent country." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14105","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
