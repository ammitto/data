<https://www.ammitto.org/entry/uk/consolidated-list/bel0101>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0101> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-06-21"^^xsd:date ; ammitto:effectiveDate "2021-06-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0101" ;
  ammitto:remarks "\nIn his capacity as Director of the Aviation Department at the Ministry of Transport and Communication of the Republic of Belarus, Artsiom Sikorski is responsible for the state management in the sphere of civil aviation and supervision of air traffic control. He is therefore responsible for the forced redirection and landing of Ryanair passenger flight FR4978 at Minsk airport, without proper justification, on 23 May 2021. In doing so, Sikorski acted at the direction of Alexander Lukashenko and in conjunction with the Belarusian Ministry of Defence. These politically motivated decisions were aimed at detaining and arresting the opposition journalist and civil society actor Roman Protasevich and Protasevich’s partner Sofia Sapega and are a form of repression against civil society and democratic opposition in Belarus. Therefore, Artsiom Sikorski is responsible for the repression of civil society and democratic opposition in Belarus and so undermined democracy and the rule of law there." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14120","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
