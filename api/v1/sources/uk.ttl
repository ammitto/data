  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/cyb0114> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_cyber_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-12-09"^^xsd:date ; ammitto:effectiveDate "2025-12-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-12-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0114" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Sichuan Anxun Information Technology Co., Ltd. (i-Soon) has been involved in relevant cyber activity, including being responsible for, engaging in and providing support for malicious cyber activity that resulted in the exploitation of previously unknown vulnerabilities and gaining unauthorised access to over 80 foreign government and private business networks.\n \nIn addition, i-Soon facilitated and supported a wider ecosystem of China-based information security companies, enabling actual or attempted unauthorised access to and interference with information systems and data, which targeted UK public sector and private industry IT systems through, namely, researching, exploiting and sharing of vulnerabilities. This malicious activity undermined or was intended to undermine the integrity, prosperity or security of the United Kingdom or a country other than the United Kingdom.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
