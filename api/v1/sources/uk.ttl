  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-23"^^xsd:date ; ammitto:effectiveDate "2023-02-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1740" ;
  ammitto:remarks "\nThe JOINT STOCK COMPANY \"Repair Base for Repair of Aircraft Instruments and Aerodrome Equipment\" known as JSC REMBAZA is an involved person under the Russia (Sanctions)(EU Exit) Regulations 2019 because it is or has been obtaining a benefit from or supporting the Government of Russia by carrying on business in a sector of strategic importance to the Government of Russia namely the electronics sector. In addition, JSC REMBAZA has made available goods to the Ministry of Defence of the Russian Federation that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty and independence of Ukraine.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15777","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
