  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-11-15"^^xsd:date ; ammitto:effectiveDate "2021-11-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "NIC0008" ;
  ammitto:remarks "\nGustavo Eduardo Porras Cortés has been President of the Nicaraguan National Assembly since 2017. During this time, Porras has presided over, introduced, voted for, signed, and publicly advocated for legislation which undermines democracy, violates human rights, and represses civil society and the democratic opposition. He is therefore responsible for undermining democracy and the rule of law, repression of civil society and the democratic opposition and for human rights violations.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14146","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
