  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-10-15"^^xsd:date ; ammitto:effectiveDate "2025-10-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-10-22"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3094" ;
  ammitto:remarks "\nPJSC Oil Company LUKOIL (hereafter LUKOIL) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 based on the following grounds: 1) LUKOIL is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian energy sector; and 2) LUKOIL is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business of economic significance to the Government of Russia.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17195","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Entity"}""" ] .
