  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-04-06"^^xsd:date ; ammitto:effectiveDate "2022-04-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1122" ;
  ammitto:remarks "\nAndrey Igorevich AKIMOV (hereafter AKIMOV) is a Russian businessman who holds senior positions in several Russian companies. AKIMOV is Chairman of the Management Board and Deputy Chairman of the Board of Directors at Gazprombank. Gazprombank is an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector. AKIMOV is a member of the Board of Directors for Novatek. Novatek is an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian energy sector. AKIMOV is a member of the Gazprom Board of Directors. Gazprom is an entity that is controlled directly by the Government of Russia and therefore a Government of Russia-affiliated entity. AKIMOV is or has been involved in obtaining a benefit from or supporting the Government of Russia through working as a director of entities that are carrying on business in a sector of strategic significance to the Government of Russia, and working as a director of a Government of Russia-affiliated entity.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15071","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
