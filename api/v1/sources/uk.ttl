  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0785" ;
  ammitto:remarks "\nNikita Dmitrievich MAZEPIN is the son of Dmitry Arkadievich MAZEPIN (RUS0776). Nikita Dmitrievich MAEZPIN is therefore associated with and has obtained a financial benefit or other material benefit from Dmitry Arkadievich MAZEPIN. \nDmitry Arkadievich MAZEPIN is a member of the Board of Directors for Uralchem Group (a large producer of mineral fertilizer and other chemicals) and CEO of Uralchem JSC. MAZEPIN is or has been involved in obtaining a benefit from or supporting the Government of Russia as a Director or equivalent of an entity carrying on business in the chemical sector – a sector of strategic significance to the Government of Russia.   \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14736","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
