  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0144" ;
  ammitto:remarks "\nFormer Governor of the Krasnodar Krai. He was awarded the medal ‘for the liberation of Crimea’ by the Acting head of the Autonomous Republic of Crimea for the support he provided to the unlawful annexation of Crimea. At that occasion, the Acting Head of the Autonomous Republic of Crimea said that Tkachyov was one of the first to express his support to the new ‘leadership’ of Crimea. Was Minister of Agriculture of the Russian Federation (from 22 April 2015 to 7 May 2018). The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13043","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
