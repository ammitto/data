<https://www.ammitto.org/entity/uk/drc0021>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "MACHANGA LTD" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/drc0021> ;
  ammitto:remarks "Gold export company (Directors: Mr. Rajendra Kumar Vaya and Mr. Hirendra M. Vaya). In 2010, assets belonging to Machanga, held in the account of Emirates Gold, were frozen by Bank of Nova Scotia Mocatta (UK). The owners of Machanga have remained involved in purchasing gold from eastern DRC. Machanga Ltd last filed an annual return in 2004 and was listed as “status inactive” according to the authorities of the Republic of Uganda. INTERPOL-UN Security Council Special Notice web link: https://www.interpol.int/en/How-we-work/Notices/View-UN-Notices-Entities." ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "Plot 55A" ; ammitto:city "Upper Kololo Terrace" ; ammitto:state "Kampala" ; ammitto:country "Uganda" ] .
