  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0072" ;
  ammitto:remarks "\nMinister of the Interior until August 2009. As Interior Minister, Mahsouli had authority over all police forces, interior ministry security agents, and plainclothes agents. The forces under his direction were responsible for attacks on the dormitories of Tehran University on 14 June 2009 and the torture of students in the basement of the Ministry (the notorious basement level 4). Other protestors were severely abused at the Kahrizak Detention Centre, which was operated by police under Mahsouli's control." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12189","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
