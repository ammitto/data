  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-08-10"^^xsd:date ; ammitto:effectiveDate "2023-08-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0044" ;
  ammitto:remarks "\nRaja SALAMEH is an involved person under the Global Anti-Corruption Sanctions Regulations 2021 on the basis that he has been involved in serious corruption. Specifically, he has been responsible for or engaged in serious corruption, has facilitated or provided support for serious corruption or has profited financially or obtained any other benefit from serious corruption given that he received benefit from funds worth over $300m improperly diverted, granted or allocated to a company owned by him from the Central Bank of Lebanon whilst his brother, Riad Salameh, was its Governor.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16069","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
