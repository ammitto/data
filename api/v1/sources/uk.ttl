  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-16"^^xsd:date ; ammitto:effectiveDate "2026-06-16"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-16"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3659" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect that ”A7-AGENT” LIMITED LIABILITY COMPANY is or has been involved in obtaining a benefit from or supporting the Government of Russia on the following two grounds: (1), by providing financial services, or making available funds, economic resources, goods or technology, to a person, in this case A7 LLC and PJSC Promsvyazbank, \n who is carrying on business in a sector of strategic significance to the Government of Russia,\n and (2) by carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
