<https://www.ammitto.org/entry/uk/consolidated-list/rus0164>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0164> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0164" ;
  ammitto:remarks "\nThe ownership of the entity was transferred contrary to the Ukrainian law. On 9 April 2014, the ‘Presidium of the Parliament of Crimea’ adopted a decision No 1991-6/14 ‘On the amendments to the Resolution of the State Council of the “Republic of Crimea” of 26 March 2014 No 1836-6/14 ‘On nationalization of the property of enterprises, institutions and organizations of agro-industrial complex, located in the territory of the “Republic of Crimea”’ declaring the appropriation of assets belonging to the state enterprise ‘Gosudarstvenoye predpriyatiye Agrofirma “Magarach” nacionalnogo instituta vinograda i vina “Magarach”’ on behalf of the ‘Republic of Crimea’. The enterprise is thus effectively confiscated by the Crimean ‘authorities’. Re-registered on 15 January 2015 as ‘State Unitary Institution of the “Republic of Crimea” National Institute of Wine “Magarach”’. Founder: The Ministry of Agriculture of the ‘Republic of Crimea’. On 7 February 2017, State Unitary Enterprise of the ‘Republic of Crimea’‘National Institute of Wine “Magarach”’ was transformed into Federal Budgetary scientific facility ‘All-Russia scientific-research institute of viticulture and winemaking “Magarach”’, Russian Academy of Sciences The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13061","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
