<https://www.ammitto.org/entity/uk/rus0664>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "FRIDMAN" ; ammitto:firstName "Mikhail" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "FRIEDMAN" ; ammitto:firstName "Mikhail" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Михаил Маратович ФРИДМАН" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/rus0664> ;
  ammitto:remarks "Transport sanctions: ships owned, controlled, chartered or operated by the individual are prohibited from entering a port in the UK; may be given a movement or a port entry direction, can be detained, and will be refused permission to register on the UK Ship Register or have its existing registration terminated. An aircraft owned, chartered or operated by the individual is prohibited from overflying or landing in the UK, may be given a movement direction, can be detained or moved to a specified airport, and will be refused permission to register on the CAA Aircraft Register or have its existing registration terminated. Prohibition of technical assistance relating to aircraft and ships: a prohibition on the provision of technical assistance relating to aircraft or ships will prevent a person from directly or indirectly providing technical assistance to, or for the benefit of, the designated person, where that technical assistance relates to an aircraft or ship. The Director Disqualification Sanction was imposed on 09/04/2025." .
<https://www.ammitto.org/entry/uk/consolidated-list/rus0664>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0664> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-24"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0664" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect that Mikhail Maratovich FRIDMAN is an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019 (the \"Russia Regulations\") on the basis of the following grounds: (1) FRIDMAN is and/or has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of Alfa Group, a person carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (2) FRIDMAN has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of ABH Holdings S.A., an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (3) FRIDMAN has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of Alfa-Bank Russia, an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector;  (4) FRIDMAN has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of Alfa-Bank Russia, an entity carrying on business of economic significance to the Government of Russia; (5) FRIDMAN is and/or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (6) FRIDMAN is associated with a person who is or has been so involved, namely Petr AVEN. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14615","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/rus0665>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "AVEN" ; ammitto:firstName "Petr" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "AVEN" ; ammitto:firstName "Pyotr" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Пëтр Олегович АВЕН" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/rus0665> ;
  ammitto:remarks "Transport sanctions: where transport sanctions apply, a ship owned, controlled, chartered or operated by a designated person is prohibited from entering a port in the UK, may be given a movement or a port entry direction, can be detained, and will be refused permission to register on the UK Ship Register or have its existing registration terminated. Similarly, an aircraft owned, chartered or operated by a designated person is prohibited from overflying or landing in the UK, may be given a movement direction, can be detained or moved to a specified airport, and will be refused permission to register on the CAA Aircraft Register or have its existing registration terminated. This also includes a prohibition of technical assistance relating to aircraft and ships: a prohibition on the provision of technical assistance relating to aircraft or ships will prevent a person from directly or indirectly providing technical assistance to, or for the benefit of, the designated person, where that technical assistance relates to an aircraft or ship. The Director Disqualification Sanction was imposed on 09/04/2025. " ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "Riga" ; ammitto:country "Latvia" ] .
