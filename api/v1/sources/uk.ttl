<https://www.ammitto.org/entry/uk/consolidated-list/bel0108>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0108> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-06-21"^^xsd:date ; ammitto:effectiveDate "2021-06-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0108" ;
  ammitto:remarks "\nBELAERONAVIGATSIA Republican Unitary Air Navigation Services Enterprise is responsible for Belarusian air traffic control. It therefore bears responsibility for the order to intercept passenger flight FR4978 and compel its landing at Minsk airport, without proper justification, on 23 May 2021. In doing so, it acted on the direction of Alexander Lukashenko and in conjunction with the Belarusian defence forces. This resulted in the detention of the aircraft, its passengers and the crew, and the arrest of opposition journalist and civil society actor Roman Protasevich and Protasevich’s partner Sofia Sapega. This politically-motivated decision was aimed at arresting and detaining opposition journalist Protasevich and Sapega and constitutes a form of repression of civil society and democratic opposition in Belarus.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14082","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/bel0109>
