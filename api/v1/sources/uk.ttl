  ammitto:hasRegime <https://www.ammitto.org/regime/the_venezuela_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "VEN0001" ;
  ammitto:remarks "\nCurrently Minister for Electrical Energy and Sectoral Vice President of Public Works and Services. There are reasonable grounds to suspect that Reverol Torres, as Interior Minister, was responsible for policing, and parts of the Venezuelan security forces.  Under the command of Reverol Torres as Interior Minister, the Bolivarian National Police committed serious human rights violations between April and July 2017, including excessive use of force by security forces, arbitrary arrest and detention, mistreatment and torture in detention, and over 120 deaths between April and August 2017. Further, there are reasonable grounds to suspect that he was also involved in the commission of serious human rights violations as former Commander General of the Bolivian National Guard, including during “Liberation of the People” security operations against suspected gang-members in 2015. He was later promoted to General in Chief within the National Guard. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13580","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
