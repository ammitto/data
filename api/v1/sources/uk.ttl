  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-05-05"^^xsd:date ; ammitto:effectiveDate "2026-05-05"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-05-05"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0051" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect that Polina Alexandrovna AZARNYKH is an involved person under the Global Irregular Migration and Trafficking in Persons Sanctions Regulations 2025 as she is or has been involved in a relevant activity, namely the instrumentalisation of migration for the purposes of destabilisation. Backed by the Government of Russia, AZARNYKH facilitates the travel of individuals from countries like Egypt, Iraq, the Ivory Coast, Nigeria, Morocco, Syria, and Yemen to Ukraine via Russia for the purpose of destabilising Ukraine as the individuals are deployed to fight for Russia in its war of aggression in Ukraine.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
