  ammitto:status "active" ;
  ammitto:referenceNumber "BIH0002" ;
  ammitto:remarks "\nMilorad Dodik as the Bosnian Serb member of the Bosnia and Herzegovina tripartite Presidency has used this position to undermine the territorial integrity, sovereignty and stability of Bosnia and Herzegovina through using hate speech to stir ethnic tensions, calling for the fragmentation of Bosnia and Herzogovina to create an independent Republika Srpska, and overseeing legislative steps to degrade/destroy state institutions.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15082","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
