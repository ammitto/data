  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/drc0072> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_democratic_republic_of_the_congo_sanctions_eu_exit_regulatio> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-12-09"^^xsd:date ; ammitto:effectiveDate "2024-12-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "DRC0072" ;
  ammitto:remarks "\nAlain Francois Viviane GOETZ is an involved person under the Democratic Republic of the Congo (Sanctions) (EU Exit) Regulations 2019 on the basis of the following ground: GOETZ is or has been involved in providing financial services, or making available funds or economic resources, that could contribute to any serious human rights violation or abuse, any violation of international humanitarian law or obstructing or undermining respect for democracy, the rule of law and good governance in the Democratic Republic of the Congo. Specifically, GOETZ, through his involvement in the global gold market and the illicit trade of gold, is or has been involved in contributing to serious human rights violations and obstructing or undermining respect for democracy, the rule of law and good governance in the DRC. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16710","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/drc0076>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Alliance Fleuve Congo" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Congo River Alliance" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "AFC" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/drc0076> ;
  ammitto:remarks "Listed pursuant to paragraphs 7(c), 7(h), 7(g), and 7(j) of resolution 2293 (2016), as reaffirmed by paragraph 2 of resolution 2688 (2023) and paragraph 3 of resolution 2738 (2024) and resolution 2783 (2025): The CONGO RIVER ALLIANCE has and continues to  impede the participation of their combatants, namely M23 combatants, in disarmament, demobilization and reintegration processes.  The CONGO RIVER ALLIANCE acts on behalf of, and provides support for, a designated entity, namely M23, and shares responsibility for  M23’s destabilisation activities including through the exploitation of natural resources such as coltan." ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:country "Congo (Democratic Republic)" ] .
