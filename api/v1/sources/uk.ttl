  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0107" ;
  ammitto:remarks "\nBNK (UK) Ltd Company is controlled directly or indirectly by the President of Belarus, Alexander Lukashenko, who has been responsible for serious violations of human rights in Belarus. BNK (UK) Ltd is controlled by CJSC Belarusian Oil Company, the state exporter of oil products, of which Belarusneft Production Association, a State owned entity in Belarus is the major controlling party. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14124","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/bel0108>
