  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13939","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
