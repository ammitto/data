  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-04-10"^^xsd:date ; ammitto:effectiveDate "2025-04-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0152" ;
  ammitto:remarks "\nShalva Bedoidze is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis of the following ground: Shalva Bedoidze is and/or has been responsible for activity which amounts to a serious violation of the right of individuals not to be subjected to cruel, inhuman or degrading treatment or punishment. \n \nSpecifically, during the protests that occurred following the announcement of the suspension of EU accession talks, the Ministry of Internal Affairs of Georgia oversaw the police force's disproportionate use of violence against protestors. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16852","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
