<https://www.ammitto.org/entry/uk/consolidated-list/gac0026>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/gac0026> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_anti_corruption_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-07-22"^^xsd:date ; ammitto:effectiveDate "2021-07-22"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0026" ;
  ammitto:remarks "\nAlvaro Enrique Pulido Vargas (aka German Enrique Rubio Salas) is a close business associate of Alex Saab. With him, he engaged in serious corruption in Venezuela through his participation in two of Venezuela’s public programmes: the ‘Local Committees for Supply and Production’ (CLAP) and the Great Housing Scheme Venezuela (GMVV). In each case, contracts were improperly granted for the benefit of an official and/or for another person including Pulido Vargas himself. In the CLAP programme, basic foodstuffs were provided at highly inflated prices. For GMVV, Global Construction Fund only delivered a small proportion of the products they had agreed to deliver, misappropriating the remainder of the funds. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14129","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
