  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Vasilyev" ; ammitto:firstName "Kirill" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
