  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ЛОЗИЦКИЙ Александр Витальевич" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
