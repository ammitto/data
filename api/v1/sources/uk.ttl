  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-04-13"^^xsd:date ; ammitto:effectiveDate "2022-04-13"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-07-23"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1333" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Pavel EZUBOV is an involved person on the basis of the following grounds: (1) Pavel EZUBOV is associated with Alexey Petrovich EZUBOV, his father, who was designated under the Russia (Sanctions) (EU Exit) Regulations 2019 by the United Kingdom on 11 March 2022. Alexey Petrovich EZUBOV is or has been involved in providing support for policies and/or actions which destabilise Ukraine and/or undermine or threaten the territorial integrity, sovereignty or independence of Ukraine through his role as a member of the State Duma of Russia; (2) Pavel EZUBOV is associated with Oleg DERIPASKA (including on the basis of obtaining financial or other material benefit). Oleg DERIPASKA was designated under the Russia (Sanctions) (EU Exit) Regulations 2019 by the United Kingdom on 10 March 2022. Oleg DERIPASKA is associated with and acting on behalf of, or at the direction of, a person who is and has been involved in destabilising Ukraine and undermining and threatening the territorial integrity, sovereignty and independence of Ukraine, namely Vladimir Putin, and is and has been involved in obtaining a benefit from or supporting the Government of Russia by indirectly owning or controlling entities which are carrying on business in sectors of strategic significance to the Government of Russia. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15268","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
