  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0040" ;
  ammitto:remarks "\nFormer Governor-General (‘Farmandar’) of Tehran Province until September 2010, he was responsible for the intervention of police forces and therefore for the repression of demonstrations. He received a prize in December 2010 for his role in the post-election repression." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12194","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
