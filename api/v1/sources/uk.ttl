  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_nicaragua_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "NIC0006" ;
  ammitto:remarks "\nMoncada Lau holds several unofficial positions in Ortega’s regime. He is the custodian of the Sandinista National Liberation Front. He also acts as the liaison between Ortega and the chief of the National Police, as well as with paramilitary groups and intelligence activities. In these roles, he has been involved in serious violations of human rights in Nicaragua through the National Police’s disproportionate use of force in relation to the 2018 protests, including extrajudicial killings, violating the right to life, the right to freedom of assembly and the right to freedom of expression. He is also involved in paramilitary groups murdering and arbitrarily detaining protesters, violating the right to life, the right to freedom of assembly and the right to freedom of expression." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13837","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
