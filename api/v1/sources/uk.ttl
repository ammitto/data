  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-04-02"^^xsd:date ; ammitto:effectiveDate "2025-04-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0068" ;
  ammitto:remarks "\nThere are reasonable grounds to suspect that José Rafael Curruchiche Cucul (“Curruchiche”) is an involved person within the meaning of the Global Anti-Corruption Sanctions Regulations 2021 on the basis of the following grounds: \n \n(1) Curruchiche is or has been involved in serious corruption by being responsible for or engaging in serious corruption. Whilst a prosecutor within the Public Ministry (Ministerio Público, MP), a foreign public official exercising a judicial function, he accepted a promotion to Head of the Special Prosecution Office Against Impunity (Fiscalía Especial contra la Impunidad, FECI). He did so in anticipation of him improperly performing a public function as Head of the FECI, intentionally undermining corruption investigations into the Guatemalan political elite. \n \n(2) Curruchiche is or has been involved in serious corruption, by being responsible for the investigation or prosecution of serious corruption and intentionally failing to fulfil that responsibility. Whilst a prosecutor within the MP, a foreign public official exercising a judicial function, he accepted a promotion to Head of the FECI. He did so in anticipation of him improperly performing a public function as Head of the FECI, intentionally undermining corruption investigations into the Guatemalan political elite. \n \n(3) Curruchiche is or has used threats or intimidation to interfere in a law enforcement or judicial process in connection with serious corruption. Whilst a prosecutor within the MP, a foreign public official exercising a judicial function, he accepted a promotion to Head of the FECI. He did so in anticipation of him improperly performing a public function as Head of the FECI, intentionally undermining corruption investigations into the Guatemalan political elite.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16842","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
