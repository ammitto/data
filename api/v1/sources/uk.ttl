  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-01"^^xsd:date ; ammitto:effectiveDate "2022-03-01"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0257" ;
  ammitto:remarks "\nAs Deputy Minister of Defence for Logistics and Chief of Logistics of the Belarusian Armed Forces, Major General Andrei Burdyko is an active and senior military leader in Belarus and, as part of the top-level chain of command, is responsible for directing the actions of the Belarusian armed forces, which have supported and enabled Russia’s invasion of Ukraine. The Belarusian armed forces have conducted joint military exercises with Russian armed forces, and also consented to the deployment of Russian troops along the border of Belarus with Ukraine, which has directly contributed to Russia’s ability to both threaten and attack Ukraine, including from positions in Belarus. Burdyko therefore is or has been involved in destabilising Ukraine and undermining or threatening the territorial integrity, sovereignty and independence of Ukraine. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14203","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
