  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0010" ;
  ammitto:remarks "\nLarisa Anatolievna Litvinova was head of the therapeutic ward at Butyrka Prison where Sergei Magnitsky was detained between 25 July and 16 November 2009. She was involved in the mistreatment of Sergei Magnitsky by failing to ensure the proper administration of medical care to him during this period causing him considerable suffering and contributing significantly to his death." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13865","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
