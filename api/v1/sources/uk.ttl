  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-10-28"^^xsd:date ; ammitto:effectiveDate "2024-10-28"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS2289" ;
  ammitto:remarks "\nAndrey Naumovich Perla (hereafter Perla) is an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: 1) Perla is and has been obtaining a benefit from the Government of Russia by acting as a director or equivalent of an entity, Social Design Agency, which is carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian information, communications and digital technologies sector; 2) Perla is and has been involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine, by working as a director or equivalent of an entity, Social Design Agency, that is responsible for, engages in, provides support for, or promotes any policy or action which destabilises Ukraine or undermines or threatens the territorial integrity, sovereignty or independence of Ukraine; and 3) Perla is and has been involved in destabilising Ukraine, undermining, or threatening the territorial integrity, sovereignty, or independence of Ukraine by promoting policies and actions which destabilise Ukraine, undermine and threaten the territorial integrity, sovereignty, and independence of Ukraine. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16613","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction|Internet Services Sanctions: see \"Other Information\"","uk:entityType":"Individual"}""" ] .
