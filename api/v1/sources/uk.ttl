  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CTI0046" ;
  ammitto:remarks "\nGuillaume Pirotte is a member of the jihadist group Firqatul Ghuraba which is headed by Senegalese national Oumar Diaby. He participated in battles alongside members of Jabhat al Nusra and appeared as an actor in jihadist propaganda. Jabhat al Nusra was disbanded in January 2017. Over the course of the past few years, he has assisted many individuals to travel from France to Syria for the purposes of committing terrorist acts." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13798","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Arms embargo|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
