  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0014" ;
  ammitto:remarks "\nRepresentative of the Guide for the Pasdaran since 1995 after spending his whole career within the institution of the military, and specifically in the Pasdaran intelligence service. This official role makes him the key figure in the transmission of orders emanating from the Office of the Guide to the Pasdaran's repression apparatus." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12651","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
