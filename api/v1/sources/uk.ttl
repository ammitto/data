<https://www.ammitto.org/entry/uk/consolidated-list/cyb0044>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/cyb0044> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_cyber_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-03-25"^^xsd:date ; ammitto:effectiveDate "2024-03-25"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0044" ;
  ammitto:remarks "\nWUHAN XIAORUIZHI SCIENCE AND TECHNOLOGY COMPANY LIMITED is associated with Advanced Persistent Threat Group 31 (APT31) and is, or has been, involved in relevant cyber activity, including being responsible for, engaging in, or providing support for the commission, planning, or preparation of relevant cyber activity on behalf of the Chinese State. \n \nThis included the preparation for, and/or the provision of support to, sophisticated cyber activity, including spear-phishing campaigns and information systems interference which resulted in the unauthorised access to, and exfiltration of, sensitive data. Such campaigns included cyber activities targeting officials, government entities and parliamentarians conducted by APT31 against such individuals in the UK and internationally. \n \nAs such, WUHAN XIAORUIZHI SCIENCE AND TECHNOLOGY COMPANY LIMITED, is an associated person in the activity of the APT31 group operating on behalf of the Chinese Ministry of State Security (MSS) as part of the PRC’s state-sponsored apparatus and itself has engaged in relevant cyber activity, in support of malicious cyber activity that targeted officials, government entities and parliamentarians. \n \nThis action undermined, or was intended to undermine, the integrity, prosperity and security of UK and international organisations and individuals engaged in political and democratic processes. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16460","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
