  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "MALEKI" ; ammitto:firstName "NASER" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/inu0294> ;
  ammitto:remarks "Naser MALEKI was listed pursuant to paragraph 12 of resolution 1737 (2006), as read with resolutions 1747, 1803 and 1929, as: a person involved in nuclear or ballistic missile activities. Head of SHIG, which is designated under resolution 1737 (2006) for its role in Iran’s ballistic missile programme. Naser Maleki is also a MODAFL official overseeing work on the Shahab-3 ballistic missile programme. The Shahab-3 is Iran’s long range ballistic missile currently in service. The Director Disqualification Sanction was imposed on 09/04/2025." .
