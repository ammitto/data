  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0077" ;
  ammitto:remarks "\nFormer head of the Revolutionary Prosecution of Shiraz. Responsible for illegal arrests and ill treatment of political activists, journalists, human rights defenders, Baha'is and prisoners of conscience, who were harassed, tortured, interrogated and denied access to lawyers and due process. Musavi-Tabar signed judicial orders in the notorious No 100 Detention Centre (a male prison), including an order to detain female Baha'i prisoner Raha Sabet for three years in solitary confinement." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12856","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
