<https://www.ammitto.org/entry/uk/consolidated-list/rus0193>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0193> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0193" ;
  ammitto:remarks "\nAfter the illegal annexation of Crimea, Russian National Commercial Bank (RNCB) became fully owned by the so-called 'Republic of Crimea'. In January 2016 became a property of Federal Agency for State Property Management also known as Rosimushchestvo. It has become the dominant player in the market, while it had no presence in Crimea before the annexation. By buying or taking over from branches of retreating banks operating in Crimea, RNBC supported materially and financially the actions of the Russian government to integrate Crimea into the Russian Federation, thus undermining Ukraine's territorial integrity. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13078","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
