<https://www.ammitto.org/entry/uk/consolidated-list/ven0034>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ven0034> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_venezuela_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "VEN0034" ;
  ammitto:remarks "\nLuis Parra Rivero is a National Assembly Deputy (2021-2025) having been re-elected on 6 December 2020 in undemocratic parliamentary elections not recognised as free and fair by the UK. He was appointed Vice President of the National Assembly’s Permanent Commission on the Environment in January 2021. Parra Rivero had previously served as a National Assembly Deputy for the period 2016-2020. \n \nThere are reasonable grounds to suspect that Parra has been involved in undermining democracy in Venezuela by attempting to take office as NA President on 5 January 2020 under an illegitimate process. The evidence indicates that Parra did not have the quorum for a session, the session was not moderated by the previous President of the National Assembly, and security forces blocked access to MPs that tried to enter the NA to participate in elections for a new National Assembly board.  \n \nThere are also reasonable grounds to suspect that Parra was involved with Operation Alacran, a scandal in which MPs were bribed, intimidated and coerced by the regime (or deputies co-opted by the regime) to not vote for opposition figurehead Juan Guaidó.  \n \nThere are lastly reasonable grounds to suspect that Parra has been involved in undermining democracy and the rule of law in Venezuela through his involvement in a corruption scandal related to the regime’s Committee of Supply and Demand (CLAP).  \n \nThere are also reasonable grounds to suspect that Parra is associated with a person who is involved in undermining democracy in Venezuela (Nicolas Maduro), through aiding Maduro’s attacks on and attempts to control the National Assembly. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13849","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/ven0035>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Duarte" ; ammitto:firstName "Franklyn" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/ven0035> ;
  ammitto:remarks "The Director Disqualification Sanction was imposed on 09/04/2025." .
<https://www.ammitto.org/entry/uk/consolidated-list/ven0035>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ven0035> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_venezuela_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "VEN0035" ;
  ammitto:remarks "\nFranklyn Duarte is a National Assembly Deputy (2021-2025) having been re-elected on 6 December 2020 in undemocratic parliamentary elections not recognised as free and fair by the UK. Duarte had previously served as a National Assembly Deputy for the period 20156-2020. \n \nAs a Deputy of the 2015-2020 National Assembly Deputy, there are reasonable grounds to suspect that Franklin Duarte has been involved in the repression of democratic opposition and other actions, policies, or activities which undermine democracy in Venezuela by coming to power through fraudulent/illegitimate elections for the new National Assembly Board on 5 January 2020 and through his involvement with Operation Alacran.  \n \nThere are also reasonable grounds to suspect that Duarte has been acting on behalf of, or at the direction of, a person (Nicolas Maduro) who is involved in repression of political opposition and other actions, policies, or activities which undermine democracy in Venezuela, by enabling him to attack and control the democratically elected National Assembly.  \n \nThere are lastly reasonable grounds to suspect that Duarte is a member of, or associated with, persons who have been involved with the repression of democratic opposition and other actions, policies, and activities which undermined democracy in Venezuela due to his involvement in Operation Alacran. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13850","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/ven0036>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Noriega Figueroa" ; ammitto:firstName "Jose" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "José Gregorio NORIEGA FIGUEROA" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
