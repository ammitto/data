<https://www.ammitto.org/entry/uk/consolidated-list/ghr0154>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ghr0154> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-04-10"^^xsd:date ; ammitto:effectiveDate "2025-04-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0154" ;
  ammitto:remarks "\nKarlo Katsitadze is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis of the following ground: Karlo Katsitadze is and/or has been responsible for the investigation or prosecution of activity which amounts to a serious violation of the right of individuals not to be subjected to cruel, inhuman or degrading treatment or punishment, and has intentionally or recklessly failed to fulfil that responsibility. \n \nSpecifically, during the protests that occurred after the passage of the foreign influence law, security forces from the Ministry of Internal Affairs Special Task Department (Special Task Department), and Tbilisi Police Department, violently targeted Georgian citizens, political opposition leaders, journalists, and youth activists. In his role as Head of the Special Investigatory Service, Karlo Katsitadze is responsible for investigating and holding law enforcement officials accountable for police violence, and in this instance has failed to do so. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16854","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
