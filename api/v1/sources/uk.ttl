  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "KAINA" ; ammitto:firstName "INNOCENT" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "KAINA" ; ammitto:firstName "Innocent" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Queen" ; ammitto:firstName "India" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/drc0037> ;
  ammitto:remarks "Became M23 deputy commander after the flight of Bosco Taganda’s faction to Rwanda in March 2013. Fled to Uganda in November 2013. In Uganda as of early 2016. INTERPOL-UN Security Council Special Notice web link: https://www.interpol.int/en/notice/search/un/5776081" ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:country "Uganda" ] .
