  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1712> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-08"^^xsd:date ; ammitto:effectiveDate "2023-02-08"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1712" ;
  ammitto:remarks "\n LLC CST is an involved person under the Russia (Sanctions) (EU Exit) regulations 2019 because (1) it is involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine through the manufacture and supply of UAVs which are used by the Russian military in its invasion of Ukraine and (2) by obtaining a benefit from or supporting the Government of Russia by carrying on business in the strategically important defence sector. LLC CST, under the trade name ZALA AERO GROUP is a Russian based Unmanned Aerial Vehicle (UAV) manufacturer. They produce the Lancet range of UAVs which have been used extensively by the Armed Forces of the Russian Federation in Ukraine.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15734","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
