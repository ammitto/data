  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ornellas Ferreira" ; ammitto:firstName "Jose" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "José Adelino Ornelas Ferreira" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
