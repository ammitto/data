  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "HISSENE" ; ammitto:firstName "ABDOULAYE" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abdoulaye" ; ammitto:firstName "Hissene" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abdoulaye" ; ammitto:firstName "Issene" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Hissein" ; ammitto:firstName "Abdoulaye" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Issene" ; ammitto:firstName "Abdoulaye" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ramadan" ; ammitto:firstName "Abdoulaye" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ramadane" ; ammitto:firstName "Abdoulaye" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abdoulaye Issène" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abdoulaye Ramadane Issène" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/caf0013> ;
  ammitto:remarks "Hissène was formerly the Minister of Youth and Sports as part of the Cabinet for the Central African Republic’s former President Michel Djotodia. Prior to that, he was the head of the Convention of Patriots for Justice and Peace, a political party. He also established himself as a leader of armed militias in Bangui, in particular in the “PK5” (3rd district) neighborhood. In October 2016, Abdoulaye Hissène was appointed President of the Conseil National de Défense et de Sécurité, a body which was created at the time to gather military leaders and commanding fighters from all ex-Séléka factions. He has remained in this position since then, but has actual control over FPRC fighters only. Father’s name is Abdoulaye. Mother’s name is Absita Moussa. Photo available for inclusion in the INTERPOL-UN Security Council Special Notice. INTERPOL-UN Security Council Special Notice web link: https://www.interpol.int/en/How-we-work/Notices/View-UN-Notices-Individuals" ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:state "Nana-Grebizi" ; ammitto:country "Central African Republic" ] ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:city "KM5" ; ammitto:state "Bangui" ; ammitto:country "Central African Republic" ] ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:city "Ndélé" ; ammitto:state "Bamingui-Bangoran" ] ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:city "Ndjari" ; ammitto:state "Ndjamena" ; ammitto:country "Chad" ] .
