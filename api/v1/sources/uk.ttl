  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0149" ;
  ammitto:remarks "\nWasantha KARANNAGODA is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis that he has been and remains responsible for an activity that amounts to a serious violation of an individual's right to life and right not to be subjected to torture or cruel, inhuman or degrading treatment or punishment. Specifically, KARANNAGODA was the Commander of the Navy between September 2005 and July 2009 and during this time the Sri Lankan Navy under KARANNAGODA’s command responsibility committed human rights violations including illegal killings and engaged in activities amounting to torture or cruel, inhuman or degrading treatment or punishment.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16831","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
