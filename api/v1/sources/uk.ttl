  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0071" ;
  ammitto:remarks "\nFabio Zavarse has held several high-ranking positions within the Venezuelan Armed Forces during different waves of protests in Venezuela. The military, responding to these protests with excessive use of force, committed serious human rights violations, including violations of the right to life. Zavarse bears responsibility for the serious violations of human rights conducted by GNB forces under his command in Caracas in seeking to quell the protests in 2016 and 2017." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14011","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
