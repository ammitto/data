  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0083" ;
  ammitto:remarks "\nFormer so-called \"Prime Minister of the Donetsk People's Republic \", as such responsible for the separatist \"governmental\" activities of the so called \"government of the Donetsk People's Republic\" (eg on 8 July stated \"our military is conducting a special operation against the Ukrainian \"fascists), signatory of the Memorandum of Understanding on \"Novorossiya union\". \nRemains active in supporting separatist actions or policies; heads the “Union of Donbas volunteers”. \n \nInvolved actively in recruitment and training of “volunteers” sent to fight in Donbas.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13009","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
