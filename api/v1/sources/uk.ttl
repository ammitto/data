  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-07-06"^^xsd:date ; ammitto:effectiveDate "2026-07-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-07-06"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CHW0044" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that \nSC Signal is an involved person under the Chemical Weapons (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: (1) SC Signal is or has been responsible for, engaging in, providing support for, or promoting prohibited activity related to chemical weapons; (2) SC Signal is a member of, or associated with, entities, namely the State Research Institute of Military Medicine (GNIII VM) and the State Research Institute of Organic Chemistry and Technology (GosNIIOKhT), which are or have been responsible for, engaging in, providing support for, or promoting prohibited activity related to chemical weapons.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
