<https://www.ammitto.org/entry/uk/consolidated-list/rus2718>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus2718> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-05-20"^^xsd:date ; ammitto:effectiveDate "2025-05-20"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-05-20"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS2718" ;
  ammitto:remarks "\nA7 Limited Liability Company is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the following grounds:  \n \n(1) A7 Limited Liability Company is involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine because it provides financial services to a person that provides financial services or makes available funds and economic resources that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine. \n \n(2) A7 is involved in obtaining a benefit from or supporting the Government of Russia because it is carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector.  \n \n(3) A7 Limited Liability Company is involved in obtaining a benefit from or supporting the Government of Russia because it is carrying on business as a Government of Russia-affiliated entity. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16954","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
