  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0048" ;
  ammitto:remarks "\nHead of section VI of the police, investigation department. Former Head of the Intelligence Services within the Iranian Police. Former Head of the Computer Crimes Unit of the Iranian Police. He was responsible for thousands of investigations and indictments of reformists and political opponents using the Internet. He was thus responsible for grave human rights violations in the repression of persons who speak out in defence of their legitimate rights, including freedom of expression during and after the 2009 Green Movement." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12191","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
