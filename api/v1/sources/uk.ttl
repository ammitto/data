  ammitto:addresses [ a ammitto:Address ; ammitto:street "Quarter Master General Office, Ministry of Defence, Building 24" ; ammitto:state "Naypyitaw" ; ammitto:country "Myanmar" ] .
<https://www.ammitto.org/entry/uk/consolidated-list/mya0031>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0031> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-10"^^xsd:date ; ammitto:effectiveDate "2021-12-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0031" ;
  ammitto:remarks "\nThe Quarter Master General Office (QMGO) sits within the Myanmar Ministry of Defence which is responsible for overseeing a campaign of violence and human rights violations across Myanmar, particularly in ethnic areas. Evidence indicates that the QMGO plays a crucial role in procuring equipment for the Myanmar Armed Forces, including ammunition, bombs and jet fuel. This directly enables serious human rights violations, and the repression of the civilian population including peaceful protestors and ethnic minorities. Further and/or alternatively, the QMGO is associated with the Commander-in-Chief (as Chief of the Armed Forces) who is a designated individual. The QMGO also works for the State Administration Council (SAC), as the SAC has control over the Ministry of Defence. In addition, the QMGO is intrinsically linked with Myanmar Economic Corporation, which is designated for funding serious human rights violations.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14164","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/mya0032>
  a ammitto:OrganizationEntity ;
