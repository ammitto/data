<https://www.ammitto.org/entry/uk/consolidated-list/bel0111>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0111> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-02"^^xsd:date ; ammitto:effectiveDate "2021-12-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0111" ;
  ammitto:remarks "\nOJSC BELARUSKALI is one of the world’s largest producers of the key fertilizer ingredient potassium chloride (potash), and is 100% owned by the Belarusian state. As a state-owned enterprise, OJSC BELARUSKALI is a major source of revenue and foreign currency for the Lukashenko regime, including through the transfer of OJSC BELARUSKALI’s profits to the National Development Fund which is directed by Lukashenko. Export duties and taxes generated by OJSC BELARUSKALI account for 8-10% of the total budget of the Government of Belarus, and are therefore critically important in maintaining the regime and enabling its actions. Through the production of potash and its treatment of striking workers during the protests and crackdown in 2020, OJSC BELARUSKALI has helped prop up the authoritarian rule of Lukashenko’s regime. OJSC BELARUSKALI therefore is or has been involved in providing support for the Government of Belarus, which has taken actions to undermine democracy and the rule of law, repress civil society and the democratic opposition, and commit serious human rights violations. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14154","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
