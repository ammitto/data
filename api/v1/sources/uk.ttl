  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mangue" ; ammitto:firstName "Teodoro" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
