<https://www.ammitto.org/entry/uk/consolidated-list/gac0065>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/gac0065> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_anti_corruption_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-04-02"^^xsd:date ; ammitto:effectiveDate "2025-04-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0065" ;
  ammitto:remarks "\nThere are reasonable grounds to suspect that Ángel Arnoldo Pineda Ávila (“Pineda”) is an involved person within the meaning of the Global Anti-Corruption Sanctions Regulations 2021 on the basis of the following grounds: \n \n(1) Pineda is or has been involved in serious corruption, by being responsible for or engaging in serious corruption. When Secretary of International Affairs and Cooperation at the Public Ministry (Ministerio Público, MP), a foreign public official performing an executive or administrative function, he received an advantage, namely his appointment as Secretary General of the MP. On accepting the advantage, he intended to improperly perform a public function. He has done so by intentionally undermining corruption investigations into the Guatemalan political elite and pursuing meritless legal challenges against journalists, judges and prosecutors who revealed endemic corruption in Guatemala.\n \n(2) Pineda is or has been involved in serious corruption, by being responsible for the investigation or prosecution of serious corruption and intentionally failing to fulfil that responsibility. When Secretary of International Affairs and Cooperation at the MP, a foreign public official performing an executive or administrative function, he received an advantage, namely his appointment as Secretary General of the MP. On accepting the advantage, he intended to improperly perform a public function. He has done so by intentionally undermining corruption investigations into the Guatemalan political elite and pursuing meritless legal challenges against journalists, judges and prosecutors who revealed endemic corruption in Guatemala. \n \n(3) Pineda is or has used threats or intimidation to interfere in a law enforcement or judicial process in connection with serious corruption. When Secretary of International Affairs and Cooperation at the MP, a foreign public official performing an executive or administrative function, he received an advantage, namely his appointment as Secretary General of the MP. On accepting the advantage, he intended to improperly perform a public function. He has done so by intentionally undermining corruption investigations into the Guatemalan political elite and pursuing meritless legal challenges against journalists, judges and prosecutors who revealed endemic corruption in Guatemala.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16839","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
