  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0041" ;
  ammitto:remarks "\nFirst Deputy Advisor to the Judiciary and Judge of the Supreme Court. Deputy to the Prosecutor-General of Iran (2007-2015). In this role he was responsible for judicial cases brought after the post-election protests in 2009 which were conducted in contravention of human rights. Also in this role he has condoned excessive punishments for drug offences." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12196","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
