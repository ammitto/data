  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0056" ;
  ammitto:remarks "\nFormer member of the Supreme Council of Cyber Space. Former President of the Islamic Republic of Iran Broadcasting (IRIB). Former Head of IRIB World Service and Press TV, responsible for all programming decisions. Closely associated with the state security apparatus. Under his direction Press TV, along with IRIB, has worked with the Iranian security services and prosecutors to broadcast forced confessions of detainees, including that of Iranian-Canadian journalist and film- maker Maziar Bahari, in the weekly programme ‘Iran Today’. Independent broadcast regulator OFCOM fined Press TV in the UK GBP 100 000 for broadcasting Bahari's confession in 2011, which was filmed in prison whilst Bahari was under duress. Sarafraz therefore is associated with violating the right to due process and fair trial" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12852","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
