<https://www.ammitto.org/entry/uk/consolidated-list/ghr0195>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ghr0195> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-09"^^xsd:date ; ammitto:effectiveDate "2026-06-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-15"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0195" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that ARTZENU is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis of the following grounds: \n \n \n(1) ARTZENU facilitates, incites, promotes or provides support for activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(b)];\n \n \n(2) ARTZENU provides financial services, or makes available funds, economic resources, goods or technology, knowing or having reasonable cause to suspect that those financial services, funds, economic resources, goods or technology will or may contribute to activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(d)]; \n \n(3) ARTZENU provides financial services, or makes available funds, economic resources, goods or technology to persons responsible for or who engage in activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(e)];\n \n \nSpecifically, ARTZENU is involved in promoting, financing and resourcing Israeli settler farms and outposts in the West Bank, including outposts associated with acts of violence against Palestinians. ARTZENU has fundraised for tactical military equipment including bulletproof vests, security drones and thermal cameras for armed settler rapid response squads.\n \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze","uk:entityType":"Entity"}""" ] .
