<https://www.ammitto.org/entry/uk/consolidated-list/rus0261>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0261> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-01"^^xsd:date ; ammitto:effectiveDate "2022-03-01"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0261" ;
  ammitto:remarks "\nJSC 558 Aircraft Repair Plant (“558 ARP”) is a Belarusian defence company based at the Baranovichi airbase which provides maintenance and servicing to military aircraft. Belarus and Russia have deepened military cooperation at Baranovichi airbase in recent years and held extensive joint exercises there in February 2022, immediately before Russia’s invasion of Ukraine. There is evidence that Russian aircraft operated from Baranovichi airbase as part of the invasion. Given 558 ARP’s role in providing maintenance and servicing to aircraft stationed at Baranovichi airbase, there are reasonable grounds to suspect that 558 ARP is providing those services to Russian aircraft involved in the invasion of Ukraine, and therefore is or has been involved in destabilising Ukraine and undermining or threatening the territorial integrity, sovereignty and independence of Ukraine. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14201","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/rus0262>
