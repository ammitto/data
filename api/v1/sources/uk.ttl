  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/nic0013> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_nicaragua_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-11-15"^^xsd:date ; ammitto:effectiveDate "2021-11-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "NIC0013" ;
  ammitto:remarks "\nAs a senior commissioner of the Nicaraguan National Police (NNP), Juan Antonio Valle Valle is responsible for human rights violations against civilians during protests, which began on 18 April 2018. The NNP’s Department of Surveillance and Patrolling, of which Valle Valle is Chief, has repeatedly restricted the freedom of assembly and expression of Nicaraguans in Managua. Valle Valle was responsible for the harassment by police against individuals sheltered in the Metrocentro shopping centre in Managua in 2019. He is therefore responsible for undermining democracy and the rule of law, repression of civil society and the democratic opposition and for human rights violations. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14151","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
