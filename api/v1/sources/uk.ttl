  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0853" ;
  ammitto:remarks "\nKIRILL KOVALCHUK, was Chairman of the Board of Directors and then President of National Media Group (NMG), a Government of Russia-affiliated entity. There are reasonable grounds to suspect that he is an involved person pursuant to regulation 6(4)(d)(i) of the Russian Regulations 2019 in that he is or has been involved in obtaining a benefit from or supporting the Government of Russia as the Federal Agency for State Property management, a Government of Russia-affiliated entity, is listed as part owner of National Media Group (NMG).  \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14804","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
