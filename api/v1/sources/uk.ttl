<https://www.ammitto.org/entry/uk/consolidated-list/ghr0193>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ghr0193> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-09"^^xsd:date ; ammitto:effectiveDate "2026-06-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-15"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0193" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Ahavat Gilad is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis of the following grounds: \n \n \n((1) Ahavat Gilad provides financial services, or makes available funds, economic resources, goods or technology, knowing or having reasonable cause to suspect that those financial services, funds, economic resources, goods or technology will or may contribute to activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(d)]; \n \n \n(2) Ahavat Gilad provides financial services, or makes available funds, economic resources, goods or technology to persons responsible for or who engage in activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(e)];\n \n \nSpecifically, Ahavat Gilad is a registered Israeli association that serves as the financial conduit for The Farms Association, channelling donations to settler farms and outposts in the West Bank, including outposts associated with acts of violence, intimidation and the forced displacement of Palestinians. Recipients of funding channelled through Ahavat Gilad include individuals and outposts designated by the UK for involvement in serious abuses of the human rights of Palestinians.\n  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
