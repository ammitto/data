  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-05-18"^^xsd:date ; ammitto:effectiveDate "2023-05-18"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1887" ;
  ammitto:remarks "\n JOINT STOCK COMPANY \"SCIENTIFIC-RESEARCH INSTITUTE OF TECHNICAL GLASS NAMED AFTER V.F. SOLINOV\" (JSC NITS) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019. JSC NITS is a Russian based manufacturing plant that produces components for the Armed Forces of the Russian Federation, including parts for the Mi-24, Mi-28 and Ka-52 attack helicopters that Russian forces have used in Ukraine. JSC NITS is an “involved person” per regulations 6(2)(a)(i)&(ii) by “destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine” and by “obtaining a benefit from or supporting the Government of Russia” by carrying on business in the strategically important defence sector.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15944","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
