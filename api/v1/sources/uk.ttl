<https://www.ammitto.org/entry/uk/consolidated-list/ghr0158>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ghr0158> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-05-20"^^xsd:date ; ammitto:effectiveDate "2025-05-20"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-05-20"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0158" ;
  ammitto:remarks "\nNACHALA is an involved person under the Global Human Rights Sanctions Regulations 2020 on the basis of the following grounds:  \n \nNACHALA is and/or has been facilitating, inciting, promoting or providing support for activity which amounts to a serious abuse of the right of individuals not to be subjected to cruel, inhuman or degrading treatment or punishment.  NACHALA has been involved in providing financial services, or making available funds, economic resources, goods or technology to persons responsible for or engaging in an activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.  NACHALA provides financial services, or makes available funds, economic resources, goods or technology, knowing or having reasonable cause to suspect that those financial services, funds, economic resources, goods or technology will or may contribute to an activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.  \nSpecifically, NACHALA is or has been involved in facilitating, inciting, promoting and providing logistical and financial support for the establishment of illegal outposts and forced displacement of Palestinians in Israel and the Occupied Palestinian Territories, activities which cause the psychological suffering of Palestinians, and which often lead to violence perpetrated against Palestinians. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16930","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze","uk:entityType":"Entity"}""" ] .
