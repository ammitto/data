  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0062" ;
  ammitto:remarks "\nBeltechexport is a key revenue stream for the military-industrial complex of Belarus with close ties to the Lukashenko regime. The ongoing financial and economic support of Beltechexport to the Belarusian state is helping to sustain the Lukashenko regime. Beltechexport therefore bears responsibility for supporting the Lukashenko regime and the human rights violations, undermining of democracy and repression of civil society carried out following the August 9 elections." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14034","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
