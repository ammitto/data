  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0803> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0803" ;
  ammitto:remarks "\nThere are reasonable grounds to suspect that Karina ROTENBERG is associated with Boris Romanovich ROTENBERG; Karina ROTENBERG is the wife of Boris Romanovich ROTENBERG (RUS0246). \nBoris Romanovich ROTENBERG has been designated by the UK since 22/02/2022. Boris Romanovich ROTENBERG is a prominent Russian businessman with close personal ties to Russian President, Vladimir Putin. Boris Romanovich ROTENBERG is a major shareholder of SMP Bank, where he sits on the Board of Directors. Boris Romanovich ROTENBERG therefore is or has been involved in obtaining a benefit from or supporting the Government of Russia by virtue of owning or controlling directly or indirectly\" or \"working as a director\" or \"equivalent\" at SMP Bank, a Government of Russia affiliated-entity which obtains a financial benefit or other material benefit from the Government of Russia and is carrying out business in the finance sector which is a sector of strategic significance to the Government of Russia. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14754","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
