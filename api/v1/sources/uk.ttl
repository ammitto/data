<https://www.ammitto.org/entry/uk/consolidated-list/rus1831>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1831> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-04-21"^^xsd:date ; ammitto:effectiveDate "2023-04-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1831" ;
  ammitto:remarks "\nMajor Andrei ZADACHIN is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 because he built a criminal case that is politically motivated against and petitioned the arrest of Vladimir Kara-Murza for disseminating false information about the Russian army under section 2 of article 207.3 of the Russian Criminal Code, one of the so-called “fake news” laws. This law was enacted as a result of, and its application and enforcement by prosecutors and courts is a result of, a Russian Government policy aimed at preventing the Russian public from knowing the truth about the conflict in Ukraine and intimidating those willing to criticise it and to provide accurate information about the conflict. This policy prevents the spread of accurate information about the conflict, anti-war sentiment and dissent that would undermine the Russian Government’s ability to wage the war by reducing the support of the Russian population. In this way, the policy is facilitating the continuation of the war, which is destabilising Ukraine. ZADACHIN’s role as an investigator in the case against Vladimir Kara-Murza amounts to providing support for this policy. Therefore, ZADACHIN is an involved person because he is providing support for a policy that is destabilising Ukraine.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15890","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
