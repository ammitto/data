  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-01-31"^^xsd:date ; ammitto:effectiveDate "2022-01-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0035" ;
  ammitto:remarks "\nU Thein Soe was appointed by the Commander-in-Chief as Chair of the, reconstituted, Union Election Commission (UEC) on 3 February 2021, two days after the military seized power in a coup. \n \n The Chair of the UEC is responsible for overseeing activity relating to elections in Myanmar and the conduct of political parties. As Chair of the UEC U Thein Soe has been involved in undermining democracy in his attempts to override the democratic wishes of the people of Myanmar at the November 2020 polls, in particular on 27 July 2021 he passed a decree which annulled the November 2020 election results on the unsubstantiated grounds of widespread electoral fraud. \n \n Further and/or alternatively he is carrying out activities on behalf of the State Administration Council (designated under the Myanmar (Sanctions) Regulations 2021) and/or Min Aung Hlaing (the Commander-in-Chief and Chairman of the SAC) (designated under the Global Human Rights (Sanctions) Regulations 2020 and Myanmar (Sanctions) Regulations 2021.\n \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14174","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
