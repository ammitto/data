  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/irn0006> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_iran_sanctions_regulations_2023> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0006" ;
  ammitto:remarks "\nAbdolsamad Khoramabadi, as Head of the ‘Commission to Determine the Instances of Criminal Content’, is or has been involved in a governmental organization in charge of online censorship and cyber crime. Under his leadership the Commission defined ‘cybercrime’ by a number of vague categories that criminalize creation and publication of content deemed inappropriate by the regime. He is responsible for repression and the blocking of numerous opposition sites, electronic newspapers, blogs, sites of human rights NGOs and of Google and Gmail since September 2012. He and the Commission actively contributed to the death in detention of the blogger Sattar Beheshti in November 2012. Thus the Commission is directly responsible for systemic violations of human rights, in particular by banning and filtering websites to the general public, and occasionally disabling Internet access altogether." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12865","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
