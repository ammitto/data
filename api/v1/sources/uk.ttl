  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "LIB0071" ;
  ammitto:remarks "\nYevgeniy Viktorovich Prigozhin is or has been involved in\n activities which threaten the peace, stability and security of Libya or undermine its transition to a democratic, peaceful and independent country, through his responsibility and provision of support for the activities in Libya of the organisation known as the Wagner Group. The Wagner Group is a Russia-based private military company but its organisation is purposely opaque to obscure its ownership and \nin order to provide a deniable military capability for the Russian State. The Wagner Group is or has been operating in Libya\n in contravention of the United Nations arms embargo established by United Nations Security Council Resolution 1970 (2011) and, through its activities in Libya in support of Khalifa Haftar’s Libyan National Army, threatens the peace, stability and security of Libya or undermines its transition to a democratic, peaceful and independent country.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13968","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
