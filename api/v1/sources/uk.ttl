  ammitto:hasRegime <https://www.ammitto.org/regime/the_iran_sanctions_nuclear_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "INU0059" ;
  ammitto:remarks "\nBonyad Taavon Sepah, also known as the IRGC Cooperative Foundation, was formed by the commanders of the IRGC to structure the IRGC's investments. It is controlled by the IRGC. Bonyad Taavon Sepah's Board of Trustees is composed of nine members, of whom eight are IRGC members. These officers include the IRGC's Commander in Chief, who is the Chairman of the Board of Trustees, the Supreme Leader's representative to the IRGC , the Basij Commander, the IRGC Ground Forces Commander, the IRGC Air Force Commander, the IRGC Navy Commander, the head of the IRGC Information Security Organisation, a senior IRGC officer from the Armed Forces general staff and a senior IRGC officer from MODAFL." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11580","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
