<https://www.ammitto.org/entry/uk/consolidated-list/rus1943>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1943> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-07-31"^^xsd:date ; ammitto:effectiveDate "2023-07-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1943" ;
  ammitto:remarks "\nJudge Natalia DUDAR is an involved person under the Russia (EU Exit) (Sanctions) regulations 2019.  DUDAR was a judge who extended the period of detention of Vladimir Kara-Murza as he awaited trial for three charges, of which he was ultimately found guilty, which included that of disseminating false information about the Russian Armed Forces under part 2 of Article 207.3 of the Russian Criminal Code, also known as the “fake news” law. The prosecution of Kara-Murza is widely considered to be politically motivated. This law and its application and enforcement by prosecutors and courts is a result of the Russian Government’s policy to prevent the Russian public from knowing the truth about the conflict in Ukraine.  This policy prevents the spread of accurate information about the conflict in Ukraine, anti-war sentiment and dissent, which would reduce public support for and undermine the Russian Government’s ability to wage the war. In this way, the policy is facilitating the continuation of the war, which is destabilising Ukraine and undermining its territorial integrity and sovereignty. DUDAR’s decision to extend the period of detention of Kara-Murza under the “fake news” charge shows that she is providing support for this policy. Therefore, DUDAR is an involved person because she is providing support for a policy that is destabilising Ukraine and undermining its territorial integrity and sovereignty. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16039","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
