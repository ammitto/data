  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-23"^^xsd:date ; ammitto:effectiveDate "2023-02-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1739" ;
  ammitto:remarks "\nJSC ZVEZDA is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019. JSC ZVEZDA is a Russian based manufacturer, it is involved in the development, production, maintenance, repair and sale of military equipment. JSC ZVEZDA is an “involved person” per Regulations 6(2)(a)(i)&(ii) because it is or has been involved in “destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine” and / or “obtaining a benefit from or supporting the Government of Russia” by carrying on business in the strategically important defence sector.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15776","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
