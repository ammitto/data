  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0181" ;
  ammitto:remarks "\nSeparatist militia group of Lugansk, involved in uniting activists in the Lugansk region, thus threatening the stability or security of Ukraine. They also actively participated in the seizure of the Lugansk Regional State Administration. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13055","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/rus0182>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "So-called 'Lugansk People's Republic'" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Luhansk People's Republic" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "'Luganskaya Narodnaya Respublika' (LNR)" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/rus0182> ;
  ammitto:remarks "Names of Directors(s)|Management: Associated with Aleksey Karyakin (who signed the Novorossiya declaration)|Mr Vasyl Nikitin responsible for the separatist \"governmental\" activities of the so called \"government of the People's Republic of Luhansk\"|Gennadiy Nikolaivych Tsyplakov was active before becoming \"Prime Minister of the so-called \"Lugansk People's Republic\". The Director Disqualification Sanction was imposed on 09/04/2025." .
<https://www.ammitto.org/entry/uk/consolidated-list/rus0182>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0182> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0182" ;
  ammitto:remarks "\nThe so called ‘Lugansk People's Republic’ was established on 27 April 2014. Responsible for organising the illegal referendum on May 11 2014, and made a declaration of independence on May 12 2014. On 22 May 2014, the so called ‘People's Republics’ of Donetsk and Lugansk created the so called ‘Federal State of Novorossiya’. The so called “Lugansk People’s Republic” took part in ‘elections’ on 11 November 2018. Holding any kind of elections without Ukraine’s consent is a clear violation of the country’s sovereignty. This is in breach of Ukrainian constitutional law, and, as a consequence, of international law, thus undermining the territorial integrity, sovereignty and independence of Ukraine. It is also involved in the recruitment to the separatist ‘Army of Southeast’ and other illegal armed separatist groups, thus undermining the stability or security of Ukraine. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13047","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
