  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "DOBRINOV " ; ammitto:firstName "Sergei " ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "DOBRINOV " ; ammitto:firstName "Sergey " ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
