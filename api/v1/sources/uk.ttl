  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3715" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect that IMO 9326811 (\"PERSEAS\") is, has been or is likely to be involved in activity whose object or effect is to destabilise Ukraine or undermine or threaten the territorial integrity, sovereignty or independence of Ukraine or to obtain a benefit from or support the Government of Russia. Namely, IMO 9326811 is involved in carrying oil or oil products that originated in Russia from Russia to a third country.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Shipping & Trade Sanctions: see \"Other Information\"","uk:entityType":"Ship"}""" ] .
