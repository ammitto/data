  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1825" ;
  ammitto:remarks "\nThe Secretary of State has reasonable Grounds to suspect that Christodolous VASSILIADES is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 because VASSILIADES was the director of Sberbank Investments Limited, a Cyprus based subsidiary 100% owned by PJSC Sberbank. PJSC Sberbank is a Russian bank owned by the Russian Ministry of Finance. Sberbank Investments Limited is therefore a company carrying on business as a Government of Russia-affiliated entity. Therefore, VASSILIADES has been involved in obtaining a benefit from or supporting the Government of Russia.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15884","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
