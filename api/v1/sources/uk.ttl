  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0807" ;
  ammitto:remarks "\nYuri Alekseyevich SOLOVIEV (hereafter SOLOVIEV) is an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: 1) SOLOVIEV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent, through his role as First Deputy President and Chairman of the Management Board, of an entity, VTB Bank PJSC, which is or has been carrying on business in a sector of strategic significance to the Government of Russia, namely the financial services sector; 2) SOLOVIEV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent, through his role as First Deputy President and Chairman of the Management Board, of a Government of Russia-affiliated entity, namely VTB Bank PJSC.\nThe trust services sanctions were imposed on 21/03/2023.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14758","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
