  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ssu0001> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_south_sudan_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "SSU0001" ;
  ammitto:remarks "\nMichael Makuei Leuth has held the position of Minister for Information and Broadcasting since 2013 and has been the public spokesman for the government delegation to the Intergovernmental Authority on Development (IGAD) peace talks. Makuei has obstructed the political process in South Sudan, in particular by obstructing the implementation of the Agreement on the Resolution of the Conflict in South Sudan (ARCSS) of August 2015 through inflammatory public statements and obstructing the work of the ARCSS Joint Monitoring Evaluation Committee and the establishment of the ARCSS Transitional Justice Institutions. He has also obstructed the operations of the UN's Regional Protection Force (RPF). Makuei is also responsible for serious violations of human rights, including restrictions on freedom of expression. Since the Revitalised ARCSS was signed (R-ARCSS) in September 2018, Makuei has continued to undermine the prospects for peace in South Sudan." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13610","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/ssu0002>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "MAKOL" ; ammitto:firstName "GABRIEL" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Jok" ; ammitto:firstName "Gabriel" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Riak" ; ammitto:firstName "Jock" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Riak" ; ammitto:firstName "Jok" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/ssu0002> ;
  ammitto:remarks "Appointed as Chief of Defence Forces on 2 May 2018. Commanded SPLA Sector One, which operates primarily within Unity State, since January 2013. In his position as the SPLA Sector One commander, he has expanded or extended the conflict in South Sudan through breaches of the Cessation of Hostilities Agreement. The SPLA is a South Sudanese military entity that has engaged in actions that have extended the conflict in South Sudan, including breaches of the January 2014 Cessation of Hostilities Agreement and the May 9, 2014 Agreement to Resolve the Crisis in South Sudan, which was a re-commitment to the CoHA and has obstructed the activities of IGAD’s Monitoring and Verification Mechanism. INTERPOL-UN Security Council Special Notice web link: https://www.interpol.int/en/notice/search/un/5879060" ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:state "Unity State" ; ammitto:country "South Sudan" ] ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "Wau" ; ammitto:state "Western Bahr El Ghazal" ; ammitto:country "South Sudan" ] .
