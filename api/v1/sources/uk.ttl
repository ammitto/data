  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-09-26"^^xsd:date ; ammitto:effectiveDate "2022-09-26"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1579" ;
  ammitto:remarks "\nAnatoly Alexandrovich Braverman is an “involved person” under the Russia (Sanctions) (EU Exit) Regulation 2019 because he has been, and is, involved in obtaining a benefit from or supporting the Government of Russia by: (1) working as a manager or equivalent of a person (other than an individual) which is carrying on business in a sector of strategic significance to the Government of Russia, namely SOVCOMBANK which is carrying on business in the financial services sector; (2) working as a manager or equivalent of a Government of Russia-affiliated entity, namely SOVCOMBANK which receives, or has received, financing, directly or indirectly, from the Russian Direct Investment Fund. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15523","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
