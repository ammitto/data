  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-07-23"^^xsd:date ; ammitto:effectiveDate "2025-07-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-07-23"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0020" ;
  ammitto:remarks "\nBledar LALA is an involved person under the Global Irregular Migration and Trafficking in Persons Sanctions Regulations 2025 (“the Regulations”) on the basis of the following grounds:\nHe is or has been involved in a relevant activity, namely people smuggling, by engaging in the unlawful arrival in a country of a person who is not a national of that country or permanently resident in it with a view to obtaining a benefit. Specifically, he is in control of the ‘Belgium operations’ of an organised criminal group which engages in the smuggling of persons from Belgium across the English Channel to the United Kingdom.\nHe is or has been involved in a relevant activity, namely people smuggling, by receiving funds and economic resources which constitute payment for the unlawful arrival of a person who is not a national of that country or permanently resident in it. Specifically, he receives payment for the smuggling of persons from Belgium across the English Channel to the United Kingdom.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17035","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
