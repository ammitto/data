  ammitto:status "active" ;
  ammitto:referenceNumber "VEN0021" ;
  ammitto:remarks "\nSenior office holder (referred to as Commissioner, Director and Director General) in the Bolivarian National Intelligence Service (SEBIN). Responsible for serious human rights violations, including torture, the use of excessive force and the mistreatment of detainees in SEBIN facilities. In particular, he participated in and was responsible for acts of torture and the cruel, inhuman and degrading treatment of detainees in El Helicoide, a SEBIN prison." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13793","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
