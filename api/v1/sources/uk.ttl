  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "BELITSKIY" ; ammitto:firstName "Vitaliy" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "БЕЛИЦКИЙ Виталий Александрович" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
