<https://www.ammitto.org/entry/uk/consolidated-list/drc0013>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/drc0013> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_democratic_republic_of_the_congo_sanctions_eu_exit_regulatio> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "DRC0013" ;
  ammitto:remarks "\nAs head of the National Intelligence Service (ANR) until February 2019, Kalev MUTONDO was involved in and responsible for the arbitrary arrest, detention and mistreatment of opposition members, civil society activists and others. Kalev MUTONDO was therefore involved in planning, directing, or committing acts that constitute serious human rights violations or abuses in DRC. In May 2019, he signed a declaration of past and future loyalty to Joseph Kabila. Until early 2021, he held the position of political adviser to the Prime Minister. He is alleged to still have influence on some parts of the security forces.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13467","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
