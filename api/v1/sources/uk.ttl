  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-05-04"^^xsd:date ; ammitto:effectiveDate "2022-05-04"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1404" ;
  ammitto:remarks "\n JOINT STOCK COMPANY MIKRON is an involved person under the Russia (Sanctions) (EU Exit) Regulation 2019 because it is the largest Russian manufacturer and exporter of microelectronics. The company received tax benefits to produce the domestic chip for Russia’s National Payment Card System, which was developed following previous sanctions on Russia. Therefore, JOINT STOCK COMPANY MIKRON is involved in obtaining a benefit from or supporting the Government of Russia by carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian electronics sector. \n The trust services sanctions were imposed on 21/03/2023." ;
