  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ghr0066> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-10"^^xsd:date ; ammitto:effectiveDate "2020-12-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0066" ;
  ammitto:remarks "\nRamzan Kadyrov’s leadership of the Chechen Republic in Russia has been characterised by the systematic persecution of critics of the Chechen authorities and of perceived subversives. This has included the systematic use of murder and CIDT against LGBT Chechens and human rights defenders. There is a considerable and credible body of evidence strongly indicating that the Terek Rapid Response Unit has been heavily involved in the murder and use of CIDT against LGBT Chechens since 2017." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14007","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
