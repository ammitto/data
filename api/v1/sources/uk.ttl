  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ROUINE" ; ammitto:firstName "AL-AZHAR" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lazhar" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
