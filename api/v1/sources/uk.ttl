  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ja'fari Dowlatabadi" ; ammitto:firstName "Abbas" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
