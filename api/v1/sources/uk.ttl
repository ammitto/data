  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3064" ;
  ammitto:remarks "\nPJSC Rosneft Oil Company (hereafter ROSNEFT) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 based on the following grounds: 1) ROSNEFT is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian energy sector; and 2) ROSNEFT is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business of economic significance to the Government of Russia.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17169","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Entity"}""" ] .
