  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus2479> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-02-24"^^xsd:date ; ammitto:effectiveDate "2025-02-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-03-06"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS2479" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that OJSC KEREMET BANK is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis that it has been involved in obtaining a benefit from or supporting the Government of Russia through: (1) carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (2) providing financial services to persons carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16829","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Prohibition on correspondent banking and clearing","uk:entityType":"Entity"}""" ] .
