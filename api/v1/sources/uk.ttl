  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "arms_embargo" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
