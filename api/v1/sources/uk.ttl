  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mahsuli" ; ammitto:firstName "Sadeq" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/irn0072> ;
