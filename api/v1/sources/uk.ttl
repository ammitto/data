<https://www.ammitto.org/entry/uk/consolidated-list/bel0117>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0117> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-02"^^xsd:date ; ammitto:effectiveDate "2021-12-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0117" ;
  ammitto:remarks "\nThe Main Directorate for Combatting Organized Crime and Corruption (GUBOPiK) of the MVD plays a leading role in the repression of civil society and democratic opposition in Belarus, including deploying specialised “Attack” units against peaceful protestors and in raids on the homes and offices of journalists, activists and opposition supporters.\nIn his position as Chairman of the GUBOPiK, Andrei PARSHYN is responsible for the inhuman and degrading treatment inflicted on citizens who participated in peaceful protests and for their arbitrary arrest and detention. Numerous testimonies, photo and video evidence indicate that the group under his command beat and arrested peaceful protestors, threatening them with firearms.\nPARSHYN therefore is or has been involved in undermining democracy and the rule of law in Belarus, repressing of civil society and the democratic opposition, and for serious human rights violations in Belarus.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14160","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
