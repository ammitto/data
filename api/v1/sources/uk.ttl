  ammitto:hasRegime <https://www.ammitto.org/regime/the_cyber_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-11-19"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0004" ;
  ammitto:remarks "\nChosun Expo, a front company used by malicious cyber actors operating under the Reconnaissance General Bureau (RGB), has been responsible for, engaging in, providing support for, or promoting the commissions, planning or preparation of relevant cyber activity, including data interference and accessing information systems. Such activity that Chosun Expo is or has been involved in undermines, or is intended to undermine, the integrity, prosperity or security of the United Kingdom or a country other than the United Kingdom and directly or indirectly caused economic loss to, or prejudice to the commercial interests of, those affected by the activity.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13910","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
