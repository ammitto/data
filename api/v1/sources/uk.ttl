  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0784" ;
  ammitto:remarks "\nDmitry Vladimirovich KONOV (hereinafter KONOV) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: (1) KONOV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of PJSC SIBUR Holding, an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian chemicals sector; (2) KONOV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of PJSC Alrosa, an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian extractives sector; (3) KONOV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of PJSC Alrosa, an entity carrying on business as a Government of Russia-affiliated entity. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14735","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
