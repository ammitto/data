  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-16"^^xsd:date ; ammitto:effectiveDate "2026-06-16"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-16"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3649" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Ruslan Petrovich KOSHKIN is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 because he is, or has been, a member of THE MAIN DIRECTORATE OF THE GENERAL STAFF OF THE ARMED FORCES OF THE RUSSIAN FEDERATION (“the GRU”). Specifically, Ruslan Petrovich KOSHKIN is an officer of the GRU and has been involved in supporting GRU front company LLC NEPTUNE CO LTD’s activities procuring goods and technology to support the production and development needs of the Russian defence sector.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
