  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0034" ;
  ammitto:remarks "\nKeeper of Ward 1 of Radjaishahr prison, Karadj until July 2010. Several former detainees have denounced the use of torture by him, as well as orders he gave to prevent inmates receiving medical assistance. According to a transcript of one reported detainee in the Radjaishahr prison, wardens all beat him severely, with Akharian’s full knowledge. There is also at least one reported case of ill treatment and the death of a detainee, Mohsen Beikvand, under Akharian’s wardenship. Beikvand died in September 2010. Other prisoners claim credibly that he was killed by the instructions of Hassan Akharian." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12176","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
