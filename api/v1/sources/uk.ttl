  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/drc0070> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_democratic_republic_of_the_congo_sanctions_eu_exit_regulatio> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-02-21"^^xsd:date ; ammitto:effectiveDate "2024-02-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2024-02-23"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "DRC0070" ;
  ammitto:remarks "\nListed pursuant to paragraph 7 (c), 7 (e), and 7 (h) of resolution 2293 (2016), as reaffirmed by paragraph 2 of resolution 2688 (2023): Willy NGOMA has and continues to engage in acts that undermine the peace and security of the DRC. He is a senior leader and military spokesperson of M23, a UN sanctioned Congolese militia which received support from outside the DRC and which impedes the disarmament and reintegration process. WILLY NGOMA has a major role in a designated entity. As the M23 military spokesperson, he shares responsibility for crimes committed by M23 (killings, abduction, lootings, recruitment of child soldiers, sexual abuse, illegal trade mining, taxation, and arms proliferation) and is directly responsible for having justified and communicated on the repeated M23 attacks in the East of DRC. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16382","uk:unReferenceNumber":"CDi.044","uk:designationSource":"UN","uk:sanctionsImposed":"Asset freeze|Travel Ban","uk:entityType":"Individual"}""" ] .
