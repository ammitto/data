  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0194" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that ARI YSHAG is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis of the following grounds: \n \n \n(1) ARI YSHAG facilitates, incites, promotes or provides support for activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(b)];\n \n \n(2) ARI YSHAG provides financial services, or makes available funds, economic resources, goods or technology, knowing or having reasonable cause to suspect that those financial services, funds, economic resources, goods or technology will or may contribute to activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(d)]; \n (3) ARI YSHAG provides financial services, or makes available funds, economic resources, goods or technology to persons responsible for or who engage in activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment [reg 6(3)(e)];\n \n \nSpecifically, ARI YSHAG is an Israeli registered association that fundraises for illegal settler outposts in the West Bank, including outposts associated with documented acts of violence, intimidation and the forced displacement of Palestinians.\n \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
