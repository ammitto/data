  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "SHUVALOV " ; ammitto:firstName "Yevgeny" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
