<https://www.ammitto.org/entry/uk/consolidated-list/bel0096>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0096> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "technology_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-06-21"^^xsd:date ; ammitto:effectiveDate "2021-06-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0096" ;
  ammitto:remarks "\nIn his position as Minister of Defence of Belarus since 20 January 2020, Viktor Khrenin is responsible for the decision taken by the Command of the Air Forces and Air Defence Forces for the order dispatching military aircraft to intercept passenger flight FR4978 and compel its landing at Minsk airport, without proper justification, on 23 May 2021. In doing so, Khrenin acted at the direction of Alexander Lukashenko and in conjunction with the Belarusian aviation authorities. This resulted in the forced redirection of flight FR4978, the detention of the aircraft, its passengers and the crew, and the arrest of opposition journalist and civil society actor Roman Protasevich and Protasevich’s partner, Sofia Sapega. This politically motivated decision was aimed at arresting and detaining opposition journalist Protasevich and Sapega and constitutes a form of repression against civil society and democratic opposition in Belarus. \nViktor Khrenin is therefore responsible for the repression of civil society and democratic opposition in Belarus and so undermined democracy and the rule of law there. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14113","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Technical assistance related to aircraft|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
