  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-09"^^xsd:date ; ammitto:effectiveDate "2026-06-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-15"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0191" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that \nItamar Yehuda Levi\n is an involved person under the Global Human Rights Sanctions Regulations 2020 on the basis of the following ground: \n \n \nItamar Yehuda Levi facilitates, incites, promotes or provides support for such an activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.\n  \nItamar Yehuda Levi owns or controls an organisation that is responsible for an activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.\n  \nItamar Yehuda Levi\n is associated with a person responsible for \nengaging in an activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.\n \n \nSpecifically, Itamar Yehuda Levi owns a company, EYAL HARI YEHUDA COMPANY LTD which facilitates, supports and is responsible for activities of construction and demolition jobs in the West Bank as well as the destruction of Palestinian land and property, physically attacks, shootings and killings of Palestinians which has led to the wider forced displacement of Palestinians.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
