  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-16"^^xsd:date ; ammitto:effectiveDate "2026-06-16"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-16"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3627" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that LLC NEPTUNE CO LTD is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: \nLLC NEPTUNE CO LTD is associated with THE MAIN DIRECTORATE OF THE GENERAL STAFF OF THE ARMED FORCES OF THE RUSSIAN FEDERATION (GRU). LLC NEPTUNE CO LTD is a GRU front company that has been procuring goods and technology to support the production and development needs of the Russian defence sector. \nLLC NEPTUNE CO LTD is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business in sectors of strategic significance to the Government of Russia. Namely, LLC NEPTUNE CO LTD has been conducting business in the Russian defence and electronics sectors. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
