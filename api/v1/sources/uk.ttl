  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0104> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-06-21"^^xsd:date ; ammitto:effectiveDate "2021-06-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0104" ;
  ammitto:remarks "\nIn his position as Chairman of the Second National Television Station (ONT), Marat Markov is responsible for the programming and editorial decisions of the station, including the decision to record and broadcast an ‘interview’ with the detained opposition activist and civil society actor Roman Protasevich, widely believed to be filmed under duress and with Protasevich showing signs of ill treatment. This action is directly linked to the politically motivated decision to divert Ryanair flight FR4978 to Minsk airport on 23 May 2021 without proper justification, aimed at arresting and detaining opposition journalist and civil society actor Protasevich and Protasevich’s partner, Sofia Sapega and is a form of repression against civil society and democratic opposition in Belarus. Marat Markov is therefore responsible for the repression of civil society and democratic opposition in Belarus and so undermined democracy and the rule of law there." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14121","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
