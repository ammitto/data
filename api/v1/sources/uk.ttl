  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0045" ;
  ammitto:remarks "\nDmitrii Vladimirovich Ovsyannikov (hereafter OVSYANNIKOV) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: \n (1) OVSYANNIKOV has been obtaining a benefit from or supporting the Government of Russia by working for the Government of Russia, as a regional Governor of the City of Sevastopol (2016-2019) and as a Deputy Minister of a Ministry of the Russian Federation (2019-2020).  \n (2) OVSYANNIKOV has been involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine by being responsible for, engaging in, providing support for, and promoting policies and actions which destabilise Ukraine or undermines or threatens the territorial integrity, sovereignty or independence of Ukraine.\n﻿The trust services sanctions were imposed on 21/03/2023.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13558","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
