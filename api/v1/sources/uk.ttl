  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0172" ;
  ammitto:remarks "\nIllegal armed separatist group responsible for fighting against the Ukrainian government forces in the Eastern Ukraine, thus threatening the stability or security of Ukraine. Inter alia, the militant group seized control of several government buildings in Eastern Ukraine in early April 2014, thus undermining the territorial integrity, sovereignty and indepedence of Ukraine. Its former leader Mr Pavel Gubarev, is responsible for the taking over of the regional government building in Donetsk with pro-Russian forces and proclaiming himself the 'people's governor'. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13045","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
