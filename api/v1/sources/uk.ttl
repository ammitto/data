  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "DUDAR" ; ammitto:firstName "Natalia" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ДУДАРЬ Наталья Николаевна" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
