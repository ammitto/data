  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0809> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0809" ;
  ammitto:remarks "\nEvgeny Igorovich SHUVALOV is the son of Igor Ivanovich SHUVALOV (RUS0265), who has been designated by the UK since 3 March 2022, with whom he is closely associated and from whom he has obtained a financial benefit or other material benefit.\nIgor Ivanovich SHUVALOV is Chairman of the Management Board at Vnesheconombank (hereafter referred to as VEB.RF). VEB.RF is a state corporation established by the Government of Russia to function as the national development bank, and is owned or controlled directly by the Government of Russia. It is therefore a Government of Russia-affiliated entity. Therefore, as a result of his position as Chairman of the Management Board at VEB.RF, SHUVALOV is working as a director or equivalent at a Government of Russia-affiliated entity, and is obtaining a benefit from or supporting the Government of Russia.  \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14760","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
