  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-02"^^xsd:date ; ammitto:effectiveDate "2021-12-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0115" ;
  ammitto:remarks "\nAndrei Nikolaevich MUKOVOZCHYK is a propagandist of the Lukashenko regime. He is a journalist publishing in “Belarus Segodnya\", the official (state-owned) newspaper of the Presidential Administration. His published opinions/articles are one of the main mouthpieces of state propaganda and include death threats against those who oppose the regime as well as belittling and discrediting independent journalists and opposition supporters who seek to demonstrate evidence of serious human rights violations committed by the regime. His journalism is specifically endorsed by the Lukashenko regime as it is the subject of several state sponsored awards. \nMUKOVOZCHYK therefore is or has been involved in repressing civil society and democratic opposition in Belarus and for serious human rights violations in Belarus.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14158","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
