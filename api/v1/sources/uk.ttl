  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-07-23"^^xsd:date ; ammitto:effectiveDate "2025-07-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-07-23"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0026" ;
  ammitto:remarks "\nWeihai Yamar Outdoors Product Co is an involved person under the Global Irregular Migration and Trafficking in Persons Regulations 2025 on the basis of the following ground: \n \nWeihai Yamar Outdoors Product Co is or has been involved in the provision of economic resources, goods or technology that could contribute to a relevant activity, namely people smuggling, by offering rigid inflatable boats for sale on online retail platforms which are advertised to people who facilitate the unlawful arrival in a country of an individual who is not a national of that country or resident in it, including, but not limited to, the arrival in the United Kingdom of individuals from France by rigid inflatable boats travelling across the English Channel. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17040","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
