  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-05-04"^^xsd:date ; ammitto:effectiveDate "2022-05-04"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1432" ;
  ammitto:remarks "\n INTEGRAL SPB is an electronics company based in St Petersburg servicing the military and civilian markets. It is an appointed representative and distributor for JSC INTEGRAL, a Minsk based company designated by the UK on 1 March 2022. As a representative and distributor of JSC INTEGRAL, and benefiting through the selling of JSC INTEGRAL products in the Russian market, INTEGRAL SPB is associated with an involved person and therefore INTEGRAL SPB is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019. Further, by selling electronics products to military customers, INTEGRAL SPB is also carrying on business in a sector of strategic significance to the Government of Russia, namely the electronics and defence sectors. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15373","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
