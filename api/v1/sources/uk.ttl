<https://www.ammitto.org/entry/uk/consolidated-list/bel0113>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0113> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-02"^^xsd:date ; ammitto:effectiveDate "2021-12-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0113" ;
  ammitto:remarks "\nIn her former position as assistant prosecutor at the Fruzensky District Court in Minsk, Alina Sergeevna KASYANCHYK has represented the Lukashenko regime in politically motivated cases against journalists, activists and protesters.\nIn particular, she has prosecuted BelSat journalists Katsiaryna Bakhvalava (Andreyeva) and Darya Chultsova for live streaming peaceful protests, based on the unwarrented charges of “conspiracy” and “violating public order”. She has also prosecuted members of Belarusian civil society e.g. for taking parts in peaceful protests, and paying tribute to murdered protester Aliaksandr Taraikousky. She has consistently asked the judge for disproportionately long-term prison sentences.\nKASYANCHYK therefore is or has been involved in undermining democracy and the rule of law in Belarus, repressing civil society and the democratic opposition in Belarus, and for serious human rights violations.   \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14156","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
