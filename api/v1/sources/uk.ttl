<https://www.ammitto.org/entry/uk/consolidated-list/rus3660>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus3660> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-16"^^xsd:date ; ammitto:effectiveDate "2026-06-16"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-16"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3660" ;
  ammitto:remarks "\n(1) The Secretary of State considers that there are reasonable grounds to suspect that PILOT FINANCE LIMITED (hereafter “Pilot Finance”) is or has been involved in obtaining a benefit from or supporting the Government of Russia by being associated with a person, namely A7 LIMITED LIABILITY COMPANY (hereafter “A7”). Pilot Finance’s association with A7 is by obtaining a financial or other material benefit from A7. A7 is carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian Financial Services sector\n(2)  The Secretary of State considers that there are reasonable grounds to suspect that PILOT FINANCE LIMITED is or has been involved in obtaining a benefit from or supporting the Government of Russia by providing financial services, or making available funds, economic resources, goods or technology, to a person, namely A7 LIMITED LIABILITY COMPANY, which is carrying on business in a sector of strategic significance to the Government of Russia.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/rus3661>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "IMO 9296377 (\"MARJORIE\")" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/rus3661> ;
  ammitto:remarks "This vessel has been specified under Regulation 57F for all of the following purposes:\n \nShipping sanctions, namely:  Prohibition on chartering or operating specified ships (regulation 57ZA); Prohibition on port entry (regulation 57A); Directions prohibiting port entry (regulation 57B); Movement of ships (regulation 57C); Detention of ships (regulation 57D); Registration of ships (regulation 57E).\n \nWhere all listed shipping sanctions apply, a specified ship must not be chartered or operated, is prohibited from being provided with access to or having its master or pilot cause it to enter a port in the UK, may have its registration on the UK Ship Register terminated, and a master or pilot of a specified ship may be given a port barring direction, a detention direction, and a port entry direction or a movement direction. \n \nTrade sanctions, namely: Provision of services relating to specified ships (regulation 46AA); Procurement of services relating to specified ships (regulation 46AB).\n \nWhere all listed trade sanctions apply (including both the provision of services relating to specified ships and the procurement of services relating to specified ships), it is an offence to directly or indirectly provide technical assistance, crew services, operating services, chartering services, brokering services, financial services or funds in relation to a specified ship. It is an offence to directly or indirectly provide services relating to the acquisition, sale, transfer or supply of a specified ship. It is also an offence to directly or indirectly procure services relating to a specified ship, including, in particular, services involving the use of that specified ship." .
<https://www.ammitto.org/entry/uk/consolidated-list/rus3661>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus3661> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-16"^^xsd:date ; ammitto:effectiveDate "2026-06-16"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-16"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3661" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect that IMO 9296377 (\"MARJORIE\") is, has been or is likely to be involved in activity whose object or effect is to destabilise Ukraine or undermine or threaten the territorial integrity, sovereignty or independence of Ukraine or to obtain a benefit from or support the Government of Russia. Namely, 9296377 is involved in carrying oil or oil products that originated in Russia from Russia to a third country.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Shipping & Trade Sanctions: see \"Other Information\"","uk:entityType":"Ship"}""" ] .
