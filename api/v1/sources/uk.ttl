  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0004" ;
  ammitto:remarks "\nJudge, Head of Tehran Revolutionary Court, Branch 15. Committing Judge in the Tehran Tribunal. In charge of the post-election cases, he was the judge presiding the ‘show trials’ in summer 2009. He condemned to death two monarchists that appeared in the show trials. He has sentenced more than a hundred political prisoners, human rights activists and demonstrators to lengthy prison sentences. In 2018, reports showed that he continued to hand down similar sentences without proper observance of fair hearing procedures." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11801","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
