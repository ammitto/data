  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1542" ;
  ammitto:remarks "\nSarvar ISMAILOV (hereafter ISMAILOV) is an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following ground: ISMAILOV is associated with a person who is or has been carrying on business in sectors of strategic significance to the Government of Russia, namely Alisher Burkhanovich Usmanov. ISMAILOV is the nephew of Alisher Burkhanovich Usmanov.\nThe trust services sanctions were imposed on 21/03/2023.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15469","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
