  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus3512> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-05-05"^^xsd:date ; ammitto:effectiveDate "2026-05-05"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-05-05"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3512" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Anastasia BARYSHEVA is\n an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019\n on the basis that\n she \nis\n or has been involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine by providing support for or promoting actions which destabilise Ukraine or undermine or threaten its territorial integrity sovereignty or independence. \n \nSpecifically, Anastasia BARYSHEVA has been involved in the recruitment of foreign nationals on behalf of Alabuga Start Programme. The Alabuga Start Programme is a Russian recruitment scheme that hires individuals from outside Russia, usually from economically insecure backgrounds, using deceptive practices and puts them to work in Russia's Alabuga Special Economic Zone in the Republic of Tatarstan. These individuals assist in the production of military drones within the Alabuga Special Economic Zone which are then deployed as attack and reconnaissance vehicles in Ukraine. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
