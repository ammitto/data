  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0842" ;
  ammitto:remarks "\nIgor Viktorovich KRASNOV is a member of the Russian Security Council (RSC) and Russia’s Prosecutor General. The RSC has been involved actively in decision-making about Russian policy towards Ukraine. On 21 February 2022, the RSC supported a proposal to recognise Donetsk and Luhansk as independent republics. As a member of the RSC, KRASNOV is, or has been, responsible for, engaged in, provided support for or promoted policies or actions which destabilised Ukraine and undermined or threatened the territorial integrity, sovereignty or independence of Ukraine.  \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14793","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
