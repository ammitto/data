<https://www.ammitto.org/entry/uk/consolidated-list/mya0055>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0055> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-08-24"^^xsd:date ; ammitto:effectiveDate "2022-08-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0055" ;
  ammitto:remarks "\n  The Myanmar Security Forces have a track record of committing serious human rights violations and violations of international humanitarian law in Myanmar for decades\n. In 2017, the Myanmar Security Forces murdered, raped and tortured thousands of Rohingya during the Rakhine clearance operations. 740,000 Rohingya were forced over the border into Bangladesh. \nStar Sapphire Trading Company Limited has been responsible for the brokering of deals for military \ngoods, including Unmanned Aerial Vehicles (UAVs). Therefore, Star Sapphire Trading Company Limited has been involved in the supply of restricted goods to Myanmar\n, which have likely been used in military operations. \nStar Sapphire Trading Company Limited contributed funds to the Myanmar Security Forces in 2017, at fundraising events for the Rakhine clearance operations held by Commander in Chief, Min Aung Hlaing. Star Sapphire Trading Company Limited has therefore made funds and economic resources available to or for the benefit of the Myanmar Security Forces, which could have contributed to serious human rights violations and\n repression of the civilian population in Myanmar.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15496","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
