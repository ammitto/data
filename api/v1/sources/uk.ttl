  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0097" ;
  ammitto:remarks "\nThe 161st Specialist Training Centre (TsPS) (Unit 29155) of the Russian General Staff of the Armed Forces of the Russian Federation (GRU), is involved in relevant cyber acitivty in that it has been responsible for, engaging in, providing support for, or promoting the commission, planning or preparation or relevant cyber acitivty, including information system and data interference such as hacking and leaking of sensitive information, defacement of websites, espionage through the collection of data, and sabotage through the destruction of data, including by deploying WhisperGate malware. These activities undermine, or are intended to undermine, the integrity, prosperity or security of the United Kingdom or a country other than the United Kingdom.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16991","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/cyb0098>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Media Land LLC" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Media Land " ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Medialand" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/cyb0098> ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "Office 27, Tsvetnochnoye str. 16, Moskovskaya zastava Municipal Okrug" ; ammitto:state "St Petersburg" ; ammitto:country "Russia" ] .
<https://www.ammitto.org/entry/uk/consolidated-list/cyb0098>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/cyb0098> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_cyber_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-11-19"^^xsd:date ; ammitto:effectiveDate "2025-11-19"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-11-19"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0098" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that MEDIA LAND LLC is or has been involved in relevant cyber activity, in that it has provided support for the commission, planning or preparation of such activity, and has supplied technology and provided technical assistance that could contribute to the commission of relevant cyber activity. \nMEDIA LAND has operated from St. Petersburg, Russia and has promoted itself as a Bulletproof Hosting (BPH) provider. MEDIA LAND has been involved in relevant cyber activity through its role in providing infrastructure used in ransomware incidents and malicious cyber activity for customers, including those affiliated with the LockBit ransomware group. MEDIA LAND has been identified as a key enabler of the cybercrime ecosystem. \nSuch activity that MEDIA LAND is or has been involved in, directly or indirectly caused, or was intended to cause, economic loss to, or prejudice to the commercial interests of, those affected by the activity. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17218","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
