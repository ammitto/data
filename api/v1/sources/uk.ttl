  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-01"^^xsd:date ; ammitto:effectiveDate "2022-03-01"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0263" ;
  ammitto:remarks "\nThe Russian Direct Investment Fund (RDIF) is Russia's sovereign wealth fund. It facilitates co-investments into the Russian economy. RDIF is owned by the Government of Russia. As Russia's sovereign wealth fund, RDIF carries on business of economic significance to the Government of Russia by financing projects of economic and political significance to the Government. RDIF also carries on business in the Russian financial sector, which is a sector of significance to the Government of Russia.  \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14207","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
