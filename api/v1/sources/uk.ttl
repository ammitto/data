  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0026" ;
  ammitto:remarks "\nFormer Senior Advisor for Security Affairs to the Chief of the Armed Forces General Staff. Chief of Iran's National Police from 2005 until early 2015. Also Head of the Iranian Cyber Police (listed) from January 2011 until early 2015. Forces under his command led brutal attacks on peaceful protests, and a violent night time attack on the dormitories of Tehran University on 15 June 2009" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11583","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
