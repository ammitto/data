<https://www.ammitto.org/entry/uk/consolidated-list/mya0032>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0032> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-10"^^xsd:date ; ammitto:effectiveDate "2021-12-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0032" ;
  ammitto:remarks "\nThe Myanmar military seized power from civilian leaders on 1 February in a coup d’état and established a military junta. The Myanmar security forces have committed serious human rights violations since 1 February 2021 and are responsible for the repression of the civilian population.\nThe Directorate for Defence Industries (DDI) is a state-owned enterprise which operates under the Ministry of Defence (MOD). There are reasonable grounds to suspect that DDI is or has been involved in undermining democracy, the rule of law or good governance in Myanmar and the repression of the civilian population in Myanmar by its involvement in the supply to Myanmar of goods or technology which could contribute to a serious human rights violation or abuse.\nFurther, there are reasonable grounds to suspect that DDI, as a state-owned enterprise subservient to the MOD, is acting on behalf or at the direction of the Minister of Defence, General Mya Tun Oo, who has been involved in undermining democracy, the rule of law or good governance in Myanmar and the repression of the civilian population in Myanmar, and is designated by the UK’s Myanmar sanctions regime.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14165","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
