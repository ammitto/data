<https://www.ammitto.org/entry/uk/consolidated-list/inu0400>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/inu0400> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_iran_sanctions_nuclear_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-09-29"^^xsd:date ; ammitto:effectiveDate "2025-09-29"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-09-29"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "INU0400" ;
  ammitto:remarks "\nFuture Bank is an involved person under the Iran (Sanctions) (Nuclear) (EU Exit) Regulations 2019 on the basis of the following grounds:  \n \n(1) Future Bank is associated with Bank Melli, who is or has been providing financial services, or making available funds or economic resources, that could contribute to a relevant nuclear activity, namely the proliferation or development of nuclear weapons in, or for use in, Iran or an activity that could lead to the development of nuclear weapons in, or for use in, Iran. \n \n(2) Future Bank is associated with Bank Saderat, who is or has been providing financial services, or making available funds or economic resources, that could contribute to a relevant nuclear activity, namely the proliferation or development of nuclear weapons in, or for use in, Iran or an activity that could lead to the development of nuclear weapons in, or for use in, Iran. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11177","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
