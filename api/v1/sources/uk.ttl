  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-10"^^xsd:date ; ammitto:effectiveDate "2020-12-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0062" ;
  ammitto:remarks "\nApti Alaudinov is the Deputy Minister of Internal Affairs of the Chechen Republic and Major General of the Police. In this position Alaudinov has presided over several waves of persecution against the LGBT community in Chechnya from 2017 to 2019. As a leading, senior official, Alaudinov is responsible for the actions of police and security forces under his command who have engaged in cruel, inhuman or degrading treatment or torture. In addition, by upholding the impunity of security forces and actively encouraging violence against LGBT persons, Alaudinov has facilitated, incited, promoted, and provided support for, the torture and murder of LGBT persons. Alaudinov is also responsible for the mistreatment of human rights defender Ruslan Kutaev." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14015","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
