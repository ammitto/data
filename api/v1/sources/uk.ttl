  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0001" ;
  ammitto:remarks "\nDmitry Borisovich Kratov, who was the chief medical officer and deputy head of Butyrka Prison where Magnitsky was detained until shortly before his death on 16 November 2009, was responsible for the mistreatment of Sergei Magnitsky, including by failing to ensure the proper administration of medical care, which contributed significantly to his death." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13852","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
