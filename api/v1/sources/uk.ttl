<https://www.ammitto.org/entry/uk/consolidated-list/rus0102>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0102> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0102" ;
  ammitto:remarks "\nOne of the self-described leaders of the so-called ‘people' Republic of Donetsk’. He requested Russian intervention in eastern Ukraine, including through the deployment of Russian peacekeeping forces. He is associated with Igor Strelkov/Girkin, who is responsible for actions which undermine or threaten the territorial integrity, sovereignty and independence of Ukraine. Gubarev is responsible for recruiting people for armed forces of separatists. Responsible for taking over of the regional government building in Donetsk with pro-Russian forces and proclaimed himself the ‘people's governor’. Despite being arrested for threatening the territorial integrity of Ukraine, and subsequently released, he has continued to play a prominent role in separatist activities, thus undermining the territorial integrity, sovereignty and independence of Ukraine. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13044","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
