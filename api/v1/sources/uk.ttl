  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0156" ;
  ammitto:remarks "\nZohar Sabah (hereafter “SABAH”) is an involved person within the meaning of the Global Human Rights Sanctions Regulations 2020 on the basis of the following ground: SABAH is and/or has been responsible for, engaging in, facilitating, inciting or providing support for activity which amounts to a serious abuse of the right of individuals not to be subjected to cruel, inhuman or degrading treatment or punishment. Specifically, SABAH has been involved in threatening, perpetrating, promoting and supporting, acts of aggression and violence against Palestinian individuals. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16926","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
