  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-05-13"^^xsd:date ; ammitto:effectiveDate "2022-05-13"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1458" ;
  ammitto:remarks "\nAnna ZATSEPILINA (henceforth ZATSEPILINA) is the grandmother of Alina KABAEVA, the Chair of the Board of Directors at Russia’s National Media Group. \nZATSEPILINA is also associated with Gennady TIMCHENKO, from whom she has received property. TIMCHENKO is a major shareholder in Bank Rossiya, and was sanctioned by the United Kingdom on the 22nd February 2022 for his provision of support for policies and actions which have destabilised and undermined or threatened the territorial integrity, sovereignty or independence of Ukraine\n The trust services sanctions were imposed on 21/03/2023." ;
