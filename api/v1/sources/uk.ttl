  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "مرکز به جرایم سازمان یافته – دفتر جرم و جنایت سایبر را مورد تحقیق قرار دهید" ; ammitto:script "Arab" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
