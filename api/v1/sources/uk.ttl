  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lumisa" ; ammitto:firstName "Muhammed" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kato" ; ammitto:firstName "L" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
