  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0015" ;
  ammitto:remarks "\nFormer Judge, Tehran Revolutionary Court. He participated in protesters trials. He was questioned by the Judiciary about Kahrizak abuses. He was instrumental in issuing detention orders to consign detainees to Kahrizak Detention Centre in 2009. In November 2014, his role in the deaths of detainees was officially recognised by the Iranian authorities." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11794","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
