  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1052" ;
  ammitto:remarks "\nVictor Evdokimovich GAVRILOV has held a number of senior positions of leadership in the Federal Security Service (FSB), including as Head of the FSB’s Economic Security Service’s Department of Transport, FSB Head of the Orenburg Region and other Russian-Government affiliated entities. As a member of the FSB and in his other senior Government posts, GAVRILOV is or has been responsible for, engaged in, provided support for or promoted policies or actions which destabilise Ukraine and undermine or threaten the territorial integrity, sovereignty or independence of Ukraine. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14995","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
