  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1755> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-23"^^xsd:date ; ammitto:effectiveDate "2023-02-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1755" ;
  ammitto:remarks "\nAlexei Gennadyevich DYUMIN is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 (“Russia Regulations”) because he i) is the regional Governor of Tula Oblast thereby meeting regulation 6(4a)(g) of the Russia Regulations; and ii) was previously working as Putin's chief security guard and continues to be associated with Putin, thereby meeting regulation 6(2)(d) of the Russia Regulations. Finally, iii) DYUMIN led the Russian military's Special Operations Forces, overseeing the annexation of Crimea in 2014 and in 2022 launched a drone training school for operatives undertaking missions in Ukraine, thereby meeting regulations 6(3)(a) and(b) of the Russia Regulations. \nAccordingly, there are reasonable grounds to suspect that DYUMIN has been involved and continues to be involved with destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine.  \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15790","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
