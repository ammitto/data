  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0082" ;
  ammitto:remarks "\nFurqan Bangalzai was commander of the militant wing of the terror organisation Lashkar-e-Jhangvi. In this capacity, he was involved in an activity which, if carried out by or on behalf of a State within the territory of that State, would amount to a serious violation by that State of an individual’s right to life by his role in facilitating the bombing of the Lal Shahbaz Qalandar shrine in Sehwan, Pakistan, in which at least 70 people were killed.  \n \nAdditional information: In May 2020, Bangalzai was convicted of70 counts of murder for his involvement in the bombing.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14167","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
