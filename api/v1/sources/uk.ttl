<https://www.ammitto.org/entry/uk/consolidated-list/drc0001>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/drc0001> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_democratic_republic_of_the_congo_sanctions_eu_exit_regulatio> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "DRC0001" ;
  ammitto:remarks "\nAs Commander of the Republican Guard until July 2020, Ilunga KAMPETE was responsible for the GR units deployed on the ground and involved in the disproportionate use of force and violent repression, in September 2016 in Kinshasa. In this capacity, Ilunga KAMPETE was therefore involved in planning, directing, or committing acts that constitute serious human rights violations in DRC.  Since July 2020, he remains a high-ranking soldier, as a Lieutenant General in the Congolese Armed Forces (FARDC) and Commander of the Kitona military base in the province of Kongo Central. There are reasonable grounds to conclude that KAMPETE is an “involved person” given that matters within reg (6)(2) occurred in Kinshasa while he was Commander of the Republic Guard and therefore bears responsibility for the human rights violations committed by the FARDC. \n" ;
