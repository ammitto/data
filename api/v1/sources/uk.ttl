  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-05-05"^^xsd:date ; ammitto:effectiveDate "2026-05-05"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-05-05"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0063" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that 24x7 RAS OVERSEAS FOUNDATION is or has been an involved person under the Global Irregular Migration and Trafficking in Persons Sanctions Regulations 2025 as it has been involved in a relevant activity, namely \ntrafficking in persons. \nSpecifically, 24x7 RAS OVERSEAS FOUNDATION engaged in the recruitment of Indian nationals using deception and then exploited them. In its public communications, it advertised well paid roles within “the Russian security sector” but, upon the Indian nationals’ arrival in Russia, they were forced to fight on the front line of Russia’s war of aggression against Ukraine under the menaces, namely verbal abuse, threats and physical violence.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
