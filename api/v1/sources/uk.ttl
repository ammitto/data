  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0027" ;
  ammitto:remarks "\nLt General Valeri Vakulchyk was Chairman of the State Security Committee (KGB) of Belarus between November 2012 and 03 September 2020. From 03 September to 29 October 2020, he was Head of the Security Council. In his role as Chairman of the State Security Committee, he had overall responsibility for the State Security Committee including the involvement of KGB officers in serious human rights violations and abuses against detained protestors and journalists, which they carried out following the election of 9 August.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13959","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
