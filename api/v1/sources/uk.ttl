  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-05-04"^^xsd:date ; ammitto:effectiveDate "2022-05-04"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1376" ;
  ammitto:remarks "\nNailya ASKER-ZADE is a television journalist and interviewer at the All-Russia State Television and Radio Broadcasting Company (VGTRK) and widely understood to be in a long-term relationship with Andrei Kostin, Chairman of VTB Bank. As such, she is associated with two entities (VGTRK and Kostin), both of which is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business as a Government of Russia-affiliated entity.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15333","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
