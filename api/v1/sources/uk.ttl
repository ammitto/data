  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Дмитрий Николаевич БЕЗРУКИХ" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
