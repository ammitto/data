<https://www.ammitto.org/entry/uk/consolidated-list/mya0028>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0028> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-09-02"^^xsd:date ; ammitto:effectiveDate "2021-09-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0028" ;
  ammitto:remarks "\nThe Tatmadaw has a track record of committing serious human rights violations in Myanmar for decades, including the ethnic cleansing of the Rohingya in 2017, ongoing attacks on other ethnic groups and the 2021 coup and associated repression of the civilian population and serious human rights violations including killings, arbitrary detention and torture. U Tay Za has provided support for these activities in his role as an arms dealer for the military responsible for brokering deals with Russia for arms. Further or alternatively, he has made funds or economic resources available and/or he is or has been involved in the supply of goods and/or technology, which could contribute to serious human rights violations. Further, and/or alternatively, U Tay Za is associated with the military through his extensive links with the former and current junta regimes.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14139","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
