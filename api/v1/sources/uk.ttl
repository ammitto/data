  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0029" ;
  ammitto:remarks "\nSince 2011 Chief of the Intelligence of the Ministry of Defence. Ramezani has held a number of senior roles in Military Intelligence and security for IRGC including Commander and Deputy Commander of Intelligence of IRGC and Head of Protection and Intelligence. Involved in the suppression of freedom of expression, including by being associated with those responsible for the arrests of bloggers/journalists in 2004, and reported to have had a role in the suppression of the post-election protests in 2009." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12659","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
