<https://www.ammitto.org/entity/uk/drc0030>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "NJABU" ; ammitto:firstName "FLORIBERT" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ndjabu" ; ammitto:firstName "Floribert" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ndjabu" ; ammitto:firstName "Floribert" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ngabu" ; ammitto:firstName "Floribert" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/drc0030> ;
  ammitto:remarks "Under house arrest in Kinshasa since March 2005 for FNI involvement in human rights abuses. Transferred to The Hague on 27 March 2011 to testify in the ICC Germain Katanga and Mathieu Ngudjolo trials. Applied for asylum in the Netherlands in May 2011. In October 2012, a Dutch court denied his asylum claim. In July 2014, he was deported from the Netherlands to DRC, where he was placed under arrest. INTERPOL-UN Security Council Special Notice web link: https://www.interpol.int/en/notice/search/un/5776373" .
<https://www.ammitto.org/entry/uk/consolidated-list/drc0030>
