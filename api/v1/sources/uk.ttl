<https://www.ammitto.org/entry/uk/consolidated-list/mya0037>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0037> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-04-19"^^xsd:date ; ammitto:effectiveDate "2022-04-19"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0037" ;
  ammitto:remarks "\nThe Tatmadaw has a track record of committing serious human rights violations and violations of international humanitarian law in Myanmar for decades.\nAs Director of Dynasty International Company Ltd (DICL), Aung Moe Myint has used his commercial and personal position to provide support for these activities in his role as an importer and broker of arms and dual use goods. Through his control of DICL, he has acted as a key source of weapons and commercial support for the junta, including through his close political/commercial ties with Belarus. Aung Moe Myint has therefore been involved in the supply of restricted goods and/or restricted technology, and dual-use goods, which could have contributed to serious human rights violations.\nFurther, and/or alternatively, Dr Aung Moe Myint is associated with the State Administration Council and Myanmar Security Forces, through his role as Honorary Consul of the Republic of Belarus. He has used this position to carry out engagement on behalf of the State Administration Council and/or the Myanmar Security Forces. Further, and/or alternatively, Dr Aung Moe Myint is associated with the military through his extensive links with the former and current junta regimes.\n  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15045","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/mya0038>
