  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0070" ;
  ammitto:remarks "\nMember of the State Duma, elected from the illegally annexed Autonomous Republic of Crimea. Deputy Chairperson of the Duma Committee on ethnic affairs. In 2014 Balbek was appointed as a Deputy Chairperson of the Council of Ministers of the so-called \"Republic of Crimea\" and worked in this capacity for the intergration of the illegally annexed Crimean peninsula into the Russian Federation for which he has been awarded with a medal \"For the Defence of Crimea\". He has supported the annexation of Crimea in public statements, including on his profile on the United Russia (Crimean branch) website and a press article published on NTV website on 3 July 2016. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13390","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
