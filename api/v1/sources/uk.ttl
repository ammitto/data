  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0018" ;
  ammitto:remarks "\nFormer Minister of Justice. Former Director of the special investigations office. Until July 2016 Deputy Minister of Interior and head of the public register. Advisor to the Disciplinary Court for Judges since April 2014. Former President of the Tehran Judiciary. As President of the Tehran Judiciary he has been responsible for human rights violations, arbitrary arrests, denials of prisoners' rights and a high number of executions." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12177","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
