  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-04-10"^^xsd:date ; ammitto:effectiveDate "2025-04-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0153" ;
  ammitto:remarks "\nMirza Kezevadze is an involved person within the meaning of the Global Human Rights Sanctions Re\ngulations 2020 on the basis of the following ground: Mirza Kezevadze i\ns and/or has been responsible for activity which amounts to a serious violation of the right of individuals not to be subjected to cruel, inhuman or degrading treatment or punishment. \n \nSpecifically, during the protests that occurred after the passage of the foreign influence law, security forces from the Ministry of Internal Affairs Special Task Department (Special Task Department), and Tbilisi Police Department, violently targeted Georgian citizens, political opposition leaders, journalists, and youth activists. In his role as Deputy Chief of the Special Task Department, this violence was overseen by Mirza Kezevadze. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16853","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
