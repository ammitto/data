  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-11-15"^^xsd:date ; ammitto:effectiveDate "2021-11-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "NIC0012" ;
  ammitto:remarks "\nLumberto Ignacio Campbell Hooker is a senior official in the Government of Nicaragua. He was the former Vice President and subsequently interim President of the Supreme Electoral Council of Nicaragua, and remains a magistrate of that organisation. There are reasonable grounds to suspect that in these roles he has stifled free and fair elections during civic protests in 2018, shown partisanship towards the Ortega Regime whilst serving as a senior official in the Supreme Electoral Council, and played an active role in disbanding opposition parties. He is responsible for undermining democracy and the rule of law, repression of civil society and the democratic opposition and for human rights violations.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14150","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
