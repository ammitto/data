  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-11-15"^^xsd:date ; ammitto:effectiveDate "2021-11-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "NIC0011" ;
  ammitto:remarks "\nAlba Luz Ramos Vanegas is the President of Nicaragua’s Supreme Court of Justice, and sits on the National Council for Judicial Administration and Career. There are reasonable grounds to suspect that in her role as President of the Supreme Court of Justice she has undermined the independence of the judiciary, denying accused parties in the courts a free and fair trial, and permitting and actively encouraging cruel, degrading and inhumane treatment of accused parties. She is responsible for undermining democracy and the rule of law, repression of civil society and the democratic opposition and for human rights violations.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14149","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
