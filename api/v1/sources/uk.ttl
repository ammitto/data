  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/sud0031> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_sudan_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-02-05"^^xsd:date ; ammitto:effectiveDate "2026-02-05"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-02-05"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "SUD0031" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Mustafa Ibrahim Abdel Nabi Mohamed is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020 (1) through his association with Alkhaleej Bank Co Ltd; and (2) Mustafa Ibrahim Abdel Nabi Mohamed himself is or has been  providing financial services that could contribute to an action, policy or activity which threatens the peace, stability and security of Sudan because he has acted as financial advisor to the RSF and he has therefore contributed to the RSF’s siege of El Fasher in North Darfur and the RSF’s operations elsewhere in Sudan.\n  \n   \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/sud0036>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "DAGALO" ; ammitto:firstName "Al-Goney" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "DAGALO" ; ammitto:firstName "Algoney" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "DAGALO" ; ammitto:firstName "Al-qoni" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/sud0036> ;
  ammitto:remarks "Al-Goney Hamdan Dagalo was sanctioned by the UN on 28 April 2026 pursuant to paragraph 3 (c) of resolution 1591 (2005) on the following grounds: Al-Goney Hamdan Dagalo (Al-Goney) is being designated for engaging in actions or policies that threaten the peace, security, or stability of Darfur.\n\nAl-Goney is the procurement director of the Rapid Support Forces (RSF) and a brother of Mohammed Hamdan “Hemedti” Dagalo, the leader of the RSF.  Al-Goney has extended this war by leading RSF efforts to procure weapons and military materiel.  By arming the RSF, his actions have directly contributed to the RSF’s ongoing siege of El Fasher in North Darfur, a city of nearly two million vulnerable civilians, and the RSF’s operations elsewhere in Sudan.\n\nAl-Goney has controlled the RSF front company Tradive General Trading, which imported vehicles to Sudan on behalf of the RSF.\n\n" ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "" ; ammitto:state "Dubai" ; ammitto:country "United Arab Emirates" ] .
