  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rotenberg" ; ammitto:firstName "Liliya " ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "РОТЕНБЕРГ Лилия Аркадьевна" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
