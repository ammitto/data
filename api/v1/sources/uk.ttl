  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0035" ;
  ammitto:remarks "\nFormer Minister of Intelligence (2009-2013). Under his leadership, the Ministry of Intelligence continued the practices of widespread arbitrary detention and persecution of protesters and dissidents. The Ministry of Intelligence runs Ward 209 of Evin Prison, where many activists have been held on account of their peaceful activities in opposition to the government in power. Interrogators from the Ministry of Intelligence have subjected prisoners in Ward 209 to beatings and mental and sexual abuse." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12202","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
