  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-04-06"^^xsd:date ; ammitto:effectiveDate "2022-04-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1120" ;
  ammitto:remarks "\nSergei Sergeevich IVANOV is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the following grounds: (1) IVANOV has been \ninvolved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent, of PJSC Alrosa, a Government of Russia-affiliated entity; (2) IVANOV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent, of PJSC Alrosa, a business in the Russian extractives sector, a sector of strategic significance to the Government of Russia; (3) Sergei Sergeevich IVANOV is associated with Sergey Borisovich IVANOV (an involved person) by being an immediate family member,  namely Sergey Borisovich IVANOV’s child. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15068","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
