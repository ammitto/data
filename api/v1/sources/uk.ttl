  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0003" ;
  ammitto:remarks "\nInvolved in the unresolved disappearances of Yuri Zakharenko, Viktor Gonchar, Anatoly Krasovski and Dmitri Zavadski in Belarus in 1999-2000. Sheiman is associated with other Belarus Officials who have been listed for their involvement in these disappearances. Sheiman was a former Chief of Staff to President Lukashenka. He was appointed to the position of Prosecutor General in 2000 but failed to take any action to investigate the case of the unresolved disappearances." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"8904","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
