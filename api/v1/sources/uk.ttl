  ammitto:remarks "The Director Disqualification Sanction was imposed on 09/04/2025." .
<https://www.ammitto.org/entry/uk/consolidated-list/irn0002>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/irn0002> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_iran_sanctions_regulations_2023> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0002" ;
  ammitto:remarks "\nProsecutor General of Tehran from August 2009 until May 2019. Dolatabadi's office indicted a large number of protesters, including individuals who took part in the December 2009 Ashura Day protests. He ordered the closure of Karroubi's office in September 2009 and the arrest of several reformist politicians, and he banned two reformist political parties in June 2010. His office charged protesters with the charge of Muharebeh, or enmity against God, which carries a death sentence, and denied due process to those facing the death sentence. His office also targeted and arrested reformists, human rights activists, and members of the media, as part of a broad crackdown on the political opposition. In October 2018 he announced to the media that four detained Iranian environmental activists were to be charged with “sowing corruption on earth”, a charge which carries the death penalty. In October 2018 he announced to the media that four detained Iranian environmental activists were to be charged with “sowing corruption on earth”, a charge which carries the death penalty" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11795","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
