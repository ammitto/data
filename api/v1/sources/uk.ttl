  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-09-29"^^xsd:date ; ammitto:effectiveDate "2020-09-29"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0052" ;
  ammitto:remarks "\nIgor Petrovich Sergeenko is the Chief of Staff to the President of Belarus, Alexander Lukashenko, also known as the Head of the Presidential Administration of Belarus.In this role, Sergeenko has significant influence over the Belarusian authorities’ response to the post-election protests, which included subjecting detainees to cruel, inhuman and degrading treatment or torture. Sergeenko also plays an important coordinating role over state bodies, including the working relationship between the President and the Belarusian Ministry of the Interior and its internal security forces, which are responsible for treatment amounting to CIDT or torture of detainees." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13920","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
