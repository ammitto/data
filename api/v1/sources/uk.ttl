  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/sud0006> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_sudan_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-07-12"^^xsd:date ; ammitto:effectiveDate "2023-07-12"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "SUD0006" ;
  ammitto:remarks "\nAl Junaid Multi Activities Co Ltd (AL JUNAID) is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020 through its association with, support for and funding of the Rapid Support Forces (RSF). The RSF, through its participation in ongoing conflict and frequent breaches of ceasefire agreements, are responsible for activity which threatens the peace, stability and security of Sudan. AL-JUNAID is itself responsible for activity which threatens the peace, stability and security of Sudan because it funds and supplies one of the main parties to the conflict. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16004","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
