  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-08"^^xsd:date ; ammitto:effectiveDate "2023-02-08"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1709" ;
  ammitto:remarks "\n JSC PLANT UNIVERSALMASH is an involved person under the Russian (EU Exit) (Sanctions) regulations 2019. JSC PLANT UNIVERSALMASH is a Russian based manufacturing plant, their main activity is currently the manufacture of the tracked chassis of the S-300V4 anti-aircraft missile system used by the Armed Forces of the Russian Federation in Ukraine. There are therefore reasonable grounds to suspect that JSC PLANT UNIVERSALMASH is an “involved person” per regulations 6(2)(a)(i)&(ii) by “destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine” and by “obtaining a benefit from or supporting the Government of Russia” by carrying on business in the strategically important defence sector.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15731","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
