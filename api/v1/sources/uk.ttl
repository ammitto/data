  ammitto:status "active" ;
  ammitto:referenceNumber "VEN0037" ;
  ammitto:remarks "\nAsdrubal José Brito Hernández is an involved person through his role as the Director of Criminal Investigations at the General Directorate of Military Counter-Intelligence (DGCIM). The DGCIM is and has been involved in the commission of serious human rights violations and abuses in Venezuela, including, but not limited to, “Operation Tun-Tun”, which followed the disputed July 2024 presidential election.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16721","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
