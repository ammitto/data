  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "PODOPRIGOROV" ; ammitto:firstName "Sergey" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
