  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-05-17"^^xsd:date ; ammitto:effectiveDate "2024-05-17"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "DPR0290" ;
  ammitto:remarks "\nToplivo Bunkering Company (TBK) is an involved person under The Democratic People’s Republic of Korea (Sanctions) (EU Exit) Regulations 2019 because it has been involved in the facilitation of any of the DPRK’s military programmes. Toplivo Bunkering Company has assisted the contravention or circumvention of any relevant DPRK-related provisions specifically 2321 (2016) and 2371 (2017); by allowing UN designated vessels to bunker in its berth at the port of Vostochny.   \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16496","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
