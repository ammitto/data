  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0073" ;
  ammitto:remarks "\nViktor Ratushniak, the former Deputy Minister of Internal Affairs in Ukraine, implemented an order on 18 February to clear protesters in Kyiv with the use of firearms, which led directly to the deaths of protesters. As Deputy Minister for Internal Affairs responsible for public security he was in charge of and bore responsibility for the actions of Ukrainian law enforcement and the civilian groups they worked with, who tortured and killed protesters. International human rights institutions concluded that it was Ukrainian government policy to suppress the Maidan protest movement with excessive and lethal force." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12892","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
