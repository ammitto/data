  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0080" ;
  ammitto:remarks "\nMohammad Rostami Cheshmeh Gachi as Head of the Morality Police in Iran is or has been involved in the commission of serious human rights violations or abuse in Iran. The Morality Police enforce Iran’s Islamic dress requirements and are known to use unreasonable force against individuals they deem to be non-compliant. In this role Gachi is responsible for and promotes violations of the right to liberty and security and the right to freedom of expression." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15597","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
