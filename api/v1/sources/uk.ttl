  ammitto:remarks "\nHead of the Army Command and General Staff College (DAFOOS). Former Head of the IRGC’s Seyyed al-Shohada Corps, Tehran Province. The Seyyed al-Shohada Corps played a key role in organising the repression of protests in 2009." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11783","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
