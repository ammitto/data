<https://www.ammitto.org/entry/uk/consolidated-list/mya0038>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0038> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-25"^^xsd:date ; ammitto:effectiveDate "2022-03-25"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0038" ;
  ammitto:remarks "\n The Tatmadaw has a track record of committing serious human rights violations and violations of international humanitarian law in Myanmar for decades. \n \nMiya Win International Ltd is responsible for ongoing activity in brokering deals for the supply and upkeep of aircraft for the Myanmar Air Force. Evidence indicates that Miya Win International Ltd has been involved this activity since at least 2017 and has continued to support the Myanmar Security Forces since the coup in February 2021. Miya Win International Ltd has therefore been involved in the supply of dual-use goods to the Myanmar Air Force; and has been involved in the supply of restricted goods which could contribute to serious human rights violations \n \nFurther and/or additionally Miya Win International Ltd contributed funds to the Myanmar Security Forces in 2017, at two fundraising events held by Commander-in-Chief Min Aung Hlaing during the Rakhine clearance operations. There are reasonable grounds to suspect that these funds contributed to serious human rights violations and ethnic cleansing against the Rohingya.\n  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15048","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/mya0040>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
