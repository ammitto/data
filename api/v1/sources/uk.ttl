  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-07-22"^^xsd:date ; ammitto:effectiveDate "2021-07-22"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0023" ;
  ammitto:remarks "\nKudakwashe Regimond Tagwirei profited or otherwise benefitted from the misappropriation of property when his company, Sakunda Holdings, redeemed Government of Zimbabwe Treasury Bills at up to ten times their official value. This meant that Sakunda Holdings and Tagwirei, as its CEO and owner, profited significantly at the expense of macroeconomic stability in Zimbabwe. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14126","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
