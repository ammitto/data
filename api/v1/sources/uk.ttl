  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-07-06"^^xsd:date ; ammitto:effectiveDate "2020-07-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0011" ;
  ammitto:remarks "\nAlexander Ivanovich Bastrykin was appointed First Deputy Prosecutor General and Head of the Investigative Committee under the Prosecutor’s Office on 22 June 2007; he continued as Chairman of the Investigative Committee after it became an independent body in January 2011. In this role Bastrykin was responsible for the investigation of the mistreatment and death of Sergei Magnitsky in detention and intentionally or recklessly failed to fulfil that responsibility." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13867","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
