<https://www.ammitto.org/entry/uk/consolidated-list/mya0041>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0041> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-25"^^xsd:date ; ammitto:effectiveDate "2022-03-25"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0041" ;
  ammitto:remarks "\nThe Tatmadaw has a track record of committing serious human rights violations and violations of international humanitarian law in Myanmar for decades.\nDynasty International Company Ltd has provided support for these activities in its role as an importer and broker of arms imports to Myanmar. It has been responsible for the supply and upkeep of military and training aircrafts for the Myanmar Air Force, including since the February 2021 coup. Dynasty International Company Ltd is therefore involved in the supply of restricted goods and/or restricted technology, and dual-use goods, which could contribute to serious human rights violations. \nFurther and/or alternatively, Dynasty International Company Ltd is owned and controlled by Dr Aung Moe Myint, who is an “involved person” for the purposes of the Myanmar (Sanctions) Regulations 2021 for his involvement in supplying goods and technology to the Myanmar Security Forces, and his association with the State Administration Council.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15049","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
