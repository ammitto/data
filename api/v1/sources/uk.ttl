  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0771" ;
  ammitto:remarks "\nJSC SOGAZ is a Russian Insurance company, and is the largest insurer in the Russian corporate sector. JSC SOGAZ provides insurance to the oil and gas sector, water and rail transport, military-industrial complex and metallurgy. As such, it is carrying on business in the financial services sector, a sector of strategic significance to the Russian Government, thereby obtaining a benefit from or supporting the Government of Russia. Furthermore, it provides insurance for the Kerch Bridge, thereby providing support to policies that could destabilise Ukraine or undermine the territorial integrity, sovereignty, or independence of Ukraine.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14722","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
