  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "INU0048" ;
  ammitto:remarks "\nBonyad Taavon Sepah created Ansar Bank to provide financial and credit services to IRGC personnel. Initially, Ansar Bank operated as a credit union and transitioned into a fully fledged bank in mid 2009, upon receiving a license from Iran's Central Bank. Ansar Bank, formerly known as Ansar al Mojahedin, provides financial services to the IRGC. IRGC members received their salaries through Ansar Bank. In addition, Ansar Bank provides special benefits to IRGC personnel, including reduced rates for home furnishings, free or reduced-cost healthcare." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11581","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
