<https://www.ammitto.org/entry/uk/consolidated-list/rus0185>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0185> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
