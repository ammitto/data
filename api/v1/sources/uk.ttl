  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-02-28"^^xsd:date ; ammitto:effectiveDate "2022-02-28"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0254" ;
  ammitto:remarks "\nBank Otkritie Financial Corporation PJSC (hereafter 'Otkritie') is the only bank of systematic importance that is owned by the Central Bank of Russia (CBR). Otkritie is the 8th largest bank in Russia with assets of approximately 3.2 trillion Rubles (3% of the total assets in the financial sector). It is supporting and obtaining a benefit from the Government of Russia. Otkritie is owned by the Central Bank of Russia, part of the Government of Russia. It is also carrying on business of economic significance to the Government of Russia. Furthermore, Otkritie is carrying on business in the Russian financial services sector which is a sector of strategic importance to the Government of Russia.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14199","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Prohibition on Correspondent banking relationships and processing payments","uk:entityType":"Entity"}""" ] .
