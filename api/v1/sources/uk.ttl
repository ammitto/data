<https://www.ammitto.org/entity/uk/drc0023>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "UGANDA COMMERCIAL IMPEX (UCI) LTD" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/drc0023> ;
  ammitto:remarks "Gold export company. (Directors Mr. Jamnadas V. LODHIA – known as “Chuni”- and his sons Mr. Kunal LODHIA and Jitendra J. LODHIA). In January 2011, Ugandan authorities notified the Committee that following an exemption on its financial holdings, Emirates Gold repaid UCI’s debt to Crane Bank in Kampala, leading to final closure of its accounts. The directors of UCI have remained involved in purchasing gold from eastern DRC. Uganda Commercial Impex (UCI) Ltd last filed a return in 2013 and was listed as “Inactive – status inactive” by the authorities of the Republic of Uganda. INTERPOL-UN Security Council Special Notice web link: https://www.interpol.int/en/How-we-work/Notices/View-UN-Notices-Entities." ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "Plot 22, Kanjokya Street" ; ammitto:city "Kamwokya" ; ammitto:state "Kampala" ; ammitto:country "Uganda" ] ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "PO BOX 22709" ; ammitto:state "Kampala" ; ammitto:country "Uganda" ] .
