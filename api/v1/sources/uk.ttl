<https://www.ammitto.org/entry/uk/consolidated-list/cyb0113>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/cyb0113> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_cyber_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-12-09"^^xsd:date ; ammitto:effectiveDate "2025-12-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-12-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0113" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Integrity Technology Group Incorporated (Integrity Tech), formerly Beijing Integrity Technology Group (BITG), has been involved in relevant cyber activity, in that it provided support for and engaged in the commission, planning or preparation of such activity, and supplied technology that could contribute to the commission of relevant cyber activity. \n \nIntegrity Tech controlled and managed a botnet covert network consisting of over 260,000 compromised devices worldwide and supplied access to this network enabling unauthorised access to and interference with information systems and data which targeted UK public sector IT systems. \n \nSuch activity that Integrity Tech was involved in, undermined, or was intended to undermine, the integrity, prosperity or security of the United Kingdom or a country other than the United Kingdom. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
