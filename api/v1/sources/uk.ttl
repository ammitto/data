  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Htut" ; ammitto:firstName "Soe" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/mya0015> ;
  ammitto:remarks "Lt-Gen Soe Htut graduated from Intake 64 of the Myanmar military’s Officer Training School. Became a regional commander in 2010. The Director Disqualification Sanction was imposed on 09/04/2025." ;
