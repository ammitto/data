  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0013" ;
  ammitto:remarks "\nOleg Logunov, as the Deputy Head of the Investigative Committee of the Russian Interior Ministry, was involved in the mistreatment of Sergei Magnitsky, which contributed significantly to his death on 16 November 2009. Lugunov was part of a ‘team’ of investigators who failed to investigate complaints made by Magnitsky about his mistreatment and provided support to subordinates who were directly involved in that conduct." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13870","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
