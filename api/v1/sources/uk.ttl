<https://www.ammitto.org/entry/uk/consolidated-list/gac0024>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/gac0024> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_anti_corruption_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-07-22"^^xsd:date ; ammitto:effectiveDate "2021-07-22"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0024" ;
  ammitto:remarks "\nTeodoro NGUEMA Obiang Mangue is an involved person within the meaning of the Global Anti-Corruption Sanctions Regulations 2021 on the basis of the following grounds: 1) NGUEMA has been involved in engaging in or being responsible for serious corruption. Specifically, whilst Vice President of Equatorial Guinea, NGUEMA is or has been responsible for or engaging in bribery and the misappropriation of property; 2) NGUEMA has been involved in facilitating or providing support for serious corruption. Specifically, whilst Vice President of Equatorial Guinea, NGUEMA is or has been facilitating or providing support for the serious corruption of the Equatorial Guinean elite; and 3) NGUEMA has been involved in profiting financially or obtaining any other benefit from serious corruption. Specifically, NGUEMA has utilised the proceeds of corruption to acquire assets in multiple countries which are vastly disproportionate to his legitimate sources of income.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14127","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
