<https://www.ammitto.org/entry/uk/consolidated-list/mya0030>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0030> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-12-10"^^xsd:date ; ammitto:effectiveDate "2021-12-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0030" ;
  ammitto:remarks "\nThe Myanmar War Veterans Organisation (MWVO) is associated with the Tatmadaw which is responsible for serious human rights violations against the population of Myanmar; undermining democracy and repressing the civilian population, in particular during the 2021 coup d'etat and violence against ethnic minorities. The MWVO functions in part as a reserve force for the Tatmadaw and helps shape national defence and security policy. Several high-ranking serving Tatmadaw officers sit on the Central Patron Board. In particular the Commander-in-Chief and Deputy Commander-in-Chief of the Defence Services, both of whom have been involved in serious human rights violations (and designated under the Global Human Rights sanctions regulations) sit on the Central Patron Board of the MWVO. Further or alternatively, the MWVO has promoted and supported the Tatmadaw’s involvement in undermining democracy; violating human rights; and repressing the civilian population. The MWVO organises pro-regime rallies in support of, and to counter international condemnation of the Tatmadaw; and practises people’s militia. Further or alternatively, MWVO is also associated with Myanmar Economic Holdings Ltd (MEHL), a designated entity, through a shared governance structure and financial relationship.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14163","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/mya0031>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Quarter Master General Office" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/mya0031> ;
