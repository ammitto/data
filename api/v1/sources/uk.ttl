  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-23"^^xsd:date ; ammitto:effectiveDate "2023-02-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1736" ;
  ammitto:remarks "\nJoint Stock Company IZUMRUD develops and manufactures shipborne radar systems to control the firing of shipborne anti-aircraft artillery, radio navigation equipment and remote control radio equipment for the Russian Federation navy. They also service weapons and military equipment.   \nJoint Stock Company IZUMRUD is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 that makes available goods or technology that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15773","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
