  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-02-28"^^xsd:date ; ammitto:effectiveDate "2022-02-28"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0253" ;
  ammitto:remarks "\nVEB.RF is a state corporation established by the Russian Government to function as the national development bank and a state payment agent to a range of entities across sectors of strategic significance to the Government of Russia.\nVEB.RF is benefitting from and supporting the Government of Russia. VEB.RF is carrying on business as a Government of Russia-affiliated entity by receiving financial benefits from the Government of Russia. VEB.RF carries out activities in financial services in the Russian financial services sector, and is therefore carrying on business in a sector of strategic significance to the Government of Russia.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14198","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Prohibition on Correspondent banking relationships and processing payments","uk:entityType":"Entity"}""" ] .
