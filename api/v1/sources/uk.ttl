  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0039" ;
  ammitto:remarks "\nHead of IRGC Intelligence since October 2009. Commander of the Basij until October 2009. Forces under his command participated in mass beatings, murders, detentions and tortures of peaceful protestors." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11788","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
