  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0016" ;
  ammitto:remarks "\nJudge of the Supreme Court, head of the 44th section. Deputy Chief Executive Officer of Setad-e Dieh Foundation. Chief Judge, Mashhad Revolutionary Court (2001-2011). Trials under his jurisdiction have been conducted summarily and inside closed session, without adherence to basic rights of the accused. As execution rulings were issued en masse (up to 550 between summer 2009 and summer 2011), death sentences were issued without proper observance of fair hearing procedures." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11789","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
