  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0249" ;
  ammitto:remarks "\nElena Alexandrovna GEORGIEVA is the Chair of the Board of Novikombank. Novikombank is a subsidiary of Rostec (Russian Technologies State Corporation), a major Russian state owned defence conglomerate. Novikombank plays a significant role in the implementation of Russian government programmes aimed at the development of high technology industries in Russia by providing financing to key military and civilian projects. GEORGIEVA is involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of a company which carries on business in sectors of strategic significance to the Government of Russia, in particular the defence sector. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14194","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
