  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0045" ;
  ammitto:remarks "\nDeputy to the Prosecutor-General of Tehran for Prison Affairs during the crackdown of 2009. As Deputy to the Prosecutor-General of Tehran for Prison Affairs he was responsible, by virtue of his senior position, for many of the arrest warrants against innocent, peaceful protesters and activists. Reports show that virtually all those arrested were held incommunicado without access to their lawyer or families, and without charge, for varying lengths of time. He was aware and complicit in allowing and promoting these human rights abuses and has made statements supporting excessive punishments and detentions of individuals, which appear arbitrary." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12192","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
