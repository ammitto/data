  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-07-06"^^xsd:date ; ammitto:effectiveDate "2020-07-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0009" ;
  ammitto:remarks "\nIvan Pavlovitch Prokopenko was the Head of the Russian Penitentiary Service (FSIN) at Matrosskaya Tishina pre-trial detention centre where Magnitsky was detained from 28 November 2008 to 25 July 2009. The FSIN is a federal law enforcement body responsible for the supervision of sentences. Heading the FSIN service at Matrosskaya Tishina, Prokopenko was responsible for the supervision of Magnitsky’s sentence. In this role, Prokopenko facilitated the mistreatment of Sergei Magnitsky by transferring him from Matrosskaya Tishina detention centre to Butyrka Prison, ignoring Magnitsky’s medical needs which could have been provided for at Matrosskaya Tishina, and depriving Magnitsky of important medical care. This unreasonably put Magnitsky’s life in danger and contributed to his death." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13864","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
<https://www.ammitto.org/entity/uk/ghr0010>
