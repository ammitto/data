<https://www.ammitto.org/entry/uk/consolidated-list/bel0065>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0065> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0065" ;
  ammitto:remarks "\nLLC Synesis (“Synesis”), including through its former wholly-owned subsidiary, LLC 24x7 Panoptes (“Panoptes”), has supplied the Kipod Technology (“Kipod”) to the Republic of Belarus for use with the “Republican System for Monitoring Public Safety” (“RSMPS”), which is a video surveillance and monitoring system. The RSMPS is used by the Belarus Ministry of Internal Affairs, as the State body authorised to coordinate the use of the RSMPS, and law enforcement agencies, including by security and police units. Kipod is a key part of the RSMPS.  \nThe RSMPS, relying on Kipod, has provided the Ministry of Internal Affairs and law enforcement agencies with the capability inter alia, to track down civil society and pro-democracy activists, in order to repress them. Further, that capability has been so used. For example, following the elections on 9 August 2020, Nikolay Dedok, a civil society activist who was in hiding was tracked down by the RSMPS using the Kipod system. He was subsequently detained and tortured.  \nSynesis has therefore been involved in the commission of a serious human rights violation or abuse in Belarus and/or the repression of civil society or democratic opposition in Belarus as Synesis has been responsible for and/or has provided support for, either or both such activities; and/or that Synesis has been involved in the supply to Belarus of technology which could contribute to either or both such activities. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14039","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
