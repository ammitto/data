  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-02-08"^^xsd:date ; ammitto:effectiveDate "2023-02-08"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1701" ;
  ammitto:remarks "\nAlexander REPIK is an involved person within the meaning of the Russia (Sanctions) (EU Exit) Regulations 2019 because he is the Chairman of the Board of R-Pharm, one of Russia’s largest pharmaceutical companies. R-Pharm receives financing from the Russian Direct Investment Fund, meaning it is a Government of Russia-affiliated entity. Therefore, REPIK is the director or equivalent of an entity that is both carrying on business in a sector of strategic significance to the Government of Russia, namely, the chemicals sector, and carrying on business as a Government of Russia-affiliated entity. REPIK is also associated to an involved person in destabilising Ukraine, namely, President Putin, through his close working relationship with Putin. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15723","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
