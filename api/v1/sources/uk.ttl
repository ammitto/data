  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "VEN0036" ;
  ammitto:remarks "\nNoriega is a National Assembly Deputy (2021-2025) having been re-elected on 6 December 2020 in undemocratic parliamentary elections not recognised as free and fair by the UK. Noriega had previously served as a National Assembly Deputy for the period 2016-2020. \n \nThere are reasonable grounds to suspect that Noriega, a member of the Venezuelan National Assembly, has been involved in the repression of democratic opposition in Venezuela and other actions, policies, or activities which undermine democracy in Venezuela, by coming to power through fraudulent/illegitimate elections and by his involvement with Operation Alacran.  \n \nThere are also reasonable grounds to suspect he is associated with Nicolas Maduro, a person who is involved in the repression of democratic opposition and otherwise undermining democracy in Venezuela through his involvement in Operation Alacran. \n \nLastly, there are reasonable grounds to suspect that Noriega was acting on behalf of, or at the command of a person (Nicolas Maduro) who is involved in repression of political opposition and other policies which undermine democracy in Venezuela by aiding his attacks and attempts to control the National Assembly. In July 2020, Noriega, helped by the Venezuelan Supreme Court of Justice (Tribunal Supremo de Justicia (TSJ)), illegitimately took over the leadership of the political party Voluntad Popular, thereby further undermining democracy in Venezuela. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13851","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
