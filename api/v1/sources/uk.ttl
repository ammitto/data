  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0036" ;
  ammitto:remarks "\nMember of the National Security and Foreign policy Committee. Parliamentary deputy for Lorestan Province. Member of the Parliamentary Commission for Foreign and Security Policy. Head of Evin prison until 2012. Torture was a common practice in Evin prison while Souri was its head. In Ward 209, many activists were held for their peaceful activities in opposition to the ruling government." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12193","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
