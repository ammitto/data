<https://www.ammitto.org/entry/uk/consolidated-list/rus1683>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1683> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-12-13"^^xsd:date ; ammitto:effectiveDate "2022-12-13"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1683" ;
  ammitto:remarks "\n Major General Robert Petrovich BARANOV is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following two grounds: (1) as a Major General in the Russian Armed Forces, BARANOV is involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine under reg. 6(2)(a)(i), or obtaining a benefit from or supporting the Government of Russia under reg. 6(2)(a)(ii), as he works for, or is affiliated with, the Government of Russia as member of the armed forces or law-enforcement organs of the Russian Federation of the rank of colonel, or equivalent, or higher under reg. 6(4A)(i); (2) he is responsible for, engages in, provides support for, and promotes a policy or action which destabilises Ukraine or undermines or threatens the territorial integrity, sovereignty or independence of Ukraine under reg. 6(3)(a) through his role as director of the Main Computation Centre of the Armed Forces of Russia. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15689","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
