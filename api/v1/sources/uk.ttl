  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-03-27"^^xsd:date ; ammitto:effectiveDate "2024-03-27"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-03"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CTD0003" ;
  ammitto:remarks "\nWe have reasonable grounds to suspect that Aozma SULTANA (“SULTANA”) is an involved person on the basis that SULTANA: 1. Has been involved in terrorist activity by: a. Making available funds and providing financial services for the purposes of terrorism by making available funds and providing financial services to “Gaza Now”, an organisation which promotes, encourages and supports Hamas and Palestinian Islamic Jihad, and to its founder Mustafa AYASH, and b. Supporting or assisting Mustafa AYASH, and Gaza Now, both persons whom it is reasonable to suspect SULTANA knew or believed were involved in promoting or encouraging terrorism; and 2. Is associated with persons who are or have been involved in terrorist activity, namely Mustafa AYASH, and Gaza Now. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16458","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
