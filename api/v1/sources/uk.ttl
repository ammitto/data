<https://www.ammitto.org/entry/uk/consolidated-list/ctd0007>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/ctd0007> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_counter_terrorism_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-09-25"^^xsd:date ; ammitto:effectiveDate "2025-09-25"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-10-03"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CTD0007" ;
  ammitto:remarks "\nWe have reasonable grounds to suspect that Rampage Productions (“Rampage”) is an involved person on the basis that Rampage has been and is involved in the terrorist activity set out below. (a) Rampage has been and is facilitating, promoting and encouraging terrorism via its dissemination of music whose content promotes and encourages terrorism and through supporting events where such music is performed and disseminated; (b) Rampage has made funds available to, or for the benefit of, a person involved in terrorism for the purpose of promoting and encouraging terrorism through the sale of music and material whose content promotes and encourages terrorism; and through supporting events where such music is performed and such material disseminated; and (c) Rampage is an unincorporated association and/or organisation controlled directly by a person involved in terrorism. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17100","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze","uk:entityType":"Entity"}""" ] .
