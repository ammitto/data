  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0073" ;
  ammitto:remarks "\nFormer Prosecutor General of Tehran until August 2009. As Tehran Prosecutor General, he issued a blanket order used for the detention of hundreds of activists, journalists and students. In January 2010 a parliamentary investigation held him directly responsible for the detention of three prisoners who subsequently died in custody. He was suspended from office in August 2010 after an investigation by the Iranian judiciary into his role in the deaths of the three men detained on his orders following the election. In November 2014, his role in the deaths of detainees was officially recognised by the Iranian authorities. He was acquitted by an Iranian Court on 19 August 2015, on charges connected to the torture and deaths of three young men at the Kahrizak detention centre in 2009." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"11798","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
