  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0033" ;
  ammitto:remarks "\nPress TV Newsroom Director. Former Press TV Senior Producer. Responsible for producing and broadcasting the forced confessions of detainees, including journalists, political activists, persons belonging to Kurdish and Arab minorities, violating internationally recognised rights to a fair trial and due process. Independent broadcast regulator OFCOM fined Press TV in the UK GBP 100 000 for broadcasting the forced confession of Iranian-Canadian journalist and film-maker Maziar Bahari in 2011, which was filmed in prison whilst Bahari was under duress. NGOs have reported further instances of forced televised confessions by Press TV. Emadi is therefore associated with violating the right to due process and fair trial." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12854","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
