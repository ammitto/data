  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-02-21"^^xsd:date ; ammitto:effectiveDate "2024-02-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2024-02-21"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "DRC0071" ;
  ammitto:remarks "\nListed pursuant to paragraph 7 (c), 7(d), 7(e) of resolution 2293 (2016) as “political and military leaders of Congolese militias, including those receiving support from outside the DRC, who impede the participation of their combatants in disarmament, demobilization and reintegration processes”; “recruiting or using children in armed conflict in the DRC in violation of applicable international law”; “planning, directing, or committing acts in the DRC that constitute human rights violations or abuses or violations of international humanitarian law, as applicable, including those acts involving the targeting of civilians, including killing and maiming, rape and other sexual violence, abduction, forced displacement, and attacks on schools and hospitals”; as extended by resolution 2688 (2023). As a military leader of an armed Congolese militia, \nRUKUNDA is involved in promulgating and supporting the group’s activities. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16381","uk:unReferenceNumber":"CDi.041","uk:designationSource":"UN","uk:sanctionsImposed":"Asset freeze|Travel Ban","uk:entityType":"Individual"}""" ] .
