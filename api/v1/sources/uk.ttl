  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-07-12"^^xsd:date ; ammitto:effectiveDate "2023-07-12"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "SUD0010" ;
  ammitto:remarks "\nGSK is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020.   \n \nGSK is associated with RSF, an ‘involved person’ fighting for power in Sudan. GSK is one of RSF’s ‘front companies’ and is controlled by the head of RSF’s brother. \n \nRSF is an armed group and GSK supports it with funds and goods and equipment to fight. GSK provides funds for activity which threatens the peace, stability and security of Sudan, as an enabler of RSF’s participation in the conflict in Sudan.   \n \nGSK is an involved person responsible for activity which threatens the peace, stability and security of Sudan. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16008","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
