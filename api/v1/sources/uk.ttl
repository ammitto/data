  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0004" ;
  ammitto:remarks "\nDalibor Ćurlik \nis an involved person under the Global Irregular Migration and Trafficking in Persons Sanctions Regulations 2025 since he is or has been involved in a relevant activity, namely people smuggling. He facilitates the Kavač Gang, an organised criminal group originating in Montenegro, obtain passports based on false identities with a view to obtain a benefit for himself. This procures the unlawful entry of Kavač Gang members into different countries in the Balkans and Turkey of which they are not citizens and in which they are not permanent residents.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17019","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
