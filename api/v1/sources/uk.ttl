  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-10"^^xsd:date ; ammitto:effectiveDate "2020-12-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0068" ;
  ammitto:remarks "\nRafael Bastardo was Commander of FAES, the Special Action Force of the Venezuelan National Police between 2017 and 2019. There is reliable evidence that FAES committed serious human rights violations during Bastardo’s period in command. The recent UN Independent International Fact Finding Mission (IIFFM) report shows reasonable grounds to suspect that FAES was involved in multiple cases of extrajudicial executions. As FAES Commander, Bastardo is responsible for the human rights violations committed by FAES forces under his command." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14008","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
