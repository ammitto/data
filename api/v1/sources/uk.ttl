  ammitto:status "active" ;
  ammitto:referenceNumber "SUD0008" ;
  ammitto:remarks "\nDefense Industries System (‘DIS’) is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020 as it is associated with the SAF (an involved person), supports the activity the SAF is involved in, is involved in the supply to Sudan (specifically the SAF) of military goods or military technology or of material related to such goods or technology, and thereby engages in activity which threatens the peace, stability and security of Sudan. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16006","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
