  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-07-04"^^xsd:date ; ammitto:effectiveDate "2022-07-04"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1502" ;
  ammitto:remarks "\nYuriy Sergeyevich FEDIN (hereafter FEDIN) is an entrepreneur who has provided funding to the Russian news organisation NewsFront, including via his company INTENT. NewsFront has disseminated disinformation relating to Russian activities in Crimea and the war against Ukraine. FEDIN has therefore made available funds and provided support for activity that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15442","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
