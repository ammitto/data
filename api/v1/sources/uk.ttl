  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_anti_corruption_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-04-02"^^xsd:date ; ammitto:effectiveDate "2025-04-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0076" ;
  ammitto:remarks "\nThere are reasonable grounds to suspect that Levan Murusidze (“MURUSIDZE”) is an involved person within the meaning of the Global Anti-Corruption Sanctions Regulations 2021 on the basis of the following grounds: \n \nMURUSIDZE is or has been involved in serious corruption by engaging in serious corruption. As a Member of the High Council of Justice of Georgia, a foreign public official performing an executive or judicial function, he received a financial advantage as a reward for improperly performing his public functions, specifically improperly asserting his influence as a Member of the High Council of Justice to ensure that judicial appointments and decisions favoured the incumbent Georgian Dream Party. MURUSIDZE is or has been involved in serious corruption by engaging in serious corruption. As a Member of the High Council of Justice of Georgia, a foreign public official performing an executive or judicial function, he accepted an advantage, namely a lifetime appointment to the Tbilisi Court of Appeals, intending in consequence to continue improperly performing his public functions by ensuring that judicial appointments and decisions favour the incumbent Georgian Dream Party. MURUSDIZE is or has been involved in serious corruption by engaging in serious corruption. As a Member of the High Council of Justice of Georgia, a foreign public official performing an executive or judicial function, he accepted an advantage, namely a lifetime appointment to the Tbilisi Court of Appeals, intending to improperly perform his public functions by ensuring that judicial appointments and decisions favour the incumbent Georgian Dream Party.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16850","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
