  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-07-06"^^xsd:date ; ammitto:effectiveDate "2020-07-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0046" ;
  ammitto:remarks "\nSenior General Min Aung Hlaing is Commander in Chief of the Myanmar Armed Forces (Tatmadaw). In this role, he was responsible for military operations carried out in Rakhine State in 2017 and in 2019 and is responsible for atrocities and serious human rights violations committed against the Rohingya population in Rakhine state by the Tatmadaw. These include unlawful killings, including through systematic burning of Rohingya houses and buildings, massacre, torture, forced labour, systematic rape and other forms of targeted sexual violence, and enforced labour." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13897","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
