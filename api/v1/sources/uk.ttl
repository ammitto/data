  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0059" ;
  ammitto:remarks "\nNatalia Eismont was appointed Spokesperson / Press Secretary to President Lukashenko in November 2014. In this role, she has actively supported President Lukashenko throughout the flawed election process surrounding the 9 August 2020 Presidential election. Through her activities and statements, she has supported the repression of civil society and democratic opposition in Belarus and has undermined democracy and the rule of law in Belarus.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13993","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Technical assistance related to aircraft|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
