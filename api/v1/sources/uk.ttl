  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/gac0001> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_anti_corruption_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-04-26"^^xsd:date ; ammitto:effectiveDate "2021-04-26"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0001" ;
  ammitto:remarks "\nIn December 2007, an organised criminal group was involved in serious corruption through the misappropriation of the equivalent of $230m of Russian state property via a complex scheme involving a fraudulent tax rebate. KUZNETSOV participated in the fraud through his involvement, in particular, in seizing documents used to secure the fraudulent tax rebate. He interfered in judicial processes and benefited financially from the proceeds of the serious corruption. His actions facilitated or provided support for serious corruption." ;
