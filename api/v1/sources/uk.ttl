  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khan" ; ammitto:firstName "Anzhelika" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khan" ; ammitto:firstName "Angelika" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Анжелика Хан" ; ammitto:script "Cyrl" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/uk/consolidated-list/rus1359> ;
  ammitto:remarks "Transport sanction: where transport sanctions apply, a ship owned, controlled, chartered or operated by a designated person is prohibited from entering a port in the UK, may be given a movement or a port entry direction, can be detained, and will be refused permission to register on the UK Ship Register or have its existing registration terminated. Similarly, an aircraft owned, chartered or operated by a designated person is prohibited from overflying or landing in the UK, may be given a movement direction, can be detained or moved to a specified airport, and will be refused permission to register on the CAA Aircraft Register or have its existing registration terminated. In addition, there is a prohibition of the provision of technical assistance relating to aircraft or ships which will prevent a person from directly or indirectly providing technical assistance to, or for the benefit of, the designated person, where that technical assistance relates to an aircraft or ship The Director Disqualification Sanction was imposed on 09/04/2025." ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "118 Eaton Square" ; ammitto:state "London" ; ammitto:country "United Kingdom" ] .
<https://www.ammitto.org/entry/uk/consolidated-list/rus1359>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1359> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-04-21"^^xsd:date ; ammitto:effectiveDate "2022-04-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1359" ;
  ammitto:remarks "\nThere are reasonable grounds to suspect that Anzhelika KHAN is associated with German Borisovich KHAN. Anzhelika KHAN is the wife of German Borisovich KHAN.  \nGerman Borisovich KHAN, hereafter KHAN, is a prominent Russian businessman. KHAN is obtaining a benefit from and/or supporting the Government of Russia through his positions on the Supervisory Board of the Alfa Group Consortium and the Board of Directors of ABH Holdings S.A., owner of Russia’s largest privately owned bank 'Alfa-Bank (Russia)’, and Chairman of the Supervisory Board of A1 Investment Holding S. A., entities which are carrying on business in sectors of strategic significance to the Government of Russia. KHAN is also a close associate of Vladimir Putin who has been involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15310","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
