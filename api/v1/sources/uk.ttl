  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-06-09"^^xsd:date ; ammitto:effectiveDate "2026-06-09"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-06-15"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0192" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that EYAL HARI YEHUDA COMPANY LTD is an involved person under the Global Human Rights Sanctions Regulations 2020 on the basis of the following ground: \n \n \nEYAL HARI YEHUDA COMPANY LTD facilitates, incites, promotes or provides support for such an activity which amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.\n  \nEYAL HARI YEHUDA COMPANY LTD\n is responsible for or engages in such an activity \nwhich amounts to a serious abuse of the right of an individual not to be subjected to cruel, inhuman or degrading treatment or punishment.\n  \nSpecifically, EYAL HARI YEHUDA COMPANY LTD facilitates, supports and is responsible for owners, staff, associates and family members who have used company resources while hired on construction and demolition jobs in the West Bank to destroy Palestinian land and property as well as physically attack, shoot and kill Palestinians which has led to the wider forced displacement of Palestinians. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
