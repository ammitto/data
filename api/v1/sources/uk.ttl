  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0059" ;
  ammitto:remarks "\nOne of the leaders of the Donetsk People’s Republic. Participated in the seizure and occupation of the regional administration in Donetsk in 2014. Active spokesperson for the separatists. Until 4 September 2015 so-called Deputy Chairman of the “People’s Council” of the so-called “Donetsk People’s Republic”. Since 4 September 2015 “Chairman” of the “People’s Council of the Donetsk People’s Republic”. So-called 'acting Head of the Donetsk People's Republic' after 7 September 2018. So-called 'Head of the Donetsk People's Republic' following the so-called elections of 11 November 2018. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12962","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
