  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0089" ;
  ammitto:remarks "\nShares responsibility for the decision to transfer gas turbines that had been delivered by Siemens Gas Turbine Technologies OOO to OAO VO Technopromexport to be installed in Crimea. This decision contributes to establishing an independent power supply for Crimea and Sevastopol as a means of supporting their separation from Ukraine, and undermines the territorial integrity, sovereignty, and independence of Ukraine. The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13521","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
