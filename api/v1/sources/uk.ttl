  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-10"^^xsd:date ; ammitto:effectiveDate "2022-03-10"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0267" ;
  ammitto:remarks "\nAndrei Leonidovich KOSTIN is an involved person under the Russia (EU Exit) (Sanctions) Regulations 2019 on the following grounds: KOSTIN is or has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director (whether executive or non-executive), trustee, or equivalent of a Government of Russia-affiliated entity and an entity that is carrying on business in the Russian financial services sector, a sector of strategic significance to the Government of Russia.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14217","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Technical assistance related to aircraft|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
