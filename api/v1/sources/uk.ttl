  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ibrahim" ; ammitto:firstName "Osama" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "al Kuni" ; ammitto:firstName "Osama" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "al-Milad" ; ammitto:firstName "Osama" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
