<https://www.ammitto.org/entry/uk/consolidated-list/gac0025>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/gac0025> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_anti_corruption_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-07-22"^^xsd:date ; ammitto:effectiveDate "2021-07-22"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GAC0025" ;
  ammitto:remarks "\nAlex Nain Saab Moran engaged in serious corruption in Venezuela through his participation in two of Venezuela’s public programmes: the ‘Local Committees for Supply and Production’ (CLAP) and the Great Housing Scheme Venezuela (Spanish acronym: GMVV). In each case, contracts were improperly granted by public officials to companies owned or controlled by Saab Moran, for the benefit of the official(s) and/or for another person, including Saab Moran himself. In the CLAP programme, basic foodstuffs were provided at highly inflated prices. For GMVV, Saab Moran’s company only delivered a small proportion of the products they had agreed to deliver and for which it had been paid, misappropriating the remainder of the funds. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14128","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
