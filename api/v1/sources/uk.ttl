  ammitto:remarks "Management: Igor Srelkov Girking (subject to sanctions) The Director Disqualification Sanction was imposed on 09/04/2025." ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "Occupies several rooms in the former Ptitsyn-Zalogina estate near the Taganskaya metro station (in Moscow, Russia)" ] .
<https://www.ammitto.org/entry/uk/consolidated-list/rus0184>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0184> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0184" ;
  ammitto:remarks "\nThe Movement “Novorossiya”/”New Russia” was established in November 2014 in Russia and is headed by Russian officer Igor Girkin a.k.a.Strelkov (identified as a staff member of the Main Intelligence Directorate of the General Staff of the Armed Forces of the Russian Federation (GRU)).  Girkin is a defendant in the case of the shooting down of flight MH17 over Eastern Ukraine in 2014 that led to the death of 289 on board, including 196 Dutch nationals. The Dutch prosecutor is demanding life sentences for all defendants.  According to its stated objectives, the Movement aims to provide all-round, effective assistance to “Novorossiya”, including by helping militia fighting in Eastern Ukraine, thereby supporting actions undermining the territorial integrity, sovereignty and independence of Ukraine.   Associated with a person listed for undermining the territorial integrity of Ukraine. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13226","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
