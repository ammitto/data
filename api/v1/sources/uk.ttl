  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "IRN0047" ;
  ammitto:remarks "\nMassoud Jazayeri, in his capacity as a senior figure within the Iranian armed forces, and his position as official spokesman, was responsible for supporting and promoting the repression of protests in 2009. He has openly called for repression of foreign mass media outlets, Iranians working for such outlets and the political opposition, and issued threats against protestors, both inside and outside of Iran. In 2010, he urged the passing of tougher laws against Iranians who cooperate with foreign media sources. He was responsible for the support and promotion of serious human rights violations in Iran, including the violation of freedom of expression and assembly." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"12185","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
