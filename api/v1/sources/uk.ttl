  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0855" ;
  ammitto:remarks "\nTatyana KOVALCHUK is the wife of Yuri KOVALCHUK (RUS0007). Yuri KOVALCHUK is an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019. As his wife, she is “associated with” Yuri KOVALCHUK as there are reasonable grounds to suspect that she has obtained a financial and other material benefit from her husband. Accordingly, there are reasonable grounds to suspect that she is herself an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019 \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14806","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
