  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0005" ;
  ammitto:remarks "\nAlexey Valeryevich Minin was part of a team of intelligence officers of the Russian General Staff Main Intelligence Directorate (GRU) unit known as field post number 26165 that attempted to gain unauthorised access to the information systems of the Organisation for the Prohibition of Chemical Weapons (OPCW) in April 2018. The Netherlands authorities disrupted the cyber attack before it was successful. This attempted relevant cyber activity was intended to undermine the independence or effective functioning of an international organisation." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13905","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
