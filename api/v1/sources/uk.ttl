<https://www.ammitto.org/entry/uk/consolidated-list/mya0052>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0052> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-08-24"^^xsd:date ; ammitto:effectiveDate "2022-08-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-02-10"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0052" ;
  ammitto:remarks "\nThe Myanmar Security Forces have a track record of committing serious human rights violations and repression of the civilian population of Myanmar. In 2017, the Myanmar Security Forces murdered, raped and tortured thousands of Rohingya during the Rakhine clearance operations. 740,000 Rohingya were forced over the border into Bangladesh.\nSky One Construction Company Limited contributed funds to the Myanmar Security Forces in 2017 at two fundraising events for the Rakhine clearance operations held by Commander in Chief, Min Aung Hlaing. Sky One Construction Company Limited has therefore made funds and economic resources available directly to or for the benefit of the Myanmar Security Forces, which could have contributed to serious human rights violations and repression of the civilian population in Myanmar.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15495","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
