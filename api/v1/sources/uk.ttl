<https://www.ammitto.org/entry/uk/consolidated-list/rus1090>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1090> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-24"^^xsd:date ; ammitto:effectiveDate "2022-03-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1090" ;
  ammitto:remarks "\nThe WAGNER GROUP is often described as a Russia-based Private Military Company and is an entity or group that provides military services for financial gain. It has organised the recruitment of, and coordinated and planned operations for, the Wagner Group mercenaries participating in military operations in Ukraine. There are multiple, credible sources which corroborate and support the conclusion that the existence of the organisation known as the Wagner Group is kept purposefully vague and opaque in order to provide a deniable military capability for the Russian State.  \n \nThe WAGNER GROUP is therefore responsible for, engages in, and provides support for actions which destabilise Ukraine and undermine or threaten the territorial integrity, sovereignty or independence of Ukraine. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15033","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
