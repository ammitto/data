  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-08-20"^^xsd:date ; ammitto:effectiveDate "2025-08-20"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-04-29"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS2990" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect that Kantemir Kaparbekovich CHALBAYEV (hereafter CHALBAYEV) is an “involved person” under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following ground: CHALBAYEV is and has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of an entity, OJSC CAPITAL BANK OF CENTRAL ASIA, which is carrying on business in a sector of strategic significance to the Government of Russia, namely the financial services sector. Further, or in the alternative, he has been so involved through working as a director or equivalent of that same entity which is carrying on business of economic significance to the Government of Russia.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17076","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
