  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus3467> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-02-24"^^xsd:date ; ammitto:effectiveDate "2026-02-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-02-24"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3467" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that POSTV is an involved person under the Russia (EU Exit) (Sanctions) Regulations 2019 on the basis of the following ground: it spreads and has spread deliberately misleading information concerning Russia’s full-scale invasion of Ukraine to its audiences, which are predominately located in Georgia, which provides support for or promotes a policy or action which destabilises Ukraine or undermines or threatens the territorial integrity, sovereignty or independence of Ukraine. In particular, it regularly disseminates content that the Ukrainian Government and President Zelensky are illegitimate, Ukraine is a “puppet” of the West, Ukraine is a corrupt country and that Ukraine and the West are seeking to destabilise Georgia.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
