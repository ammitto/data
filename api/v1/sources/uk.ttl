  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Viv Ansanm" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Fos Revolisyone G9 an Fanmi e Alye" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
