  ammitto:hasRegime <https://www.ammitto.org/regime/the_cyber_sanctions_eu_exit_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-12-31"^^xsd:date ; ammitto:effectiveDate "2020-12-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "CYB0011" ;
  ammitto:remarks "\nIgor Kostyukov is the Head of the Russian General Staff’s Main Intelligence Department (GRU), and was previously First Deputy Head. In this capacity, Igor Kostyukov is responsible for cyber attacks carried out by the 85th Main Centre of Special Services (GTsSS), also referred to as Field Post Number 26165, APT28, Fancy Bear, Sofacy Group, Pawn Storm, Strontium. These attacks include the cyber attack against the German federal parliament (Deutscher Bundestag) in April and May 2015. The cyber attack against the German federal parliament (Deutscher Bundestag) targeted the parliament’s information system and affected its operation for several days. A significant amount of data was stolen and e-mail accounts of several MPs as well as Chancellor Angela Merkel were affected" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13748","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
