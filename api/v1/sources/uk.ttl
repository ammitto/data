  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1616> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-09-26"^^xsd:date ; ammitto:effectiveDate "2022-09-26"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1616" ;
  ammitto:remarks "\nAlexander KHARICHEV is an involved person within the meaning of the Russia (Sanctions) (EU Exit) Regulations 2019 because KARICHEV is a head or deputy-head of any public body, federal agency or service subordinate to the President of the Russian Federation, including the Administration of the President of the Russian Federation. Specifically, KARICHEV is Chief of the Presidential Directorate for Supporting Activities of the State Council of the Russian Federation (also known as the Office of the President of the Russian Federation for ensuring the activities of the State Council of the Russian Federation).  Therefore, KARICHEV is a person involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine or obtaining a benefit from or supporting the Government of Russia. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15560","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
