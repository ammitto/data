  ammitto:remarks "\nThe 99th Light Infantry Division (99 LID) is an involved person under The Myanmar (Sanctions) Regulations 2021 because: 99 LID is or has been involved in the commission of serious human rights violations in Myanmar. Specifically in relation to the right of persons not to be subject to torture or cruel, inhuman or degrading treatment or punishment in Myanmar, including in the context of—rape and other forms of sexual and gender-based violence, against men, women and children of ethnic and religious minorities in Rakhine State.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15666","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
