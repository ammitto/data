  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus0851> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0851" ;
  ammitto:remarks "\nThere are reasonable grounds to suspect that Boris KOVALCHUK is associated with Yuri KOVALCHUK. Boris KOVALCHUK is the son of Yuri KOVALCHUK (RUS0007). \n \nYuri KOVALCHUK has been designated by the UK since 31 December 2020 (updated 18/12/2021) and is a long-time acquaintance of President Putin. He is a co-founder of the so-called Ozero Dacha, a cooperative society bringing together an influential group of individuals around President Putin. He is the chairman and largest shareholder of Bank Rossiya, of which he owned around 38% in 2013, and which is considered the personal bank of Senior Officials of the Russian Federation. Since the illegal annexation of Crimea, Bank Rossiya has opened branches across Crimea and Sevastopol, thereby consolidating their integration into the Russian Federation. Furthermore, Bank Rossiya has important stakes in the National Media Group which in turn controls television stations which actively support the Russian government’s policies of destabilisation of Ukraine\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14802","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
