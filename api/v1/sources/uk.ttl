<https://www.ammitto.org/entry/uk/consolidated-list/mya0017>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0017> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-04-29"^^xsd:date ; ammitto:effectiveDate "2021-04-29"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0017" ;
  ammitto:remarks "\nFollowing the coup against the democratically elected government by the Myanmar military (Tatmadaw) on 31 January, General Mya Tun Oo was appointed Minister of Defence on 1 February. The Minister of Defence is responsible for the Tatmadaw, which includes the Army, Navy and Air Force. The Tatmadaw have committed serious human rights violations in Myanmar since 1 February 2021 including prohibiting freedom of assembly, the arbitrary arrest and detention of opposition leaders and opponents of the coup, violence against protesters – including the use of water cannon and rubber and live ammunition - and preventing use of the internet. As the Minister of Defence, General Mya Tun Oo has command responsibility for these violations and can therefore be held responsible for these actions." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14058","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
