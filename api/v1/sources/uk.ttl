  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_human_rights_sanctions_regulations_2020> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2020-07-06"^^xsd:date ; ammitto:effectiveDate "2020-07-06"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GHR0033" ;
  ammitto:remarks "\nDr Salah Muhammed Tubaigy held the position of Forensic doctor with the Ministry of Interior in Saudi Arabia and Professor in the Department of Criminal Evidence at Naif Arab University. He was involved in the unlawful killing of Jamal Khashoggi in the Saudi Consulate in Istanbul on 2 October 2018 as part of the 15 man team sent to Turkey by Saudi authorities. Dr Tubaigy was present at the time of Jamal Khashoggi’s death and held a direct role in Jamal Khashoggi’s killing and in the concealment of evidence relating to his death." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13874","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
