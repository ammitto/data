<https://www.ammitto.org/entry/uk/consolidated-list/bel0109>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/bel0109> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_republic_of_belarus_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-07-21"^^xsd:date ; ammitto:effectiveDate "2021-07-21"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "BEL0109" ;
  ammitto:remarks "\nJSC AGAT - Electromechanical Plant is named as one of a number of Belarusian defence companies on the website of the government authority, The State Authority for Military Industry of the Republic of Belarus (SAMI).  \nJSC AGAT – Electromechanical Plant manufactures the ‘Rubezh’ (Frontier), a barrier system designed for riot control which was deployed during the demonstrations that have taken place in the wake of the August 9 2020 Presidential elections in Belarus.  JSC AGAT - Electromechanical Plant therefore provided support for, and made available equipment to police and security forces of the Ministry of Internal Affairs, which have contributed to, the repression of civil society and of democratic opposition following the August 9 elections.    \nFurthermore, JSC AGAT - Electromechanical Plant is named as one of a number of Belarusian defence companies on the SAMI website.  SAMI was established by the Belarusian President’s Decree of 30 December 2003 and is described on its website as being “subordinate to the Council of Ministers of the Republic of Belarus and in certain aspects of its activity, in accordance with the current legislation, is subordinate to the President of the Republic of Belarus.” It is therefore reasonable to conclude that JSC AGAT - Electromechanical Plant is responsible for, engaging in, providing support for, and promoting the wider efforts directed by the Belarussian regime to repress civil society and the democratic opposition. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14125","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
