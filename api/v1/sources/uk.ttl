  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2026-02-24"^^xsd:date ; ammitto:effectiveDate "2026-02-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2026-02-24"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3410" ;
  ammitto:remarks "\nThe Secretary of State considers that there are reasonable grounds to suspect that Grant Arshavirovich AKOPOV is and has been involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine by working as a director or other manager or equivalent of entities providing economic resources, goods or technology that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine. Namely, AKOPOV is president of LIMITED LIABILITY COMPANY UNIMATIC and supervisor of DALIAN UNIMATIC TRADING CO., LTD. which are involved persons. \n \nThe Secretary of State considers that there are reasonable grounds to suspect that Grant Arshavirovich AKOPOV is and has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent of a person carrying on business in a sector of strategic significance to the Government of Russia, namely he is president of LIMITED LIABILITY COMPANY UNIMATIC which is carrying on business in the Russian defence sector.    \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":null,"uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
