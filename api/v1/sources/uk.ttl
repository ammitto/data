  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-03-15"^^xsd:date ; ammitto:effectiveDate "2022-03-15"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-07-31"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS0665" ;
  ammitto:remarks "\nPetr Olegovich Aven (hereinafter AVEN) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: (1) AVEN is or has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent at Alfa Group Consortium, an entity carrying on business in a sector of strategic significance, namely the Russian financial services sector; (2) AVEN has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent at ABH Holding, an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (3) AVEN has been involved in obtaining a benefit from or supporting the Government of Russia by working as a director or equivalent at Alfa-Bank (Russia), an entity carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (4) AVEN is or has been involved in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty, or independence of Ukraine by working as a director at AlfaStrakhovanie, an entity which provides financial services to a person that could contribute to destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty, or independence of Ukraine; (5) AVEN is associated with a person who is or has been so involved, namely Mikhail FRIDMAN.  \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14616","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
