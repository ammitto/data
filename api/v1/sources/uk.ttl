  ammitto:referenceNumber "RUS1700" ;
  ammitto:remarks "\nPavel TITOV is an involved person within the meaning of the Russia (Sanctions) (EU Exit) Regulations 2019 because he is the son of Boris Titov. Therefore, Pavel TITOV is associated with an involved person in destabilising Ukraine or undermining or threatening the territorial integrity, sovereignty or independence of Ukraine. \n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15722","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
