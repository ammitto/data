  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/gim0001> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_global_irregular_migration_and_trafficking_in_persons_sancti> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-07-23"^^xsd:date ; ammitto:effectiveDate "2025-07-23"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-07-23"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0001" ;
  ammitto:remarks "\nGoran Assad JALAL is an involved person under the Global Irregular Migration and Trafficking in Persons Sanctions Regulations 2025 on the basis of the following ground: \n \nHe has engaged in a relevant activity, namely people smuggling. He facilitated the unlawful arrival of persons into the United Kingdom who were not United Kingdom nationals nor permanent residents in the United Kingdom with a view to obtaining a benefit for himself, namely money. He formed part of an organised crime group which stowed migrants in refrigerated lorries which crossed the English Channel from France to the United Kingdom on at least ten occasions between January and March 2019. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17016","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
