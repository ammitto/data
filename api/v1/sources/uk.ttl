  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus2457> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-02-24"^^xsd:date ; ammitto:effectiveDate "2025-02-24"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS2457" ;
  ammitto:remarks "\nAleksandr Sergeyevich USHKO is an “involved person\" under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds:  \n \n(1) Aleksandr Sergeyevich USHKO is associated with a person who is or has been involved in obtaining a benefit from or supporting the Government of Russia, namely Sergey Petrovich Ushko. Sergey Petrovich Ushko is an involved person as defined in the regulations. Sergey Petrovich Ushko is the father of Aleksandr Sergeyevich USHKO.  Sergey Petrovich Ushko is or has been involved in obtaining a benefit from or supporting the Government of Russia by virtue of his shareholding in LLC TROS, an entity which is carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian defence sector.  \n \n(2) Aleksandr Sergeyevich USHKO is associated with a person who is or has been involved in obtaining a benefit from or supporting the Government of Russia, namely LLC TROS. LLC TROS is an “involved person” under the Russia (Sanctions)(EU Exit) Regulations 2019 because it is or has been involved in obtaining a benefit from or supporting the Government of Russia by carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian defence sector. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16819","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
