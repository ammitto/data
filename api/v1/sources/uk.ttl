  ammitto:status "active" ;
  ammitto:referenceNumber "GIM0002" ;
  ammitto:remarks "\nThe Škaljari Gang is an involved person under the Global Irregular Migration and Trafficking in Persons Sanctions Regulations 2025 as it is or has engaged in a relevant activity, namely people smuggling. By procuring the issuance of passports based on false identities, and with a view of obtaining any gain or benefit, it engages in facilitating the unlawful entry of its gang members into different countries in the Balkans and Turkey of which the gang members are not citizens and in which they are not permanent residents. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17017","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze","uk:entityType":"Entity"}""" ] .
