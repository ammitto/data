  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0076> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2024-02-01"^^xsd:date ; ammitto:effectiveDate "2024-02-01"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0076" ;
  ammitto:remarks "\nThe 101st Light Infantry Division (LID 101) is an involved person under The Myanmar (Sanctions) Regulations 2021 because LID 101 is or has been involved in the commission of serious human rights violations in Myanmar. Specifically, being responsible for activity which violates the right of life of persons in Myanmar; the right to liberty and security of persons in Myanmar, including freedom from arbitrary arrest, detention or enforced disappearance;  and the right of persons not to be subject to torture or cruel, inhuman or degrading treatment or punishment in Myanmar, including in the context of violence against persons on the basis of their political opinion, religious belief or ethnicity, and of rape and other forms of sexual and gender-based violence. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16358","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
