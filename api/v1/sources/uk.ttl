<https://www.ammitto.org/entry/uk/consolidated-list/mya0029>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0029> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-09-02"^^xsd:date ; ammitto:effectiveDate "2021-09-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0029" ;
  ammitto:remarks "\nThe Htoo Group of Companies is owned or controlled directly or indirectly by U Tay Za, who is an involved person. Htoo Group of Companies contributed funds to the Tatmadaw in 2017, at a fundraising event for the Rakhine clearance operations held by Commander in Chief, Min Aung Hlaing. There are reasonable grounds to suspect that these funds contributed to serious human rights violations and ethnic cleansing against the Rohingya. Further and/or additionally, Myanmar Avia Export Ltd, a subsidiary of Htoo Group of Companies has connections to the Myanmar military, and has been responsible for brokering aircraft deals and arms with Russia, which, could have been used in serious human rights violations, including killings, arbitrary detention and torture in the Rakhine state and during the 2021 military coup.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14140","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
<https://www.ammitto.org/entity/uk/mya0030>
  a ammitto:OrganizationEntity ;
