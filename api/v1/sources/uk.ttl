  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2025-12-18"^^xsd:date ; ammitto:effectiveDate "2025-12-18"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-12-18"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS3180" ;
  ammitto:remarks "\nThe Secretary of State has reasonable grounds to suspect \nKIFIKO Limited Liability Company, h\nereafter known as ‘KIFIKO LLC’ is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis that it is and has been involved in obtaining a benefit from or supporting the Government of Russia through: (1) carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian financial services sector; (2) providing financial services, or making available funds, economic resources, goods or technology, to a person who is involved in obtaining a benefit from of supporting the Government of Russia within the meaning of regulation 6(4)(a) to (e), namely A7 LLC. \n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"17275","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
