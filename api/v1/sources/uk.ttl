  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OUNI HARZI" ; ammitto:firstName "Tarak" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Al Tounisi" ; ammitto:firstName "Abou" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
