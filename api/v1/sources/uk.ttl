<https://www.ammitto.org/entry/uk/consolidated-list/mya0015>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/mya0015> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_myanmar_sanctions_regulations_2021> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-04-29"^^xsd:date ; ammitto:effectiveDate "2021-04-29"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0015" ;
  ammitto:remarks "\nSoe Htut was appointed Minister for Home Affairs, on 1 February 2020. He was Home Affairs Minister during the coup, on 1 February, when Tatmadaw security forces (including the police) were directed to detain MPs and civil society figures. . The Minister for Home Affairs is responsible for the Myanmar Police Force, Fire Service and Prison Service. The police in Myanmar have committed serious human rights violations since 1 February 2021 including killing a civilian protesting against the military coup, preventing and disbanding assemblies, the arbitrary arrest and detention of opposition leaders and opponent of the coup, and preventing freedom of expression by opponents of the coup. The Ministry for Home Affairs has as two of its functions State Security and Law and Order. Directing and managing the police force is directly under Soe Htut’s command as Minister for Home Affairs. As such, we have strong reason to suspect that Lt. General Soe Htut has command responsibility for these violations." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14056","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
