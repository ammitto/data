  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2022-11-02"^^xsd:date ; ammitto:effectiveDate "2022-11-02"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1647" ;
  ammitto:remarks "\nAlexander Vladimirovich FROLOV (hereafter FROLOV) is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 on the basis of the following grounds: \n(1) FROLOV is a former director of Evraz plc; in this role, FROLOV has been involved in obtaining a benefit from or supporting the Government of Russia by working as a Director of an entity carrying on business in sectors of strategic significance to the Government of Russia, namely, the Russian extractives, transport and construction sectors;\n(2) FROLOV is a former CEO of Evraz plc, in this role, FROLOV has been involved in supporting the Government of Russia by working as a manager of an entity carrying on business in sectors of strategic significance to the Government of Russia, namely, the Russian extractives, transport and construction sectors;\n(3) FROLOV is involved in obtaining a benefit from or supporting the Government of Russia by owning or controlling directly or indirectly (within the meaning of reg. 7 (2)) Evraz plc, an entity carrying on business in sectors of strategic significance to the Government of Russia, namely, the Russian extractives, transport and construction sectors.\n The trust services sanctions were imposed on 21/03/2023." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15611","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction|Transport sanctions: see \"Other information\"","uk:entityType":"Individual"}""" ] .
