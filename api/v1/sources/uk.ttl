  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0012" ;
  ammitto:remarks "\nCorporal Kyaw Chay is a member of the Border Guard Police (BGP) and was present in the BGP base in Zay Di Pyin in Rakhine, during the most intense months of the Rohingya ‘clearance operations’, which commenced on 25 August 2017 and were at their most intense during the following two months. During this time Corporal Kyaw Chay directly participated in serious human rights violations. He is personally responsible for serious human rights violations committed against the Rohingya in Rakhine State, including physical abuse, torture and sexual violence against and detention of Rohingya people." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"13738","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
