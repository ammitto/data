  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2021-04-29"^^xsd:date ; ammitto:effectiveDate "2021-04-29"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "MYA0016" ;
  ammitto:remarks "\nFollowing the coup of 1 February 2021, during which Myanmar’s military seized power from civilian leaders, Than Hlaing was appointed Deputy Minister for Home Affairs and Chief of the Myanmar Police Force. The police in Myanmar have committed serious human rights violations since 1 February 2021 including killing a civilian protestor against the coup, preventing and disbanding assemblies, the arbitrary arrest and detention of opposition leaders and supporters, and preventing freedom of expression by opponents of the coup. As Deputy Minister for Home Affairs and Chief of the Myanmar Police Force we have strong reason to suspect that Lt. General Than Hlaing has command responsibility for these serious human rights violations." ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"14057","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
