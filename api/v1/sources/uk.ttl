<https://www.ammitto.org/entry/uk/consolidated-list/rus1945>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/uk/rus1945> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/uk> ;
  ammitto:hasRegime <https://www.ammitto.org/regime/the_russia_sanctions_eu_exit_regulations_2019> ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "travel_ban" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-07-31"^^xsd:date ; ammitto:effectiveDate "2023-07-31"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1945" ;
  ammitto:remarks "\nDanila MIKHEEV is an involved person under the Russia (EU Exit) (Sanctions) Regulations 2019. MIKHEEV was the state prosecution’s \n“\nexpert\n”\n witness in the trial against Vladimir Kara-Murza, who was found guilty of three charges, including disseminating false information about the Russian Armed Forces under Section 2 of Article 207.3 of the Russian Criminal Code, also known as the “fake news” laws.  The enactment of this law and its application and enforcement by prosecutors and courts is a result of a Russian Government policy aimed at preventing the Russian public from knowing the truth about and intimidating those willing to criticise and provide accurate information about the conflict in Ukraine.  This policy prevents the spread of accurate information about the conflict in Ukraine, as well as anti-war sentiment and dissent, which would reduce public support for the war and undermine the Russian Government’s ability to wage the war. In this way, the policy is facilitating the continuation of the war, which is destabilising Ukraine and undermining its territorial integrity and sovereignty. Mikheev’s role as an \n“\nexpert\n”\n witness in the Kara-Murza case and another “fake news” case shows that he is providing support for this policy. Therefore, MIKHEEV is an involved person because he is providing support for a policy that is destabilising Ukraine and undermining its territorial integrity and sovereignty.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16041","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Travel Ban|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Individual"}""" ] .
