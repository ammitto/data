  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1892" ;
  ammitto:remarks "\n JSC KRASNY GIDROPRESS is an involved person under the Russia (Sanctions) (EU Exit) Regulations 2019 because it is, and has been, involved in obtaining a benefit from or supporting the Government of Russia by: (1) carrying on business in a sector of strategic significance to the Government of Russia, namely the Russian defence sector, as part of the JSC TACTICAL MISSILES CORPORATION holding, a Russian holding company specialising in the manufacture of weapons; (2) carrying on business as a Government of Russia-affiliated entity because the Government of Russia holds directly or indirectly a minority interest in it; and (3) carrying on business as a Government of Russia-affiliated entity because it is owned or controlled directly or indirectly by the Government of Russia.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"15949","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
