  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "G9 Family and Allies" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "G9 Fanmi e Alye" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
