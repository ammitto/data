  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "asset_freeze" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "financial_restriction" ; ammitto:scope "full" ] ;
  ammitto:hasEffect [ a ammitto:SanctionEffect ; ammitto:effectType "debarment" ; ammitto:scope "full" ] ;
  ammitto:hasPeriod [ a ammitto:TemporalPeriod ; ammitto:listedDate "2023-09-29"^^xsd:date ; ammitto:effectiveDate "2023-09-29"^^xsd:date ; ammitto:isIndefinite "true"^^xsd:boolean ; ammitto:lastUpdated "2025-04-09"^^xsd:date ] ;
  ammitto:status "active" ;
  ammitto:referenceNumber "RUS1975" ;
  ammitto:remarks "\nThe Central Election Commission of the Russian Federation (the Russian CEC) is an involved person within the meaning of the Russia (Sanctions) (EU Exit) Regulations 2019 because it arranged the illegitimate referendums held by Russia in September 2022 in the illegally temporarily controlled Ukrainian regions (‘the regions’) and attempted to legitimise the results. Further, the Russian CEC arranged illegitimate regional elections in the regions in September 2023 and attempted to legitimise the results. Therefore, the Russian CEC is or has engaged in policies or actions which destabilise Ukraine and undermine or threaten the territorial integrity, sovereignty, or independence of Ukraine.\n" ;
  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"uk:ofsiGroupId":"16100","uk:unReferenceNumber":null,"uk:designationSource":"UK","uk:sanctionsImposed":"Asset freeze|Trust Services Sanctions|Director Disqualification Sanction","uk:entityType":"Entity"}""" ] .
