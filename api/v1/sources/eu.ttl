  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ansar al-Mojahedin No-Interest Loan Institute" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ansae Institute" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/eu/consolidated-list/eu240572> ;
  ammitto:remarks "Bonyad Taavon Sepah created Ansar Bank to provide financial and credit services to IRGC personnel. Initially, Ansar Bank operated as a credit union and transitioned in to a fully fledged bank in mid 2009, upon receiving a licence from Iran's Central bank. Ansar Bank, formerly known as Ansar al Mojahedin, has been linked to the IRGC for over 20 years. IRGC members received their salaries through Ansar bank. In addition, Ansar bank provided special benefits to IRGC personnel, including reduced rates for home furnishings and free, or reduced-cost, health care. Date of listing: 23.05.2011" ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "North Khaje Nasir Street [Ansar Building]" ; ammitto:city "Tehran" ; ammitto:country "IRAN (ISLAMIC REPUBLIC OF)" ; ammitto:countryIsoCode "IR" ] ;
  ammitto:addresses [ a ammitto:Address ; ammitto:street "539 North Pasdaran Avenue, Tehran" ; ammitto:city "Tehran" ; ammitto:country "IRAN (ISLAMIC REPUBLIC OF)" ; ammitto:countryIsoCode "IR" ] .
