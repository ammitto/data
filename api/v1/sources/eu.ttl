<https://www.ammitto.org/entity/eu/eu240572>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ansar Saving and Interest Free-Loans Fund" ; ammitto:script "Latn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ansar Financial and Credit Institute" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ansar Bank" ; ammitto:script "Latn" ; ammitto:isPrimary "false"^^xsd:boolean ] ;
