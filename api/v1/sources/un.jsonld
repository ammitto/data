          "circa": false,
          "year": 1966,
          "city": "Lowy Kariz, Spin Boldak District",
          "region": "Kandahar Province",
          "country": "Afghanistan"
        }
      ],
      "nationalities": [
        "Afghanistan"
      ],
      "identifications": [

      ],
      "addresses": [
        {
          "@type": "Address",
