      "@type": "OrganizationEntity",
      "entityType": "organization",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "ADF",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "Allied Democratic Forces",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Forces Démocratiques Alliées-Armée Nationale de Libération de l’Ouganda",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "ADF/NALU",
          "script": "Latn",
          "isPrimary": false
