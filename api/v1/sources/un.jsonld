      "names": [
        {
          "@type": "NameVariant",
          "fullName": "SULTAN SALEH AIDA AIDA ZABIN",
          "firstName": "SULTAN",
          "middleName": "SALEH AIDA AIDA",
          "lastName": "ZABIN",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
