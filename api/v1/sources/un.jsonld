      "names": [
        {
          "@type": "NameVariant",
          "fullName": "ANTÓNIO INJAI",
          "firstName": "ANTÓNIO",
          "middleName": "INJAI",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
