    {
      "@id": "https://www.ammitto.org/entity/un/cdi035",
      "@type": "PersonEntity",
      "entityType": "person",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "GÉDÉON KYUNGU MUTANGA WA BAFUNKWA KANONGA",
          "firstName": "GÉDÉON",
          "middleName": "KYUNGU MUTANGA WA BAFUNKWA",
          "lastName": "KANONGA",
          "script": "Latn",
          "isPrimary": true
