          "fullName": "WILLIAM AMURI YAKUTUMBA",
          "firstName": "WILLIAM",
          "middleName": "AMURI YAKUTUMBA",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
