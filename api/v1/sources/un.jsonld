    {
      "@id": "https://www.ammitto.org/entity/un/cdi002",
      "@type": "PersonEntity",
      "entityType": "person",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "FRANK KAKOLELE BWAMBALE",
          "firstName": "FRANK KAKOLELE",
          "middleName": "BWAMBALE",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "FRANK KAKORERE",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "FRANK KAKORERE BWAMBALE",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "AIGLE BLANC",
          "script": "Latn",
          "isPrimary": false
        }
      ],
      "sourceReferences": [

      ],
      "linkedEntities": [

      ],
      "hasSanctionEntry": [
        "https://www.ammitto.org/entry/un/consolidated-list/cdi002"
      ],
      "remarks": "Left the CNDP in January 2008. As of June 2011, resides in Kinshasa.\nSince 2010, Kakolele has been involved in activities apparently on behalf of the DRC\ngovernment’s Programme de Stabilisation et Reconstruction des Zones Sortant des Conflits\nArmés (STAREC), including participation in a STAREC mission to Goma and Beni in March\n2011. DRC authorities arrested him in December 2013 in Beni, North Kivu Province, for\nallegedly blocking the DDR process. He left the DRC and lived in Kenya for some time, before being called back by the DRC Government to assist them with the situation in the Territory of Beni.  He was arrested in October 2015 in the area of Mambasa for allegedly supporting a Mai Mai group, but no charges were brought and as of June 2016, he lived in Kinshasa. INTERPOL-UN Security Council Special Notice:https://www.interpol.int/en/How-we-work/Notices/View-UN-Notices-Individuals",
      "birthInfo": [

      ],
      "nationalities": [
        "Democratic Republic of the Congo"
      ],
      "gender": "Male",
      "identifications": [

      ],
      "addresses": [
        {
          "@type": "Address",
          "city": "Kinshasa",
          "country": "Democratic Republic of the Congo"
        }
      ],
      "position": "FARDC General "
    },
