    {
      "@id": "https://www.ammitto.org/entity/un/kpe009",
      "@type": "OrganizationEntity",
      "entityType": "organization",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "AMROGGANG DEVELOPMENT BANKING CORPORATION",
          "script": "Latn",
          "isPrimary": true
        },
