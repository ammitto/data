    {
      "@id": "https://www.ammitto.org/entity/au/3170",
      "@type": "OrganizationEntity",
      "entityType": "organization",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "Munitions Industry Department",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "Military Supplies Industry Department",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "MID",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Machine Industry Department",
          "script": "Latn",
          "isPrimary": false
        }
      ],
      "sourceReferences": [

      ],
      "linkedEntities": [

      ],
      "hasSanctionEntry": [
        "https://www.ammitto.org/entry/au/consolidated-list/3170"
      ],
      "remarks": "KPe.028. The Munitions Industry Department is involved in key aspects of the DPRK's missile program. MID is responsible for overseeing the development of the DPRK's ballistic missiles, including the Taepo Dong-2.The MID oversees the DPRK's weapons production and R&D programs, including the DPRK's ballistic missile program. The Second Economic Committee and the Second Academy of Natural Sciences – also designated in August 2010 – are subordinate to the MID. The MID in recent years has worked to develop the KN08 road-mobile ICBM. The MID oversees the DPRK's nuclear program. The Nuclear Weapons Institute is subordinate to the MID.; Listing: Listed on: 2 Mar. 2016 (amended on 9 Jul. 2018, 16 Aug. 2023)",
      "identifications": [

      ],
      "addresses": [
        {
          "@type": "Address",
          "street": "Pyongyang, Democratic People's Republic of Korea",
          "country": "Democratic People's Republic of Korea"
        }
      ],
      "beneficialOwners": [

      ]
