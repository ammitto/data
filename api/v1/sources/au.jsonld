        {
          "@type": "Address",
          "street": "a) Chilgol, Pyongyang, Democratic People's Republic of Korea b) Sengujadong 11-2/(or Kwangbok-dong), Mangyongdae District, Pyongyang, Democratic People's Republic of Korea",
          "country": "Democratic People's Republic of Korea"
        }
      ],
      "beneficialOwners": [

      ]
    },
