  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Teplinskiy Mikhail Yuryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61060> ;
  ammitto:remarks "Mikhail Teplinskiy is a Russian military leader, and the Head of the Dnipro Group of Forces of the Russian Federation. The Dnipro Group of Forces of the Russian Federation is conducting military offensives in southern Ukraine. Mikhail Teplinskiy is therefore actively involved in shaping and implementing the military campaign of the Russian forces in southern Ukraine.undermine the territorial integrity, sovereignty and independence of Ukraine." ;
