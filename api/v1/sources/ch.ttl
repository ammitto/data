  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Moscow Machine-Building Plant “Vpered”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75181> ;
  ammitto:remarks "JSC Moscow Machine-Building Plant “Vpered” is one of the oldest enterprises in the Russian aviation industry, operating since 1931. The company is a leading company producing tail rotors and blades for helicopters of the Mi family, which are widely used by the Russian armed forces during Russia’s war of aggression on Ukraine." .
