  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chouman Nabil Khaled Halil" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71369> ;
  ammitto:remarks "Nabil Khaled Halil Chouman is the owner of Shuman for Currency Exchange SARL, based in Beirut, Lebanon, which has been used to launder and transfer money to Hamas, including from Iran. The sums of money transferred to Hamas through Shuman for Currency Exchange SARL are estimated at tens of millions of USD. Thus, Nabil Khaled Halil Chouman participates in the financing of Hamas." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
