<https://www.ammitto.org/entity/ch/75338>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Giba Andrey Anatolyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75338> ;
  ammitto:remarks "Andrey Giba is the Deputy Head of the Investigative Department of the Federal Security Service (FSB) of the Russian Federation in Crimea and Sevastopol. In his position, he headed politically motivated investigations against political opponents in the illegally annexed Crimea and Sevastopol. He also conducted the investigations in the trials of journalist Vladyslav Yesypenko. In that context, he has been involved in the systematic persecution campaigns targeting the Crimean Tatar community for their religious beliefs. He is therefore supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-11-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
