<https://www.ammitto.org/entity/ch/64581>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Vassiliev Timofey Vladimirovitch" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/64581> ;
  ammitto:remarks "Timofey Vassiliev is the Head of the Department for strategic guidance of ANO Dialog, a Russian non-profit organisation created by the Moscow Department of Information and Technology (DIT) in 2019 and linked to the presidential administration, which has been disseminating online propaganda about the illegally annexed territories in Ukraine. Timofey Vassiliev, runs the popular “fact-checking” Telegram account and subsequent domains “War on Fakes” which spread disinformation about the Russian war of aggression against Ukraine. Therefore, Timofey Vassiliev is responsible for supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
