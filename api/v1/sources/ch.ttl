<https://www.ammitto.org/entity/ch/101194>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Eyyub Etibar" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101194> ;
  ammitto:remarks "Etibar Eyyub founded and runs a network of companies including Coral Energy (later 2Rivers Group). Through this network of companies, he enables shipments and exports of Russian oil, notably from the Russian state owned oil-company Rosneft, by concealing the actual origin of the oil. In particular, the 2Rivers network controls and utilises a large proportion of the vessels in Russia’s so-called “shadow fleet”." .
