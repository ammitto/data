<https://www.ammitto.org/entity/ch/93326>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Radioline”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93326> ;
  ammitto:remarks "LLC Radioline has provided technological equipment of significant value, including of German origin, to Russian company Special Technology Center Ltd, which is already subject to restrictive measures by the Union and known for producing unmanned aerial vehicles (UAVs). Such UAVs are used in Russia’s war of aggression against Ukraine. Therefore, LLC Radioline is supporting Russia’s military and industrial complex." .
