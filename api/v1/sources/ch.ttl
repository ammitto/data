<https://www.ammitto.org/entity/ch/72680>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Antsev Georgiy Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72680> ;
  ammitto:remarks "Georgiy Antsev is Chairman of the St. Petersburg branch of SoyuzMash of Russia, as well as the General Director and General Designer of Joint Stock Company Research and Production Enterprise Radar MMS (JSC NPP Radar MMS). JSC NPP Radar MMS is a Russian defence industry enterprise that designs and produces homing systems for high-precision weapons, military and civil avionics, monitoring and navigation systems." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-01-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
