<https://www.ammitto.org/entity/ch/4832>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Iauseev Ihar Uladzimiravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4832> ;
  ammitto:remarks "Head of the regional Minsk police (since March or April 2015), former Head of the regional Vitebsk police, police general (since 2013). Former Deputy Head of Minsk Police and Head of the Minsk anti-riot (OMON) operation team. He commanded the troops that put down the peaceful demonstrations on 19 Dec 2010 and personally took part in the brutality, for which he received an award and an acknowledgement letter from President Lukashenka in February 2011. In 2011, he also commanded the troops that repressed several other protests by political activists and peaceful citizens in Minsk." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
