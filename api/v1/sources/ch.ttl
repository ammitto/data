<https://www.ammitto.org/entity/ch/98872>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC “NPO Aviabas”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98872> ;
  ammitto:remarks "LLC “NPO Aviabas” is a Russian company specialising in the manufacturing of unmanned aerial vehicles (UAVs). It produces the Lun-7 and Lun-10 first-person view combat UAVs, which have been actively used by Russian forces in Ukraine for reconnaissance, strike and kamikaze missions. The company operates from St. Petersburg and plays a growing role in Russia’s expanding UAV warfare capabilities." .
