<https://www.ammitto.org/entity/ch/75158>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “L. N. Koshkin Automatic Line Design Bureau”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75158> ;
  ammitto:remarks "JSC “L. N. Koshkin Automatic Line Design Bureau” (JSC KBAL) is a Russian military industry company. JSC KBAL produces machines and assembly lines that allow for cartridge production, and the cartridges produced by those machines and assembly lines are used in Russia’s war of aggression against Ukraine. The company also provides ammunition to the Russian army under state defence orders." .
<https://www.ammitto.org/entry/ch/consolidated-list/75158>
