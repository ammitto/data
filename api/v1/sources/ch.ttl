<https://www.ammitto.org/entity/ch/107617>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Serpukhov Plant “Metallist”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107617> ;
  ammitto:remarks "JSC Serpukhov Plant “Metallist” produces gyro motors, gyro units, and various precision electromechanical sensors and devices. The company is involved in the manufacture of the navigation system 9B918 for the ballistic missile 9M723 “Iskander-M”, used by Russian forces in Russia’s war of aggression against Ukraine. Therefore, JSC Serpukhov Plant “Metallist” materially supports Russia’s military and industrial complex including by being involved in the development, production or supply of military technology and equipment." .
