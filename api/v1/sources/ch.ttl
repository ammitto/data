<https://www.ammitto.org/entity/ch/89540>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company Integral – “Integral” Holding Managing Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89540> ;
  ammitto:remarks "JSC Integral is a Belarusian manufacturer of semiconductors, integrated circuits and other high technology goods. Its products are purchased by Russian entities participating in Russia’s war of aggression against Ukraine (including Roscosmos, a Russian Government agency, Ulyanovsk Instrument Design Bureau and Radar MMS), and its products have been found in the battlefield. Such purchase orders are large and account for the vast majority of the company’s exports. Semiconductors are vital to Russia’s war effort and Russia has already invested USD 350 million in JSC Integral. Therefore, JSC Integral supports actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine, and supports and benefits from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/89540>
