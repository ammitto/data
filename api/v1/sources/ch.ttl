  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72580> ;
  ammitto:remarks "Valeriy Shatilo held the position of Director of OJSC 2566 Plant for the Repair of Radio-Electronic Weapons until February 2025. The enterprise specialises in the repair and modernisation of weapons and air defence equipment, as well as other complex radio-electronic equipment and military products. OJSC 2566 Radioelectronic Armament Repair Plant is providing maintenance and repair services to the Russian Armed Forces." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-03-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
