<https://www.ammitto.org/entity/ch/95826>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Ploshchad”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95826> ;
  ammitto:remarks "JSC “Ploshchad” is a Russian company specialised in the development and implementation of robotic systems which provides comprehensive solutions for unmanned aerial vehicles (UAVs). It is involved, together with KB Microb, in the design and manufacture of the FPV, Microb and Microb-10 UAVs which are used by the Russian Armed Forces in the context of Russia’s war of aggression against Ukraine. JSC “Ploshchad” is, in particular, responsible for the development of the target acquisition system of those UAVs." .
