<https://www.ammitto.org/entity/ch/55376>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Prigozhin Pavel Evgenevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55376> ;
  ammitto:remarks "Pavel Prigozhin is the son and primary heir of the late Yevgeniy Prigozhin, a leading Russian businessperson operating in Russia with close ties to the President of the Russian Federation Vladimir Putin and the Russian Ministry of Defence. Yevgeniy Prigozhin was the founder and unofficial head of the Wagner Group, a Russia-based unincorporated military entity responsible for the deployment of mercenaries in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1998-06-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1998"^^xsd:integer ] .
