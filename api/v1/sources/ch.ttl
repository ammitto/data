  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Research and Production Unitary Enterprise “Scientific and Technical Center ‘LEMT’ BelOMO”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
