<https://www.ammitto.org/entity/ch/57052>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OJSC V.A. Degtyarev Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/57052> ;
  ammitto:remarks "A defence company which provides weapons to the Russian Armed Forces. It manufactured Igla MANPADS, 9M119M “Refleks” and 9M120 “Ataka” missiles and 3UBK20 missile launchers that were used by the Russian Armed Forces during Russia’s war of aggression against Ukraine. The company continues to produce weapons for the war as evidenced by its participation in the ARMY 2022 forum in August 2022 and recent publications on its site." .
