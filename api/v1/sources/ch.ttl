<https://www.ammitto.org/entity/ch/101436>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Latortue Youri" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101436> ;
  ammitto:remarks "Youri Latortue is the founder of the political party “L’Ayiti an Aksyon” (AAA), a former senator of the Artibonite department, and a former advisor to the President Michel Martelly during his presidency (2011-2016). He also served as president of the Senate from 13 January 2017 to 9 January 2018." .
