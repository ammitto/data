<https://www.ammitto.org/entity/ch/46673>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Epikhau Siarhei Aliaksandravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/46673> ;
  ammitto:remarks "In his position as judge at the Minsk Regional Court, Siarhei Epikhau is responsible for politically motivated rulings against opposition leaders and activists, in particular the sentencing of Maria Kolesnikova and Maksim Znak, who are considered as political prisoners by human rights organisations. Violations of rights of defence and of the right to a fair trial were reported during trials conducted under his supervision. He is therefore responsible for serious human rights violations and for seriously undermining the rule of law, as well as for the repression of civil society and democratic opposition." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-05-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
