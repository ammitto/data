<https://www.ammitto.org/entity/ch/95520>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Plant of Special Equipment”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95520> ;
  ammitto:remarks "LLC “Plant of Special Equipment” is a military-industrial company that provides products and services (such as repair of radio-electronic products) for companies, including Roscosmos and Rostec, involved in the production of missile systems, air defence and space defence systems, artillery weapons and armoured vehicles. The company holds a licence related to the use of information constituting a State secret, as well as licences for maintenance and servicing of weapons and military equipment issued by the Ministry of Industry and Trade of the Russian Federation. Therefore, LLC “Plant of Special Equipment” is supporting materially Russia’s military and industrial complex, including by being involved in the development, production or supply of military technology and equipment." .
