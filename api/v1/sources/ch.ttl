<https://www.ammitto.org/entity/ch/71421>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC VMP AVITEK" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71421> ;
  ammitto:remarks "JSC VMP Avitek (a.k.a. Vyatka Machine-Building Enterprise Avitek) is a Russian military-industrial state enterprise that develops and produces surface-to-air anti-aircraft guided missiles deployed by the Russian Armed Forces. Additionally, JSC VMP Avitek develops and produces ejection seats for fighter jets deployed by the Russian Armed Forces. Notably, JSC VMP Avitek is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." .
