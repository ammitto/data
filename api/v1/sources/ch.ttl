  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Diosdado Cabello Rondón" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38404> ;
  ammitto:remarks "Minister of the Interior, Justice and Peace since August 2024. Member of the non-democratically elected National Assembly, former President of the Constituent Assembly and First Vice-President of the United Socialist Party of Venezuela (PSUV). Involved in undermining democracy and the rule of law in Venezuela and the repression of civil society and democratic opposition, including by using the media to publicly attack and threaten political opposition, other media and civil society and giving orders to detain individuals, including to the Bolivarian National Intelligence Service (SEBIN)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-04-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
