  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Voit Alexander Vyacheslavovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75456> ;
  ammitto:remarks "Alexander Voit is the General Director of Joint Stock Company “Ulyanovsk Instrument Design Bureau” (JSC UKBP), a Russian leading developer and manufacturer of airborne electronic equipment for aircraft and helicopters, automatic control systems for hydropower, automotive components and medical equipment." .
