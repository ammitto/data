<https://www.ammitto.org/entity/ch/73745>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC GosNIIP" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73745> ;
  ammitto:remarks "JSC GosNIIP (a.k.a. JSC State Scientific Research Institute of Instrument Making) is a Russian military-industrial state enterprise that develops, inter alia, control systems for anti-submarine and cruise missiles deployed by the Russian Armed Forces. Therefore, JSC GosNIIP is supporting materially and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
