<https://www.ammitto.org/entity/ch/104654>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Makarov Nikolay Andreevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104654> ;
  ammitto:remarks "Nikolai Makarov is the Director of the state-funded Federal State Budgetary Institution of Science “Institute of Archaeology of the Russian Academy of Sciences” (IA RAS) and Vice-President of the Russian Academy of Sciences. He is responsible for IA RAS’s scientific, technical, and economic operations, including its development strategy and fieldwork policy. Under his leadership, IA RAS has become a central actor in Russia’s state-directed archaeological exploitation of the occupied Crimean Peninsula." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-12-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
