<https://www.ammitto.org/entity/ch/98849>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Aviation Gearboxes and Transmissions – Perm Motors”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98849> ;
  ammitto:remarks "JSC “Aviation Gearboxes and Transmissions – Perm Motors” manufactures and services helicopter gearboxes and transmissions for helicopters, including the Mi-28n “night hunter”, Mi-8/17 and Mi-26 (T). The Mi-28n “night hunter” has been used by the Russian military in its war of aggression against Ukraine. The company is a part of the holding company “Russian Helicopters”, which is subject to Union restrictive measures." .
