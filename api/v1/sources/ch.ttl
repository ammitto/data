<https://www.ammitto.org/entity/ch/71957>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bragin Alexey Yurievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71957> ;
  ammitto:remarks "Alexey Bragin is the former Director of JSC RIRV (a.k.a. Russian Institute of Radio Navigation and Time). JSC RIRV was a Russian military-industrial state enterprise that develops navigation equipment for the Russian GLONASS system deployed by the Russian Armed Forces to conduct high-precision strikes on civilian and military infrastructure in Ukraine. It has merged with JSC “Obukhov Plant”, part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." .
