<https://www.ammitto.org/entity/ch/70715>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Foundation “Defenders of the Fatherland”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70715> ;
  ammitto:remarks "The Foundation “Defenders of the Fatherland” was founded by a decree of the President of the Russian Federation in April 2023 to aid Russian veterans of the war of aggression\nin Ukraine. The Foundation is funded by the Russian Government and the key staff are appointed directly by either the President of the Russian Federation Vladimir Putin or the Russian Government and is composed of prominent persons with close connections to President Vladimir Putin or the Kremlin." .
