  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sajida Khayrallah Tilfah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/1570> ;
  ammitto:remarks "Wife of Saddam Hussein (listed above). Sajida Khayrallah Tilfah is Saddam Hussein’s first wife and cousin who bore him five children (he currently has at least six children), including Qusay Saddam Hussein and Uday Saddam Hussein, both of whom occupied senior positions in the former Iraqi regime. She is Saddam Hussein’s only officially recognized wife (Saddam Hussein currently has at least two wives)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1937"^^xsd:integer ] .
