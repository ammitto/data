<https://www.ammitto.org/entity/ch/4603>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Navumau Uladzimir Uladzimiravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4603> ;
  ammitto:remarks "Failed to take action to investigate the case of the unresolved disappearances of Yuri Zakharenko, Viktor Gonchar, Anatoly Krasovski and Dmitri Zavadski in Belarus in 1999-2000. Former Minister of Internal Affairs and also former Head of the President’s Security Service. As a Minister of Internal Affairs he was responsible for the repression of peaceful demonstrations until his retirement on 6 April 2009 for health reasons." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1956-02-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1956"^^xsd:integer ] .
