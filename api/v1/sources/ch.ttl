<https://www.ammitto.org/entity/ch/70223>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Falaleev Andrey Pavlovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70223> ;
  ammitto:remarks "Andrey Falaleev is the rector of the V.I. Vernadsky Crimean Federal University. On 4 March 2022, following the beginning of Russia’s war of aggression against Ukraine, Andrey Falaleev, in his capacity as the rector of the University, signed a letter supporting the actions of the President of the Russian Federation Vladimir Putin. During Andrey Falaleev’s leadership at Vernadsky Crimean Federal University, an event called “Our Support to the Armed Forces of the Russian Ministry of Defence Participating in the Special Military Operation” took place. The main objective of the event was to share stories of the heroes of the special military operation and explore alternative ways to support the servicemen involved." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-02-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
