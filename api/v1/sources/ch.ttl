<https://www.ammitto.org/entity/ch/72390>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Open Joint Stock Company “State Airline ‘224th Flight Detachment’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72390> ;
  ammitto:remarks "The Open Joint Stock Company State Airline 224th Flight Detachment is a Russian state-owned enterprise, operating under the Russian Ministry of Defence for the purpose of providing commercial air cargo transport services, including of military cargo. It transports military technology and equipment, operating under the Ministry of Defence, and therefore supports in its actions Russia’s war of aggression against Ukraine. It is a subsidiary of JSC Garnizon, a company subsidiary to the Russian Ministry of Defence." .
