<https://www.ammitto.org/entity/ch/38146>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Boshab Evariste" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38146> ;
  ammitto:remarks "In his capacity as Vice Prime Minister and Minister of the Interior and Security from December 2014 to December 2016, Evariste Boshab was officially responsible for the police and security services and for coordinating the work of provincial governors. In this capacity, he was responsible for arrests of activists and opposition members, as well as for disproportionate use of force, including between September 2016 and December 2016 in response to demonstrations in Kinshasa, which resulted in a large number of civilians being killed or injured by security services." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1956-01-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1956"^^xsd:integer ] .
