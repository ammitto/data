  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Krupko Ivan Ivanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50512> ;
  ammitto:remarks "Ivan Ivanovich Krupko is the Chairman of the Gomel Regional Executive Committee. In this position, he is responsible for overseeing the interactions between local executive and administrative bodies of the region with military authorities, as well as implementing defence and state security issues. Joint Russian-Belarussian military exercises, which preceded the Russian military aggression against Ukraine, took place in the Gomel Region." ;
