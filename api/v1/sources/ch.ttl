<https://www.ammitto.org/entity/ch/72303>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company Sonatek" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72303> ;
  ammitto:remarks "LLC Sonatek is a Limited Liability Company in Russia, which provides supply and maintenance services to a significant number of Russian defence companies relevant for Russia’s efforts in continuing the war of aggression against Ukraine. While conducting its business activities, LLC Sonatek has been awarded and thus benefitted from numerous Russian government contracts." .
