<https://www.ammitto.org/entity/ch/70649>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tsargrad TV Channel" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70649> ;
  ammitto:remarks "Tsargrad TV is a Russian propagandist media outlet. It was established by Konstantin Malofeev, who supported the illegal annexation of Crimea and Sevastopol by the Russian Federation. Tsargrad TV spreads pro-Kremlin propaganda\nand disinformation on Russia’s war of aggression against Ukraine. Furthermore, it is promoting nationalistic view about the purported Russian character of the illegally occupied territories of Ukraine and justifying the illegal transportation of Ukrainian children to Russia and their subsequent adoption by Russian families. Tsargrad TV receives financial grants from the Government of the Russian Federation for its propaganda activities. Therefore, Tsargrad TV is supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
