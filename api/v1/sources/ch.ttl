<https://www.ammitto.org/entity/ch/72635>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sorokin Vladimir Alekseevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72635> ;
  ammitto:remarks "Vladimir Sorokin is the General Director of Iskra Engineering Design Bureau JSC named after I.I. Kartukov. The company is one of the leading producers of solid-fuelled rocket motors. The company has developed various solid propellant gas generators used in the mechanisms for deploying missile elements, for emergency landing gear release and for rapid start of turbojet engines. Since its foundation, the company has developed and delivered for supply more than 200 solid-propellant engines for anti-aircraft, tactical, aviation, naval and space missile systems for the Russian Ministry of Defence. Moreover, the company also ensures its compliances with the requirements for licensing in the field of weapons and military equipment and obtaining a state defence order." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1958-03-31"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1958"^^xsd:integer ] .
