<https://www.ammitto.org/entity/ch/101167>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kildiyarov Valery" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101167> ;
  ammitto:remarks "Valery Kildiyarov is a manager of Alghaf Marine DMCC, and the finance director of Litasco Middle East DMCC. Both companies supply significant volumes of Russian crude oil. The energy sector, in particular the oil sector, is a sector providing a substantial source of revenue to the Russian Government." .
