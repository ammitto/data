  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Burova Olga Vasilyevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95041> ;
  ammitto:remarks "Olga Burova has been the so-called “First Deputy Minister of Culture of the Republic of Crimea” since 15 May 2023. In that role, she has promoted Crimea as a centre of Russian culture and as a part of Russian history, and supported its illegal annexation by Russia in 2014." ;
