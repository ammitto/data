  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Avetisyan Vladimir Evgenievych" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104763> ;
  ammitto:remarks "Vladimir Evgenievych Avetisyan is a majority shareholder in and beneficial owner of several companies with business interests in various sectors of the Russian economy such as banking and, in particular, the energy sector. He is a majority shareholder in and the ultimate owner of “Srednevolzhskaya gazovaya kompaniya”, a provider of gas distribution through mains, which ranks 12th by revenue in this sector on the Russian market, and a majority shareholder and ultimate owner of Public Joint Stock Company “Samaraenergo”, a major electric energy producer and distributor. He is also a majority shareholder in and the ultimate owner of another company active in gas distribution “Samaragaz” and a minority shareholder in electricity transmission company “Samarskaya elektrosetevaya kompaniya”. Finally, he is a minority shareholder in and a member of the Board of Directors of Joint Stock Company “Gazbank”, which is active in the banking sector." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1958-04-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1958"^^xsd:integer ] .
