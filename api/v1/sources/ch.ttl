<https://www.ammitto.org/entity/ch/101873>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abu Zaid Talha Al-Misbah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101873> ;
  ammitto:remarks "Abu Zaid Talha Al-Misbah is the Commander of the Baraa bin Malik Battalion (BBMB), an Islamist militia fighting alongside the Sudanese Armed Forces (SAF) in the conflict between the SAF, the Rapid Support Forces (RSF) and their allied armed groups, which has been ongoing since 15 April 2023." .
