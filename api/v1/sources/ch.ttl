  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Scientific and Production Association ‘Pribor’ named after S.S. Golembiovsky”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
