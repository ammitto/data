<https://www.ammitto.org/entity/ch/70450>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "PJSC UEC-Saturn" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70450> ;
  ammitto:remarks "UEC-Saturn is a Russian military industry company. It manufactures engines for the Su-30, Su-35 and Su-57 military aircraft that are used by the Armed Forces of the Russian Federation in Russia’s war of aggression against Ukraine. Furthermore, it produces engines for the Kh-101 strategic air-to-ground cruise missiles that are employed by the Armed Forces of the Russian Federation in Ukraine." .
