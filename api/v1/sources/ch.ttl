<https://www.ammitto.org/entity/ch/13338>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Hajmoham-Madi Aziz" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13338> ;
  ammitto:remarks "Attorney in Tehran since 2020. Former judge at branch 71 of the Tehran Provincial Criminal Court. Working for the judiciary since 1971, he has been involved in several trials of demonstrators, including that of Abdol-Reza Ghanbari, a teacher arrested in January 2010 and sentenced to death for his political activities. He has a track record of human rights violations, including the issuing of inhumane sentences, death sentences and prison sentences for political prisoners." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1948"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/13338>
