  ammitto:remarks "Aleksandra Melnichenko is the wife of Andrey Melnichenko, a Russian industrialist who transferred his effective ownership and benefit of the major fertiliser producer EuroChem Group and the coal company SUEK to her on 9 March 2022." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-04-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
