  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Boltenko Nadezhda Nikolaevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98190> ;
  ammitto:remarks "Nadezhda Boltenko is the Commissioner for Children’s Rights in the Novosibirsk Region. In that role, she has been involved in the illegal transportation of Ukrainian children to Russia and is actively supporting their adoption by Russian families. She is also involved in the organisation and the promotion of so-called “recreational camps” where Ukrainian children taken from illegally occupied territories of Ukraine receive Russian patriotic education." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1957-01-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1957"^^xsd:integer ] .
