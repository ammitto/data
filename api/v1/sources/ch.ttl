<https://www.ammitto.org/entity/ch/86050>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Potekhin Fedor Fedorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86050> ;
  ammitto:remarks "Fedor Potekhin is the General Director of LLC Gumich RTK, a producer of Impulse-M robot platforms, which are intended to be used in Russia’s war of aggression against Ukraine and have already been tested on the field by Russian Armed Forces as of summer 2024. As the General Director of LLC Gumich RTK, Fedor Potekhin is therefore supporting or implementing actions which threaten the territorial integrity of Ukraine. Furthermore, he is associated with LLC Gumich RTK." .
