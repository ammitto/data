<https://www.ammitto.org/entity/ch/27292>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Konstantinov Vladimir Andreevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/27292> ;
  ammitto:remarks "As speaker of the Supreme Council of the Autonomous “Republic of Crimea”, Vladimir Konstantinov played a relevant role in the decisions taken by the “Supreme Council” concerning the “referendum” against territorial integrity of Ukraine and called on voters to cast their votes in favour of Crimean independence in the “referendum” of 16 March 2014. He was one of the co-signatories of the “treaty on Crimea’s accession to the Russian Federation” of 18 March 2014." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1956-11-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1956"^^xsd:integer ] .
