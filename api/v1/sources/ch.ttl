  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60836> ;
  ammitto:remarks "Ramil Ibatullin is a Russian military leader, and Commander of the 2nd Guards Combined Arms Red Banner Army." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-10-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
