<https://www.ammitto.org/entity/ch/27302>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Berezovskiy Denis Valentinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/27302> ;
  ammitto:remarks "Berezovskiy was appointed commander of the Ukrainian Navy on 1 Mar 2014 but thereafter swore an oath to the Crimean armed forces, thereby breaking his oath to the Ukrainian Navy." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-07-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
