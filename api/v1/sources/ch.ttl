  ammitto:rawSourceData [ a ammitto:RawSourceData ; ammitto:sourceFormat "xml" ; ammitto:sourceSpecificFields """{"ch:ssid":"95365","ch:sanctions_set_id":"27286"}""" ] .
<https://www.ammitto.org/entity/ch/95378>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Inroel”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95378> ;
  ammitto:remarks "LLC “Inroel” provides metal processing services to companies in the Russian defence sector, including several companies who have been subject to Union restrictive measures for manufacturing weapons systems used by the Russian Armed Forces in Russia’s war of aggression against Ukraine. Customers of LLC “Inroel” include JSC Concern VKO Almaz-Antey, JSC “Equality”, LLC “Special Technology Center”, JSC “Radio Engineering Equipment Plant”, JSC Concern “Granit-Electron” and JSC “Plant named after A.A. Kulakov”. The main website of LLC “Inroel” also identifies the defence industry complex as one of the sectors placing orders with the company." .
