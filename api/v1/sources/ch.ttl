<https://www.ammitto.org/entity/ch/51394>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Guryev Andrey Andreevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51394> ;
  ammitto:remarks "Andrey Guryev is a shareholder of PJSC PhosAgro; a Member of the Bureau of the Board of the Russian Union of Industrialists and Entrepreneurs (RSPP); the head of the RSPP Committee on Corporate Social Responsibility and Sustainable Development, an organisation representing the interests of business circles, including in the fertilizers sector, in Russia and internationally; and President of the Russian Association of Fertilizer Producers, an organisation established by the largest Russian producers of mineral fertilizers to promote their interests in Russia and internationally. He is also involved in AgroGard, a Russian agricultural holding, through a trust investing in the company." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-03-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
