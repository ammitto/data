<https://www.ammitto.org/entity/ch/73107>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Krivoruchko Alexei Yuryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73107> ;
  ammitto:remarks "Alexei Krivoruchko is a Russian military figure and manager. He is the Deputy Defence Minister of the Russian Federation responsible for logistics, technical support and arms purchases for the Russian Armed Forces. Accordingly, he is responsible for Russia’s war of aggression against Ukraine. He is also a Board Member of Tactical Missiles Corporation, a supplier of weapons to the Ministry of Defence of the Russian Federation under a state defence order. He is also a Supervisory Board Member of Promsvyazbank PJSC, a state-owned bank which operates in the Crimea." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-07-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
