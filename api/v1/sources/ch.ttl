  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sibanda Phillip Valerio" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
