  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Yevtushenko Oleg Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107733> ;
  ammitto:remarks "Oleg Yevtushenko has been the Executive Director of Rostec State Corporation since 2018. Rostec is the most important defence corporation in Russia, made up of the main companies of Russia’s military and industrial complex. Therefore, Oleg Yevtushenko is supporting Russia’s military and industrial complex." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-11-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
