<https://www.ammitto.org/entity/ch/71990>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Medunitsin Nikolay Borisovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71990> ;
  ammitto:remarks "Nikolai Medunitsin is the Director of JSC NIIP (a.k.a. Tikhomirov Scientific Research Institute of Instrument Design). JSC NIIP is a Russian military-industrial state enterprise. JSC NIIP produces medium-range anti-aircraft missile systems for the Russian ground forces, including the Buk-M1, Buk-M2E and Buk-M1-2 missile systems, as well as weapons control systems and aviation radar systems for fighter aircraft, including the MiG-31, Su-27, Su-33, Su-30MKK, Su-30MK2, Su-30MKI, Su-27SM and Su-35 aircraft, deployed by the Russian Armed Forces. Moreover, JSC NIIP is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-10-31"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
