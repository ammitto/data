<https://www.ammitto.org/entity/ch/70253>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "PMC Convoy" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70253> ;
  ammitto:remarks "Private Military Company Convoy (“PMC Convoy”) is a Russia-based unincorporated private military entity, which reportedly works under the command of the Ministry of Defence of the Russian Federation. It is based in illegally annexed Crimea and operates under the control of the socalled “Head” of the so-called “Republic of Crimea”, Sergey Aksyonov." .
