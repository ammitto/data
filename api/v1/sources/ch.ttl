<https://www.ammitto.org/entity/ch/107232>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “ASFPV”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107232> ;
  ammitto:remarks "Limited Liability Company “ASFPV” is a Russian company that manufactures the First Person View (FPV) drones “Veterok 7”, “Veterok 10”, and “Veterok 13”, drone detectors “Gorn”, and fibre–optic cable spools for the Russian Armed Forces. The company manufactures up to 10 000 drones monthly. “Veterok” drones are used by Russia in its war of aggression against Ukraine." .
