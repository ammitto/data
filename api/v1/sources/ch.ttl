<https://www.ammitto.org/entity/ch/92776>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Zagorsk Optical and Mechanical Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92776> ;
  ammitto:remarks "JSC “Zagorsk Optical and Mechanical Plant” (JSC ZOMZ) is a Russian military industry entity. JSC ZOMZ manufactures optical devices, including binoculars and thermal imagers, and components for military products. JSC ZOMZ is part of the State-owned military industry entity JSC “Shvabe”, ultimately part of the State Corporation Rostec, and provides products incorporated into equipment used by the Russian military. JSC ZOMZ is therefore supporting Russia’s military and industrial complex and the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/92776>
