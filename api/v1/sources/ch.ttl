  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “SKF Arktika”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
