  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mlechka Andrey Viktaravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77780> ;
  ammitto:remarks "Andrey Mlechka is a judge who has served in the Frunze District Court of the City of Minsk since 2021, having been appointed by Aliaksandr Lukashenka. He has issued high politically motivated sentences against citizens peacefully expressing critical opinions of the authorities on the streets and on the internet." .
