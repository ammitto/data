<https://www.ammitto.org/entity/ch/88923>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company NPO “Orion”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88923> ;
  ammitto:remarks "JSC NPO Orion is a Russian research and manufacturing company, which is developing and producing high-tech electronical components, including for the development of the Russian military-industrial complex. It belongs to the holding JSC Shvabe, which provides manufactured optical and laser systems to the Russian Armed Forces, which are used in the war of aggression against Ukraine. Therefore, JSC NPO Orion is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine. Furthermore, JSC NPO Orion is associated with JSC Shvabe, which is responsible for supporting materially actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
