<https://www.ammitto.org/entity/ch/72760>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mishunin Pavel Anatolyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72760> ;
  ammitto:remarks "Pavel Mishunin is the General Director of the Federal State Enterprise Aleksin Chemical Plant, which is a Russian enterprise that produces a range of industrial chemicals used in the manufacture of gunpowder and weapons charges. FSE Aleksin Chemical Plant supplies state-owned plants that produce gunpowder, cartridges and ammunition for the Russian Armed Forces. FSE Aleksin Chemical Plant is a major producer and supplier of chemical materials of strategic importance to the Russian defence sector." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-06-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
