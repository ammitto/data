<https://www.ammitto.org/entity/ch/50762>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tokarev Nikolay Petrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50762> ;
  ammitto:remarks "Nikolay Tokarev is CEO of Transneft, major Russian oil and gas company. He is Vladimir Putin’s long-time acquaintance and close associate. He served together with Putin in the KGB in 1980s. Nikolay Tokarev is one of the Russian state oligarchs who assumed control over large state assets in the 2000s as President Putin consolidated power, and who operate in close partnership with the Russian state. Nikolay Tokarev has been in charge of Transneft, one of Russia’s most important government-controlled companies, which transports a considerable amount of Russian oil through a well-developed oil pipelines network." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1950-12-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1950"^^xsd:integer ] .
