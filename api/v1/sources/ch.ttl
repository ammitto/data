  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OJSC Arsenal Machine-Building Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72028> ;
  ammitto:remarks "OJSC Machine-Building Plant Arsenal is a Russian military industry company. It fulfils Russian state defence orders and is engaged in the production of Lotos reconnaissance satellites and AK-176M naval guns. Lotos is used by the Russian Armed Forces in the war of aggression against Ukraine for target identification and AK-176M naval guns are installed in the Russian Navy ships that shell Ukrainian troops." .
