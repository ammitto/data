<https://www.ammitto.org/entity/ch/96721>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Alkhaleej Bank Co Ltd" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/96721> ;
  ammitto:remarks "Alkhaleej Bank Co Ltd (“Alkhaleej”) plays an essential role in the Rapid Support Forces’ (RSF) efforts to finance its own operations, complicating efforts to stop the fighting in Sudan. Alkhaleej is largely owned by companies linked to family members of RSF Commander Mohamed Hamdan Dagalo (Hemedti) and is therefore considered to be controlled by the RSF." .
<https://www.ammitto.org/entry/ch/consolidated-list/96721>
