<https://www.ammitto.org/entity/ch/98812>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Public Joint Stock Company “Far Eastern Shipping Company”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98812> ;
  ammitto:remarks "PJSC “Far Eastern Shipping Company” (FESCO) is one of Russia’s largest transportation and logistics firms, and the largest port container operator in the Russian Far East. The company specialises in container shipping, port operations, and intermodal transport across sea, rail and road. Its core operations are concentrated in the Russian Far East, with key assets including the Commercial Port of Vladivostok and a fleet of 30 vessels. The company plays a vital role in connecting Russia with Asia and the Middle East, offering services for general, chemical and petroleum cargo." .
