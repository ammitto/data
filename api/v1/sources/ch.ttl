  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nikiforova Victoria" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55329> ;
  ammitto:remarks "Victoria Nikiforova is a Russian propagandist and columnist at RIA Novosti, a Russian State-owned domestic news agency under the effective State control of Rossiya Segodnya. She is a central figure in Government propaganda and has denied Ukraine's right to exist, as well as the ability of the Ukrainian people to decide for itself. She describes the Ukrainian people as “brainwashed” and “taken hostage” and thus promotes a positive attitude towards the Russian aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1971-06-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
