  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77874> ;
  ammitto:remarks "Stanislau Ivaniutsenka is a judge who has served in the the court of the Rechitsa district of the Gomel region since 2019, having been appointed by Aliaksandr Lukashenka. He has issued politically motivated sentences against citizens of Belarus who voiced their opinions against the President and the brutality of Belarusian law-enforcement structures. He ruled on the case of Polina Sharendo, a social activist from Belarus, who was detained in January 2021." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-07-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
