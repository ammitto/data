<https://www.ammitto.org/entity/ch/71656>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Razdolye Implementation Center LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71656> ;
  ammitto:remarks "Razdolye Implementation Center LLC is a Russian IT company that develops products for the Russian military-industrial complex. In particular, Razdolye Implementation Center LLC develops enterprise resource planning and automation software for Morinformsystem Agat JSC, PJSC United Engine Corporation, JSC Tactical Missile Weapons Corporation, JSC Almaz-Antey Air and Space Defence Corporation, JSC Ratep, PJSC “Scientific and Production Association ‘Almaz’ named after Academician A.A. Raspletin”, PJSC Stavropol Radio Plant “Signal”, and Production Association Strela. Automation software developed and implemented by Razdolye Implementation Center LLC is used by Russian weapons manufacturers to execute state defence orders and reduce production costs." .
<https://www.ammitto.org/entry/ch/consolidated-list/71656>
  a ammitto:SanctionEntry ;
