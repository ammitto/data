<https://www.ammitto.org/entity/ch/98904>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Prom Composite Limited Liability Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98904> ;
  ammitto:remarks "Prom Composite LLC is a Russian company developing and producing unmanned aerial vehicles (UAVs). Its portfolio includes UAV models such as UAV-KT “Lisa”, UAV-KT “Volk”, first-person view (FPV) UAV “Dozor” and FPV UAV “Vespa”, as well as large radar domes. Those products support both civilian and military applications, reflecting Prom Composite LLC’s dual-use profile." .
