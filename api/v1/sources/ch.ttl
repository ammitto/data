<https://www.ammitto.org/entity/ch/94544>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Furtună Victoria" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94544> ;
  ammitto:remarks "Victoria Furtună is a politician from the Republic of Moldova who has received significant support from Ilan Shor and the Victory/Pobeda Political Bloc, which is the successor of the outlawed ȘOR political party, led by Ilan Shor. In particular, during the 2024 Presidential election, members of the Victory/Pobeda Political Bloc were encouraged to vote for Victoria Furtună, including through bribing schemes. Moreover, in breach of electoral laws prohibiting campaigning during the day of the elections, listed person Ilan Shor and his associates instructed their supporters to vote for Victoria Furtună." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1981-02-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1981"^^xsd:integer ] .
