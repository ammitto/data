<https://www.ammitto.org/entity/ch/75311>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Novaport Holding" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75311> ;
  ammitto:remarks "Novaport Holding is a Russian transport company which operates regional airports, and which holds interests in the operation of several other airports. Various airports owned and operated by Novaport Holding are in shared use by the Russian Air Force. In particular, commercial flights are being operated to Simferopol in illegally annexed Crimea from the Pskow airport which is owned by Novaport. Novaport thus supports the Russian Government in providing logistical infrastructure for the Russian Air Force and undermines the territorial integrity of Ukraine by promoting flights between its airports and airports in illegally annexed Crimea." .
