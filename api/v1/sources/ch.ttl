  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72007> ;
  ammitto:remarks "Gennady Svetlov is the Director of JSC RPTP Granit (a.k.a. Ryazan Production and Technical Enterprise Granit). JSC RPTP Granit is a Russian military-industrial state enterprise that conducts maintenance and testing of weapons systems, including the S-400 Triumf and S-300 missile systems, deployed by the Russian Armed Forces. Moreover, JSC RPTP Granit is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1958-01-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1958"^^xsd:integer ] .
