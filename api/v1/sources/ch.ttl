<https://www.ammitto.org/entity/ch/46809>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "VIP Grub" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/46809> ;
  ammitto:remarks "VIP Grub is a passport and visa service based in Istanbul, Turkey, which organises trips to Belarus with the explicit intention of facilitating migration to the Union. VIP Grub actively advertises migration to the Union. VIP Grub therefore contributes to activities by the Lukashenka regime that facilitate the illegal crossing of the external borders of the Union." .
