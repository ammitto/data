<https://www.ammitto.org/entity/ch/42957>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Elvis Eduardo Hidrobo Amoroso" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/42957> ;
  ammitto:remarks "President of the National Electoral Commission of Venezuela (CNE) since 24 August 2023. Former Comptroller-General (between 23 October 2018 and August 2023), and former First and Second Vice-President of the non-recognised National Constituent Assembly (ANC). His actions have undermined democracy and the rule of law in Venezuela, including by banning opposition members from holding public office for 15 years and leading the non-recognised ANC, signing the “law against hatred”, justifying the removal of a legally-elected opposition governor, banning Juan Guaidó from running for any public office, and announcing the results of the Presidential election held in July 2024, without the CNE under his leadership publishing the official voting records of polling stations." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-08-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
