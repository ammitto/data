<https://www.ammitto.org/entity/ch/60993>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "195 Repair Plant of Rocket and Artillery Weapons" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60993> ;
  ammitto:remarks "“195 Repair Plant of Rocket and Artillery Weapons” is a Russian military-industrial enterprise that repairs and maintains military products that are used by the Russian armed forces during Russia’s war of aggression against Ukraine. The company holds licences provided by the Russian government to “develop and repair weapons and military equipment” and describes itself as offering “repair and maintenance services for ships” of the Russian Federation Navy." .
