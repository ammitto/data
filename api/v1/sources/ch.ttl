<https://www.ammitto.org/entity/ch/88955>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Alabuga Machinery”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88955> ;
  ammitto:remarks "LLC Alabuga Machinery is a Russian producer of machine tools and gears. It is also a 100 % subsidiary of LLC Alabuga Development, which is a 100 % subsidiary of JSC Alabuga (subject to Union restrictive measures since 18 December 2023). JSC Alabuga is therefore the ultimate beneficial owner of LLC Alabuga Machinery." .
