<https://www.ammitto.org/entity/ch/107772>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tikmenov Vasiliy Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107772> ;
  ammitto:remarks "Vasiliy Tikmenov is the head of the Joint Stock Company Scientific and Technical Center Elins (“JSC ‘STC Elins’”), which is an integral part of the military-industrial complex of the Russian Federation. JSC “STC Elins” produces weapons and ammunition, is involved in the production of electronic components and electronic circuit boards, manufactures computers, radio and television transmitting equipment, instruments and devices for measuring, testing and navigation, wires and cables for electronic and electrical equipment, develops computer software and provides research & development in the field of natural and technical sciences etc. Therefore, JSC “STC Elins” plays a significant role in the fulfilment of state defence orders during Russia’s invasion of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1950-10-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1950"^^xsd:integer ] .
