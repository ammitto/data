<https://www.ammitto.org/entity/ch/51408>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Konov Dmitry Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51408> ;
  ammitto:remarks "Dmitry Konov is the former Chairman of the Management Board of PJSC SIBUR Holding, and in that capacity oversaw the company’s activities. SIBUR Holding is the largest integrated petrochemicals company in Russia and one of the fastest-growing companies in the global petrochemicals industry. SIBUR is a leading emerging markets petrochemical group and the largest petrochemical producer in the Russian market. Majority stakes in SIBUR are owned by leading businesspersons close to the President of the Russian Federation, Vladimir Putin, namely Leonid Mikhelson and Gennady Timchenko. Between 2017 and 2020, Dmitry Konov was ranked among the 200 wealthiest individuals in Russia." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-09-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
