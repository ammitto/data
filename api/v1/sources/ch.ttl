<https://www.ammitto.org/entity/ch/51018>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gas Industry Insurance Company SOGAZ" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51018> ;
  ammitto:remarks "Joint stock company “Gas Industry Insurance Company SOGAZ” insured the construction of the railway infrastructure connecting the bridge over the Kerch Strait and the Port of Taman and reinsured the construction of the bridge over the Kerch Strait. Therefore, it supported the consolidation of the illegally annexed Crimean Peninsula into the Russian Federation, which in turn further undermined the territorial integrity, sovereignty and independence of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/51018>
  a ammitto:SanctionEntry ;
