<https://www.ammitto.org/entity/ch/85679>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Kaluga Research Institute of Radio Engineering”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85679> ;
  ammitto:remarks "JSC “Kaluga Research Institute of Radio Engineering” (JSC KNIRTI) is one of the main military-industrial companies in the Kaluga region. Among other activities, it researches, develops and produces navigational, meteorological, geodetic and geophysical instruments, and radar, radio navigation equipment and radio remote control equipment, including Khibiny, an electronic warfare system for fighter jets used in Russia’s war of aggression against Ukraine." .
