<https://www.ammitto.org/entity/ch/39984>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tun Naing" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/39984> ;
  ammitto:remarks "Tun Naing is the Commanding Officer of the Border Guard Police (BGP) base in Taung Bazar. In that capacity, he is responsible for the atrocities and serious human rights violations against the Rohingya population in Rakhine State committed by the BGP in Taung Bazar before, around and after 25 Aug 2017, including forced detention, ill-treatment and torture." .
