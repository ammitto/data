<https://www.ammitto.org/entity/ch/39445>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "AO \"Institute Giprostroymost — Saint-Petersburg\"" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/39445> ;
  ammitto:remarks "AO “Institute Giprostroymost – Saint-Petersburg” participated in the construction of the Kerch Bridge through its design of the Bridge, connecting Russia to the illegally annexed Crimean peninsula. Therefore it is supporting the consolidation of the illegally annexed Crimean peninsula into the Russian Federation, which in turn further undermines the territorial integrity, sovereignty and independence of Ukraine." .
