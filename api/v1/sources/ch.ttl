<https://www.ammitto.org/entity/ch/77763>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sotnikau Anatoliy Ryhoravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77763> ;
  ammitto:remarks "Anatoliy Sotnikau is a judge who has served in the Homel Regional Court since 2019, having been appointed by Aliaksandr Lukashenka. He has issued politically motivated sentences against citizens of Belarus who voiced their opinions against Russia’s full-scale war of aggression against Ukraine and the brutality of Belarusian law-enforcement structures." .
