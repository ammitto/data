  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Central research radiotechnical institute named after academian A.I. Berg”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104995> ;
  ammitto:remarks "Joint Stock Company “Central research radiotechnical institute named after academian A.I. Berg” is a Russian company which plays a central role in the research, development, and production of radio electronic equipment for aviation, ground-based and space-based electronic reconnaissance and electronic warfare. This involves, in particular, developing specific protection system for Russian military aircrafts." .
