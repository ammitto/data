<https://www.ammitto.org/entity/ch/52958>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ayziman Olga" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52958> ;
  ammitto:remarks "Olga Ayziman is the ex-wife of Mikhail Fridman, founder and one of the main shareholders of the Alfa Group, which includes the major Russian bank Alfa Bank, considered as a top Russian financier and enabler of President Vladimir Putin’s inner circle. Mikhail Fridman is the major sponsor of his ex-wife’s activities and needs since she moved to Paris." ;
