<https://www.ammitto.org/entity/ch/56998>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ryzhkov Sergey Borissovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56998> ;
  ammitto:remarks "Major General of the Russian armed forces and Commander of the 41st Combined Arms Army. As such, he is a key figure in Russia’s order of battle and has played a central role in the invasion and occupation of Ukrainian territory. In this role, he is responsible for the Russian war effort at large." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-10-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
