<https://www.ammitto.org/entity/ch/85708>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Federal State Enterprise “Kamensky ‘Combine’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85708> ;
  ammitto:remarks "FSE “Kamensky ‘Combine’” is a chemical plant, mainly producing special-purpose chemical products for Russia’s military industry, which produces weapons used by the Russian military. It is state-owned through Rostec (State Corporation for the Promotion of the Development, Manufacture and Export of High-Tech Products). It holds patents for technologies related to rockets and explosives. FSE “Kamensky ‘Combine’” has been involved in the implementation of the Russian state defence orders and since 2022 the volume of state defence orders it receives has increased significantly. FSE “Kamensky ‘Combine’” therefore materially supports actions which undermine the territorial integrity, sovereignty and independence of Ukraine." .
