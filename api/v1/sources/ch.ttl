<https://www.ammitto.org/entity/ch/72408>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Isaev Yuri Konstantinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72408> ;
  ammitto:remarks "Yuri Isaev is a General Director in the Russian military industry company Temp-Avia. The company is specialised in producing navigation and automatic control systems, inertial control systems, inertial measurement units, gyrostabilisers, primary information sensors, attitude indicators and integrated backup flight navigation instrument systems. The contracting parties are other Russian military industry companies and the Russian Government itself. In particular, Temp-Avia produces basic attitude indicator AGB-96, which is used on Mi-8 helicopters of the Russian Armed Forces deployed in the war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
