<https://www.ammitto.org/entity/ch/60654>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Lipetsk Mechanical Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60654> ;
  ammitto:remarks "Lipetsk Mechanical Plant is a Russian military industry company. It provides weapons to the Armed Forces of the Russian Federation. It manufactured self-propelled tracked chassis for the S-300V4 surface-toair missile systems that were used by the Armed Forces of the Russian Federation during Russia’s war of aggression against Ukraine." .
