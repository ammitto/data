  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72040> ;
  ammitto:remarks "Igor Makushev is a high-ranking official in the Russian military and Director of JSC MAK Vympel. JSC MAK Vympel (a.k.a. Public Joint Stock Company Vympel Interstate Corporation) is a Russian military-industrial state enterprise that develops antiballistic missile systems and space control systems deployed by the Russian Armed Forces. Moreover, JSC MAK Vympel is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1964-08-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
