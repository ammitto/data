<https://www.ammitto.org/entity/ch/4610>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sivakau Iury Leanidavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4610> ;
  ammitto:remarks "Orchestrated the unresolved disappearances of Yuri Zakharenko, Viktor Gonchar, Anatoly Krasovski and Dmitri Zavadski in Belarus in 1999-2000. Former Minister of Tourism and Sports, former Minister of Internal Affairs and former Deputy Head of the Presidential Administration." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1946-08-05"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1946"^^xsd:integer ] .
