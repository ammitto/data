<https://www.ammitto.org/entity/ch/63184>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Desyatova Natalya Leonidovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63184> ;
  ammitto:remarks "Natalya Desyatova was appointed in Jul 2022 as the director of the Kherson Fine Arts Museum by the Russian authorities. When Kherson was still under the control of the Russian Armed Forces, the cultural property of the Kherson Fine Arts Museum was removed from the museum in Oct and Nov 2022 and taken illegally to Simferopol, in illegally annexed Crimea. This was done under Desyatova’s control and with the assistance of Russian security forces." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-07-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
