<https://www.ammitto.org/entity/ch/60856>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Shvabe”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60856> ;
  ammitto:remarks "JSC Shvabe (Shvabe), a holding firm owned by Rostec, specialises in research into and the mass manufacture of optical and laser systems and complexes. Shvabe connects a number of industrial sites and research institutions around Russia, forming the backbone of the country's optical sector. The Shvabe holding carries out the complete cycle of developing cutting-edge optoelectronic and laser technology for Russia's national security. Shvabe also produces and develops optoelectronic and laser systems for the Russian Federation's armed forces." .
