<https://www.ammitto.org/entity/ch/75683>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Solin Anatoliy" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75683> ;
  ammitto:remarks "Anatoliy Solin is a judge of the Military Court of Appeal of the Russian Federation. In his position, he took multiple politically motivated decisions against opponents of the illegal annexation of Crimea and Sevastopol, as well as decisions based on religious grounds. In particular, Anatoliy Solin prosecuted Amet Suleymanov and other political prisoners. He is therefore supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
