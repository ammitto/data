<https://www.ammitto.org/entity/ch/9309>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mobin Sanjesh" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/9309> ;
  ammitto:remarks "Mobin Sanjesh directly participates in Iran’s proliferation-sensitive nuclear activities. It provides goods and services for magnetic systems which have a direct application in Iran’s nuclear fuel cycle industry, for example calibration of mass spectrometers." .
