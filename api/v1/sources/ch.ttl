<https://www.ammitto.org/entity/ch/50968>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sychevoy Andrey Ivanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50968> ;
  ammitto:remarks "Andrey Sychevoy is Lieutenant General and on 24 February 2022 he was Commander of the 8th Guards Combined Arms Army of the Southern Military District, which has been involved in military actions against Ukraine. In July 2022 he was named as commander of Russia’s group of forces “Zapad” operating in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-05-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
