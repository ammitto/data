<https://www.ammitto.org/entity/ch/5284>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zhukouski Siarhei Kanstantsinavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/5284> ;
  ammitto:remarks "Deputy Prosecutor of the Zavodskoi District of Minsk dealing with the case of Khalip Irina, Martselev Sergei, Severinets Pavel, outstanding civil society representatives. The accusation presented by him had a clear and imminent political motivation and was a clear violation of the Code of Criminal Procedure. It was based on an incorrect classification of the events of 19 Dec 2010, and not sustained by evidences, proofs or testimonies of witnesses." .
