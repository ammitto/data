<https://www.ammitto.org/entity/ch/4679>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Utsiuryn Andrei Aliaksandravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4679> ;
  ammitto:remarks "Deputy Head of the Security Council of the Republic of Belarus (since 2014). Former Head of the Security Service of the President. Under his supervision, several members of his service took part in interrogations of political activists after the demonstrations on 19 Dec 2010." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
