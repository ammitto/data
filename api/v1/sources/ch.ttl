<https://www.ammitto.org/entity/ch/73129>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kazazaev Andrey Petrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73129> ;
  ammitto:remarks "Andrey Kazazaev is the General Director of OJSC Plant named after V.A. Degtyarev. He is responsible for the fulfilment of Russian state defence orders for arms used by the Russian Armed Forces during Russia’s war of aggression against Ukraine. As the General Director of the company, he publicly supports the ongoing Russian aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1964-11-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
