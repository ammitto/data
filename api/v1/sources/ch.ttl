<https://www.ammitto.org/entity/ch/76093>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OJSC Ural Airlines" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/76093> ;
  ammitto:remarks "Ural Airlines is a civil Russian airline. Since the start of Russia’s war of aggression against Ukraine, Ural Airlines has provided logistical support, in particular by transporting military personnel towards the war zone during the mobilisation phase. In this capacity, Ural Airlines also established a special ticket-selling scheme with the Russian Ministry of Defence. Ural Airlines is supporting materially and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
