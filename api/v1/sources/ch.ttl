<https://www.ammitto.org/entity/ch/86943>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tkachenko Nikolay Vitalyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86943> ;
  ammitto:remarks "Nikolay Tkachenko is a the general manager of Gazstroyprom JSC. Gazstroyprom JSC is a leading company in the Russian energy sector, which carries out different projects for the extraction, processing and transportation of natural gas. The company employs 95 000 people and is active in all federal districts of the Russian Federation. The energy sector, especially oil, provides substantial revenues to the Government of the Russian Federation.Therefore, Nikolay Tkachenko is associated with a company involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation, which is responsible for the illegal annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-08-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
