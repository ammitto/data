<https://www.ammitto.org/entity/ch/51369>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Moshkovich Vadim Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51369> ;
  ammitto:remarks "Vadim Moshkovich is a Russian entrepreneur with business interests in agriculture and real-estate development. In 2004, Vadim Moshkovich founded Rusagro Group, which is a major producer of pork, fats and sugar, rated first among agricultural holdings in 2021 in Russia. Vadim Moshkovich is therefore a businessperson involved in economic sectors providing a substantial source of revenue to the Government of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1967-04-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
