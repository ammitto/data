<https://www.ammitto.org/entity/ch/44845>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Thein Soe" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/44845> ;
  ammitto:remarks "Thein Soe was nominated as chairman of the Union Election Commission (UEC) on 2 Feb 2021. By accepting this nomination in the aftermath of the military coup of 1 Feb 2021, and through his actions as chairman of the UEC, notably the cancelling of the results of the elections without any proven evidence of frauds, Thein Soe has been directly involved in actions undermining democracy and the rule of law in Myanmar." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1952-01-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1952"^^xsd:integer ] .
