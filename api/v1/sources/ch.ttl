  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63374> ;
  ammitto:remarks "Anton Zlatopolskiy is the First Deputy Director General of All-Russia Television and Radio Broadcasting Company (VGTRK), Russia’s largest media corporation. He is also a long-term Director General of Rossiya 1 TV Channel. During the war of aggression against Ukraine, TV channels and other parts of the VGTRK holding have been among the most active and important instruments in spreading the Kremlin’s narrative and supporting the war with aggressive commentaries and unverified information." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-09-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
