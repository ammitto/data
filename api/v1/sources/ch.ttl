<https://www.ammitto.org/entity/ch/71293>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Corşicova Arina Evgheni" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71293> ;
  ammitto:remarks "Arina Corșicova has led several communications media trusts in the Republic of Moldova, one of which owns two television channels, “Accent TV” and “Primul în Moldova”, the broadcasting licences of which were suspended by the Republic of Moldova, for disseminating incorrect information concerning the Russian war of aggression against Ukraine and current political events in the Republic of Moldova. Despite losing its television broadcasting licence, “Primul în Moldova” continues to disseminate false statements aimed at destabilising the constitutional order of the Republic of Moldova." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-12-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/71293>
