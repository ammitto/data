<https://www.ammitto.org/entity/ch/85023>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bregan Yauheni Anatolevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85023> ;
  ammitto:remarks "Yauheni Bregan is a Belarusian judge of the Brest Regional Court. He was appointed by Aliaksandr Lukashenka. He was formerly a judge of the Moskovsky District Court of Brest and judge of the city of Baranovichi in the Brest region. He issued sentences against a large number of citizens of Belarus accused, amongst other things, of having taken part in the protests against the Belarusian regime in August 2020." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-03-26"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
