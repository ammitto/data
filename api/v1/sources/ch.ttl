  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/40037> ;
  ammitto:remarks "Leading businessperson operating in Syria linked to the former al-Assad regime, with interests and activities in multiple sectors of Syria’s economy. Samer Foz provides financial and other support to the former al-Assad regime, including funding the Military Security Shield Forces in Syria and brokering grain deals. He also benefits financially from access to commercial opportunities through the wheat trade and reconstruction projects as a result of his links to the former regime." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1973-05-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1973"^^xsd:integer ] .
