  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dolina Larisa Aleksandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86847> ;
  ammitto:remarks "Larisa Dolina is a Russian singer and actress. Since the beginning of the Russian war of aggression against Ukraine, Dolina has frequently supported Russia’s actions which threaten the territorial integrity, sovereignty and independence of Ukraine. To that end, Dolina has worked with the Russian Ministry of Defence and led entertainment campaigns on behalf of the Russian Government to reward Russian military personnel for their participation in the Russian war of aggression against Ukraine. She moreover gave public concerts in the Russian occupied Donbass region in coordination with the Russian Government." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-09-10"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
