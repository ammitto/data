<https://www.ammitto.org/entity/ch/105256>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Raw Materials Cellulose LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105256> ;
  ammitto:remarks "Raw Materials Cellulose LLC is an Uzbek company producing cotton pulp. Raw Materials Cellulose LLC supplies cotton pulp to Russian military-industrial companies, including the FSE Tambov Gunpowder Plant, which use it to produce gunpowder. Therefore, Raw Materials Cellulose LLC is supporting Russia’s military and industrial complex by being involved in supply of military technology and equipment." .
