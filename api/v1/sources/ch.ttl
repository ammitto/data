<https://www.ammitto.org/entity/ch/99010>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chinaoil (Hong Kong) Corporation Limited" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/99010> ;
  ammitto:remarks "Chinaoil (Hong Kong) Corporation Limited is a Chinese company based in Hong Kong. It is a significant buyer of crude oil products of Russian origin. The energy sector, in particular the oil sector, is a sector providing substantial revenue to the Russian Government. Therefore, Chinaoil (Hong Kong) Corporation Limited is involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation." .
<https://www.ammitto.org/entry/ch/consolidated-list/99010>
