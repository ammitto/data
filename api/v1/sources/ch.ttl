<https://www.ammitto.org/entity/ch/89068>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Oko Design Bureau" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89068> ;
  ammitto:remarks "Oko Design Bureau is a company created in 2022 which produces two kinds of drones named Privet-82 and Privet-120. Privet-82 drones were introduced in the frontline of war in Ukraine to the Russian Army units in the first half of 2023 and have been widely used in combat since then. Privet-82 drones produced by Oko Design Bureau have received full support from the Russian Ministry of Defence and have completed all tests. Oko Design Bureau participated in the Army2023 Forum presenting its products." .
