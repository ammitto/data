<https://www.ammitto.org/entity/ch/58325>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ANO TV-Novosti" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/58325> ;
  ammitto:remarks "TV-Novosti is a Russian-government-linked media organisation. It is funded from the federal budget of the Russian Federation. Through its subordinate media outlets, including RT, it has consistently spread pro-Kremlin propaganda and disinformation, and supported Russia’s war of aggression against Ukraine. Through its content, RT spreads false narratives of the Russian regime to undermine Ukraine and is thus supporting a large-scale disinformation campaign to erode international support for Ukraine." .
