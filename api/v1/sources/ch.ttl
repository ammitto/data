<https://www.ammitto.org/entity/ch/71323>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Petrov Victor" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71323> ;
  ammitto:remarks "Victor Petrov is a deputy to the bashkan of the People’s Assembly of Gagauzia and the leader of the People’s Union of Gagauzia, a manifestly pro-Russian socio-political movement that merged with the “Renaștere” political party. He receives political backing from listed person Ilan Shor." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-06-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
