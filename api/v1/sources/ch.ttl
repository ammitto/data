  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Moroz Aleksandr Ivanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/76301> ;
  ammitto:remarks "Aleksandr Moroz is the General Director of the Belarusian Optical-Mechanical Association “BelOMO”. He was appointed by President Lukashenko. BelOMO is a state-owned enterprise that operates in the defence sector in Belarus, producing and selling optical sights for small arms, including telescopic sights and optical sights with illuminated reticles." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-06-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
