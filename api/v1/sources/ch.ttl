<https://www.ammitto.org/entity/ch/107442>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Albatross Shipmanagement LLC-FZ" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107442> ;
  ammitto:remarks "Albatross Shipmanagement LLC-FZ is a shipping company based in the United Arab Emirates and the technical manager of the vessels Zaliv Aniva, Zaliv Baikal and Zaliv Vostok. Those vessels lack adequate liability insurance and engage in manipulation of Automatic Identification Systems while transporting crude oil or petroleum products exported from Russia. Therefore, Albatross Shipmanagement LLC-FZ manages vessels that transport crude oil or petroleum products exported from Russia and practice irregular and high-risk shipping practices as set out in the International Maritime Organization General Assembly resolution A.1192(33)." .
