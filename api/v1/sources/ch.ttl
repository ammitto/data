<https://www.ammitto.org/entity/ch/77812>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zhuk Dzmitry Aliaksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77812> ;
  ammitto:remarks "Dzmitry Zhuk is a long-time supporter of Aliaksandr Lukashenka and his regime. He was previously the head of Lukashenka’s press service and a long-time director-general of the biggest State news agency, Belarusian Telegraph Agency (BelTA)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-07-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
