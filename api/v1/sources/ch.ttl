<https://www.ammitto.org/entity/ch/28777>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Suhayl Hassan" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/28777> ;
  ammitto:remarks "Officer of the rank of Major-General in the Syrian Army under the former al-Assad regime after May 2011. Commander of army division known as “Tiger Forces”. Since August 2019, “Tiger Forces” has been renamed “Division 25 Special Mission Forces” and placed under the army’s central command. Responsible for the violent repression of the civilian population in Syria." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-06-10"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
