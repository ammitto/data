<https://www.ammitto.org/entity/ch/93533>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Morozova Elena Alexandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93533> ;
  ammitto:remarks "Elena Morozova is the Director of the State Museum-Preserve “Tauric Chersonese”, a museum operating in Sevastopol. Since the annexation of Crimea, the museum has actively undermined Ukrainian cultural heritage by promoting pro-Russian narratives regarding the cultural significance of the artefacts and excavation sites it administers. Following Russia’s full-scale invasion of Ukraine, the museum has used its platform to promote the invasion and the actors perpetrating it, including organising deliveries of supplies to the frontlines. Therefore, Elena Morozova is responsible for actions or policies which undermine or threaten the territorial integrity, sovereignty and independence of Ukraine, or stability or security in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-02-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/93533>
  a ammitto:SanctionEntry ;
