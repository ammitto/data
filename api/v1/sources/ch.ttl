<https://www.ammitto.org/entity/ch/105194>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kapysh Vladimir Petrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105194> ;
  ammitto:remarks "Vladimir Kapysh is the General Director of Siber AO, which is a part of Rostec. Siber AO provides security services for strategic Russian military and industrial companies, including JSC Uralvagonzavod Concern, JSC Shvabe, JSC High-Precision Systems Research and Production Association, JSC Spetskhimiya, JSC NPK Tekhmash, JSC Izhevsk Mechanical Plant, JSC Kalashnikov Concern, JSC KBAL and Rostec. Siber AO also cooperates with the Federal Security Service of the Russian Federation (FSB) in evaluating organisations’ eligibility for obtaining licenses from FSB for work involving the use of state secrets." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-11-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
