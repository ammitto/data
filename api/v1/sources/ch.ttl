  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Fishelev Oleg Igorevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107722> ;
  ammitto:remarks "Oleg Fishelev is the owner of LLC Unimatik. LLC Unimatik is a Russian manufacturer, importer and wholesaler of computer numerical control (CNC) machines, and related parts which it provides to Russian defence companies, using also its subsidiary, LLC Unimatik MSK. Unimatik has supplied JSC “Plant No. 9”, JSC “Uralvagonzavod”, JSC “Almaz-Antey”, JSC “Corporation Tactical Missile Weapons”, among others." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1986-11-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1986"^^xsd:integer ] .
