  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shagiakhmetov Ilshat Ilgizovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95051> ;
  ammitto:remarks "Ilshat Shagiakhmetov is the General Director of the Territorial Development Fund, a public law company operating under the Ministry of Construction of the Russian Federation and founded by the Government of the Russian Federation. In particular, the Territorial Development Fund manages the so-called free economic zone in the illegally occupied territories of Donetsk, Luhansk, Kherson and Zaporizhzhia, which was created by the Government of the Russian Federation to grant benefits and privileges to companies that operate in those illegally occupied territories." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-06-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
