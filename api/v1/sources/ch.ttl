<https://www.ammitto.org/entity/ch/86586>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "UralDronZavod" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86586> ;
  ammitto:remarks "UralDronZavod is a newly created company that arose as a start-up during Russia’s war of aggression against Ukraine. The company produces an FPV drone called “Upyr” (“Ghoul”) which has been widely in use since autumn of 2023 during the invasion of Ukraine. The company has received full support from the Russian Ministry of Defence and other state agencies and is currently producing drones on the Russian Government’s orders. The company and its manager and creator have gained attention from President Putin himself. UralDronZavod is constantly developing and upgrading its flagship drone “Upyr” based on experience collected on the battlefield. The drone has repeatedly been successfully used against the Ukrainian Army." .
<https://www.ammitto.org/entry/ch/consolidated-list/86586>
