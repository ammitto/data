<https://www.ammitto.org/entity/ch/55505>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nizhnekamsk All-Steel Tyre Plant, LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55505> ;
  ammitto:remarks "Nizhnekamsk All-Steel Tyre Plant produces all-steel tyres. It was a subordinate company of Tatneft. Its products are supplied to the Ministry of Defence of the Russian Federation. On 1 June 2022, Nizhnekamsk All-Steel Tyre Plant was sold to JSC Tatneftekhiminvest-holding. The sale also included MC Tatneft-Neftekhim, Trade House Kama, Nizhnekamskshina among others." .
