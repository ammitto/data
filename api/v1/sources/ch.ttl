<https://www.ammitto.org/entity/ch/45600>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gusachenka Siarhei Aliaksandravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45600> ;
  ammitto:remarks "In his position as the First Deputy Chairman of Belteleradio Company (the National State Television and Radio Company), author and host of weekly propaganda television show “Glavnyy efir”, Siarhei Gusachenka has been willingly providing the Belarusian public with false information about the outcome of elections, protests, repressions perpetrated by the state authorities and activities of the Lukashenka regime that facilitate illegal crossing of the external borders of the Union. He is directly responsible for the way in which the state television presents information about the situation in the country, thus lending support to the authorities including Lukashenka." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1983-11-05"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1983"^^xsd:integer ] .
