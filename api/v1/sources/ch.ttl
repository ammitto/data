<https://www.ammitto.org/entity/ch/75205>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Egorov Oleg Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75205> ;
  ammitto:remarks "Oleg Egorov is a judge of the Military Court of Appeal of the Russian Federation. In his position, he took multiple politically motivated decisions against opponents of the illegal annexation of Crimea and Sevastopol, as well as decisions based on religious grounds. In particular, Oleg Egorov prosecuted Rustem Seytmemetov, Osman Seytumerov, Seytumer Seytumerov and other political prisoners. Oleg Egorov is therefore supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
