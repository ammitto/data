<https://www.ammitto.org/entity/ch/13317>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tala Hossein" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13317> ;
  ammitto:remarks "Mayor of Eslamshahr until 2020. Former Iranian MP. Former Governor-General (\"Farmandar\") of Tehran Province until Sep 2010, he was responsible for the intervention of police forces and therefore for the repression of demonstrations. He received a prize in Dec 2010 for his role in the post-election repression." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
