  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint-Stock Company “Optical-Mechanical Design Bureau ‘Astron’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105279> ;
  ammitto:remarks "JSC OKB “ASTRON” is a Russian company which developed and now manufactures reconnaissance systems with intelligent analytics “Blockpost-4T”, reconnaissance drone UAV400T, capable of ammunition drop and reconnaissance-attack UAV “Kurs-800 TB” and FPV attack drones “Granat-KOBE” and “Granat PG”, all of which are used in Russia’s war of aggression against Ukraine. JSC OKB “ASTRON” is part of the Shvabe holding of Rostec State Corporation." .
