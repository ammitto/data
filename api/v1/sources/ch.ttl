<https://www.ammitto.org/entity/ch/72853>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lukin Sergey Anatolyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72853> ;
  ammitto:remarks "Sergey Lukin is the General Director of JSC Tula Cartridge Plant, which is a Russian enterprise that produces and distributes cartridges for various types of weapons used by the Russian Armed Forces. The plant is a leading supplier of ammunition for the Russian law enforcement agencies, including the National Guard and the Ministry of the Interior. JSC Tula Cartridge Plant offers a wide range of cartridges of various caliber used by the Russian Armed Forces. The plant operates in a strategically important sector of the military industry and its activities directly enhance the Russian military’s fighting capabilities." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1983-09-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1983"^^xsd:integer ] .
