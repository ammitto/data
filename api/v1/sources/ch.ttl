<https://www.ammitto.org/entity/ch/46272>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bayardo Arce Castaño" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/46272> ;
  ammitto:remarks "In his position as Economic Advisor to President Daniel Ortega, Bayardo Arce Castano holds significant influence over the policies of the Ortega regime. He is therefore associated with persons responsible for serious violations of human rights in Nicaragua. He supported the development of legislation preventing opposition candidates from taking part in elections. He is therefore responsible for repression against civil society and democratic opposition in Nicaragua." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1950-03-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1950"^^xsd:integer ] .
