  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pishgaman Tejarat Rafi Novin Co." ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101772> ;
  ammitto:remarks "Pishgaman Tejarat Rafi Novin Co. is a private company with links to entities involved in Iran’s missile programme. Pishgaman Tejarat Rafi Novin Co. has procured significant amounts of ammonium perchlorate, a key propellant for solid-fuel missiles, from foreign suppliers for Iran’s missile programme. Pishgaman Tejarat Rafi Novin Co. is therefore involved in Iran’s missile programme." .
