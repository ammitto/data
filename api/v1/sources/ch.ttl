  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Vladimirov Vladimir Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63625> ;
  ammitto:remarks "Vladimir Vladimirov is the Governor of the Stavropol Krai. In this role, he has been responsible for the illegal deportation of Ukrainian children to the Stavropol Krai region for their subsequent illegal adoption by Russian families. His actions violate the rights of Ukrainian children and infringe Ukraine’s law and administrative order." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-10-14"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
