<https://www.ammitto.org/entity/ch/72513>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Petrov Sergei Valentinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72513> ;
  ammitto:remarks "Sergei Petrov is the CEO and owner of PSV Technologies LLC. PSV Technologies LLC is a Russian entity involved in the procurement of high-tech goods on behalf of the Government of the Russian Federation. The entity functions as a supplier in at least 10 contracts with the Russian Government, which includes contracts with leading state owned weapons manufacturers within Russia’s military-industrial complex. In particular, PSV Technologies LLC facilitates the acquisition of sanctioned dual-use and military goods from the European Union on behalf of Russian state-owned weapons manufacturers." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-04-26"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
