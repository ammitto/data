  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Latypov Nail Shavketovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73022> ;
  ammitto:remarks "Nail Latypov is the Director of JSC Kazan Experimental Design Bureau Soyuz. JSC Kazan Experimental Design Bureau Soyuz is a Russian military-industrial state enterprise that develops solid propellant rocket engines for missile systems deployed by the Russian Armed Forces. Moreover, JSC Kazan Experimental Design Bureau Soyuz is part of the Joint Stock Company Almaz-Antey air and space defence corporation, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1953-01-10"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1953"^^xsd:integer ] .
