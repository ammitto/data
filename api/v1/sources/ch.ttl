<https://www.ammitto.org/entity/ch/89508>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Asteis”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89508> ;
  ammitto:remarks "JSC Asteis is a developer and producer of special purpose vehicles. The company is one of the largest manufacturers of chassis-mounted special equipment for civil and military purposes in Russia. JSC Asteis manufactures and supplies vehicles (including Patrol-IV armoured vehicle (Asteis 70202)) used by the Russian military in Russia’s war of aggression against Ukraine. JSC Asteis therefore supports actions that undermine the territorial integrity, sovereignty and independence of Ukraine. By supplying armoured vehicles to the Russian military units (in particular to the units of the military police and to the motorised rifle units), JSC Asteis also supports and benefits from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/89508>
  a ammitto:SanctionEntry ;
