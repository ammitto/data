  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shin Geum Cheol" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88536> ;
  ammitto:remarks "Shin Geum Cheol is the Head of the Main Operational Directorate of the General Staff of the Korean People’s Army of the Democratic People’s Republic of Korea. He is a high-level military officer overseeing the practical conduct of operations, such as military coordination. He is tasked with disseminating Russian and modern warfare tactics, such as drone operations, artillery tactics and electronic warfare technologies, to the North Korean army." .
