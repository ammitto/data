<https://www.ammitto.org/entity/ch/72297>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Non-governmental organisation “Delfini”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72297> ;
  ammitto:remarks "Delfini is a non-governmental organisation in the Republic of Belarus founded by Olga Volkova, who is one of the main actors involved in the deportation of Ukrainian children from the illegally occupied territories of Ukraine to Belarus. Olga Volkova and the Delfini organisation have coordinated the movement of multiple groups of children from Ukraine to Belarus and been involved in subjecting children to re-education and military training. Therefore, the Delfini organisation is supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine, and stability and security in Ukraine." .
