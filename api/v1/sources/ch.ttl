<https://www.ammitto.org/entity/ch/88481>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mokeev Sergey Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88481> ;
  ammitto:remarks "Sergey Mokeev is the General Director of JSC Novo-Vyatka. JSC Novo-Vyatka, by being a manufacturer of weapons and ammunition, is an entity of the Russian military-industrial complex. In 2023 and 2024, JSC Novo-Vyatka received state subsidies under a programme designed to finance training of military industry workers of selected entities. By being the General Director of JSC Novo-Vyatka, Sergey Mokeev is responsible for the company’s actions. Therefore, Sergey Mokeev supports and benefits from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
