<https://www.ammitto.org/entity/ch/101981>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Faizullahi Ahmad Ali" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101981> ;
  ammitto:remarks "Ahmad Ali Faizullahi is the Commander of the Islamic Revolutionary Guard Corps (IRGC) Saberin Takavar Special Forces Brigade, an elite special operations force within the Ground Forces of the IRGC. The Saberin Takavar Special Forces Brigade has been directly involved in the violent suppression of protests in Iran and in committing serious human rights violations, including in relation to the nationwide protests in Iran that began in December 2025." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
