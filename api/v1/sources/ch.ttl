  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shved Andrei Ivanavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4749> ;
  ammitto:remarks "Head of the State Committee of Legal Expertise. Former Deputy Head of the Investigation Committee and former Deputy Prosecutor General and Head of the Investigation Department. Upon request of the KGB, he initiated in 2011 the investigation of the case of Ales Byaliatski, one of the most prominent human rights defenders, Chief of the Belarusian Human Rights Centre \"Vyasna\", Vice President of FIDH. A. Byalyatski was active in defending and providing assistance to those who suffered from repression in relation to the 19 Dec 2010 elections and the repression of civil society and of the democratic opposition in Belarus." .
