<https://www.ammitto.org/entity/ch/78540>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Teyf Tadbir Engineering Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/78540> ;
  ammitto:remarks "Teyf Tadbir Engineering Company is an Iranian procurement firm. Its CEO is EU-listed Hossein Hatefi Ardakani, an Iranian businessman who oversees a transnational procurement network for unmanned aerial vehicle (UAV) components. He operates through his Tehran-based firms, including Teyf Tadbir Engineering Company and the EU-listed Kavan Electronics LLC." .
