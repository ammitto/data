  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Leshchenko Yan Vitalyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88548> ;
  ammitto:remarks "Yan Leshchenko is a deputy of the so-called “People’s Council” of the so-called “Luhansk People’s Republic”. Leshchenko is also the regional coordinator of the actions of Russia’s war of aggression against Ukraine in the occupied territory of Luhansk. He has supported the war in actions and in public statements, including supporting specific attacks by Russia on Ukrainian territory." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-09-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
