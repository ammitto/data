<https://www.ammitto.org/entity/ch/56377>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "The Alexander Gorchakov Public Diplomacy Fund" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56377> ;
  ammitto:remarks "The Alexander Gorchakov Public Diplomacy Fund was established in 2010 by the Russian President Dmitry Medvedev. The founder of the Fund was the Russian Ministry of Foreign Affairs and the current Minister of Foreign Affairs is the head of the board of trustees. The Ministry funds the work of the Gorchakov Fund, which in turn grants funding to think tanks and GONGOs." .
