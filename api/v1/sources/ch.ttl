  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Admiral Group" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95768> ;
  ammitto:remarks "Admiral Group is a Dubai-based shipping company, led by Hossein Shamkhani. He uses the company to transport and sell Russian crude oil. Therefore, Admiral Group is involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine. Furthermore, Admiral Group is associated with its Director, Hossein Shamkhani." .
