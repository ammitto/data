  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “41 Central Plant of Railway Equipment”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93705> ;
  ammitto:remarks "JSC “41 Central Plant of Railway Equipment” is a Russian military industry company that manufactures and supplies mobile repair complexes for the Ministry of Defence of Russia. It is specialised in providing equipment for the Railway Troops of the Russian Armed Forces. JSC “41 Central Plant of Railway Equipment” is therefore supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
