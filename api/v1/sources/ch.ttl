<https://www.ammitto.org/entity/ch/89169>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Antsev Ivan Georgyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89169> ;
  ammitto:remarks "Ivan Antsev is the Executive Director of JSC NPP Radar MMS, which produces unmanned aerial systems in Russia. Some of those systems include non-military drones, also made available to Russian armed forces for use in the context of Russia’s war of aggression against Ukraine. JSC NPP Radar MMS works under Russian government contracts and cooperates with the military-defence industry. As the Executive Director of JSC NPP Radar MMS, Ivan Antsev has ultimate executive control over that work." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-08-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
