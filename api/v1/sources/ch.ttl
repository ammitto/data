  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104972> ;
  ammitto:remarks "Timur Yunusov is a Russian singer and entrepreneur. He supports Russia’s war of aggression against Ukraine by spreading Kremlin propaganda narratives and symbols of the so-called “special military operation” and declaring his readiness to personally fight against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1983-08-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1983"^^xsd:integer ] .
