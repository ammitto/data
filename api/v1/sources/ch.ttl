  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kerimov Suleyman Abusaidovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52383> ;
  ammitto:remarks "Suleyman Kerimov is a leading Russian businessperson and member of the Federation Council of the Federal Assembly of the Russian Federation and of the Committee on the Rules of Procedure and Parliamentary Governance. He is former owner of the financial and industrial group Nafta Moscow. The net worth of Kerimov and his family is estimated at USD 16,4  billion. He received large sums of money from Sergei Roldugin, who is the caretaker of the wealth of the President of the Russian Federation Vladimir Putin." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-03-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
