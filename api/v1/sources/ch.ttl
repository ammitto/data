<https://www.ammitto.org/entity/ch/93313>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "State Museum-Preserve “Tauric Chersonese”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93313> ;
  ammitto:remarks "The State Museum-Preserve “Tauric Chersonese” is a museum operating in Sevastopol. Since the annexation of Crimea, the museum has actively undermined Ukrainian cultural heritage by promoting pro-Russian narratives regarding the cultural significance of the artefacts and excavation sites it administers. Following Russia’s full-scale invasion of Ukraine, the museum has used its platform to promote the invasion and the actors perpetrating it, including organising deliveries of supplies to the frontlines. Therefore, the State Museum-Preserve “Tauric Chersonese” is responsible for actions or policies which undermine or threaten the territorial integrity, sovereignty and independence of Ukraine, or stability or security in Ukraine." .
