  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ivanova Elena Sergeevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72912> ;
  ammitto:remarks "Elena Ivanova is General Director at the Russian military-industrial-complex company JSC Central Research Institute of Materials Named After D.I. Mendeleev that oversees the research and development of military technologies and owns several production facilities that play an important role in deploying such technologies, in particular in combat operations on the territory of Ukraine. Elena Ivanova has personally worked on and led projects that improved various pieces of military equipment including fighter jet SU-57, tank T-14, main tank armament 2A46M and self-propelled artillery 2S35." .
