  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Zelenograd Nanotechnology Center”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89096> ;
  ammitto:remarks "JSC Zelenograd Nanotechnology Center is a Russian research and manufacturing company which is developing and producing high-tech electronical components, including for the development of the Russian military-industrial complex. It is operating in the Special Economic Zone “Technopolis Moscow”. For companies operating in that special economic zone, the Russian Government offers a special tax regime, which encompasses a lower income tax and no property tax, transport tax or customs duties. The company benefits from operating in a privileged environment offered by the Russian Government. Therefore, JSC Zelenograd Nanotechnology Center is benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/89096>
  a ammitto:SanctionEntry ;
