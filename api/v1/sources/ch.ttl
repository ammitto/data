<https://www.ammitto.org/entity/ch/85648>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Biagun Vasili Vasilievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85648> ;
  ammitto:remarks "Vasily Biagun is a Belarusian judge who has served in the Gomel Regional Court since 2003. He was appointed by Aliaksandr Lukashenka. Biagun issued numerous rulings against opponents of the Belarusian authorities, including sentences against individuals for their activity on social media. He also issued politically motivated prison sentences against Nikita Slepenka (3 years) and Pavel Bobchenko (2 years)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-12-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
