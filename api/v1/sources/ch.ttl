<https://www.ammitto.org/entity/ch/55461>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "INDEPENDENT INSURANCE GROUP" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55461> ;
  ammitto:remarks "Independent Insurance Group Ltd is an insurer of Russian defence industry companies. It is included on the list of insurers who render insurance services for the international shipment of military goods. It cooperates with and insures Russian State-owned companies, especially in the military and defence sector. Independent Insurance Group Ltd has been the main risk insurer of Rostec, the Russian State-owned defence conglomerate. The company is among the sponsors and participants of the International Military-Technical Forum “Army2022”, organised by the Ministry of Defence of the Russian Federation. It confirms its close connections to the defence sector on its website." .
<https://www.ammitto.org/entry/ch/consolidated-list/55461>
