<https://www.ammitto.org/entity/ch/89323>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Novo-Vyatka”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89323> ;
  ammitto:remarks "JSC Novo-Vyatka is a manufacturer of weapons and ammunition and therefore part of the Russian military-industrial complex. In 2023 and 2024, JSC Novo-Vyatka received state subsidies under a programme designed to finance training of military industry workers of selected entities. JSC Novo-Vyatka therefore materially supports and benefits from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
