<https://www.ammitto.org/entity/ch/62615>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shor Ilan Mironovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/62615> ;
  ammitto:remarks "Ilan Shor is a Moldovan politician (leader of the ȘOR political party) and businessman from the Republic of Moldova who is involved in the illegal financing of political parties in the Republic of Moldova and in incitement to violence against the political opposition. Before being declared unconstitutional in June 2023, the ȘOR Party, which Ilan Shor leads, was involved in the payment and training of persons in order to provoke disorder and unrest during the protests in the Republic of Moldova." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1987-03-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1987"^^xsd:integer ] .
