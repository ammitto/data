  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61217> ;
  ammitto:remarks "Kirill Vyshinsky is a Russian propagandist. He is an executive director of the Rossiya Segodnya, a Russian government-linked media group which is funded from the federal budget of the Russian Federation. Through its subordinate media outlet, Sputnik, Rossiya\nSegodnya spread pro-Kremlin propaganda and disinformation on Russia’s war of aggression against Ukraine. Kirill Vyshinsky is also a member of the Presidential Council for Civil Society and Human Rights." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1967-02-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
