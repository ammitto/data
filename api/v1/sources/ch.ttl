  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tauber Marina" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/62643> ;
  ammitto:remarks "Marina Tauber is the deputy leader of Ilan Shor’s ȘOR political party and a Member of the Parliament of the Republic of Moldova. She was charged in the “Bank Fraud” case and she is subject to investigation in two criminal cases in the Republic of Moldova related to the illegal financing from an organised criminal group and the falsification of the report on the financial management of the ȘOR Party." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1986-05-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1986"^^xsd:integer ] .
