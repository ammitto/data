<https://www.ammitto.org/entity/ch/56980>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pankov Nikolay Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56980> ;
  ammitto:remarks "Former Deputy Minister of Defence, general of the Russian army reserve and state secretary of the Russian Federation. He ranked fifth in the overall hierarchy of the Russian military leadership. Given his key position in Russia’s military enterprise, he has been responsible for the Russian war effort at large. He has been involved in the deployment of troops to Ukraine. Additionally, he has openly supported and justified Russia’s war of aggression against Ukraine in his public appearances. He has also awarded Russian paratroopers with awards for their participation in Russia’s war of aggression against Ukraine. Those actions demonstrate that he actively supports and defends Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1954-12-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
