  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Peftsieu Uladzimir Paulavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/5300> ;
