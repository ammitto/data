<https://www.ammitto.org/entity/ch/75632>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mezentsev Dmitriy Fedorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75632> ;
  ammitto:remarks "Dmitriy Mezentsev is the Presidential Representative in the Constitutional Court of the Russian Federation and the former State Secretary of the Union State of Russia and Belarus. In his role as the State Secretary of the Union State of Russia and Belarus, Mezentsev contributed to the illegal deportation and adoption of Ukrainian children. He facilitated the unlawful deportation to Belarus and re-education of Ukrainian children. The activities pursued by Mezentsev are part of a broader strategy of the Russian Federation to illegally deport Ukrainian citizens, in which the Republic of Belarus is complicit. Since its war of aggression against Ukraine, Russia has transferred many Ukrainian civilians to Russian-occupied areas, to Russia itself and to Belarus, while often denying or impeding those civilians from having safe passage to government-held parts of Ukraine. Mezentsev is one of the senior leaders involved in the forcible deportation and abduction of Ukrainian children to Belarus. Mezentsev’s actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-08-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
