<https://www.ammitto.org/entity/ch/71730>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC NMZ" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71730> ;
  ammitto:remarks "JSC NMZ (a.k.a. Nizhny Novgorod Machine-Building Plant) is a Russian military-industrial state enterprise that develops artillery systems and missile systems, including the S-300 anti-aircraft missile systems, deployed by the Russian Armed Forces. Moreover, JSC NMZ is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." .
