<https://www.ammitto.org/entity/ch/4482>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Miklashevich Piotr Piatrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4482> ;
  ammitto:remarks "Head of the Constitutional Court and former Prosecutor General who has been active in the repression of civil society and of the democratic opposition. In his previous capacity, he was one of the main persons involved in the repression of the democratic opposition and of civil society from 2004 to 2008. Since his appointment to the Constitutional Court in 2008, he has faithfully implemented the repressive policies of the regime and has validated repressive laws even when they violated the constitution." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1954-10-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
