<https://www.ammitto.org/entity/ch/69787>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Muraveiko Pavel Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69787> ;
  ammitto:remarks "Pavel Muraveiko is the First Deputy Secretary of State of the Security Council of the Republic of Belarus. In his position, he oversees the actions of the Security Council, including military-technical cooperation between Belarus and Russia. The Security Council of the Republic of Belarus is the constitutional, supreme collective coordinating and political body that enforces the powers of the President of the Republic of Belarus. The new Concept of National Security of the Security Council provides for the development of a regional grouping of forces of the Republic of Belarus and the Russian Federation, increasing the effectiveness of military command and control bodies. The military-technical cooperation contributes to strengthening the military capabilities of Russia, which is carrying out a war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1971-09-26"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
