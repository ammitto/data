  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rusakevich Uladzimir Vasilievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4429> ;
  ammitto:remarks "Has actively undermined democracy in Belarus. As a former Minister of Information, he was the main person responsible for the pressure and repression of the independent media and journalists between 2003 and 2009." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1947-09-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1947"^^xsd:integer ] .
