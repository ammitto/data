  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52310> ;
  ammitto:remarks "Alexander Shokhin is the president of the Russian Union of Industrialists and Entrepreneurs (RSPP) – a lobby group, which promotes the interests of business in Russia. He also chairs the Coordinating Council on Import Substitution and Technological Independence of RSPP. He is former Deputy Chairman of Mechel PAO’s Board of Directors – one of the leading Russian mining and metals companies, which generates a source of revenue for the Government of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1951-12-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1951"^^xsd:integer ] .
