<https://www.ammitto.org/entity/ch/77901>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kriakvin Aliaksei Iurievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77901> ;
  ammitto:remarks "Aliaksei Kriakvin is a propagandist for the State-owned ONT TV channel and is engaged in the production of propaganda material in support of the Lukashenka regime. In particular, he was directly involved in the work on ONT’s “special investigation” about the criminal case of Viktor Babariko, in which data from the preliminary investigation were disclosed. He appears in television programmes, regularly criticising the actions of opponents of the Lukashenka regime and talking about the involvement of the West in popular unrest in Belarus. He is therefore supporting the Lukashenka regime." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1984-11-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1984"^^xsd:integer ] .
