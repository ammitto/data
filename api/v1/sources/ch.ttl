  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Shipping Company Lyukstrans" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
