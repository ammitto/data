  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88507> ;
  ammitto:remarks "Lee Chang Ho coordinated North Korean soldiers deployed on the battlefield in Ukraine, who may have been given tasks related to irregular guerrilla warfare. Thus, he was involved in the participation of North Korean soldiers in the war against Ukraine. He has led cyber-attack units such as Lazarus and Kim Suki." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
