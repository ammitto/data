<https://www.ammitto.org/entity/ch/13305>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Omidi Mehrdad" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13305> ;
  ammitto:remarks "Head of section VI of the police, investigation department. Former Head of the Intelligence Services within the Iranian Police. Former Head of the Computer Crimes Unit of the Iranian Police. He was responsible for thousands of investigations and indictments of reformists and political opponents using the Internet. He was thus responsible for grave human rights violations in the repression of persons who speak out in defence of their legitimate rights, including freedom of expression during and after the 2009 Green Movement." .
<https://www.ammitto.org/entry/ch/consolidated-list/13305>
