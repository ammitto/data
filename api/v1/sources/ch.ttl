<https://www.ammitto.org/entity/ch/107698>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shenzhen Minghuaxin" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107698> ;
  ammitto:remarks "Shenzhen Minghuaxin is a Chinese company supplying the Russian military and industrial complex. Shenzhen Minghuaxin has supplied significant volumes of components to Rustakt LLC, a Russian producer of military grade first-person-view drones. Therefore, Shenzhen Minghuaxin supports Russia’s military and industrial complex by being involved in the supply of military technology and equipment. Moreover, Shenzhen Minghuaxin is associated with Rustakt LLC." .
