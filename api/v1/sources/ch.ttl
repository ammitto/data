<https://www.ammitto.org/entity/ch/69999>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Davidovich Leonid Vyacheslavovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69999> ;
  ammitto:remarks "Leonid Davidovich is the Commander of the 61st air base and the Baranovichi garrison, in which the Russian Federation trains its soldiers. Over the course of Russia’s war in Ukraine, citizens have noticed military cargo deliveries and fighter jets flying to and from the Baranovichi garrison. People who have tried to oppose that military training and transportation of military cargo have been called “railway partisans”, been arrested, and been named extremists and traitors. Moreover, there have been reports that Baranovichi garrison has been used to launch rockets to Ukraine. Therefore, Leonid Davidovich is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-01-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/69999>
