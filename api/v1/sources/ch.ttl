<https://www.ammitto.org/entity/ch/55388>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Volozh Arkady Yurievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55388> ;
  ammitto:remarks "Arkady Volozh is a Russian businessperson with business interests in IT and technology. He is the founder and former CEO of Yandex, having resigned following his listing by the European Union. He is a major shareholder of Yandex, the largest Internet company in Russia, operating Russia’s most popular search engine. Yandex operates in the ICT sector, which brings considerable tax revenue to the Government of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1964-02-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
