<https://www.ammitto.org/entity/ch/89567>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Morion”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89567> ;
  ammitto:remarks "JSC Morion is a leading Russian enterprise in the development and serial production of piezoelectric frequency stabilisation and selection devices (namely quartz generators, filters and resonators), which it supplies to the Russian defence industry. JSC Morion is equipped with modern high-performance equipment and high-precision measuring equipment and has advanced world-class technology." .
