<https://www.ammitto.org/entity/ch/89591>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "State Unitary Enterprise of the Donetsk People’s Republic “Komtel”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89591> ;
  ammitto:remarks "State Unitary Enterprise of the Donetsk People’s Republic “Komtel” (SUE DPR “KOMTEL”) is a telecom operator operating in the illegally occupied region of Ukraine of Donetsk. It was founded by the so-called “Donetsk People’s Republic” and is managed by the Ministry of Communication of the so-called “Donetsk People’s Republic”. It provides telecommunications services, including to authorities of the so-called “Donetsk People’s Republic”, and it facilitated the holding of the so-called referendum on annexation to the Russian Federation." .
