<https://www.ammitto.org/entity/ch/4587>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mihun Andrei Arkadzevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4587> ;
  ammitto:remarks "Public Prosecutor. In 2006, he dealt with the case of the Civic Initiative \"Partnership\" for monitoring the Presidential elections in 2006. The accusation presented by him against Nikolai Astreiko, Timofei Dranchuk, Aleksandr Shalaiko and Enira Bronitskaya was politically motivated and included clear violations of the Code of Criminal Procedure." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-02-05"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
