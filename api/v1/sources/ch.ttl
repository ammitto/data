<https://www.ammitto.org/entity/ch/54296>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Baltic Shipbuilding Plant “Yantar”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
