  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kampete Ilunga" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38067> ;
  ammitto:remarks "As Commander of the Republican Guard (GR) until April 2020, Ilunga Kampete was responsible for the GR units deployed on the ground and involved in the disproportionate use of force and violent repression in September 2016 in Kinshasa." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1964-11-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
