<https://www.ammitto.org/entity/ch/44854>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mya Tun Oo" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/44854> ;
  ammitto:remarks "General Mya Tun Oo is a member of the Myanmar Armed Forces (Tatmadaw). He was Minister of Defence from 1 February 2021 to 3 August 2023, and was a member of the State Administrative Council (SAC) until its dissolution on 31 July 2025. On 1 February 2023, he was also appointed Deputy Prime Minister. As of 1 August 2023, he also assumed the role of Union Minister of Transport and Communications. He also oversees other junta-controlled supervisory bodies related to foreign investment and trade." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-05-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
