  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Padabed Iury Mikalaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4631> ;
  ammitto:remarks "Head of the security service of the holding company Triple of Yuri Chizh, former Head of the Unit for Special Purposes, Ministry of Interior. As a commander of internal anti-riot troops he was directly responsible for and was directly involved in the violent repression of peaceful demonstrations, notably in 2004 and 2008." ;
