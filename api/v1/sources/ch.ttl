<https://www.ammitto.org/entity/ch/86530>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kostin Vladislav Vyacheslavovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86530> ;
  ammitto:remarks "Vladislav Kostin is the General Director of JSC VNIIR-Progress. JSC VNIIR-Progress is a Russian research and development institute that specialises in the production of advanced electronic warfare (EW) systems, focusing on technologies for signal-jamming and intelligence-gathering. One of its key products is the Kometa antenna, which is designed to disrupt communications by interfering with radio, satellite and radar frequencies. The Kometa-M variant, a type of Kometa antenna, used in devices like the Orlan-10 unmanned aerial vehicle and guided bomb kits, employs adaptive antenna arrays to enhance resistance against electronic interference, ensuring accurate targeting even under adversarial EW measures. Weapons that incorporate Kometa antennas manufactured by JSC VNIIR-Progress are extensively used in Russia’s war of aggression against Ukraine, therefore JSC VNIIR-Progress is supporting actions which undermine the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1983-10-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1983"^^xsd:integer ] .
