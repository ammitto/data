<https://www.ammitto.org/entity/ch/95786>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Izhevsk Mechanical Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95786> ;
  ammitto:remarks "JSC “Izhevsk Mechanical Plant” is one of the largest multi-profile manufacturers in Russia, and its primary products include combat weapons, components for missile systems, and high-precision castings. It produces weapons for the Russian Armed Forces operating in Ukraine. Therefore, JSC “Izhevsk Mechanical Plant” is supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine. Furthermore, it is forming part of Russia’s military and industrial complex." .
