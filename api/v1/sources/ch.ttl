<https://www.ammitto.org/entity/ch/75058>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC RT-Techpriemka" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75058> ;
  ammitto:remarks "JSC RT-Techpriemka is a Russian military industry company. Under an agreement with the Russian Ministry of Defence, the company provides certification services for components dedicated to military industry companies. Also, JSC RT-Techpriemka produces metal alloys (for example, VNS9-Sh type) for companies that produce Mi-26, Mi-28 and Ka-52 helicopters. Mi-26, Mi-28 and Ka-52 helicopters are used by the Armed Forces of the Russian Federation in Russia’s war of aggression against Ukraine." .
