<https://www.ammitto.org/entity/ch/73168>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bobkov Vladimir Vitalyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73168> ;
  ammitto:remarks "Vladimir Bobkov has been a Member of the so-called “Presidium of the Regional Political Council of the Republic of Crimea” of the United Russia Party and Deputy of the so-called “State Council of the Republic of Crimea” since September 2019. He oversees and supports policies aimed at implementing the legislation of the Russian Federation in illegally annexed Crimea, including in relation to language policy. He has also supported Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-03-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
