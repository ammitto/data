  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bekkiev Azret Yuspovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105219> ;
  ammitto:remarks "Azret Bekkiev is the First Deputy General Director of JSC United Instrument Manufacturing Corporation (“OPK JSC”), company listed by the Union, and subsidiary of Rostec, one of the main military suppliers of the Armed Forces of the Russian Federation. OPK JSC functions as a holding company operating under a brand name Rosel and produces military equipment that is used by the Russian Armed Forces during Russia’s war of aggression against Ukraine, in particular automated control systems." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1952-04-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1952"^^xsd:integer ] .
