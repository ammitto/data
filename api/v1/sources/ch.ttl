<https://www.ammitto.org/entity/ch/95532>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Research Institute of Modern Telecommunication Technologies”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95532> ;
  ammitto:remarks "JSC “Research Institute of Modern Telecommunication Technologies” specialises in the production of radio and television transmitting equipment. It also produces weapons and ammunition. The products of JSC “Research Institute of Modern Telecommunication Technologies” are used by Russia in its war of aggression against Ukraine, in particular its unmanned aerial vehicle Merlin-VR." .
