  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kadyrova Aimani Nesievna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75364> ;
  ammitto:remarks "Aimani Kadyrova is the President of the Kadyrov Foundation. The Kadyrov Foundation carries out re-education programmes for Ukrainian children and teenagers, subjecting them to militaristic training with the intent of alienating them from their home country and relatives. Furthermore, the Kadyrov Foundation provides financial incentives to the families of the Chechen fighters involved in Russia’s war of aggression against Ukraine to attract new volunteers and keep those already fighting motivated." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1953-08-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1953"^^xsd:integer ] .
