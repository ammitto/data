<https://www.ammitto.org/entity/ch/107299>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Usov Anton" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107299> ;
  ammitto:remarks "Anton Usov is an activist in the Popular Front – Putin’s Team, who infiltrated the church structures of the Republic of Moldova, coordinating a structured influence campaign targeting the country’s parliamentary elections of 2025. He oversaw messaging, clergy mobilisation and political alignment within the Diocese of Soroca and Drochia. He used religious platforms, particularly the “Salt and Light” Telegram channel and the print outlet “Salt and Light”, to disseminate narratives blending Orthodox discourse with political messaging, while instructing priests how and for whom parishioners should vote." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1986-04-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1986"^^xsd:integer ] .
