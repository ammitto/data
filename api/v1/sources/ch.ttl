  ammitto:remarks "Vadzim Murashka is a Belarusian national and head of the correctional institution Penal Colony No 13, a maximum-security prison where a number of political prisoners are held, including Nikolai Statkevich, Vitaly Melnik and Sergei Vereshkhagin. Prisoners of Colony No 13 face inhumane conditions and are subject to abuses." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1979-06-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1979"^^xsd:integer ] .
