<https://www.ammitto.org/entity/ch/50848>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Turchak Andrey Anatolyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50848> ;
  ammitto:remarks "Andrey Turchak was formerly the secretary of the General Council of the United Russia Party and first deputy speaker of the Federation Council. He is currently governor of the Altai republic of Russia. His political success is associated with his father, Anatoly Turchak, who trained judo with the President of the Russian Federation Vladimir Putin and the Rotenberg brothers. He promoted a positive attitude to the recognition of the separatist so-called “People’s Republics” of Donetsk and Luhansk." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-12-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/50848>
