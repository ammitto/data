<https://www.ammitto.org/entity/ch/70249>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Spas TV Channel" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70249> ;
  ammitto:remarks "Spas TV Channel is a Russian television channel owned by the Russian Orthodox Church, which also receives financial support from the Government of the Russian Federation. The management of the channel maintains links with the Kremlin. It spreads pro-Kremlin propaganda and disinformation on Russia’s war of aggression against Ukraine. In various programmes it justifies Russia’s war of aggression against Ukraine on religious and spiritual grounds." .
