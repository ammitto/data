<https://www.ammitto.org/entity/ch/61148>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Komissarov Alexey Gennadyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61148> ;
  ammitto:remarks "Alexey Komissarov is the Co-Chairman of the Central Headquarters of the All-Russia People’s Front. Under his control and leadership, the People’s Front provides support for Russia’s war against Ukraine, including through the social campaign “All for Victory!”, including collecting physical and financial donations to support the military units of the so-called “Donetsk People’s Republic” and “Luhansk People’s Republic”." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-10-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/61148>
