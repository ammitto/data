  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Afzalov Viktor Musavirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69628> ;
  ammitto:remarks "Colonel-General Viktor Afzalov is Chief of the General Staff of the Russian Aerospace Forces since August 2018, and acting Commanderin-Chief of the Russian Aerospace Forces since 23 August 2023. As such, he is responsible for conducting air operations against Ukraine during Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-06-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
