<https://www.ammitto.org/entity/ch/101448>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Celestin Rony" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/101448> ;
  ammitto:remarks "Rony Celestin, a former senator of Haiti, is involved in violence linked to armed groups and smuggling. He has notably been held responsible for orchestrating the murder of the journalist Néhémie Joseph, who exposed his illegal activities and corruption." .
