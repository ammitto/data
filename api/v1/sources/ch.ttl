<https://www.ammitto.org/entity/ch/13185>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Salavati Abdolghassem" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13185> ;
  ammitto:remarks "Judge of the Special Court for Financial Crimes, branch 4 since 2019. Former Head of Tehran Revolutionary Court, branch 15. Committing Judge in the Tehran Tribunal. In charge of the post-election cases, he was the Judge presiding the “show trials” in summer 2009, he condemned to death two monarchists that appeared in the show trials. He has sentenced more than a hundred political prisoners, human rights activists and demonstrators to lengthy prison sentences." .
