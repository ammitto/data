  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Osipov Oleg Sergeevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98096> ;
  ammitto:remarks "Oleg Osipov has been a close collaborator of Dmitry Medvedev since 2018. Between 2018 and 2020, Oleg Osipov served as Press Secretary to Dmitry Medvedev, then Prime Minister of the Russian Federation. Since 2020, Oleg Osipov has served as aide to Dmitry Medvedev, currently the Deputy Chairman of the Security Council of the Russian Federation. As Dmitry Medvedev’s aide, Oleg Osipov continues to serve as his public voice, managing his public image and media coverage, including on social media. He is spreading disinformation and reproducing Russian propaganda narratives, including through verbal attacks." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-09-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
