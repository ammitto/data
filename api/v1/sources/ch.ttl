  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nizkous Alexey Vadimovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98366> ;
  ammitto:remarks "Alexey Nizkous is the General Director of PJSC Energiya, a Russian producer of chemical power sources, including batteries specifically designed for military applications. The company manufactures batteries used in unmanned aerial vehicles, aviation equipment and naval equipment. The company has significantly increased its production capacity and output, fulfilling substantial State defence orders. The company’s leadership has emphasised the priority of fulfilling State defence contracts." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1989"^^xsd:integer ] .
