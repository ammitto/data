  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sorokin Ilya Anatolyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98355> ;
  ammitto:remarks "Ilya Sorokin, alias “Dr Evil”, is a medic at the Penal Colony No 10 in Mordovia in Russia. Prisoners of war (POWs) detained there recall inhumane and degrading treatment, ranging from sexual abuse to other physical abuse and indoctrination. That degrading behaviour is a violation of the Geneva Conventions." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-08-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
