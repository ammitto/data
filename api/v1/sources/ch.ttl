<https://www.ammitto.org/entity/ch/98921>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC “Uvs Avia”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98921> ;
  ammitto:remarks "LLC Uvs Avia is a Russian developer, producer and seller of weapons and military equipment. The company’s products include unmanned systems and unmanned aerial vehicles (UAVs), on-board control equipment for UAVs, on-board communication facilities and telemetry equipment for aircraft. The company’s UAVs, including “Quasimacht” UAVs, are used by the Russian forces in Russia’s war of aggression against Ukraine. LLC Uvs Avia is therefore forming part of Russia’s military and industrial complex." .
