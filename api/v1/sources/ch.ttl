  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77720> ;
  ammitto:remarks "Viktar Dubrouka is the former head of the correctional institution Penal Colony No 11, where Siarhei Ramanau is serving a sentence of 20 years and 11 months and Vadzim Bobyrau is serving a sentence of 11 years. Both Ramanau and Bobyrau have been placed in the punishment cell multiple times." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-06-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
