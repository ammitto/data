  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "185th Center for Combat Use and Combat Purpose of the Aerospace Forces “Ashuluk”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72403> ;
  ammitto:remarks "The 185th Center for Combat Use and Combat Purpose of the Aerospace Forces “Ashuluk” is a weapons training ground of the Armed Forces of the Russian Federation. It is used in particular to test anti-aircraft and other types of missiles, which are used by the Russian military in Russia’s war of aggression against Ukraine." .
