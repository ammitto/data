<https://www.ammitto.org/entity/ch/69484>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lopatin Anton Igorevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69484> ;
  ammitto:remarks "Anton Lopatin has served as a member of the Central Election Committee of the Russian Federation (CEC) since 2021. During his tenure, the CEC has been responsible for organising illegal referenda in 2022, as well as illegal elections in September 2023, in occupied parts of Ukraine, thus attempting to legitimise the Russian war of aggression of those parts. In this role, Anton Lopatin is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-09-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
