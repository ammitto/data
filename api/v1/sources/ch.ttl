  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Serdyukova Viktoria Alexandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63675> ;
  ammitto:remarks "Viktoria Serdyukova is the former so-called “Commissioner for Human Rights of the Luhansk People’s Republic”. In this role, she supported the war of aggression Russia launched against Ukraine on 24 February 2022. She supported the illegal annexation of the territory of Luhansk and the adoption of Russian legislation in that and other illegally annexed territories." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1981-06-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1981"^^xsd:integer ] .
