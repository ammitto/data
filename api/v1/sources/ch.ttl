<https://www.ammitto.org/entity/ch/77803>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rachylouski Mikita Sviatoslavovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77803> ;
  ammitto:remarks "Mikita Rachylouski holds senior positions in the government institution the Youth Council, the GONGO Moving Forward and the media (the “Senate” television programme). Using those positions, Mykyta Rachylouski has spoken out against Belarusian citizens for criticising the government, participating in protests in 2020 and having opposing views. He has been especially vocal in seeking punishment and persecution for the blogger Kokobay, as well as the music band Drozdy and others. His statements incite persecution and promote hatred towards critics of the regime. During one of his numerous television appearances, he advocated for the removal of history faculty staff at Belarusian universities." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1997-07-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1997"^^xsd:integer ] .
