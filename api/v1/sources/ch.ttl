<https://www.ammitto.org/entity/ch/98966>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Signal”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98966> ;
  ammitto:remarks "JSC Signal is a Russian defence company which manufactures weapons, ammunition and explosives. The company is part of the holding company NPK Tekhmash JSC, which produces conventional weapons, ammunition and special chemicals and is part of the State Corporation Rostec. As part of Tekhmash, JSC Signal provides special products under the Russian State defence order. It participated in the International Military-Technical Forum “Army-2023”." .
