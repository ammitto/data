<https://www.ammitto.org/entity/ch/9645>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Islamic Revolutionary Guard Corps (IRGC)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
