  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Atlivanchik Sergey Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88614> ;
  ammitto:remarks "Sergey Atlivanchik is the General Director of LLC Eliars, which is a Russian company involved in developing and producing microwave equipment. It has developed and produced the Zont (Umbrella) system, an anti-drone system which allows the suppression of the signal for unmanned aerial vehicles. The Zont system has been used by Russian armed forces in the war of aggression against Ukraine. Therefore, in his role of General Director of LLC Eliars, Sergey Atlivanchik is supporting actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-01-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
