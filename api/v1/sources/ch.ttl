<https://www.ammitto.org/entity/ch/69711>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Labko Alexei Borisovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69711> ;
  ammitto:remarks "Alexei Labko is the Head of the 230th combined-arms training ground. In his capacity as the Head of the 230th combined-arms training ground he is responsible for training Russian army conscripts and soldiers in the facilities which he is heading. Therefore, Alexei Labko is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-08-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
