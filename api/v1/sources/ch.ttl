  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Brovko Vasily Yuryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89187> ;
  ammitto:remarks "Vasily Brovko is the Director for strategic research and communication at Rostec, the leading Russian state-controlled defence and industrial manufacturing corporation. He is also referred to as Director for Special Projects, effectively making him responsible for the company’s IT and public relations work, including the public relations for Rostec chairman Sergei Chemenzov." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1987-06-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1987"^^xsd:integer ] .
