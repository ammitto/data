<https://www.ammitto.org/entity/ch/103584>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Goudarzi Mohammad Moazami" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103584> ;
  ammitto:remarks "Mohammad Moazami Goudarzi is Chief of the Preventive Police, Deputy Chief of the Greater Tehran Police and former Police Commander of Karaj and Alborz. In his current and previous positions, he has been directly involved in the violent suppression of protests in Iran. During the December 2025 and January 2026 protests, he was directly responsible for directing relief units, police stations and strike teams on the streets of Tehran." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1957-03-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1957"^^xsd:integer ] .
