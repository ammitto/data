<https://www.ammitto.org/entity/ch/69019>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Baharestan Kish Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69019> ;
  ammitto:remarks "Baharestan Kish Company manufactures unmanned aerial vehicle (UAV) components for the Islamic Revolutionary Guard Corps (IRGC). The company has also worked on Shahed UAV components, which were exported to Russia. Baharestan Kish Company has overseen various defense-related projects, which included the manufacturing of UAVs. It is therefore supporting and involved in Iran’s UAV programme." .
