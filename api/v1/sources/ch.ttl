<https://www.ammitto.org/entity/ch/70518>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nizhny Novgorod Sokol Aircraft Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70518> ;
  ammitto:remarks "Nizhny Novgorod Sokol Aircraft Plant is a Russian aviation company. It is a contractor of the Ministry of Defence of the Russian Federation. It maintains and modernises the MiG-31 interceptor aircraft of the Armed Forces of the Russian Federation under the State defence order. Some of the modernised MiG-31 are equipped with the Kinzhal hypersonic air-launched ballistic missiles." .
