<https://www.ammitto.org/entity/ch/58259>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shadayev Maksut Igoryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/58259> ;
  ammitto:remarks "Maksut Igoryevich Shadayev is Minister of Digital Development, Communications and Mass Communications of the Russian Federation. In this role, and under his responsibility, activities have been undertaken to prepare for the extension of digital and\ntelecommunications services into the illegally annexed regions of Donetsk, Luhansk, Kherson and Zaporzhzhia, to connect them directly to Russia, as well as to the illegally annexed Crimea. The Ministry also assists with the mobilisation, therefore contributing\ndirectly to Russia’s war of agression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1979-11-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1979"^^xsd:integer ] .
