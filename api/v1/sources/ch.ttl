<https://www.ammitto.org/entity/ch/93417>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Molot-Oruzhie”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93417> ;
  ammitto:remarks "LLC “Molot-Oruzhie” is a Russian company designing and manufacturing weapons, in particular shotguns of the Vepr-12 series, for the Armed Forces of the Russian Federation, which are used in Russia’s war of aggression against Ukraine. The company also produces various modifications of the RPK 74 machine gun and the ASG-17 automatic grenade launcher, which are used in Russia’s war of aggression against Ukraine." .
