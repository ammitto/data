<https://www.ammitto.org/entity/ch/93590>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nurgaleev Ravil Ramilievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93590> ;
  ammitto:remarks "Ravil Nurgaleev is the General Director of LLC “Molot-Oruzhie”, a Russian company designing and manufacturing weapons, in particular shotguns of the Vepr-12 series, for the Armed Forces of the Russian Federation, which are used in Russia’s war of aggression against Ukraine. The company also produces various modifications of the RPK 74 machine gun and the ASG-17 automatic grenade launcher, which are used in Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-10-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
