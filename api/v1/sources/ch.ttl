  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nikishaeva Alina Sergeevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107057> ;
  ammitto:remarks "Alina Nikishaeva is the Head of the Simferopol military-patriotic club “Battalion Forpost,” operating in the temporarily occupied territory of Crimea under Russian state-supported youth and patriotic education initiatives. The club promotes pro-Russian patriotism and militarised values among children and adolescents, contributing to the ideological indoctrination of minors, including those from occupied territories of Ukraine." ;
