<https://www.ammitto.org/entity/ch/55471>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "PJSC KAMAZ" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55471> ;
  ammitto:remarks "KAMAZ is a Russian developer and manufacturer of vehicles and military equipment. It produced KAMAZ-5350, KAMAZ-6350, KAMAZ 6560 vehicles that are used by the Armed Forces of the Russian Federation during Russia’s war of aggression against Ukraine. In November, KAMAZ referred to its factory operating at the limits of its capacity to meet arms orders. It also published a video in April 2022 using the “Z” symbol, expressing support for the operation in Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/55471>
  a ammitto:SanctionEntry ;
