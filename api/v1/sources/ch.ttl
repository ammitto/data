  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Babaei Davoud" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/11017> ;
  ammitto:remarks "The current head of security for the Ministry of Defence Armed Forces Logistics’ research institute the Organisation of Defensive Innovation and Research (SPND), which was run by UN-designated Mohsen Fakhrizadeh-Mahabadi. The IAEA have identified SPND with their concerns over possible military dimensions to Iran’s nuclear programme over which Iran refuses to co-operate. As head of security, Babaei is responsible for preventing the disclosure of information, including to the IAEA." .
