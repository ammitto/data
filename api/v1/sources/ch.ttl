<https://www.ammitto.org/entity/ch/54492>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sich Andrii" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/54492> ;
  ammitto:remarks "Andrii Sich is a co-host of the programme “Platform” on state-owned television channel “Belarus 1”. In that position, he has supported regime narratives that aim to discredit independent media, undermine democracy and justify repression. He has supported the Lukashenka regime’s narrative about Western states’ intentions to organise a coup d’état in Belarus and called for harsh punishments for those allegedly involved, supported disinformation campaigns about mistreatment of migrants arriving in the Union from Belarus, and promoted the image of independent media as agents of foreign influence whose activity should be restricted. He is therefore supporting the Lukashenka regime." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-09-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
