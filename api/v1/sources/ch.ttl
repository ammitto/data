<https://www.ammitto.org/entity/ch/98344>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dyukov Aleksandr Reshideovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98344> ;
  ammitto:remarks "Aleksandr Dyukov is Director of the Historical Memory Foundation, which conducts pseudo-historical research that supports the official policy of the Government of the Russian Federation. By manipulating historical facts, the Historical Memory Foundation’s studies aim to justify the Soviet repression and to maintain the image that Russia is fighting against widespread Nazism in countries that oppose Russia. Ukraine is portrayed as a Nazi-run State. By being the Director of the Historical Memory Foundation, Aleksandr Dyukov is responsible for the Foundation’s actions spreading propaganda." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-10-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
