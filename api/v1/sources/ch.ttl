  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Research and Production Enterprise ‘Istok’ Named After A.I. Shokin”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
