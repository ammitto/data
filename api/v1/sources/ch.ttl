<https://www.ammitto.org/entity/ch/10708>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pacific Shipping" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/10708> ;
  ammitto:remarks "Acts for IRISL in the Middle East. It is a subsidiary of Azores Shipping Company. Its Managing Director is Mohammad Moghaddami Fard. In October 2010 it was involved in setting up cover companies; the names of the new ones to be used on bills of lading in order to circumvent sanctions. It continues to be involved in the scheduling of IRISL ships." .
