<https://www.ammitto.org/entity/ch/70540>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Paliukh Anna Borisovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70540> ;
  ammitto:remarks "Anna Paliukh, whose pseudonym is Anna Shafran, is a Russian propagandist who spreads Russian propaganda and publicly supports Russia’s war of aggression against Ukraine. She holds the position of Head of the Directorate of Analytical Radio Programmes of Zvezda media holding, which is a state-owned media network run by the\nRussian Ministry of Defence. She consistently justifies Russia’s actions in the war and demonises the people and government of Ukraine, stating publicly that Ukraine needs to be demilitarised and denazified. Therefore, she is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and\nindependence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-12-31"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
