<https://www.ammitto.org/entity/ch/70368>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shapurova Elena Aleksandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70368> ;
  ammitto:remarks "Elena Shapurova is the Russian-appointed “Minister of the Ministry of Education and Science of Zaporizhia region”. She enacted re-education policies of Ukrainian children in the Russian-occupied region of Zaporizhzhia, diminishing Ukrainian-language classes and increasing the number of Russian classes, including promoting Russian culture and\ncivic-education classes. Therefore, she is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty, and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-11-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
