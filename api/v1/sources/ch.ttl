<https://www.ammitto.org/entity/ch/70421>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "NPP Salyut JSC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70421> ;
  ammitto:remarks "NPP Salyut produces “Fregat-MAE-4K”, “Fregat M2EM” and “Fregat-M2M” shipborne radars, which are installed on warships employed by the Armed Forces of the Russian Federation during Russia’s war of aggression against Ukraine. The warships equipped with Salyut’s radars that are used by Russia in the war included project 22160 patrol ship\n“Dmitry Rogachev” and project 11356 frigates “Admiral Makarov” and “Admiral Essen”." .
