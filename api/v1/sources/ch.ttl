<https://www.ammitto.org/entity/ch/46257>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Alba Luz Ramos Vanegas" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/46257> ;
  ammitto:remarks "Former President of the Supreme Court of Justice of Nicaragua. Responsible for instrumentalisation of the judiciary in favour of the interests of the Ortega regime, through the selective criminalisation of opposition activities, perpetuating the pattern of violations of rights of due process, arbitrary arrests, and the disqualification of political parties and opposition candidates. She is therefore responsible for serious human rights violations, for the repression of civil society and democratic opposition, and for seriously undermining the rule of law in Nicaragua." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1949-06-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1949"^^xsd:integer ] .
