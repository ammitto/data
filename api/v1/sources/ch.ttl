  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Federal State Unitary Enterprise “18th Central Research Institute” of the Ministry of Defence of the Russian Federation" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107589> ;
  ammitto:remarks "Federal State Unitary Enterprise (FSUE) “18th Central Research Institute” of the Ministry of Defence of the Russian Federation develops electronic systems for the Air Force and Ground Forces and also manufactures weapons. The institute is subordinate to the Ministry of Defence of the Russian Federation and cooperates with other research institutes and enterprises of Russia’s military and industrial complex. Therefore, FSUE “18th Central Research Institute” materially supports Russia’s military and industrial complex, including by being involved in the development of military technology and equipment." .
