<https://www.ammitto.org/entity/ch/75523>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Achmatov Ibrahim Mahomedovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75523> ;
  ammitto:remarks "Ibrahim Achmatov is the General Director of JSC Kizlyar Electromechanical Plant, a Russian military industry company. The plant specialises in the development and manufacture of aircraft ground control and diagnostic systems, and the production of attachments and on-board equipment. The company produces DZ-UM lock for SU-25 fighters, which are used by Russian military forces to attack Ukraine. JSC Kizlyar Electromechanical Plant fulfils Russia’s state defence orders." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1948"^^xsd:integer ] .
