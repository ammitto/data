<https://www.ammitto.org/entity/ch/41011>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Alexis Enrique Escalona Marrero" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/41011> ;
  ammitto:remarks "Chief in Charge of the National Office Against Organized Crime and Terrorist Financing (ONDOFT) from Jan 2018 until May 2019. Retired Major General, former Vice Minister for prevention and public safety at the Ministry of the Interior (appointed in 2017 by President Maduro) and former National Commander of the National Anti-Extortion and Kidnapping Command (Comando Nacional Antiextorsión y Secuestro (CONAS)) (between 2014 and 2017). Responsible for serious human rights violations, including torture, the use of excessive force and the mistreatment of detainees by members of CONAS under his command. Also responsible for the repression of civil society by members of CONAS under his command." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-10-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/41011>
