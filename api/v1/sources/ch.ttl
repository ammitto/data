  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Armour Repair Plant No. 144" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75503> ;
  ammitto:remarks "JSC Armour Repair Plant No. 144 is a Russian military-industrial enterprise that produces armoured vehicles, which are deployed by the Russian armed forces. JSC Armour Repair Plant No. 144 is therefore supporting materially and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
