  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Thura San Lwin" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/39403> ;
  ammitto:remarks "Brigadier General Thura San Lwin was the Commander of the Border Guard Police from Oct 2016 until early Oct 2017. In that context, he is responsible for the atrocities and serious human rights violations committed against Rohingya population in Rakhine State by the Border Guard Police during that period. These include unlawful killings and systematic burning of Rohingya houses and buildings." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-03-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
