<https://www.ammitto.org/entity/ch/38241>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mutondo Kalev" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38241> ;
  ammitto:remarks "As Head of the National Intelligence Service (ANR) until Feb 2019, Kalev Mutondo was involved in and responsible for the arbitrary arrest, detention and mistreatment of opposition members, civil society activists and others." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1957-03-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1957"^^xsd:integer ] .
