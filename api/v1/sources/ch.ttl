<https://www.ammitto.org/entity/ch/89025>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Scientific Research Institute of Computing Complexes Named After M.A. Kartsev”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89025> ;
  ammitto:remarks "JSC “Scientific Research Institute of Computing Complexes Named After M.A. Kartsev” is a research institute based in Russia and involved in the development and production of unmanned aerial vehicles (UAVs). It has produced several different types of UAVs, which have been or will be tested by Russian armed forces in the war of aggression against Ukraine. Therefore, JSC “Scientific Research Institute of Computing Complexes Named After M.A. Kartsev” is supporting actions or policies which undermine or threaten the territorial integrity, sovereignty and independence of Ukraine." .
