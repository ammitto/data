<https://www.ammitto.org/entity/ch/50958>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Muradov Rustam Usmanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50958> ;
  ammitto:remarks "Rustam Muradov is Colonel General and First Deputy Commander-in-Chief of the Ground Forces of Russia. He is also a former Commander of the Eastern Military District. Previously, he was the deputy commander of the Southern Military District, which has been involved in military actions against Ukraine. In July 2022 he was named commander of Russia’s group of forces “Vostok” operating in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1973-03-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1973"^^xsd:integer ] .
