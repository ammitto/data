  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Myanmar Economic Holdings Public Company Ltd" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45083> ;
  ammitto:remarks "Myanmar Economic Holdings Public Company Ltd (MEHL) is a conglomerate owned and controlled by the Myanmar Armed Forces (Tatmadaw), having subsidiaries and affiliated companies in diverse sectors of the economy, including banking, insurance, construction, trade, transportation, mining, gem extraction, manufacturing and tourism. MEHL and its subsidiaries generate revenue for the Tatmadaw, therefore contributing to its capabilities to carry out activities undermining democracy and the rule of law and to serious human rights violations in Myanmar/Burma." .
