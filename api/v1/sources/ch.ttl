<https://www.ammitto.org/entity/ch/93482>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lobaev Nikolay Yevgenyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93482> ;
  ammitto:remarks "Nikolay Lobaev is a shareholder of LLC “Trading House ‘Lobaev Arms’” (Lobaev Arms), and together with his brother Vladislav Lobaev is the co-founder of the Lobaev group of entities. He is also the former General Director of Lobaev Arms. Lobaev Arms mass-produces and customises rifles which are used by the Russian Armed Forces in Russia’s war of aggression against Ukraine. As a shareholder of Lobaev Arms, he is benefitting financially from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine. Moreover, he is associated with Lobaev Arms and with his brother Vladislav Lobaev." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-06-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
