<https://www.ammitto.org/entity/ch/103417>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mohammad Rasulullah Corps" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103417> ;
  ammitto:remarks "The Mohammad Rasulullah Corps is responsible for coordinating Islamic Revolutionary Guard Corps (IRGC) and Basij forces in Tehran. Those forces have been involved in the violent repression of demonstrations, including during the nationwide protests in Iran that began in December 2025 where IRGC and Basij forces opened fire on protesters, resulting in deaths and injuries." .
