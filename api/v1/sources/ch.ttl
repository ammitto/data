  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dubovik Volha Anatoleuna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77922> ;
  ammitto:remarks "Volha Dubovik is a Belarusian judge who serves in the court of the Maladzechna district of the Minsk region. She was appointed by Aliaksandr Lukashenka in 2020. She has issued politically motivated sentences, including against citizens of Belarus who protested against the fraudulent presidential elections of 2020. She also sentenced a citizen for acting in self-defence against law-enforcement brutality." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-08-26"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
