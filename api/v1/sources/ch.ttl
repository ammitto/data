<https://www.ammitto.org/entity/ch/38394>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Maikel José Moreno Pérez" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38394> ;
  ammitto:remarks "Judge of the Criminal Appeal Chamber of the Supreme Court of Venezuela (Tribunal Supremo de Justicia (TSJ)). Former President and Vice President of the Supreme Court. In those roles, he has supported and facilitated the Government’s actions and policies which have undermined democracy and the rule of law in Venezuela, and is responsible for actions and statements that have usurped the authority of the National Assembly, including the appointment of the National Electoral Council (CNE) in Jun 2020 and the suspension and replacement of the leadership of three opposition parties in Jun and Jul 2020." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1965-12-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
