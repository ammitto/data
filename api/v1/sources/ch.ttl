<https://www.ammitto.org/entity/ch/76031>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nizhny Novgorod Joint-Stock Company “Hydromash” named after V.I. Luzyanin" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/76031> ;
  ammitto:remarks "Nizhny Novgorod JSC ‘Hydromash’ named after V.I. Luzyanin (JSC Hydromash) is a leading Russian enterprise in the development, production and testing of landing gear, hydraulic cylinders and hydraulic units for all types of aircraft devices. The company participates in almost all domestic aircraft construction projects (both in civil and in military spheres). JSC Hydromash fulfils Russian state defence orders, and its products (chassis and other hydraulic units) are used by the Armed Forces of the Russian Federation. JSC Hydromash is therefore supporting materially and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/76031>
