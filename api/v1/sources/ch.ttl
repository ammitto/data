  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Public joint-stock company Rosbank" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60628> ;
  ammitto:remarks "Rosbank is one of the largest financial structures in Russia, and one of the country’s top lenders. The Central Bank of Russia lists it as a systemically-important credit institution in the country. Its total assets as of the first quarter of 2024 were RUB 2 161,76 billion and its net profit was RUB 10,02 billion." .
