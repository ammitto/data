<https://www.ammitto.org/entity/ch/107714>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Lukoil-Western Siberia”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107714> ;
  ammitto:remarks "Limited Liability Company “Lukoil-Western Siberia” is a shipping company based in Russia and the commercial operator of the vessels Aries, Neva Lux and Nimbus Spb. Those vessels lack adequate liability insurance and are engaged in ship-to-ship transfers as well as manipulation of Automatic Identification Systems while transporting crude oil or petroleum products exported from Russia. Therefore, Limited Liability Company “Lukoil-Western Siberia” operates vessels that transport crude oil or petroleum products exported from Russia and practice irregular and high-risk shipping practices as set out in the International Maritime Organization General Assembly resolution A.1192(33)." .
