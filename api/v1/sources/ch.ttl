<https://www.ammitto.org/entity/ch/51272>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pumpyansky Alexander Dmitrievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51272> ;
  ammitto:remarks "Alexander Pumpyansky is the son of Dmitry Pumpyansky. Dmitry Pumpyansky is the former Chairman of the board of directors of TMK PAO and the former President and a former board member of Group Sinara. In those capacities, he supported and benefitted from cooperation with authorities of the Russian Federation and state-owned enterprises, including Russian railways, Gazprom and Rosneft. Irrespective of the purported sale of TMK and Group Sinara, he still has ongoing links with those companies and has seen his financial worth increase considerably in the last two years." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1987-05-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1987"^^xsd:integer ] .
