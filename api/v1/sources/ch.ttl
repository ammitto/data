  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/62697> ;
  ammitto:remarks "Boris Alyoshin is a Russian businessman involved in the activities of Russian companies and corporations contributing to the strengthening of Russia’s military base. He is one of the founders and managers of the LLC “SoyuzMash Russia”, which unites more than a thousand Russian military and civilian industries." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-03-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
