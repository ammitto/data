<https://www.ammitto.org/entity/ch/60750>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Avtodor" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60750> ;
  ammitto:remarks "Avtodor is a construction company subordinated to the “department of roads” of the “Ministry of Transport” of the so-called “Donetsk People’s Republic”. Since Russia’s war of aggression against Ukraine, Avtodor has actively restored strategic infrastructure, such as bridges and roads, on behalf of the Russian occupying forces. Avtodor has been commissioned by the Russian occupying forces to establish road connections between occupied regions of Ukraine, as well as to replace Ukrainian road signs with Russian-language signs in the occupied areas. The work carried out by Avtodor is part of a broader strategy pursued by the Russian Federation in cooperation with the occupying forces in the so-called “Donetsk People’s Republic” to advance Russia’s war of aggression through infrastructural projects." .
<https://www.ammitto.org/entry/ch/consolidated-list/60750>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/ch/60750> ;
  ammitto:hasAuthority <https://www.ammitto.org/authority/ch> ;
