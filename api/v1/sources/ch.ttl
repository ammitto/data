  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Neftegazpromstroy LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75622> ;
  ammitto:remarks "Neftegazpromstroy LLC is a leading company in the Russian energy sector. Since it was founded in 2015, the company has been involved in the construction of numerous gas and oil pipelines and the development of oil fields, contributing substantially to the development of the Russian energy sector. Therefore, Neftegazpromstroy LLC is involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
