<https://www.ammitto.org/entity/ch/13313>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khodaei Souri Hojatollah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13313> ;
  ammitto:remarks "Member of the National Security and Foreign policy Committee. Parliamentary deputy for Lorestan Province. Member of the Parliamentary Commission for Foreign and Security Policy. Head of Evin prison until 2012. Torture was a common practice in Evin prison while Souri was its head. In Ward 209, many activists were held for their peaceful activities in opposition to the ruling government." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/13313>
