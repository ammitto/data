<https://www.ammitto.org/entity/ch/39317>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Iván Hernández Dala" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/39317> ;
  ammitto:remarks "President of the National Telephone Company of Venezuela (Cantv). Major-General in FANB. Director-General of the Directorate-General for Military Counterintelligence (DGCIM) between January 2014 and October 2024 and Head of the Presidential Guard between September 2015 and October 2024. As Head of the DGCIM, Iván Hernández Dala is responsible for the repression of civil society and democratic opposition and for serious human rights violations committed by members of the DGCIM under his command, including torture, the use of excessive force and the ill-treatment of detainees." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-05-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
