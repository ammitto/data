<https://www.ammitto.org/entity/ch/13396>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Saeedi Ali" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13396> ;
  ammitto:remarks "Head of the Supreme Leader’s political ideology bureau. Former representative of the Supreme Leader for the Pasdaran (1995-2020) after spending his whole career within the institution of the military, and specifically in the Pasdaran intelligence service. This official role makes him the key figure in the transmission of orders emanating from the Office of the Guide to the Pasdaran's repression apparatus." .
