<https://www.ammitto.org/entity/ch/105772>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint-Stock Company “Promsintez”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105772> ;
  ammitto:remarks "JSC “Promsintez” is an enterprise of the military and industrial complex of the Russian Federation engaged in the production of explosives. The JSC “Promsintez” plant produces a wide range of explosives, including TNT, which is directly used in the production of ammunition. JSC “Promsintez” therefore forms part of Russia’s military and industrial complex." .
