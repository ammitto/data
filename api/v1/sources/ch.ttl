<https://www.ammitto.org/entity/ch/55538>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OJSC Balashikha Casting and Mechanical Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55538> ;
  ammitto:remarks "BLMZ is a Russian casting and mechanical plant. It supplies materials used for the production of weapons to the Russian military equipment providers that were sanctioned by the Union in view of Russia’s actions destabilising the situation in Ukraine." .
