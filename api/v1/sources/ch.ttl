<https://www.ammitto.org/entity/ch/70279>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC “Promtechnologiya”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70279> ;
  ammitto:remarks "LLC “Promtechnologiya”, a subsidiary of JSC “Promyshlennye Tekhnologii”, is a Russian manufacturer of weapons and ammunition. It manufactures and supplies firearms (ORSIS rifles) under State procurement contracts to the Russian Armed Forces, which are used in the war of aggression against Ukraine. Therefore, LLC “Promtechnologiya” supports materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
