<https://www.ammitto.org/entity/ch/56244>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lvova-Belova Maria Alexeyevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56244> ;
  ammitto:remarks "Maria Alexeyevna Lvova-Belova is a Presidential Commissioner for children’s rights and initiated the simplification of the procedure for granting citizenship to orphaned children in Ukraine. She is one of the most involved persons in the illegal transportation of Ukrainian children to Russia and their adoption by Russian families. Maria Alexeyevna Lvova-Belova’s actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order. She publicly supported the annexation of the Donbass region by the Russian Federation. Therefore she is responsible for, supporting or implementing actions or policies which undermine the sovereignty and independence of Ukraine and stability and security in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1984-10-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1984"^^xsd:integer ] .
