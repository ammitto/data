<https://www.ammitto.org/entity/ch/105178>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company Simbirsk Design Bureau “Piranya”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105178> ;
  ammitto:remarks "LLC SDB “Piranya” is a Russia-based company that manufactures drones used by Russia in its war of aggression against Ukraine. LLC SDB “Piranya” manufactures First Person View (FPV) drones and specifically the models “Piranya-7”, “Piranya-10” and “Piranya-13”. The company manufactures up to 10 000 drones per month and the Russian Army views its products as being extremely valuable in its military operations." .
