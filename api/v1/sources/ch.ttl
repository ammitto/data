<https://www.ammitto.org/entity/ch/71600>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Open Joint Stock Company “Peleng”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71600> ;
  ammitto:remarks "OJSC Peleng is the leading enterprise in the optomechanical and optoelectronic industry in the Republic of Belarus. OJSC Peleng produces and provides components for the manufacture of Russian artillery and military vehicles (namely armoured personnel carriers BTR-82A), which are used by the Russian Armed Forces in the war of aggression against Ukraine." .
