  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/47992> ;
  ammitto:remarks "Margarita Simonyan is a central figure of the Government propaganda. She is also editor-in-chief of the English language television news network RT (Russia Today). Through her function, she promoted a positive attitude to the annexation of Crimea and the actions of separatists in Donbas." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-04-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
