<https://www.ammitto.org/entity/ch/46972>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kuznetsov Aleksandr Sergeevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/46972> ;
  ammitto:remarks "Aleksandr Sergeevich Kuznetsov belongs to the command structure of the Wagner Group, a Russia-based unincorporated private military entity. He took command of the 1st Attack and Reconnaissance Company of the Wagner Group in 2014. He was injured in Sep 2019 in Libya while fighting alongside the Libyan National Liberation Army (NLA) as commander of the Wagner Group’s military operatives. Through his position and actions, Kuznetsov is responsible for the Wagner Group’s activities that threaten the peace, stability and security of Libya." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-10-08"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
