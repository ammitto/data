  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Federal State Enterprise ANOSIT" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69456> ;
  ammitto:remarks "Federal State Enterprise Anosit is a Russian producer of chemical substances used in explosives and rocket fuel. It is owned by the Russian State but according to a decree of the President of the Russian Federation it will be transformed and transferred to the possession of the State corporation Rostec. Therefore, Federal State Enterprise Anosit will remain in the control of the Russian Government." .
