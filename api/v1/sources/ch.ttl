<https://www.ammitto.org/entity/ch/88459>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Potupchik Kristina Andreevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88459> ;
  ammitto:remarks "Kristina Potupchik is a Russian blogger and media entrepreneur. She is the founder of the K2 communications agency which runs social media and information campaigns for clients, predominantly clients controlled by the Russian Government, for which she disseminates misinformation on the war in Ukraine and delegitimises Ukraine’s territorial integrity and sovereignty." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1986-01-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1986"^^xsd:integer ] .
