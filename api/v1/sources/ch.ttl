<https://www.ammitto.org/entity/ch/56910>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bulayev Nikolay Ivanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56910> ;
  ammitto:remarks "Deputy chairman of the Russian Central Election Commission since 2021. He was responsible for overseeing the voting procedures to conduct the illegal “referenda” on the illegal annexation of the so-called “Donetsk People’s Republic”, so-called “Luhansk People’s Republic”, Zaporozhzhia and Kherson Regions of Ukraine by the Russian Federation in September 2022. Under his guidance, voting stations were opened inside the Russian Federation in order to facilitate this vote. In September 2023, the CEC organised illegal elections in occupied parts of Ukraine, thus attempting to legitimise Russia’s war of aggression and illegal occupation of those parts of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1949-09-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1949"^^xsd:integer ] .
