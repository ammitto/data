<https://www.ammitto.org/entity/ch/73032>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zhoga Artem Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73032> ;
  ammitto:remarks "Artem Zhoga has been the Chairman of the so-called “People’s Council of the Donetsk People’s Republic” since 20 September 2023 and the Presidential Plenipotentiary Envoy to the Urals Federal District since 2 October 2024. Since 25 October 2024, he is a member of the Security Council of the Russian Federation. From May 2022 to December 2023, he was Commander of the Sparta Battalion, an armed separatist group which has actively supported actions which undermine the territorial integrity, sovereignty and independence of Ukraine and further destabilise Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-01-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
