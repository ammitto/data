  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88517> ;
  ammitto:remarks "Yury Nimchenko has been a Senator of the Federation Council from the illegally annexed “Republic of Crimea” since 12 September 2024 and is a Member of the Federation Council’s Committee on Defence and Security. He is a veteran of Russia’s war of aggression against Ukraine, having fought as a tank driver, for which he was awarded the title of “Hero of Russia” by the President of the Russian Federation" ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-06-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
