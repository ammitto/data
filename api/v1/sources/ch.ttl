  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Stanko”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93142> ;
  ammitto:remarks "LLC Stanko is a Russian company involved in the industrial sector. It acts as the public-facing company of the Stanko Group of companies, which is an important Russian supplier of machine tools, in particular from Chinese manufacturers, and related services to the Russian market, including for use by the Russian military and industrial complex. Therefore, LLC Stanko is supporting Russia’s military and industrial complex." .
