<https://www.ammitto.org/entity/ch/63057>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Belova Olga Nikolaevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63057> ;
  ammitto:remarks "Olga BELOVA is a propagandist working at TV Zvezda, an outlet of the Russian Armed Forces. She is a host of TV Zvezda’s flagship programmes, which regularly spreads disinformation regarding Russia’s war of aggression against Ukraine, undermines\nUkraine’s territorial integrity and sovereignty, and provides crucial media support for Kremlin policy. In particular, she has spread disinformation concerning Ukrainians being Nazis who are also preparing biological and chemical bombs against Russians." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-07-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
