<https://www.ammitto.org/entity/ch/58628>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Central Research Institute 'Burevestnik'" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/58628> ;
  ammitto:remarks "JSC CENTRAL RESEARCH INSTITUTE “BUREVESTNIK” is a Russian arms industry company. During its existence (since 1970), the company developed around 400 different types of arms and military equipment. It is best known for producing the following arms: artillery installations for naval artillery AK-176, A-190; mobile Mortars (types 2B11, 2K32, 2C12, 2B25), howitzer 2C35 and others." .
