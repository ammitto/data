  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Research And Production Enterprise ‘Polet’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92906> ;
  ammitto:remarks "JSC Research And Production Enterprise “Polet” is one of the leading developers and manufacturers of aviation radio communication equipment for military bodies. It developed digital communication tools that increase protection against interference and increase intelligence of on-board system communications. Furthermore, the company manufactures the RITM-POLYOT, a biorhythm stimulation device for recovery, which is actively used by the Russian military, including in Russia’s war of aggression against Ukraine. The company supplies its products to the Russian State, including the Ministry of Industry and Trade and the Ministry of Defence." .
