<https://www.ammitto.org/entity/ch/88725>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Alexey Shadrin Valerievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88725> ;
  ammitto:remarks "Alexey Shadrin is shareholder and co-founder of Promtech JSC. Promtech JSC is a Russian holding company that repeatedly imported goods of European origin while those products were subject to European export restrictions. In particular, Promtech JSC imported those goods through a network of Russian subsidiaries and via the Turkish company Enutek Makina Sanayi Ve Ticaret. Alexey Shadrin therefore facilitated infringements of the prohibition against circumvention of the Union’s restrictive measures regime imposed on the Russian Federation." .
