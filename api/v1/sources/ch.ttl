<https://www.ammitto.org/entity/ch/73199>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tsykurenko Anton Sergeyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73199> ;
  ammitto:remarks "Anton Tsykurenko is a judge of the Kyiv District Court of the city of Simferopol, Crimea. He has been appointed by the President of the Russian Federation Vladimir Putin. Tsykurenko makes politically motivated court decisions on charges against Ukrainian citizens, such as Oleg Prikhodko, who opposed the illegal annexation of Crimea and Sevastopol and the repressive policies of the occupation authorities towards the Crimean Tatars. He arrested lawyer Emil Kurbedinov, who defended Crimean Tatars and Ukrainian activists who were persecuted by Russian authorities for political reasons. Tsykurenko also arrested Crimean Tatar Mumine Salieva, the wife of political prisoner Seyran Saliev, for posts on social networks and other Crimean Tatar women for peaceful assembly during the detention of compatriots." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-11-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
