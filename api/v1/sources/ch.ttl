<https://www.ammitto.org/entity/ch/105303>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Ecoprom”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105303> ;
  ammitto:remarks "LLC “Ecoprom” is a Russian company which manufactures first person view (FPV) unmanned aerial vehicles (UAVs) of Bekas series, including models Bekas-700, Bekas-2500, Bekas-3500, Bekas-4500. All these UAVs are used in Russia’s war of aggression against Ukraine. LLC “Ecoprom” also manufactures special kits for its UAVs of Bekas series." .
