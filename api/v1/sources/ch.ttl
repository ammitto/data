  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tselitsa Lidziia Fiodarauna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/5090> ;
  ammitto:remarks "Judge at the Moskovski Rayon Court of the city of Minsk. She was directly involved in the judicial repression of the peaceful demonstrators on 19 December 2010. On 20 December 2010, she sentenced civil society activist Mikhail Barsukou to 10 days in jail Her way of conducting the trial was a clear violation of the Code of Criminal Procedure. She sustained the use of evidence and testimonies irrelevant to the accused." .
