<https://www.ammitto.org/entity/ch/65196>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Murashkin Mikhail Mikhailavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/65196> ;
  ammitto:remarks "In his capacity as former head of the Public Security Police in Zhodino, Mikhail Murashkin ordered the police troops and riot police, OMON, to brutally crack down on peaceful protests in the wake of the presidential elections in 2020, beating protesters and using violence against them. He is also involved in the unlawful repeated detention of independent journalists covering the protests in the lead-up to the presidential elections." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1989-09-08"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1989"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/65196>
