<https://www.ammitto.org/entity/ch/93472>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nikolayev Konstantin Yuryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93472> ;
  ammitto:remarks "Konstantin Nikolayev is a Russian businessperson with business interests in the Russian military and industrial complex. In particular, he holds interests in the Russian companies Promtekhnologiya LLC, ScanEx and the Tula Cartridge Plant. Those companies cooperate with the Russian military and security services, supplying them with military hardware which has been used in Russia’s war of aggression against Ukraine. Konstantin Nikolayev hides his ownership and interest in those businesses, including by positioning his wife Svetlana Nikolayeva in visible management positions. Moreover, through his businesses he has financed mercenary groups fighting for the Russian Federation in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1971-03-05"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
