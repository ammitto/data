<https://www.ammitto.org/entity/ch/104664>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Obryvalin Sergey Gennadievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104664> ;
  ammitto:remarks "Sergei Obryvalin is the First Deputy Minister of Culture of the Russian Federation. He oversees key departments within the Ministry of Culture, including the Department of State Protection of Cultural Heritage, museum oversight, and the Russian Military Historical Society. These departments are directly involved in the seizure Ukrainian cultural property and its reclassification as Russian. Sergei Obryvalin has signed permits, known as “open letters”, authorising Russian scientists to conduct archaeological excavations in Crimea. In addition, the Ministry of Culture of the Russian Federation, together with the illegitimate governing bodies of the occupied territories of Ukraine, is promoting cultural initiatives in the occupied territories and Sergei Gennadievich Obryvalin is actively participating in this process. Therefore, Sergei Obryvalin is supporting and implementing policies which undermine or threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-10-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
