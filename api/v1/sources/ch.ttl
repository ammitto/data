  ammitto:remarks "Grigore Caramalac is a Russian/Moldovan businessperson. He exercises control over the IFAVIS Foundation (Russian Federation), through which he has engaged in organising patriotic and sports events in the occupied territories in eastern Ukraine, with the support of the occupation authorities. Furthermore, he is the assistant to the Russian senator for the Kursk region, Alexander Bryksin." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1965-05-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
