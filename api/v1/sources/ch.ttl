  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Volat-Sanjiang Joint Venture Limited Liability Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105170> ;
  ammitto:remarks "Volat-Sanjiang Joint Venture Limited Liability Company is a Belarusian joint venture co-created by Minsk Wheel Tractor Plant. It produces wheeled chassis for military equipment, including multiple launch rocket systems manufactured by the Minsk Wheel Tractor Plant. Therefore, Volat-Sanjiang Joint Venture Limited Liability Company forms part of and supports the military and industrial complex of Belarus by being involved in the development, production and supply of military technology and equipment." .
