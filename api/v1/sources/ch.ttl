  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Ulyanovsk Instrument Design Bureau”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75463> ;
  ammitto:remarks "JSC Ulyanovsk Instrument Design Bureau (JSC UKBP) is a Russian leading developer and manufacturer of airborne electronic equipment for aircraft and helicopters, automatic control systems for hydropower, automotive components and medical equipment. The history of the enterprise dates back to 1 September 1941." .
