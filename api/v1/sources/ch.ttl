<https://www.ammitto.org/entity/ch/38217>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ruhorimbere Éric" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38217> ;
  ammitto:remarks "As Deputy Commander of the 21st military region from September 2014 to July 2018, Éric Ruhorimbere was responsible for the disproportionate use of force and extrajudicial killings perpetrated by the Congolese Armed Forces (FARDC), in particular against the Nsapu militia and against women and children." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-07-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
