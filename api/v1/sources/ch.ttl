  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/58173> ;
  ammitto:remarks "Dmitry Vasilenko is a member of the Federation Council who on 4 Oct 2022 ratified the four treaties between the Russian Federation and the Donetsk People’s Republic, the Luhansk People’s Republic, the Zaporizhzhia region, and the Kherson region, and their\nadmission to the Russian Federation. Therefore, he has supported and implemented actions and policies, which undermine the territorial integrity, sovereignty and independence of Ukraine, and further destabilised Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-05-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
