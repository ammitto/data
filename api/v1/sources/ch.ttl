  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/12655> ;
  ammitto:remarks "Former Head of the Security Committee of the Southern Region from 2018 to 2020 under the former al-Assad regime. Former Head of the General Security Directorate. Major General. From April 2012 to 2 December 2018, was head of the Homs branch of the Political Security Directorate (succeeded Brigadier General Nasr al-Ali). Since 3 December 2018, head of the Political Security Directorate. Director of the General Intelligence Department since 2019. Responsible for the torture of opponents in custody." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-09-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
