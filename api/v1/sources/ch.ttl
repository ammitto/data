<https://www.ammitto.org/entity/ch/107260>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC “IONOS”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107260> ;
  ammitto:remarks "LLC “IONOS” is a Russian company specialising in the manufacture of electric lamps and lighting equipment, as well as in the manufacture of aircraft equipment. The company, in particular through the project “Alaska”, produces the First Person View (FPV) drones “Alyosha”, which have been actively used by Russian forces in Ukraine for reconnaissance, strike, and kamikaze missions. The company plays a growing role in Russia’s expanding drone warfare capabilities." .
