<https://www.ammitto.org/entity/ch/71546>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Saratov" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71546> ;
  ammitto:remarks "JSC Saratov Radio Instrument Plant is one of the leading enterprises in the production of modern surface situation illumination and target designation systems for the Russian Navy. The plant is part of the Granit-Electron Concern, which in 2018 became part of the Tactical Missile Armament Corporation." .
