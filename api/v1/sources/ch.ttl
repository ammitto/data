<https://www.ammitto.org/entity/ch/88447>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kazarezov Igor Valentinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88447> ;
  ammitto:remarks "Igor Kazarezov is the Chairman of the Center for Military Sports Training and patriotic education of youth “WARRIOR”. The WARRIOR Center is a state-led youth organisation established in the Russian Federation to foster patriotic and military education. It is supported by the President of the Russian Federation, who instructed the WARRIOR Center to work in close cooperation with participants in Russia’s war of aggression against Ukraine. The WARRIOR Center is also conducting activities in the illegally occupied territories of Ukraine, through local branches." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
