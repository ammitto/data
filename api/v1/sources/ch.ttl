<https://www.ammitto.org/entity/ch/78579>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Parutenco Nelli" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/78579> ;
  ammitto:remarks "Nelli Parutenco was the treasurer of Ilan Shor’s political party “SHOR” (“ȘOR”), until it was banned. In the context of investigations into the ȘOR Party for illegal financing, she escaped to Moscow in 2022." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-03-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
