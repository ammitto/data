<https://www.ammitto.org/entity/ch/45609>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Davydzka Genadz Branislavavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45609> ;
  ammitto:remarks "As the Chairman of Belaya Rus, a major pro-Lukashenka organization, Genadz Davydzka is one of the main propagandists of the regime. In his support for Lukashenka, he frequently used inflammatory language, and encouraged the violence of the state apparatus against peaceful protesters. He is therefore supporting the Lukashenka regime." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-09-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
