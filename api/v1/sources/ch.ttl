<https://www.ammitto.org/entity/ch/70761>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Karazi Anatoli Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70761> ;
  ammitto:remarks "Anatoli Karazi is one of the founders of the private military company known as PMC Redut, and is a former member of and head of intelligence for the Wagner Group. He is in charge of recruitment for PMC Redut, which is conducting operations in Ukraine in the course of\nRussia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-02-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
