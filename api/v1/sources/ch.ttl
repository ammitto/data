<https://www.ammitto.org/entity/ch/54375>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Prigozhin Yevgeniy Viktorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/54375> ;
  ammitto:remarks "Yevgeniy Prigozhin was a Russian leading businessperson with close ties to the President of the Russian Federation Vladimir Putin and the Russian Ministry of Defence. He reportedly died in a plane crash on 23 August 2023." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-06-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
