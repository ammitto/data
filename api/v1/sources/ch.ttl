<https://www.ammitto.org/entity/ch/7318>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Clussé Sanha Captain (Navy)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/7318> ;
  ammitto:remarks "Member of the \"Military Command\" which has assumed responsibility for the coup d'état of 12 April 2012. Very close to António Injai. Sanha Clussé integrated the \"Military Command\" delegation that met with ECOWAS in Abidjan on 26 Apr 2012." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1965-09-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
