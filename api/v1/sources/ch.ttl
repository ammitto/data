<https://www.ammitto.org/entity/ch/69901>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “V.V. Tikhomirov Scientific Research Institute of Instrument Engineering”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69901> ;
  ammitto:remarks "JSC “V.V. Tikhomirov Research Institute of Instrument Engineering” is a military-industrial complex of Russia. It develops weapon control systems for fighter aircraft and medium-range anti-aircraft missile systems for ground forces. Its medium-range anti-aircraft missile system 9K317M “Buk-M3” is used in Russia’s war of aggression against Ukraine. Therefore, JSC “V.V. Tikhomirov Research Institute of Instrument Engineering” is supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
