<https://www.ammitto.org/entity/ch/93523>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zhernov Nikolay Konstantinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93523> ;
  ammitto:remarks "Nikolay Zhernov is the Director of LLC “Aerofregat”. That company is active in the Russian military and industrial complex, namely in the development and production of unmanned aerial vehicles (UAVs). Since 2024, it has developed two specific UAV models, named “Kasatka” and “Tribunal”, both of which have military application and have been used in Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1981-02-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1981"^^xsd:integer ] .
