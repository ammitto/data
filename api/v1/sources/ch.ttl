<https://www.ammitto.org/entity/ch/98977>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Yadran-Group”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98977> ;
  ammitto:remarks "LLC Yadran-Group is a Russian conglomerate established in Tatarstan and mainly active in the oil sector, including in the extraction, processing and sale of oil and oil products. The oil sector is a sector providing substantial revenue to the Russian Government. Therefore, LLC Yadran-Group is involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
