  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zyuzin Igor Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88488> ;
  ammitto:remarks "Igor Zyuzin is a Russian businessperson, with business interests in the iron ore and steel, coal and energy sectors. Igor Zyuzin is a major shareholder and Chairman of the Board of Directors of Mechel PAO, a major Russian mining and metals company engaging in up-stream and down-stream activities within the Russian mining, metals and energy sectors. In particular, Mechel PAO is one of the leading Russian coal export companies. Those economic sectors provide a substantial source of revenue to the Government of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-05-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
