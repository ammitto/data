<https://www.ammitto.org/entity/ch/70743>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Medvedev Ilya Dmitrievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70743> ;
  ammitto:remarks "Ilya Medvedev is responsible for creating digital services in the illegally occupied Ukrainian regions of Donetsk, Luhansk, Kherson and Zaporizhzhia. He coordinated the project “I am Russian”, which aims to provide Russian governmental services to the inhabitants of those regions, including making available the simplified procedure for Russian citizenship, and social services." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1995-08-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1995"^^xsd:integer ] .
