<https://www.ammitto.org/entity/ch/107521>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ERA Military Innovation Technopolis" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107521> ;
  ammitto:remarks "ERA Military Innovation Technopolis is an entity owned by the Ministry of Defence of the Russian Federation. It was founded to develop and implement technologies important for the Russian Armed Forces. It develops technologies in close cooperation with scientific companies of the Armed Forces of the Russian Federation, the defence industry and industrial partners. Many of the products, including the drone “Boomerang”, are already being used by the Russian Armed Forces. ERA Military Innovation Technopolis is therefore forming part of Russia’s military and industrial complex, including by being involved in the development, production or supply of military technology and equipment." .
