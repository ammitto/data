<https://www.ammitto.org/entity/ch/107704>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nord Axis Ltd" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107704> ;
  ammitto:remarks "Nord Axis is a Hong Kong-based company that is part of a network of companies associated with the group 2Rivers which enables the shipment and export of Russian oil and operates vessels part of the Russia’s so-called “Shadow fleet”. Following the beginning of Russia’s war of aggression against Ukraine in 2022, Nord Axis has become an important trader of oil originating from Russian companies. The energy sector, in particular the oil sector, is a sector providing substantial revenue to the Government of the Russian Federation." .
