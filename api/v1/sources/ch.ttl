<https://www.ammitto.org/entity/ch/72354>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zaitsev Vladimir Egorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72354> ;
  ammitto:remarks "Vladimir Zaitsev is the Director of Joint Stock Company (JSC) VNIIRT (a.k.a. All-Russian Research Institute of Radio Engineering). JSC VNIIRT is a Russian military-industrial state enterprise that develops radar systems deployed by the Russian Armed Forces, including radar systems used for Russia’s Pantsir-S1 missile system. Moreover, JSC VNIIRT is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." .
