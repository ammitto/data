<https://www.ammitto.org/entity/ch/73244>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "FSE “TGP”, Federal State Enterprise “Tambov Gunpowder Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73244> ;
  ammitto:remarks "FSE Tambov Gunpowder Plant is a Russian enterprise that produces pyroxylin powders, which is used in various types of ammunition used by the Russian Armed Forced. The plant produces pyroxylin powders for a wide range of ammunition, from 7,62  mm cartridges and grenades for Kalashnikov rifles to 125 mm tank rounds for T-90 main battle tank and artillery shells for 2S3 Akatsiya, 2S19 Msta-S, Msta-B and 2S5 Hyacinth artillery and howitzer units. The plant is owned by the Russian defence conglomerate Rostec State Corporation. The plant operates in a strategically important sector of the military industry and was able to increase its production capacity during Russia’s war of aggression against Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/73244>
