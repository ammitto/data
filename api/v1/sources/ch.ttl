  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company All-Russian Scientific Research Institute “Gradient”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75654> ;
  ammitto:remarks "JSC All-Russian Scientific Research Institute “Gradient” is a Russian military industry company. It produces radio-technical equipment. JSC All-Russian Scientific Research Institute “Gradient” is a developer of Krasukha-4 multifunctional mobile radio-electronic suppression REP complex that is used by Russian armed forces in the war of aggression against Ukraine." .
