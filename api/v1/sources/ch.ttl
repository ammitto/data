  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bozorgnia Mostafa" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13201> ;
  ammitto:remarks "Head of ward 350 of Evin Prison, known for being the place of imprisonment of the regime’s political prisoners and for its particularly poor detention conditions. He unleashed on a number of occasions disproportionate violence upon prisoners." .
