<https://www.ammitto.org/entity/ch/5182>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ivanou Siarhei" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
