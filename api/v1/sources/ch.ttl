<https://www.ammitto.org/entity/ch/38116>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Numbi John" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38116> ;
  ammitto:remarks "John Numbi was Inspector General of the Congolese Armed Forces (FARDC) from July 2018 until July 2020. Owing to his role, he bears responsibility for the human rights violations committed by the FARDC between July 2018 and July 2020, such as disproportionate violence against illegal miners from June to July 2019 committed by FARDC troops under his direct authority." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-08-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
