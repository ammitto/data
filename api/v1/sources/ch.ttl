<https://www.ammitto.org/entity/ch/54559>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Open Joint Stock Company “Belaruskali”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/54559> ;
  ammitto:remarks "OJSC Belaruskali is a state-owned enterprise and one of the biggest potash producers in the world. Despite the decline of its global share in the global potash market from 20 % to 9 % in 2022, Belaruskali remains one of the most significant exporters of potash and a substantial source of revenue for the Belarussian state budget. Alexander Lukashenka described Belaruskali as “a national treasure, pride, one of the pillars of Belarusian exports”. It is also a major source of foreign currency for the Lukashenka regime." .
<https://www.ammitto.org/entry/ch/consolidated-list/54559>
