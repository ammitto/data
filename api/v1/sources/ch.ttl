  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Institute of Applied Physics (IAP)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/9143> ;
  ammitto:remarks "The Institute of Applied Physics provides research and development for Iran’s nuclear programme. It has project partnerships with the EU-listed Organisation of Defensive Innovation and Research (SPND), which is a subsidiary of EU-listed Ministry of Defense for Armed Forces Logistics (MODAFL), working to weaponise the nuclear programme, which is under the authority of the General Staff of the Armed Forces." .
