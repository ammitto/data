<https://www.ammitto.org/entity/ch/71455>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC 163 Armor Repair Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71455> ;
  ammitto:remarks "JSC 163 Armor Repair Plant’s primary activity is maintenance of T-72 main battle tanks and BMP-2 amphibious infantry fighting vehicles. The plant is part of the High Precision Systems holding company of Rostec. Various models of BMP-2 infantry fighting vehicles and T-72 main battle tanks are used by the Russian army in the war of aggression against Ukraine. JSC 163 Armor Repair Plant set a record in maintenance of BMP-2 in 2023." .
