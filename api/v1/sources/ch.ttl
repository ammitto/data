<https://www.ammitto.org/entity/ch/70559>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Arsenyev Aviation Company Progress" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70559> ;
  ammitto:remarks "JSC Arsenyev Aviation Company Progress (AAC Progress) is a company within the Russian military industrial complex which manufactures military helicopters of strategic importance to the Russian Federation. Therefore, JSC Arsenyev Avition Company Progress (AAC Progress) is an entity supporting materially and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
