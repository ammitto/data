<https://www.ammitto.org/entity/ch/104986>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kosolapov Oleg Yuryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104986> ;
  ammitto:remarks "Oleg Kosolapov is the General Director of Complex Unmanned Solutions Center Ltd (USC). USC is active throughout the full production and adaptation cycle of first-person view (FPV) systems for combat use. It produces end devices and ground equipment and trains personnel to pilot and effectively use FPV systems. USC supplies Unmanned Air Vehicles (UAVs) to the Russian Armed Forces which use them in Russia’s war of aggression against Ukraine." .
