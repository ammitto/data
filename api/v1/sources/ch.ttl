<https://www.ammitto.org/entity/ch/88527>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Karyakin Sergey Alexandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88527> ;
  ammitto:remarks "Sergey Karyakin is a Senator of the Russian Federation Council, representing illegally annexed Crimea since 12 September 2024. He was previously a chess Grandmaster, and was suspended due to his statements in support of Russia’s war of aggression against Ukraine. He has continued to support the war, including by publishing an open letter to President Vladimir Putin, travelling to the Ukrainian territories occupied by Russia and gathering military supplies in support of the Russian Armed Forces. For these actions, he has been awarded the Russian Federation medal “For Merit to the Fatherland”." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-01-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
