<https://www.ammitto.org/entity/ch/55528>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC TD KAMA" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55528> ;
  ammitto:remarks "TD KAMA is a general distributor of KAMA TIRES products, which are manufactured by Nizhnekamsk All-Steel Tyre Plant and Nizhnekamskshina. It supplies tyres to the Armed Forces of the Russian Federation and the National Guard of the Russian Federation." .
