<https://www.ammitto.org/entity/ch/73068>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Markman Alexander Matveevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73068> ;
  ammitto:remarks "Alexander Markman is the General Director of JSC Production Association Strela. The company supplies weapons to the Russian Armed Forces under Russia’s state defence orders. JSC Strela produces Oniks (Onyx) rockets and beam holders for Su-30. Both Oniks and Su-30 are used by the Russian Armed Forces in Russia’s war of aggression against Ukraine. He is active in the Central Council of SoyuzMash Russia LLC, which openly supports the politics of President of the Russian Federation Vladimir Putin, and his bid for presidency." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1948-07-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1948"^^xsd:integer ] .
