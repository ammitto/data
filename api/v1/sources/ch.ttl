<https://www.ammitto.org/entity/ch/92761>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Center for Integrated Unmanned Solutions”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92761> ;
  ammitto:remarks "LLC “Center for Integrated Unmanned Solutions” is a company based in Zhukovsky in the Moscow Oblast and part of the Russian military and industrial complex. LLC “Center for Integrated Unmanned Solutions” deals with the full cycle of first-person view (FPV) systems for combat use, from training personnel in piloting and effective use to production of end devices and ground equipment. LLC “Center for Integrated Unmanned Solutions” develops and produces unmanned aerial vehicles (UAVs) which are provided to the Russian Armed Forces and used in Russia’s war of aggression against Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/92761>
