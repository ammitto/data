  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/106833> ;
  ammitto:remarks "Aleksey Zinchenko is since July 2022 the Chairman of the State Committee for Youth Policy of the Republic of Crimea. By virtue of his function he plays an important role in indoctrination and militarisation of education in Crimea. He is one of the key figures forming the Russian policy towards young Crimeans. He is also a head of regional projects “We are together” and “Russia – country of opportunities”." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1995-02-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1995"^^xsd:integer ] .
