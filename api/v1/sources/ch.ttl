<https://www.ammitto.org/entity/ch/63148>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dubinsky Sergey Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63148> ;
  ammitto:remarks "Sergey Dubinsky was the Head of Military Intelligence of the so-called “Donetsk’s Peoples Republic (DPR) and took an active part in the separatist movement at an early stage of the armed conflict, having planned and executed the DPR’s offensive which preceded the shooting down of flight MH17. He was found guilty by a Dutch court over the downing of Malaysia Airlines Flight MH17 and the murder of all 298 civilians on board. Sergey Dubinsky is a colonel in the Military Intelligence Service (GRU) reserve, and he is protected by the Russian Government." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-08-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
