  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tsivileva Anna Evgenievna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70669> ;
  ammitto:remarks "Anna Tsivileva is the Deputy Minister of Defence of the Russian Federation and the Chair of the Foundation “Defenders of the Fatherland”. She is the wife of Sergey Evgenievich Tsivilev, who is Governor of the Kemerovo Oblast. She is also a relative of President of the Russian Federation Vladimir Putin." ;
