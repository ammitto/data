<https://www.ammitto.org/entity/ch/13116>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rajabzadeh Azizollah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13116> ;
  ammitto:remarks "Commander of the Urban Order Headquarters since 2014. Former Head of Tehran Disaster Mitigation Organisation (2010-2013). As Head of Tehran Police until Jan 2010, he was responsible for violent police attacks on protesters and students. As Commander of the Law Enforcement Forces in the Greater Tehran, Azizollah Rajabzadeh was the highest ranking accused in the case of abuses in Kahrizak Detention Centre in Dec 2009." .
