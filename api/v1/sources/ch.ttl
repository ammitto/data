  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rogach Konstantin Valerievych" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107805> ;
  ammitto:remarks "Konstantin Rogach is a maritime insurance broker and a partner in the company “Maritime Risk Management”. He has facilitated insurance coverage and provided administrative consultancy for the benefit of vessels transporting crude oil or petroleum products originating in Russia or exported from Russia while practicing irregular and high-risk shipping practices, and of companies with ties to Russia’s so-called “shadow fleet”. To cover up and obscure this activity he has used a network of shell companies functioning as payment agents." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1979-10-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1979"^^xsd:integer ] .
