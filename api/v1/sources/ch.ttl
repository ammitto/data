<https://www.ammitto.org/entity/ch/72663>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Roshchin Aleksey Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72663> ;
  ammitto:remarks "Aleksey Roshchin is the General Director of OJSC Krasnoe Znamya. The company provides services for the assembly and installation of printed circuit boards. OJSC Krasnoe Znamya is one of the largest enterprises of Russia’s military-industrial complex in the field of development and serial production of high-tech products of radio engineering profile and high-precision electronic\nequipment." .
