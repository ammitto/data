  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Archangel Center”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105828> ;
  ammitto:remarks "The Archangel Center is a Russian military training organisation that provides a wide range of tactical and combat preparation programs for military personnel. It offers courses in general military training, tactical training, sniper instruction, UAV operation, self-defense, knife combat, artillery, and reconnaissance." .
