<https://www.ammitto.org/entity/ch/70684>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kurilov Ilya Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70684> ;
  ammitto:remarks "Ilya Kurilov is the Director of the Imperial Tula Arms Plant, which produces the Konkurs-M anti-tank missile system. That missile system is used by the Russian Armed Forces in the war of aggression against Ukraine. Furthermore, Ilya Kurilov has publicly supported Russia’s war of aggression against Ukraine and the demilitarisation of Ukraine in the\nnational interest of the Russian Federation. Therefore, Ilya Kurilov is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1979-09-26"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1979"^^xsd:integer ] .
