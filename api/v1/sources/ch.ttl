<https://www.ammitto.org/entity/ch/75924>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Blatt Mark" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75924> ;
  ammitto:remarks "Mark Blatt is the CEO of the Israeli company Texel F.C.G. Technology Limited, which supplies the Russian companies LLC UNITEK and LLC LINKOS with a wide range of components, with the aim of incorporating them in Russian military equipment, such as the multifunctional optical-electronic reconnaissance complex IRONY (a laser rangefinder with a thermal imaging sensor, an optical additional back-up channel and a GPS module) which is known to be used by the Russian military forces. Texel F.C.G. Technology serves as an intermediary to transfer European goods to Russian companies LINKOS and UNITEK. In his position, Mark Blatt is significantly frustrating the provisions against the circumvention of the provisions of Decision 2014/512/CFSP and Regulation (EU) No 833/2014." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-09-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/75924>
