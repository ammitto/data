<https://www.ammitto.org/entity/ch/59370>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Fedorenko Eleonora Mikhailovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/59370> ;
  ammitto:remarks "Eleonora Fedorenko was the Commissioner for Children’s Rights in the so-called “Donetsk People’s Republic” from 18 December 2024 until 16 July 2025. Prior to this, she was the Advisor on Childrens’ Rights to the head of the so-called “Donetsk People’s Republic”. In this capacity, she was involved in the illegal transportation of Ukrainian children to Russia and their adoption by Russian families. Eleonora Fedorenko’s actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order, she is therefore responsible for, supporting and implementing actions and policies which undermine the sovereignty and independence of Ukraine and stability and security in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-10-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
