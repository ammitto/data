<https://www.ammitto.org/entity/ch/75378>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Central Research Institute of Precision Engineering”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75378> ;
  ammitto:remarks "JSC “Central Research Institute of Precision Engineering” (JSC TsNIITochMash) is part of State Corporation Rostec and is known for its scientific and technical activities in the field of development and production of weapons and military equipment for various branches of the Russian Armed Forces. More than 150 models and complexes of small arms, artillery, anti-tank weapons, combat technical means and ammunition of various types have been developed, mastered in serial production and transferred to the armament and supply of the Russian Army, Airborne Forces, Air Force, Navy and special units of law enforcement agencies under the leading role of JSC TsNIITochMash." .
