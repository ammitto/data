<https://www.ammitto.org/entity/ch/89132>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "“Promtech” Joint Stock Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89132> ;
  ammitto:remarks "Promtech JSC is a Russian holding company that repeatedly imported goods of European origin while those products were subject to European export restrictions. In particular, Promtech JSC imported those goods through a network of Russian subsidiaries and via the Turkish company Enutek Makina Sanayi Ve Ticaret. Promtech JSC thus facilitated infringements of the prohibition against circumvention of the Union’s restrictive measures regime imposed on the Russian Federation." .
