<https://www.ammitto.org/entity/ch/56220>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Belousov Andrey Removich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56220> ;
  ammitto:remarks "Andrey Removich Belousov has been the Russian Federation Defence Minister since 14 May 2024. As Defence Minister, he is ultimately responsible for any military action against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-03-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
