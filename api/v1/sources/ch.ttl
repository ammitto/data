<https://www.ammitto.org/entity/ch/86596>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zdunov Artyom Alexeevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86596> ;
  ammitto:remarks "Artyom Zdunov is the Head of the Republic of Mordovia (a Russian federal subject) since at least 18 November 2020. In this position, Artyom Zdunov has played a leadership role in implementing the Russian Government’s policy of illegally removing Ukrainian children from regions of Ukraine that are under temporary Russian control, in particular by organising the movement of children from occupied Ukrainian regions, in particular from the Kherson region and the Kalanchak Raion to the Republic of Mordovia." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-05-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
