  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kurlovich Uladzimir Anatolievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4555> ;
  ammitto:remarks "Has actively undermined democracy in Belarus. Former Сhairman of the Regional Electoral Commission of the Minsk region. As Chairman of a Regional Electoral Commission, he was directly responsible for the violations of international electoral standards in the Presidential elections, in particular in 2006 in the Minsk region." .
