<https://www.ammitto.org/entity/ch/75968>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC R-STROY" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75968> ;
  ammitto:remarks "LLC R-Stroy is a construction company in charge of re-building residential areas of Mariupol, for which it received government contracts from the Russian Federation under preferential terms. It operates in occupied territories of Ukraine, without the permission of Ukrainian authorities." .
