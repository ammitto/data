<https://www.ammitto.org/entity/ch/55412>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Oboronenergo" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55412> ;
  ammitto:remarks "JSC Oboronenergo is a military power supplier owned by JSC Garnizon which under government contracts provides electricity supply services to Russian military units and other entities subordinated to the Ministry of Defence. It took part in the modernisation of the military air base in Korenovsk, which was used by the Armed Forces of the Russian Federation to launch attacks on targets located in Ukraine during Russia’s war of aggression against Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/55412>
  a ammitto:SanctionEntry ;
