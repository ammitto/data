<https://www.ammitto.org/entity/ch/13434>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ramezani Gholamhossein" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13434> ;
  ammitto:remarks "Since 2011 Chief of the Intelligence of the Ministry of Defence; from Nov 2009 to Mar 2011: Commander of Intelligence of the Pasdaran; from Mar 2008 to Nov 2009: Deputy Commander of Intelligence of the Pasdaran; from Apr 2006 to Mar 2008: Head of Protection and Intelligence of the Pasdaran. Involved in the suppression of freedom of expression, including by being associated with those responsible for the arrests of bloggers/journalists in 2004, and reported to have had a role in the suppression of the post-election protests in 2009." .
