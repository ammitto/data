<https://www.ammitto.org/entity/ch/70149>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Educational and Methodological Center “Avangard”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70149> ;
  ammitto:remarks "Educational and Methodological Center “Avangard” is a non-profit organisation operating under the guidance and control of the Ministry of Defence of the Russian Federation. Its main aim is to provide so-called patriotic education to the youth of Russia, as well as to children in the temporarily occupied regions of Ukraine, including basic military training, and to provide drone control programmes. It organises military camps for that purpose, in which participation has become mandatory since February 2022, as well as mandatory lessons in school as of 1 September 2023." .
