  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Naing Htut Aung" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/57512> ;
  ammitto:remarks "Naing Htut Aung is a Director and sole shareholder of International Gateways Group of Company Limited (IGGC) operating in the trading sector. He has strong ties with the military leadership in Myanmar." ;
