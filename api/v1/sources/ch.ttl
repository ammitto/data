<https://www.ammitto.org/entity/ch/104847>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Goutorov Guerman" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104847> ;
  ammitto:remarks "Guerman Goutorov is the CEO of Streit Group FZE, which is a military-industrial company specialising in the production of armoured personnel carriers. Streit Group FZE has partnered with Russian military-industrial entities. Therefore, Guerman Goutorov is supporting Russia’s military and industrial complex by being involved in the supply of military technology and equipment. Moreover, Guerman Goutorov is associated with Streit Group FZE." .
