  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kerefov Murat Anatolyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
