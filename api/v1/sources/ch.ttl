<https://www.ammitto.org/entity/ch/56947>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chicherina Yulia Dmitrievna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56947> ;
  ammitto:remarks "Prominent Russian singer. She uses her considerable prominence to publicly undermine or threaten the territorial integrity and sovereignty of Ukraine, e.g. by denigrating symbols of Ukrainian statehood and publically displaying her support for the Russian annexation of Ukraine in Russian-occupied Ukrainian territory." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-08-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
