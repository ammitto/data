  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/100173> ;
  ammitto:remarks "Reza Aghazadeh is an Iranian national, member of the Expediency Discernment Council. He served as Head of the Atomic Energy Organization between 1997 and 2009. His positions have led him to be at the forefront of the development of Iran’s nuclear programme. He is still consulted by his AEOI colleagues on nuclear issues. Reza Aghazadeh is therefore responsible for directly participating in Iran’s nuclear programme and nuclear escalation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1949-03-14"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1949"^^xsd:integer ] .
