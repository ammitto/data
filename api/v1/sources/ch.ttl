<https://www.ammitto.org/entity/ch/56622>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ahmed Khalil Khalil" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56622> ;
  ammitto:remarks "Ahmed Khalil Khalil is the co-owner of Sanad Protection and Security Services, a Syrian private security company established in 2017 and supervised by the Wagner Group in Syria, active in the protection of Russian interests (phosphates, gas and securing oil sites) in Syria. The exploitation of natural resources provides revenues to the former al-Assad regime. In addition, the company is active in the recruitment of Syrian mercenaries to Libya and Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
