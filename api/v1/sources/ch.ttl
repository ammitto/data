<https://www.ammitto.org/entity/ch/50782>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Aven Petr Olegovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50782> ;
  ammitto:remarks "Petr Aven is a Russian businessperson with close links to the President of the Russian Federation, Vladimir Putin, dating back to the early 1990s. He has a significant shareholding in ABH Holdings, which controlled a major Russian bank, Alfa Bank, and still controls other companies of the Alfa Group. The transfer of his shares in A1, which is part of the Alfa Group, is considered fictitious. He is also a shareholder of the LetterOne investment firm." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-03-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
