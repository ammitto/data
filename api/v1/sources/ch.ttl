  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chekunkov Alexey Olegovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/58251> ;
  ammitto:remarks "Alexey Olegovich Chekunkov is the Minister for the Development\nof the Far East and the Arctic of the Russian Federation. In this role,\nhe has been responsible for the transfer of Ukrainian persons into the\nFar East of Russia. Under his control, resources from the Far Eastern\nregions of Russia have been used in the so-called ‘Donetsk People’s\nRepublic’." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-10-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
