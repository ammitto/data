  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bulatov Ruslan Rustemovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73377> ;
  ammitto:remarks "Ruslan Bulatov is the General Director of LLC Testkomplekt. LLC Testkomplekt supplies goods falling under Union restrictive measures to the Russian Federation. In particular, LLC Testkomplekt offers wide range of analogue-to-digital components, microcontrollers, diodes and sensors that cannot be exported to the Russian Federation. Furthermore, LLC Testkomplekt is a supplier of Radiopriborsnab, a subsidiary of Concern Radioelectronic Technologies (KRET), Russia’s major developer and manufacturer of military radio-electronic products" ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1986-04-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1986"^^xsd:integer ] .
