<https://www.ammitto.org/entity/ch/9672>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "IRGC-Air Force Al-Ghadir Missile Command" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/9672> ;
  ammitto:remarks "The IRGC-Air Force Al-Ghadir Missile Command is a specific element within the IRGC Air Force that has been working with EU-designated SBIG, with the FATEH 110, short range ballistic missile as well as the Ashura medium range ballistic missile. This command appears to be the entity that actually has the operational control of the missiles." .
<https://www.ammitto.org/entry/ch/consolidated-list/9672>
