<https://www.ammitto.org/entity/ch/51311>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mazepin Dmitry Arkadievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51311> ;
  ammitto:remarks "Dmitry Mazepin is a major owner and former CEO of the mineral fertiliser company Uralchem. Uralchem Group is a Russian manufacturer of a wide range of chemical products, including mineral fertilisers and ammoniac saltpetre. According to the company, it is the largest producer of ammonium nitrate as well as the second-largest producer of ammonia and nitrogen fertilisers in Russia. Dmitry Mazepin is thus a businessperson involved in economic sectors providing a substantial source of revenue to the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-04-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
