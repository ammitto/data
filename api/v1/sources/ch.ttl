<https://www.ammitto.org/entity/ch/72861>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mayboroda Svetlana Anatolievna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72861> ;
  ammitto:remarks "Svetlana Mayboroda is the Head of the so-called State Service for Family and Children Affairs in the so-called Donetsk People’s Republic. In this role, she has been responsible for the illegal deportation of Ukrainian children to Russia. Svetlana Mayboroda is one of the key persons involved in the forcible deportation of Ukrainian children to Russia and their subsequent illegal adoption by Russian families. Her actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-02-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
