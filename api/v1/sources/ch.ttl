<https://www.ammitto.org/entity/ch/105317>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Volgaburmash Joint Stock Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105317> ;
  ammitto:remarks "Volgaburmash AO, company based in Samara in the Samara Oblast, is an integral part of the Russian oil and gas drilling industry, a sector of strategic importance for the Russian Federation and a substantial source of revenue for the Government of the Russian Federation. Volgaburmash AO is a leading manufacturer of drill bits and machinery for the Russian oil and gas drilling sector and currently holds the position of market leader and key supplier within the sector in the Russian Federation. Volgaburmash AO also manufactures drill bits for mineral mining (including coal) and the construction industry." .
<https://www.ammitto.org/entry/ch/consolidated-list/105317>
