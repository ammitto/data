  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Amer al-Achi Major General" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/12694> ;
  ammitto:remarks "Former Governor of the Sweida Governorate under the former al-Assad regime, appointed by former President Bashar al-Assad in July 2016. Former Head of the intelligence branch of the Syrian Air Force Intelligence Service (2012-2016). Through his role in the Air Force Intelligence Service, Amer al-Achi is implicated in the repression of the Syrian opposition." .
