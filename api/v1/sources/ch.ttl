<https://www.ammitto.org/entity/ch/105012>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Public Joint Stock Company “Scientific and production enterprise ‘Impuls’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105012> ;
  ammitto:remarks "PJSC “Research and Production Enterprise ‘Impuls’” is a Russian state-owned enterprise that manufactures military electronic equipment as a subsidiary to the Joint Stock Company “Aerospace Defence Concern ‘Almaz-Antey’”. The company specialises in the development and production of automated control systems, electronic components, and critical infrastructure used in the command and control of armed forces. PJSC “Research and Production Enterprise ‘Impuls’” is involved in state defence procurement programs. Its technologies are used in systems that enhance the operational effectiveness of the Russian Armed Forces such as the air-to-surface-missiles Kh-29T, which are being used against Ukraine." .
