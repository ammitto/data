<https://www.ammitto.org/entity/ch/4436>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Halavanau Viktar Ryhoravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4436> ;
  ammitto:remarks "Rector of the private \"Belarus Institute of Law\". As former Minister of Justice, his services elaborated laws that are repressive towards civil society and the democratic opposition. He also denied or deprived registration for NGOs and political parties and he ignored unlawful acts undertaken by the security services against the population." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1952-12-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1952"^^xsd:integer ] .
