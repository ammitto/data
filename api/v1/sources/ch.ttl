  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kholin Dmitryi Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56326> ;
  ammitto:remarks "Dmitryi Kholin is a member of the Samara Provincial Duma, where he served as the Chairman of the Regulations Committee. He is currently the Deputy Governor of the Samara Region and Head of Administration for the Governor of the Region. From 2020 to 2021 he was the head of the Executive Committee of the Samara Regional Branch of the Kremlin-aligned ruling party “United Russia”. He is also a member of the Samara Regional Branch of the all-Russian public organisation “Combat Brotherhood” (organisation for veterans)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-09-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
