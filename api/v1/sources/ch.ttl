  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Promyshlennyye Tekhnologii”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70347> ;
  ammitto:remarks "JSC “Promyshlennye Tekhnologii” and its subsidiary LLC “Promtechnologiya”, which operates under the trade name ORSIS, manufactures and supplies firearms under State procurement contracts to the Russian Armed Forces, which are used in the war of aggression against Ukraine. Therefore, JSC “Promyshlennye Tekhnologii” supports materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
