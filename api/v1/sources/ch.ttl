<https://www.ammitto.org/entity/ch/75980>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint-Stock Company “United Instrument Manufacturing Corporation”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75980> ;
  ammitto:remarks "JSC United Instrument Manufacturing Corporation (JSC OPK) is a Russian state corporation. It is a specialised management company, under the auspices of which the scientific and production structures of the Russian radio-electronic industry are united. The company is associated with and manages Russian defence industry companies (JSCs Ruselectronics, NPP Istok and Concern Sozvezdie) that manufacture equipment used in Russia’s war of aggression against Ukraine. Therefore, JSC OPK is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/75980>
