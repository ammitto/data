  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chubarykin Sergey Viktorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103209> ;
  ammitto:remarks "Major General Sergey Chubarykin is the Commander of the 76th Guards Air Assault Division, whose troops committed most of the documented atrocities in Bucha, including executions, torture and looting. Those atrocities in Bucha constitute crimes against humanity and war crimes." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-08-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
