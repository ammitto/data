  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Skok Vasil Uladzimiravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77865> ;
  ammitto:remarks "Vasil Skok is a judge who has served in the Grodno Regional Court since 2003, having been appointed by Aliaksandr Lukashenka. He has issued politically motivated sentences against citizens of Belarus who voiced their opinions against the President, the regime and the brutality of Belarusian law-enforcement structures. He sentenced Andrey Sachevko to six years in a high-security penal colony." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-11-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
