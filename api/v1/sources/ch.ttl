<https://www.ammitto.org/entity/ch/49793>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chmyhalov Aleksandr Evgenevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/49793> ;
  ammitto:remarks "Deputy Head of the Sevastopol electoral commission, which took part in the organisation of the so-called elections in the illegally annexed ‘Autonomous Republic of Crimea’ and City of Sevastopol held in Sep 2021.\n\nMember of the ruling ‘United Russia’ party.\n\nIn taking on and acting in this capacity, he actively supported and implemented actions and policies which undermine the territorial integrity, sovereignty and independence of Ukraine, and further destabilised Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-06-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
