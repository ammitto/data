<https://www.ammitto.org/entity/ch/75444>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Milskaya Elena Igorevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75444> ;
  ammitto:remarks "Elena Milskaya is a Russian public figure and businessperson, closely linked to Russian authorities. Her main activity is related to enabling the forced deportation of Ukrainian children to Russia. She is CEO or founder of several non-governmental organisations which receive governmental financing. She publicly supports President of the Russian Federation Vladimir Putin and Russia’s policies violating the territorial integrity of Ukraine, including through organising projects in the territory of occupied Crimea. Moreover, she is connected with Putin’s business elites, as their companies receive significant governmental financing." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-12-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
