<https://www.ammitto.org/entity/ch/3344>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nzeyimana Stanislas" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/3344> ;
  ammitto:remarks "Deputy Commander of the FOCA (an FDLR armed branch). Military leader of a foreign armed group operating in the Democratic Republic of the Congo, impeding the disarmament and the voluntary repatriation and resettlement of combatants, per Security Council resolution 1857 (2008) OP 4 (b). In evidence collated by the UNSC DRC Sanctions Committee Group of Experts, detailed in its report of 13 February 2008, girls recovered from FDLR-FOCA had previously been abducted and sexually abused. Since mid-2007, FDLR-FOCA, which previously recruited boys in their mid to late teens, has been forcefully recruiting youth from the age of 10 years. The youngest are then used as escorts, and older children are deployed as soldiers on the frontline, per Security Council resolution 1857 (2008) OP4 (d) and (e)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-01-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
