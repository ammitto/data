<https://www.ammitto.org/entity/ch/69965>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Efanov Vitaly Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69965> ;
  ammitto:remarks "Colonel Vitaly Efanov is the Head of the 174th training ground of the Air Force and Air Defence forces “Domanovsky”. In his capacity as the Head of the 174th training ground of the Air Force and Air Defence forces “Domanovsky” he is responsible for training Russian army conscripts and soldiers in the facilities which he is heading. Therefore, Vitaly Efanov is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-01-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
