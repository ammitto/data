<https://www.ammitto.org/entity/ch/47762>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tayza Kyaw" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/47762> ;
  ammitto:remarks "Prior to the coup of 1 February 2021, U Tayza Kyaw oversaw military operations in Kachin State, characterised by excessive use of force against ethnic minority groups and indiscriminate violence leading to the violation of civilians’ rights and their forced displacement." .
