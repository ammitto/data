  ammitto:remarks "Vladimir Morozov is the former Head of Belarusian Railways, which operates railway service between Russia and Belarus. In this role, he supported the deployment and transportation of Russian military personnel and equipment involved in Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1965-06-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
