<https://www.ammitto.org/entity/ch/45691>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ivankovich Valeri Valerevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45691> ;
  ammitto:remarks "In his position as the General Director of OJSC “MAZ”, Valeri Ivankovich bears responsibility for the detention of MAZ workers within MAZ premises by security forces, and for firing MAZ employees who were participating in peaceful protests against the regime. He is therefore responsible for the repression of civil society." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1971-02-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
