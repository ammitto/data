<https://www.ammitto.org/entity/ch/86056>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gavrilov Alexander Valerievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86056> ;
  ammitto:remarks "Alexander Gavrilov is the General Director of LLC Gumich, a Russian company which fully owns LLC Gumich RTK. LLC Gumich RTK is a producer of Impulse-M robot platforms, which are intended to be used in Russia’s war of aggression against Ukraine and have already been tested on the field by Russian Armed Forces as of summer 2024. As the General Director of LLC Gumich, Alexander Gavrilov is therefore supporting actions which threaten the territorial integrity of Ukraine. Furthermore, he is associated with LLC Gumich." .
