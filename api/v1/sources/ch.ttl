<https://www.ammitto.org/entity/ch/92836>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Autonomous non-profit Organisation “Scientific and Production Center for Testing and Competence in the Field of Development of Unmanned Aircraft Systems and Means of Protection Against their Illegal Use ‘Ushkuynik’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92836> ;
  ammitto:remarks "Scientific-Research Centre “Ushkuynik” is a company producing unmanned aerial vehicles (UAVs) to the benefit of the Russian military. Its main product is the UAV named “Kniaz Vandal Novgorodskiy” (KVN), which is used by Russia in its war of aggression against Ukraine. The company also holds permission from the Russian Government to unite and coordinate the efforts of UAV engineers and construction companies in order to create and test new types of UAV in Veliky Novgorod." .
<https://www.ammitto.org/entry/ch/consolidated-list/92836>
  a ammitto:SanctionEntry ;
