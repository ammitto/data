<https://www.ammitto.org/entity/ch/75137>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kostin Igor Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75137> ;
  ammitto:remarks "Igor Kostin is a judge of the Southern District Military Court of the Russian Federation. In his position, he took multiple politically motivated decisions against opponents of the illegal annexation of Crimea and Sevastopol, as well as decisions based on religious grounds. In particular, Igor Kostin prosecuted various members of the Crimean Tatars, such as Seytumer Seytumerov, Osman Seytumerov, Rustem Seytmemetov and Amet Suleimanov, as well as other political prisoners. He is therefore supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-08-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
