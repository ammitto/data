<https://www.ammitto.org/entity/ch/75956>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Vostochnaya Stevedoring Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75956> ;
  ammitto:remarks "LLC Vostochnaya Stevedoring Company operates the shipment of containers in Vostochny port in the Primorsky region of Russia. The Democratic People’s Republic of Korea (DPRK) has shipped weapons and ammunition via shipping containers to Russian Far East ports, including Vostochny Port. Russia is using the weapons and ammunition shipped from the DPRK in its war of aggression against Ukraine. As the operating company for the shipment of containers to Vostochny port, LLC Vostchnaya Stevedoring Company is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
