<https://www.ammitto.org/entity/ch/93609>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Research Institute of Space Instrumentation”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93609> ;
  ammitto:remarks "JSC Research Institute of Space Instrumentation is a Russian research and manufacturing company which has won a government procurement contract for developing and producing high-tech electronic components for the Russian defence industry. Therefore, JSC Research Institute of Space Instrumentation is forming part of Russia’s military and industrial complex, including by being involved in the development, production or supply of military technology and equipment." .
