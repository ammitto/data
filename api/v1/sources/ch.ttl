  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ozia Mazio Dieudonné" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/3361> ;
  ammitto:remarks "Financial schemes with Jérôme Kakwavu and FAPC and smuggling across the DRC/Uganda border, allowing supplies and cash to be made available to Kakwavu and his troops. Violation of the arms embargo, including by providing assistance to armed groups and militia referred to in paragraph 20 of Res. 1493 (2003)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1949-06-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1949"^^xsd:integer ] .
