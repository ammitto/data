<https://www.ammitto.org/entity/ch/60679>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Battery Company Rigel JSC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60679> ;
  ammitto:remarks "Battery Company Rigel JSC is a manufacturer of nickel-metal hydride and silver-zinc batteries, and has been a supplier to the Russian navy for more than 15 years. The company describes itself as “a leading developer of lithium-ion batteries and batteries for autonomous and uninterruptible power systems, communications, transport, and other equipment” and provides a full cycle of development, production, and supply of lithium batteries for the Russian Navy and the Russian Ministry of Defence." .
<https://www.ammitto.org/entry/ch/consolidated-list/60679>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/ch/60679> ;
