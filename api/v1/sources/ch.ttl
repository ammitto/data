<https://www.ammitto.org/entity/ch/104809>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Anisimov Anton Sergeevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104809> ;
  ammitto:remarks "Anton Anisimov is a prominent figure in Russia’s state-controlled international media. He is the Deputy Editor-in-Chief of Russia Today, the Head of International Broadcasting of Sputnik News Agency and Radio, and the Editor-in-Chief of Sputnik News Agency and Radio. In his roles at Sputnik and Russia Today, Anton Anisimov is responsible for spreading disinformation related to Ukraine and promoting false pro-Kremlin narratives about Russia’s invasion of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-02-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
