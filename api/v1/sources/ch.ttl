<https://www.ammitto.org/entity/ch/89524>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Samara Electromechanical Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89524> ;
  ammitto:remarks "JSC “Samara Electromechanical Plant” (JSC SEMZ) is a Russian military industry company. JSC SEMZ manufactures high-tech products, precision mechanics, electronics and various machine parts, as well as electronic equipment units for special-purpose complexes. JSC SEMZ provides its products to state-owned and military industry entities, which incorporate the products into machines and equipment used by the Russian military. JSC SEMZ therefore materially supports and benefits from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/89524>
  a ammitto:SanctionEntry ;
