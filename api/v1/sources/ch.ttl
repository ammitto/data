<https://www.ammitto.org/entity/ch/88998>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Eliars”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88998> ;
  ammitto:remarks "LLC Eliars is a Russian company involved in developing and producing microwave equipment. It has developed and produced the Zont (Umbrella) system, an anti-drone system which allows the suppression of the signal for unmanned aerial vehicles. The Zont system has been used by Russian armed forces in the war of aggression against Ukraine. Therefore, LLC Eliars is supporting, materially or financially, actions which threaten the territorial integrity of Ukraine." .
