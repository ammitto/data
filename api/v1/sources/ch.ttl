<https://www.ammitto.org/entity/ch/13380>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kazemi Toraj" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13380> ;
  ammitto:remarks "Chief of the Greater Tehran division of the EU-designated Cyber Police until Jun 2020. In this capacity, he announced a campaign for the recruitment of government hackers in order to achieve better control of information on the internet and attack \"dangerous\" sites." .
<https://www.ammitto.org/entry/ch/consolidated-list/13380>
