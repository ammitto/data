<https://www.ammitto.org/entity/ch/75391>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bolataeva Lyudmila Sergeevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75391> ;
  ammitto:remarks "Lyudmila Bolataeva is the deputy governor of Moscow region and the former Minister of Social Development of Moscow Oblast. In her role as the Minister of Social Development of Moscow Oblast, she was involved in organising the deportation of children from occupied Ukrainian territories to Russia. Those actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order. Therefore, Lyudmila Bolataeva is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1957-01-30"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1957"^^xsd:integer ] .
