  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Araghi Abdollah Brigadier-General" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
