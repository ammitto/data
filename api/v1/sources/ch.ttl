<https://www.ammitto.org/entity/ch/13150>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Heydarifar Ali-Akbar" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13150> ;
  ammitto:remarks "Former Judge, Tehran Revolutionary Court. He participated in protesters trials. He was questioned by the Judiciary about Kahrizak abuses. He was instrumental in issuing detention orders to consign detainees to Kahrizak Detention Centre in 2009. In Nov 2014, his role in the deaths of detainees was officially recognised by the Iranian authorities." .
