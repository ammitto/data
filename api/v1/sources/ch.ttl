  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kovalchuk Yuriy Valentinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/28557> ;
  ammitto:remarks "Mr Kovalchuk is a long-time acquaintance of President Putin. He is a co-founder of the so-called Ozero Dacha, a cooperative society bringing together an influential group of individuals around President Putin." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1951-07-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1951"^^xsd:integer ] .
