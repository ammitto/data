<https://www.ammitto.org/entity/ch/13217>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abbaszadeh-Meshkini Mahmoud" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13217> ;
  ammitto:remarks "Member of Parliament from February 2020 to 2024 and Speaker of the Parliament’s Committee for National Security and Foreign Affairs who continues to support the Iranian regime, including by justifying the abuses committed by the regime against the “Women, Life, Freedom” movement." .
