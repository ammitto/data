<https://www.ammitto.org/entity/ch/71574>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “State Design Bureau ‘Vympel’ named after I.I. Toropov”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71574> ;
  ammitto:remarks "JSC “State Design Bureau ‘Vympel’ named after I.I. Toropov” is a specialised enterprise engaged in development and production of automated systems for the maintenance and control of weapons and military equipment. The enterprise is engaged in the development and manufacture of air-to-air and air-to-surface guided missiles, guided missiles for land and sea anti-aircraft systems, launchers, and catapults for airborne guided missiles, beam holders for suspension of aerial bomber armament and units for unguided aircraft missiles." .
