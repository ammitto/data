  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LIBSS LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105367> ;
  ammitto:remarks "LIBBS LLC is a front company for JSC IEMZ Kupol, a subsidiary of Russian state-owned arms company Almaz-Antey. It has acted as an intermediary between Kupol and Chinese suppliers manufacturing long-range attack drones of the type Garpiya-A1, which are developed and produced for use in Russia’s war of aggression against Ukraine. Therefore, LIBBS LCC is materially supporting Russia’s military and industrial complex." .
