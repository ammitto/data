<https://www.ammitto.org/entity/ch/9147>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Iran Aircraft Industries (IACI)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/9147> ;
  ammitto:remarks "A subsidiary of the IAIO within MODAFL. Manufactures, repairs, and conducts overhauls of airplanes and aircraft engines and procures aviation related parts often of US-origin typically via foreign intermediaries. IACI and its subsidiaries have also been detected using a worldwide network of brokers seeking to procure aviation-related goods." .
