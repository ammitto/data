<https://www.ammitto.org/entity/ch/3819>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abidjan Freight" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/3819> ;
  ammitto:remarks "Abidjan Freight was a front company set up by Sanjivan Ruprah (included on the Liberia Sanctions Committee list) to act as a freight forwarder for Viktor Bout’s arms shipments to Liberia. Abidjan Freight was also used by Viktor Bout and Gus Van Kouwenhoven (also included on the Committee’s assets freeze list) to conceal the exact routing and final destination of an aircraft delivering military goods to Monrovia, according to UN officials." .
