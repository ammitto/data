  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105159> ;
  ammitto:remarks "Vladimir Lepin is the general designer of JSC Kalashnikov Concern, a company listed by the Union and a Russian developer and manufacturer of military equipment, including personal rifles, missiles and vehicles. JSC Kalashnikov Concern is directly controlled by Rostec. Vikhr-1 guided aircraft missiles and AK-12 assault rifles produced by Kalashnikov Concern are used by the Russian Armed Forces during Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-07-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
