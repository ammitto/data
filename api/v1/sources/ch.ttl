<https://www.ammitto.org/entity/ch/75236>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kazakov Andrei Viktorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75236> ;
  ammitto:remarks "Andrei Kazakov is the Acting General Director of Novorossiya Railways, a company created by a decree of the Government of the Russian Federation on 29 May 2023 to consolidate the railways of the territories of Donetsk, Luhansk, Kherson and Zaporizhzhia not under the control of Ukraine’s government and to move them under the control of the Russian authorities. Novorossiya Railways is being financed from the Russian Federation’s federal budget. Its purpose is to create alternative transport links, which can then be used to transport, among others, military materiel for the purpose of using it in Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1964-03-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
