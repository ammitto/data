<https://www.ammitto.org/entity/ch/45852>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bychak Kanstantsin Fiodaravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45852> ;
  ammitto:remarks "In his position as Head of Division of the KGB Investigation Department, Kanstantin Bychak has supervised politically motivated investigation of presidential candidate Viktar Babarika. Babarika’s candidacy was rejected by the Central Election Commission. This decision was based on a report from the KGB and official TV statements of Bychak declaring Babarika guilty of money laundering while investigations were still ongoing. On Oct 26, 2020, Bychak threatened peaceful protestors on the governmental TV by stating that their actions would be classified as acts of terrorism. He is therefore responsible for the repression of the democratic opposition and civil society." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-09-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/45852>
  a ammitto:SanctionEntry ;
