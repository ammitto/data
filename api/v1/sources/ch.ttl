<https://www.ammitto.org/entity/ch/71561>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “SMP”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71561> ;
  ammitto:remarks "JSC Serov Mechanical Plant is a Russian plant that produces equipment for oil and gas production, geological exploration and mining. The plant is very important because it is one of the leading suppliers of oil drilling and production equipment to major Russian oil companies such as Lukoil, Gazpromneft and Rosneft. In addition to its important role in the Russian fossil fuel industry, JSC Serov Mechanical Plant produces special products\nunder the Russian state defence orders. The plant produces 152 mm calibre projectile casings for the Koalitsiya-SV selfpropelled artillery used by Russia in the war against Ukraine." .
