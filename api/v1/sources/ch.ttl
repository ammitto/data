<https://www.ammitto.org/entity/ch/60823>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "PJSC “Krasnogorsk Plant named after S.A. Zvereva”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60823> ;
  ammitto:remarks "PJSC “Krasnogorsk Plant named after S.A. Zvereva” is a Russian enterprise owned by JSC Shvabe, part of the Rostec corporation engaged in the defence industry. It produces military technology, military equipment and other military hardware. PJSC “Krasnogorsk Plant named after S.A. Zvereva” provides manufactured optoelectronic items which are used by the Russian military in the war of aggression against Ukraine." .
