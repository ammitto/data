<https://www.ammitto.org/entity/ch/73149>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company National Helicopter Center Mil and Kamov" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73149> ;
  ammitto:remarks "JSC National Helicopter Manufacturing Center Named After M.L. Mil and N.I. Kamov includes two research and design bureaus (OCB of Mil and OCB of Kamov), experimental production, an experimental and research complex, and a flight test centre. The enterprise conducts scientific research, designs, builds and tests prototypes of helicopters, introduces them into serial production, and modernises and supports the production and operation of military helicopters “Mi” and “Ka”, used by the Russian Armed Forces in the war of aggression against Ukraine." .
