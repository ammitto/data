  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ivashchenko Konstantin Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56121> ;
  ammitto:remarks "After the capture of the city of Mariupol by the Russian armed forces, the so-called “Head of the Donetsk People’s Republic” Denis Pushilin appointed Konstantin Ivashchenko mayor of Mariupol on 6 April 2022. He was dismissed in January 2023. He publicly supported and participated in the preparations for the illegal referenda in the occupied regions of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-10-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
