<https://www.ammitto.org/entity/ch/70343>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Miranda Media" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70343> ;
  ammitto:remarks "Miranda Media provides telecommunications services to illegal authorities and institutions in illegally annexed Crimea and Sevastopol in the interests of the Russian Federation. The Government of the Russian Federation has recognised Miranda Media as a company of essential significance. It receives substantial financial support from the Russian Federation. It also possesses the internet filtering equipment used by the Russian Government to restrict access to information, has agreed to share its subscriber data with Russian authorities, and has been awarded Russian State contracts to install video surveillance systems. Therefore, Miranda Media is supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
