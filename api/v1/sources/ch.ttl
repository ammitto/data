  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Golubovich Mikhail Vasilyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/53935> ;
  ammitto:remarks "Former member of the so-called “People’s Council” of the so-called “Luhansk People’s Republic”. Appointed as Honorary Citizen of Luhansk in 2016 and as People’s Artist of the so-called “Luhansk People’s Republic” in 2015. He is the artistic director of the Luhansk Academic Ukrainian Music and Drama Theatre in Oboronna. In 2022, he received the Certificate of Honour of the People’s Council of the so-called “Luhansk People’s Republic”. In 2023, he received a letter of thanks from the Deputy Chairman of the State Duma of the Federal Assembly of the Russian Federation and gratitude from the Minister of Culture of the Russian Federation. He has therefore supported and implemented actions and policies which undermine the territorial integrity, sovereignty and independence of Ukraine, and further destabilised Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1943-11-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1943"^^xsd:integer ] .
