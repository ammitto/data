  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gavrilchuk Sergey Alekseevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70320> ;
  ammitto:remarks "Sergey Gavrilchuk is Head of the Yunarmiya Regional Headquarters of the “Republic of Crimea” and a member of the United Russia Party. The All-Russia “Young Army” Military Patriotic Social Movement (Yunarmiya) is a Russian paramilitary organisation. In his capacity as the regional Head of Yunarmiya, he organises activities that promote military training and preparation of youth for military service in the Russian Army." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-05-30"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
