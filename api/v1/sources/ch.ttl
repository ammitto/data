<https://www.ammitto.org/entity/ch/64675>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ANO Dialog" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/64675> ;
  ammitto:remarks "ANO Dialog is a Russian non-profit organisation created by the Moscow Department of Information and Technology (DIT) in 2019 and closely linked to the presidential administration. It was headed by Alexey Goreslavsky, former deputy head of the President’s Department for Public Projects (OPS). Vladimir Tabak has been the director general since 1 December 2021. ANO Dialog has been disseminating online propaganda about the illegally annexed territories in Ukraine." .
