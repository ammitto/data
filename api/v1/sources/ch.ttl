  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Parto Sanat Co" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/9367> ;
  ammitto:remarks "Manufacturer of frequency changers and it is capable of developing and modifying imported foreign frequency changers in a way that makes them usable in gas centrifuge enrichment. It is deemed to be involved in nuclear proliferation activities." .
