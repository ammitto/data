<https://www.ammitto.org/entity/ch/13205>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Esmaili Gholam-Hossein" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13205> ;
  ammitto:remarks "Chief of Staff of Iranian President Raisi since Aug 2021. Judiciary spokesman from Apr 2019 until Jul 2021. Former head of the Tehran judiciary. Former Head of Iran's Prisons Organisation. In this capacity, he was complicit in the massive detention of political protesters and covering up abuses performed in the jailing system." .
