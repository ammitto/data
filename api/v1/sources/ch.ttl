<https://www.ammitto.org/entity/ch/107190>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Transbunker-Novo Company Limited" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107190> ;
  ammitto:remarks "Transbunker-Novo Company Limited is a shipping company based in Russia that specialises in providing technical support. The company is the technical manager of the vessel Ulika, as well as the bunkering tankers Transbunker and Korsakov. Those vessels lack adequate liability insurance and engage in manipulation of Automatic Identification Systems as well as ship-to-ship transfers while transporting crude oil or petroleum products exported from Russia. Therefore, Transbunker-Novo Company Limited manages vessels that transport crude oil or petroleum products exported from Russia and practice irregular and high-risk shipping practices as set out in the International Maritime Organization General Assembly resolution A.1192(33)." .
