  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Novik Viktar Viktaravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85077> ;
  ammitto:remarks "Viktar Novik is a Belarusian judge who has served in the Zhabinka District court since 2017. He was appointed by Aliaksandr Lukashenka. Novik issued numerous rulings against opponents of the Belarusian authorities. He issued politically motivated prison sentences against Vitali Ivanyukovich (2 years), Natalia Letsko (1 years), Andrei Vlasov and Yulia Suvalko (3 years) and Valentin Shumik (2 years)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-05-27"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
