<https://www.ammitto.org/entity/ch/75946>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Avetisyan Vladimir Zograbovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75946> ;
  ammitto:remarks "Vladimir Avetisyan is the former General Director and founder of LLC RBA-Management. LLC RBA-Management is a Russian management company that provides legal, accounting, corporate security and other management services, and which works with customers specialising in the supply of electronic components. LLC RBA-Management manages JSC Compel, which participates in import schemes for electronic components and supplies strategically important microelectronics components to Russian industry, including military industry. By being the General Director and founder of LLC RBA-Management, Vladimir Avetisyan was responsible for the company’s actions and therefore he is responsible for supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-05-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
