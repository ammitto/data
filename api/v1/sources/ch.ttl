  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Musoni Straton" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/3261> ;
  ammitto:remarks "Through his leadership of the FDLR, a foreign armed group operating in the DRC, Musoni is impeding the disarmament and voluntary repatriation or resettlement of combatants belonging to those groups, in breach of resolution 1649 (2005)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-04-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
