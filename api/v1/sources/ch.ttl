<https://www.ammitto.org/entity/ch/57041>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gazmanov Oleg Mikhaylovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/57041> ;
  ammitto:remarks "Russian musician. A member of the Public Council of the Ministry of Defense of the Russian Federation, which was established in 2006 by the Decree of the President of the Russian Federation with a publicly stated purpose to assure civil control over the Ministry of Defense and the Armed Forced of the Russian Federation. He participated in the public events organised by the ruling United Russia party." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1951-07-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1951"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/57041>
  a ammitto:SanctionEntry ;
