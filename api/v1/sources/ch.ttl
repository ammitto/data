<https://www.ammitto.org/entity/ch/88557>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gorshkov Alexey Vladislavovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88557> ;
  ammitto:remarks "Alexey Gorshkov is the General Director of JSC “Scientific Research Institute of Computing Complexes Named After M.A. Kartsev”, a research institute based in Russia and involved in the development and production of unmanned aerial vehicles (UAVs). It has produced several different types of UAVs, which have been or will be tested by Russian armed forces in the war of aggression against Ukraine. Therefore, as the General Director of JSC “Scientific Research Institute of Computing Complexes Named After M.A. Kartsev”, Alexey Gorshkov is supporting or implementing actions or policies which undermine or threaten the territorial integrity, sovereignty and independence of Ukraine. Furthermore, he is associated with JSC “Scientific Research Institute of Computing Complexes Named After M.A. Kartsev”." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-11-08"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
