  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Aung Naing Oo" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/47628> ;
  ammitto:remarks "Aung Naing Oo is the former Minister of Commerce. He was the minister for Investment and Foreign Economic Relations from 2 February 2021 until 18 August 2022. He was appointed by the State Administrative Council (SAC), led by Commander-in-Chief Min Aung Hlaing, which took over the legislative, executive and judicial powers of the State as of 2 February 2021." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-10-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
