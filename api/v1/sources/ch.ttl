  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lukyanovich Andrei Yulyanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50400> ;
  ammitto:remarks "Major General Andrei Lukyanovich is a military pilot, Commander of the Belarusian Air Force and Air Defence Forces/Chief of Aviation of Belarus, and Commander of military unit 06752/Machulishchi airfield. In this capacity, he participated in the joint military exercises of Russia and Belarus preceding the military build-up at the Ukrainian border which prepared the military aggression against Ukraine of 24 February 2022. He is part of the Belarusian army, which has supported Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-09-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
