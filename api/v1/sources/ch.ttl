<https://www.ammitto.org/entity/ch/102042>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Noshad Alireza" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/102042> ;
  ammitto:remarks "Alireza Noshad is the Police Commander of Marvdasht County and a member of the Marvdasht County Security Council. In this capacity, Alireza Noshad directed the violent repression of the nationwide protests in Iran that began in December 2025, resulting in deaths and injuries." .
