  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "National Settlement Depository (NSD)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55580> ;
  ammitto:remarks "NSD is a Russian non-bank financial institution and Russia’s central securities depository. It is the largest securities depository in Russia by market value of equity and debt securities held in custody and the only one which has access to the international financial system." .
