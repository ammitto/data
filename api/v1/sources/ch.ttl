<https://www.ammitto.org/entity/ch/46658>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Butranets Maksim Viktaravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/46658> ;
  ammitto:remarks "In his former position as Head of the Smorgon Border Group, Maksim Butranets was responsible for actions of border guards under his command. The deliberate failure of the Smorgon Border Group to carry out its duties properly facilitates attempts by migrants to cross the border with Union Member States. Maksim Butranets also stated that the number of migrants at the Belarusian-Lithuanian border remained at the usual level, despite the substantial increase observed on the Lithuanian side. He is therefore contributing to activities by the Lukashenka regime that facilitate the illegal crossing of the external borders of the Union. He was appointed as the Head of the Brest Border Group." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-12-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
