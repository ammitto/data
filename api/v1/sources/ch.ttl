<https://www.ammitto.org/entity/ch/63010>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint-stock company “PMC Wagner Centre”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63010> ;
  ammitto:remarks "PMC Wagner Centre is a Russian commercial venture, aiming to support private sector investment and innovation in order to support and bolster Russia’s defence capabilities. The Centre is overseeing engineering and IT projects with that goal and has launched a program on the operating of unmanned aerial vehicles (UAVs). The Centre and its activities are closely connected to its namesake, the PMC Wagner Group, a Russia-based unincorporated military entity, responsible for the deployment of Wagner Group mercenaries in Ukraine." .
