<https://www.ammitto.org/entity/ch/75831>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gurbich Vladimir Grigorievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75831> ;
  ammitto:remarks "Vladimir Gurbich is the General Director of Joint Stock Company (JSC) NPO PRZ. JSC NPO PRZ is part of the Almaz-Antey concern. JSC NPO PRZ manufactures, repairs and modernises radar equipment for air defence troops, and for a number of products it is the only manufacturer. Together with partners, it produces radar systems and stations, antenna systems and radar equipment of various types in use by the Russian Armed Forces in their war of aggression against Ukraine. Therefore, Vladimir Gurbich is supporting actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine. He is also associated with JSC NPO PRZ." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1948-07-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1948"^^xsd:integer ] .
