<https://www.ammitto.org/entity/ch/86550>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Alabuga Development" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86550> ;
  ammitto:remarks "LLC Alabuga Development is a Russian producer of machine tools and gears, as well as a manufacturer of metal constructions, communication devices and electric gear. It is also a 100 % subsidiary of JSC “Alabuga” Special Economic Zone of Industrial and Production Type (entity listed by the Union since 18 December 2023), which is thus the ultimate beneficial owner of LLC Alabuga Development." .
