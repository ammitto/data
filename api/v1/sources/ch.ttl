<https://www.ammitto.org/entity/ch/90939>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Precise Electro-Mechanics Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/90939> ;
  ammitto:remarks "Precise Electro-Mechanics Plant is a Belarusian State enterprise that specializes in the development and production of military products and subordinate to the State Military-Industrial Committee of the Republic of Belarus. In this capacity Precise Electro-Mechanics Plant produces military hardware in use by the Belarus armed forces, notably ballistic missiles and provides revenue to the Belarusian State." .
