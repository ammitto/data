<https://www.ammitto.org/entity/ch/59196>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Concern Radio-Electronic Technologies (KRET)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/59196> ;
  ammitto:remarks "Concern Radio-Electronic Technologies KRET is Russia’s major developer and manufacturer of military radio-electronic products. It is a Rostec subsidiary. It manufactured Krasukha-4 electronic warfare systems, that were used by the Armed Forces of the Russian Federation during Russia’s war of aggression against Ukraine." .
