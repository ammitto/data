<https://www.ammitto.org/entity/ch/59158>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Egorov Daniil Vyacheslavovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/59158> ;
  ammitto:remarks "Daniil Vyacheslavovich Egorov is a member of the ‘Coordination Council under the Government of the Russian federation to meet the needs of the Armed Forces of the Russian Federation, other troops, military formations and bodies’, established on 21 October 2022. The Coordination Council was created in order to organise interaction between federal executive bodies and executive bodies of the constituent entities of Russia in resolving issues related to ensuring the needs of the Russian Armed Forces during the war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-09-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
