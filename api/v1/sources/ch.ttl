<https://www.ammitto.org/entity/ch/98614>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ODK-Ufa Engine-Building Production Association" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98614> ;
  ammitto:remarks "ODK-Ufa Engine-Building Production Association (ODK-UMPO) is Russia’s largest gas turbine engine manufacturer and a key subsidiary of the State-owned United Engine Corporation (UEC), which plays a central role in the country’s military-industrial complex. During the Army-2024 military forum, ODK-UMPO made a deal on a 27,5 billion rouble injection from Rostec State Corporation to support its ongoing operations, further reinforcing its strategic importance." .
