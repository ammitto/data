  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Open Joint Stock Company “Special Design Bureau of Instrument Engineering and Automation”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92932> ;
  ammitto:remarks "OJSC Special Design Bureau of Instrument Engineering and Automation (OJSC “SKB PA”) is a company active in Russia’s military and industrial complex, specialised in the development and creation of electrohydraulic, electromechanical, navigation and control systems for mobile civil and special-purpose equipment. OJSC “SKB PA” holds licences for handling state secrets and developing military equipment." .
