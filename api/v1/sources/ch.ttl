<https://www.ammitto.org/entity/ch/62667>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Plahotniuc Vladimir Gheorghe" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/62667> ;
  ammitto:remarks "Vladimir Plahotniuc is subject to numerous criminal proceedings in the Republic of Moldova related to crimes in connection with the embezzlement of State funds of the Republic of Moldova and their illegal transfer outside the Republic of Moldova. He was accused in the Republic of Moldova in the “Bank Fraud” case, the economic effects of which are still affecting the country. He is also being investigated for bribing the former president of the Republic of Moldova with a bag of cash in exchange for political favours. Furthermore, he has held meetings with the Kremlin to gain support for his interference in the 2025 parliamentary elections in the Republic of Moldova." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-01-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
