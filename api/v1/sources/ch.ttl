<https://www.ammitto.org/entity/ch/4624>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Iarmoshyna Lidziia Mikhailauna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4624> ;
  ammitto:remarks "Chairwoman of the Central Election Commission of Belarus. Since 1996, she has been one of the main persons participating in the falsifications of the fraudulent elections and referendum, in particular in 2004, 2006, 2008, 2010, 2012." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1953-01-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1953"^^xsd:integer ] .
