<https://www.ammitto.org/entity/ch/75689>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Turobova Hanna Serhiyivna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75689> ;
  ammitto:remarks "Hanna Turobova is a Prosecutor of the Crimea Prosecutor’s Office. In her position, she prosecuted before the Crimean Supreme Court three Jehovah’s Witnesses who were oppressed for their religious beliefs. She also filed charges against the journalist and human rights activist Irina Danilovich, for denouncing policies and actions taken by the Russian Federation in the illegally annexed Crimea and Sevastopol." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-08-10"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
