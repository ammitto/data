<https://www.ammitto.org/entity/ch/75356>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Klychkov Andrei Evgenyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75356> ;
  ammitto:remarks "Andrey Klychkov is the Governor of Oryol Oblast. In his role as Governor, he is involved in the illegal deportation of Ukrainian children to Russia. He has personally visited camps in Russia to which Ukrainian children have been sent and has issued instructions that the children be provided with Russian citizenship. Those actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order. Therefore, Andrei Klychkov is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1979-09-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1979"^^xsd:integer ] .
