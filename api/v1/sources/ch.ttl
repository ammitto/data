<https://www.ammitto.org/entity/ch/65268>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pirozhnikava Tatsiana Valerieuna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/65268> ;
  ammitto:remarks "In her position as Judge of Moskovsky district of Minsk, Tatsiana Pirozhnikava sentenced several Belarusian citizens on political grounds, including for their participation in protests and for publishing anti-government comments on Telegram. She is documented as occasionally issuing heavier sentences than those requested by the prosecutor. She is therefore responsible for serious human rights violations and for seriously undermining the rule of law, as well as for the repression of civil society and democratic opposition In Belarus." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1987-01-08"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1987"^^xsd:integer ] .
