<https://www.ammitto.org/entity/ch/86895>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Li Xiaocui" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86895> ;
  ammitto:remarks "Li Xiaocui (“Sophia Li”) is a Chinese businessperson. She controls and represents enterprises from the People’s Republic of China and Hong Kong which have been designated by the European Union for having infringed prohibitions against circumvention of the Union’s restrictive measures regime imposed on the Russian Federation, namely ARCLM International Trading Co. Ltd and Shijiazhuang Hanqiang Technology Co. Those infringements included the export of listed goods to Unimatik, a major actor in the Russian Military-Industrial Complex. Li Xiaocui thus facilitated infringements of the prohibition against circumvention of the Union’s restrictive measures regime imposed on the Russian Federation and thus additionally significantly frustrated existing Union restrictive measures provisions." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-03-31"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
