<https://www.ammitto.org/entity/ch/60213>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Asia Sun Group" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60213> ;
  ammitto:remarks "Asia Sun Group is involved in the supply chain of aviation fuel to the military. Asia Sun Group of companies through its subsidiaries, Asia Sun Trading and Asia Sun Energy, is involved in the import of aviation fuel. Asia Sun Trading was involved at least twice in 2022 in importing aviation fuel from Thailand for use by the Myanmar Air Force." .
