  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sokolova Olga Mikhailovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104705> ;
  ammitto:remarks "Olga Sokolova is the general manager of the LLC “UAMOC” a Russia-based company which produces First Person View (FPV) drones for the Russian Armed Forces. The company was founded after the start of Russia’s full-scale war against Ukraine and rapidly expanded its production. LLC “UAMOC” produces FPV drones “Kort”, “Brus-1”, “Osa” and “Boomerang”, which are used in the war against Ukraine. It also launched a production and testing facility in the illegally occupied Luhansk and Sevastopol." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-01-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
