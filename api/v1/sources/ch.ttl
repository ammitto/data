  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Special Design Technology Bureau Kurganpribor”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104876> ;
  ammitto:remarks "Joint Stock Company “Special Design Technology Bureau Kurganpribor” is part of JSC “NPO ‘Kurganpribor’” as a separate design and research division that produces a wide range of products for the defence industry. It develops products such as sensors for air-to-air and air-to-surface missiles." .
