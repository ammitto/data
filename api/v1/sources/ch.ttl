  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ovchinnikov Nikolay Alekseyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73060> ;
  ammitto:remarks "Nikolay Ovchinnikov is the General Director of Russian military industry company Zavod no 9. The company manufactures towed guns, including the D-30A howitzer, and tank guns for T-62, T-72 and T-90 tanks. D-30 howitzers and T-62, T-72 and T-90 tanks are\nused by the Russian Armed Forces during Russia’s war of aggression against Ukraine. Moreover, the company is a supplier of the Russian Armed Forces." .
