  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98199> ;
  ammitto:remarks "Oksana Lugantseva is the Chief of Staff of the regional branch of “Yunarmiya” within the so-called “Luhansk People’s Republic”. Under her leadership, the regional branch promotes sentiments that Luhansk is Russian. Moreover, the regional branch encourages Ukrainian children to be faithful to Russia, and to enrol in its armed forces. The regional branch also provides the children with militarised education." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-02-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
