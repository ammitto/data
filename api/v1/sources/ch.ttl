<https://www.ammitto.org/entity/ch/61071>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Moskalkova Tatiana Nikolaevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61071> ;
  ammitto:remarks "Tatiana Moskalkova is the Commissioner for Human Rights of the Russian Federation. In that capacity, she serves as a key government interlocutor, actively promoting official narratives that deny the existence of Russian “filtration” and deportation practices implemented vis-à-vis the Ukrainian population. Authoritative sources confirm that \"filtration” camps are part of a major Russian effort to “filter” the Ukrainian population as a means of suppressing Ukrainian resistance and enforcing loyalty among the remaining population. As part of Russia’s “filtration” operations, Russia’s forces and proxies have interrogated, detained, and forcibly deported between 900 000 and 1,6 million Ukrainian citizens, including thousands of children." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1955-05-30"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1955"^^xsd:integer ] .
