<https://www.ammitto.org/entity/ch/5019>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sirenka Viktar Ivanavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/5019> ;
  ammitto:remarks "Deputy Governor of the Minsk region (since January 2015), former Head of the Committee for Health Care of Minsk City and former Chief Surgeon of the Minsk Emergency Hospital. He did not oppose the kidnapping of the presidential candidate, Nekliayev, who was transported to his hospital after being severely beaten on 19 Dec 2010 and, by failing to call the police, cooperated with the unknown perpetrators. Such inaction led him to be promoted. As Head of the Committee for Health Care of Minsk City he was responsible for supervising use of labour-sanitary institutions in the suppression of human rights." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-03-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
