  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tolstoy Pyotr Olegovych" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/48040> ;
  ammitto:remarks "Pyotr Tolstoy is a Member and Deputy Speaker of the State Duma and was the head of the Russian delegation at the Parliamentary Assembly of the Council of Europe (PACE) until 25 February 2022. He has also been the host of the television programme “Vremya Pokazhet”. A central figure in Government propaganda, he frequently takes positions in favour of the annexation of Crimea. He publicly supports Russian’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-06-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
