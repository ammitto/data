<https://www.ammitto.org/entity/ch/89178>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Derkach Andrii Leonidovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89178> ;
  ammitto:remarks "Andrii Derkach is a former Ukrainian politician, and is a Senator of the Federation Council since 12 September 2024 and a member of that Council’s Committee on Defence and Security since 23 October 2024. Since becoming a Senator, he has supported policies contributing to Russia’s illegal annexation of Crimea and Russia’s war of aggression against Ukraine. During his time as a member of Ukraine’s parliament before 2022, he actively supported the Russian Government by collaborating with the Main Intelligence Directorate of the General Staff of the Armed Forces of the Russian Federation (GRU). Andrii Derkach received funds from the GRU to create private security companies that Russia planned to use to invade Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1967-08-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
