  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Sarapul Electric Generator Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98676> ;
  ammitto:remarks "JSC “Sarapul Electric Generator Plant” (SEGZ) is a Russian company manufacturing power generation, control and protection systems, equipment for military aircraft and helicopters, and components for rocket technology. JSC SEGZ produces critical parts for Russian long-range aircraft. The company participates in the fulfilment of the Russian State defence order, with over half of its revenue derived from military contracts. Therefore, JSC SEGZ is forming part of Russia’s military and industrial complex, including by being involved in the development, production or supply of military technology and equipment." .
