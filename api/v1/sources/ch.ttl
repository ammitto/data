<https://www.ammitto.org/entity/ch/52264>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khan German Borisovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52264> ;
  ammitto:remarks "German Khan is a Russian businessperson maintaining a close relationship with the President of the Russian Federation, Vladimir Putin, similarly to his business partners, Mikhail Fridman, Petr Aven and Alexey Kuzmichev. In March 2022, he transferred his shares in ABH Holdings, which controls a major Russian bank, Alfa Bank, to his long-time business partner Andrei Kosogov. This transfer was however declared by the National Bank of Ukraine to be null and void." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-10-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
