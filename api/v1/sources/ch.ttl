  ammitto:remarks "Hayk Gasparyan, known as “Abrek”, is the commander of the assault forces of the Wagner Group in Ukraine and the commander of “ArBat” battalion." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1991-07-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1991"^^xsd:integer ] .
