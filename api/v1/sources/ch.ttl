  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Demidov Dmitriy Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72841> ;
  ammitto:remarks "Dmitriy Demidov is the Chairman of the Novopolotsk City Executive Committee. In this role, he has been responsible for the illegal deportation of Ukrainian children to the Republic of Belarus. Dmitriy Demidov is one of the key persons involved in the forcible deportation of Ukrainian children to Belarus and their subsequent illegal adoption by Russian and Belarusian families. His actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-12-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
