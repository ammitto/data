  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chernyshenko Dmitry Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50818> ;
  ammitto:remarks "Dmitry Chernyshenko is Deputy Prime Minister of Russia for Tourism, Sport, Culture and Communications and until June 2024 was also a member of the Board of Directors of the Russian Railways, appointed to this position by the Government of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-09-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
