<https://www.ammitto.org/entity/ch/89604>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "SouthFront" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89604> ;
  ammitto:remarks "SouthFront is a Russian website engaging in consistent manipulative messaging in multiple languages through multiple online channels. It targets European and global audiences with distorted and manipulated information, in line with Kremlin messaging, seeking in particular to undermine the security and stability of Ukraine. SouthFront has ties to the Federal Security Service of the Russian Federation." .
<https://www.ammitto.org/entry/ch/consolidated-list/89604>
