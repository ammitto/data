<https://www.ammitto.org/entity/ch/77568>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nangaa Yobeluo Corneille" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77568> ;
  ammitto:remarks "Corneille Nangaa Yobeluo holds a leading position as founder, leader and political coordinator of the “Alliance Fleuve Congo” (AFC), a politico-military movement operating in Eastern DRC and openly associated with several non-governmental armed groups, including the March 23 Movement / Congolese Revolutionary Army (M23/ARC)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-07-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
