  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Design Bureau of Instrument-Making Named After Academic A. G. Shipunov" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69431> ;
  ammitto:remarks "JSC Design Bureau of Instrument-Making Named After Academic A. G. Shipunov (JSC KBP) is one of the oldest enterprises in the Russian defence complex. It develops a wide variety of heavy military equipment including Kornet anti-tank weapons, Krasnopol missiles, and Tunguska and Pantsir-S1 anti-aircraft systems. JSC KBP belongs to the Russian state corporation Rostec." .
