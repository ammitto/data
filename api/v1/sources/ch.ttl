<https://www.ammitto.org/entity/ch/75144>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nuriev Konstantin Sergeyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75144> ;
  ammitto:remarks "Konstantin Nuriev is the General Director of R-Stroy LLC, which has received Russian government contracts to re-build the city of Mariupol, currently under Russian control. It operates in the occupied territories of Ukraine, without the permission of the Ukrainian authorities." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1987-09-27"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1987"^^xsd:integer ] .
