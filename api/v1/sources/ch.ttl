<https://www.ammitto.org/entity/ch/70729>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC Mayak" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70729> ;
  ammitto:remarks "LLC Mayak is a wholesaler based in Russia. The company is involved in the “parallel import” to Russia of goods falling under Union restrictive measures. Such goods are imported without the consent of the manufacturer. Therefore, LLC Mayak is significantly frustrating the provisions of Regulation (EU) No 833/2014." .
