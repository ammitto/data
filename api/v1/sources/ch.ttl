<https://www.ammitto.org/entity/ch/71681>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Military-patriotic centre “Vympel”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71681> ;
  ammitto:remarks "Military-patriotic centre “Vympel” is an organisation, created by former members of the Russian security services for the purpose of providing patriotic education to children, which includes militarised education. This includes military education for teenagers and organising camps for younger children. It is financed by the Russian Government." .
<https://www.ammitto.org/entry/ch/consolidated-list/71681>
