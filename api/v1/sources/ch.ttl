  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Taghipour Reza" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13373> ;
  ammitto:remarks "Member of the 11th Iranian parliament (Tehran constituency). Member of the Supreme Cyberspace Council. Former Member of the City Council of Tehran. Former Minister for Information and Communications (2009-2012)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1957"^^xsd:integer ] .
