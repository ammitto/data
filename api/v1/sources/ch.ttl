<https://www.ammitto.org/entity/ch/72531>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lukyanov Mikhail Valentinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72531> ;
  ammitto:remarks "Mikhail Lukyanov is the former Director of Oboronlogistics LLC. Oboronlogistics LLC is a shipping company established under the Russian Ministry of Defence. The company is providing logistical support to the Ministry of Defence of the Russian Federation. In particular, Oboronlogistics LLC is involved in a military transportation network of Russian cargo vessels shipping North Korean armaments from Pyongyang to military facilities in the Russian port of Dunai. Subsequently, North Korean munitions transported by Oboronlogistics LLC are transferred to depots on Russia’s western border to be deployed in Russia’s war of aggression against Ukraine." .
