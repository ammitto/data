<https://www.ammitto.org/entity/ch/50751>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sechin Igor Ivanovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50751> ;
  ammitto:remarks "Igor Sechin is CEO of Rosneft, Russian state oil company and one of the world's largest crude oil producers. He is one of Vladimir Putin’s most trusted and closest advisors, as well as his personal friend. He has been in contact with the Russian President on a daily basis. He is considered to be one of the most powerful members of the Russian political elite. His connections to Vladimir Putin are long and deep. He worked with the President in the St Petersburg mayor’s office in the 1990s and has proved his loyalty ever since. In 1999 Mr Sechin became Vladimir Putin’s deputy head of his administration, in 2008 deputy Prime Minister, and in 2012 Rosneft’s CEO. He is one of the Russian oligarchs operating in partnership with the Russian state." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-09-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
