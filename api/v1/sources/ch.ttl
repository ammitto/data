<https://www.ammitto.org/entity/ch/57400>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Swe Swe Aung" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/57400> ;
  ammitto:remarks "Swe Swe Aung is the Director-General of the Prosecution Department in the Ministry of Legal Affairs, appointed by the State Administrative Council (SAC) on 31 March 2022. The Prosecution Department, under Swe Swe Aung’s leadership, has been involved in several judicial cases against democratically elected leaders and opposition figures that were conducted in violation of rights of defense and right to a fair trial, including the proceedings leading to the execution of four pro-democracy figures. Therefore, in her capacity as Director-General of the Prosecution Department, Swe Swe Aung is engaged in activities that undermine democracy and the rule of law in Myanmar/Burma." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/57400>
