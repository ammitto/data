<https://www.ammitto.org/entity/ch/72363>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Petrushenko Vladimir Georgievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72363> ;
  ammitto:remarks "Vladimir Petrushenko is the General Director of JSC Design Bureau of Mechanical Engineering, which is a military industry company involved in developing weapons for the Russian Armed Forces. JSC Design Bureau of Mechanical Engineering is the lead developer for the Bal missile system, which is used by the Russian Armed Forces in the war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1950-04-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1950"^^xsd:integer ] .
