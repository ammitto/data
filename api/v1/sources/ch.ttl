  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "China Head Aerospace Technology Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89076> ;
  ammitto:remarks "China Head Aerospace Technology is a PRC-based firm specialised in the production of satellite imagery. The firm is an official supplier of remote sensing data to Russian firm Rakurs, which is a supplier of the Russian Ministry of Defence." .
