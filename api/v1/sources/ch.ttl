<https://www.ammitto.org/entity/ch/65203>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Maksimavich Mikalai Vasilievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/65203> ;
  ammitto:remarks "In his capacity as Deputy Chief of the Public Security Militia, Internal Affairs Directorate of the Minsk Regional Executive Committee, Mikalai Maksimavich is responsible for the brutal crackdown on peaceful protests in the run-up to the presidential elections in Aug 2020 and afterwards. He has personally given orders to the riot police, OMON, to violently suppress the demonstrations, detain the protesters and the independent journalists covering these events, and submit them to harsh conditions of detention. He is therefore responsible for serious violations of human rights and the repression of civil society in Belarus." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-02-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/65203>
  a ammitto:SanctionEntry ;
