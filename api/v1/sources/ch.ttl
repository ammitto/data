<https://www.ammitto.org/entity/ch/103185>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kondrov Andrey Viktorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103185> ;
  ammitto:remarks "Colonel Andrey Kondrov is the Commander of the 5th Separate Tank Brigade of the 36th Combined Arms Army. That brigade, led by Andrey Kondrov, is accused of looting and murdering residents in Bucha. Those atrocities in Bucha constitute crimes against humanity and war crimes." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-08-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
