  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Korean Tangun Trading Corporation" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
