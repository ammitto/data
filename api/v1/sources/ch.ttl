<https://www.ammitto.org/entity/ch/94535>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Beșchieru Alexandru" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94535> ;
  ammitto:remarks "Alexandru Beșchieru is the leader of the “Forța de Alternativă și de Salvare a Moldovei” (“FASM”) political party, which is one of the successors of the outlawed ȘOR political party, led by Ilan Shor. In April 2024, Ilan Shor launched in Moscow the Victory/Pobeda Political Bloc, which unites the successors of his party, including FASM." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-07-05"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
