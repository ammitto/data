<https://www.ammitto.org/entity/ch/69607>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sulteeva Lidia Mikhailovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69607> ;
  ammitto:remarks "Lidia Sulteeva is the wife of Rustem Nurgasimovich Sulteev. She and her husband are the owners of Vulkan LLC, a company which was used for the transfer of assets between TAIF PSC and SIBUR Holding. Furthermore, Lidia Sulteeva and Rustem Sulteev, through Financial Company Progress LLC, own more than half of the capital of TA-Information\nTechnologies LLC, which manufactures electronics." .
