<https://www.ammitto.org/entity/ch/105206>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "CJSC Belarusian Oil Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105206> ;
  ammitto:remarks "CJSC Belarusian Oil Company is Belarus’s leading exporter of petroleum and is owned by several of the largest oil production and refining enterprises in the Republic of Belarus, including Belorusneft and Naftan. Via its ownership structure, BNK is controlled by the Government of Belarus. The appointment of its General Director is agreed by Aliaksandr Lukashenka, who also names the direction in which the company should be steered. Therefore, BNK is associated with entities supporting the Lukashenka regime and is owned and controlled by entities responsible for the repression of Belarusian civil society and supporting the Lukashenka regime." .
