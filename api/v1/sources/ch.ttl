<https://www.ammitto.org/entity/ch/55482>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Kronshtadt Tekhnologii Group of Companies" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55482> ;
  ammitto:remarks "JSC Kronshtadt Tekhnologii is a Russian military contractor which develops and manufactures equipment, software and integrated solutions for unmanned aerial vehicles and Russian defence industry. The Armed Forces of the Russian Federation used Orion unmanned aerial vehicles manufactured by Kronshtadt Tekhnologii during Russia’s unprovoked and unjustified military aggression against Ukraine. The company continues to produce and develop Orion drones, which are increasingly used in the war." .
