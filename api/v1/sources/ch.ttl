<https://www.ammitto.org/entity/ch/38126>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kibelisa Roger" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38126> ;
  ammitto:remarks "As Interior Director of the National Intelligence Service (ANR), Roger Kibelisa is involved in the intimidation campaign carried out by ANR officials towards opposition members, including arbitrary arrests and detention. Roger Kibelisa has therefore undermined the rule of law and obstructed a consensual and peaceful solution towards elections in DRC." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-09-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
