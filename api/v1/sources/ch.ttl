  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “53 Arsenal”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88907> ;
  ammitto:remarks "JSC 53 Arsenal is a Russian military industry company. JSC 53 Arsenal restores and produces ammunition used by the Russian military in Russia’s war of aggression against Ukraine. JSC 53 Arsenal therefore materially supports and benefits from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine.In addition, the parent company of JSC 53 Arsenal is JSC Technodinamika, and therefore JSC 53 Arsenal is associated with JSC Technodinamika. JSC Technodinamika is a weapons, ammunition, chemistry and aviation products manufacturer, and military provider of the Armed Forces of the Russian Federation." .
