<https://www.ammitto.org/entity/ch/72326>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bobrov Vladimir Alexandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72326> ;
  ammitto:remarks "Vladimir Bobrov is the former Director of MG-Flot LLC (previously known as TransMorFlot LLC). MG-Flot LLC is a Russian shipping company providing logistical support to the Ministry of Defence of the Russian Federation. In particular, MG-Flot LLC is involved in a military transportation network of Russian cargo vessels shipping North Korean armaments from Pyongyang to military facilities in the Russian port of Dunai. Subsequently, North Korean munitions transported by MG-Flot LLC are transferred to depots on Russia’s western border to be deployed in Russia’s war of aggression against Ukraine. Additionally, vessels owned by MG-Flot LLC have been involved in weapons shipments from Iran to aid Russia’s full-scale invasion of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/72326>
  a ammitto:SanctionEntry ;
