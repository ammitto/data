  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Paulichenka Dzmitry Valerievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4617> ;
  ammitto:remarks "Key person in the unresolved disappearances of Yuri Zakharenko, Viktor Gonchar, Anatoly Krasovski and Dmitri Zavadski in Belarus in 1999-2000. Former Commander of the Special Rapid Response Unit (SOBR) at the Ministry of Internal Affairs (MoIA)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
