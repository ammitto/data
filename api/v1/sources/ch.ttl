  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Baikin Evgeniy Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72602> ;
  ammitto:remarks "Evgeniy Baikin is a Director of JSC Globus, a specialised enterprise engaged in development, production and implementation of automated systems for the maintenance and control of weapons and military equipment. The enterprise is engaged in the development and manufacture of complexes, designed to prepare for combat use, and to monitor the technical condition of, airborne guided weapons, missile air and naval defence systems." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-07-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
