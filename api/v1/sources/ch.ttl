<https://www.ammitto.org/entity/ch/5374>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bandarenka Siarhei Uladzimiravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/5374> ;
  ammitto:remarks "Judge of the Pervomaiski District Court of Minsk. On 24 Nov 2011 he sentenced Ales Byalyatski, one of the most prominent human rights defenders, Chief of the Belarusian HR Centre «Vyasna», Vice President of FIDH. The trial was conducted in a way that was a clear violation of the Code of Criminal Procedure. Byalyatski was active in defending and providing assistance to those who suffered from repression in relation with the 19 Dec 2010 elections and the crackdown on civil society and democratic opposition." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
