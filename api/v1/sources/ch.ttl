<https://www.ammitto.org/entity/ch/13287>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khalilollahi Moussa" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13287> ;
  ammitto:remarks "Chief of Justice of East Azerbaijan province. Former prosecutor of Tabriz from 2010 to 2019. He was involved in Sakineh Mohammadi-Ashtiani’s case and is complicit in grave violations of the right to due process." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
