<https://www.ammitto.org/entity/ch/32655>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Godefroid Bizimana" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/32655> ;
  ammitto:remarks "“Chargé de missions de la Présidence” and former Deputy Director-General of the National Police. On 31 Dec 2019, Mr Bizimana was promoted to the rank of Chief Police Commissioner. Responsible for undermining democracy by making operational decisions that have led to a disproportionate use of force and acts of violent repression towards peaceful demonstrations that started on 26 Apr 2015 following the announcement of the presidential candidacy of President Nkurunziza." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-04-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/32655>
  a ammitto:SanctionEntry ;
