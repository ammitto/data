  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company Aero-HIT" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105290> ;
  ammitto:remarks "LLC Aero-HIT is Russia-based company which was founded as an innovative project aimed at developing, producing and maintaining of UAV’s. LLC Aero-HIT assembles UAV “Veles”, a multi-rotor first person view strike drone, which can be used as an attack drone, optical reconnaissance device, or as part of an electronic reconnaissance system." .
