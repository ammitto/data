<https://www.ammitto.org/entity/ch/72740>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ponomarev Sergey Alekseevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72740> ;
  ammitto:remarks "Sergey Ponomarev is the General Director of JSC Corporation MIT. JSC Corporation MIT is a Russian developer of missile armament. JSC Corporation MIT developed mobile ground-based missile systems with solid-propellant guided ballistic missilesTemp-S, Temp-2S, Pioneer, Topol, Topol-M, Yars and others. Mobile ground-based complexes with ballistic missiles, developed by the corporation, are used by the Russian Armed Forces. In addition, JSC Corporation MIT ran an aid collection campaign entitled “MIT Helps!” to help soldiers and militias of the unrecognised so-called Donetsk and Lugansk People’s Republics." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1954-05-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
