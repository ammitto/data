<https://www.ammitto.org/entity/ch/107247>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint-Stock Company Engels Experimental Design Bureau “Signal” named after A.I. Glukharev" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107247> ;
  ammitto:remarks "Joint-Stock Company Engels Experimental Design Bureau “Signal” named after A.I. Glukharev develops and manufactures sensor equipment such as alarms, pressure gauges, pressure measurement systems and temperature sensors for use in difficult operating conditions for aviation, rocket, space and marine facilities. Sensors manufactured by Joint-Stock Company Engels Experimental Design Bureau “Signal” named after A.I. Glukharev are used in aircrafts Su-27, Su-35 and helicopters Mi-8, which are all used in Russia’s war of aggression against Ukraine." .
