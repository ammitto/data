<https://www.ammitto.org/entity/ch/28539>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Abisov Sergey Vadimovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/28539> ;
  ammitto:remarks "By accepting his appointment as so-called “Minister of the Interior of the ‘Republic of Crimea’” by the President of Russia (decree No 301) on 5 May 2014 and by his actions as so-called “Minister of the Interior” he has undermined the territorial integrity, sovereignty and unity of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1967-11-27"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
