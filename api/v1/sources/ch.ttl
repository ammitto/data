<https://www.ammitto.org/entity/ch/107212>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rustakt LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/107212> ;
  ammitto:remarks "Rustakt LLC is a Russian entity involved in the import of components for Unmanned Aerial Vehicles (UAVs), and in the assembly of UAVs. Rustakt LLC manufactures VT-40 First Person View (FPV) drones and supplies them to the Russian Armed Forces for use in Ukraine. Therefore, Rustakt LLC is supporting Russia’s military and industrial complex." .
