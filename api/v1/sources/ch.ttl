<https://www.ammitto.org/entity/ch/98889>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company Molot Arms" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98889> ;
  ammitto:remarks "LLC Molot Arms, founded in 2011 in Moscow, is a Russian defence manufacturer engaged in the production of firearms and unmanned aerial systems (UAVs). Its flagship product is the “Zhmil-17” first-person view (FPV) combat UAV, manufactured in Kirov Oblast since 2023 and supplied to Russian forces in Ukraine. The company’s current monthly output exceeds 500 UAV units, with State-backed plans to increase to 1 000 UAVs per month in 2025." .
