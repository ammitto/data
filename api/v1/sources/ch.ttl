<https://www.ammitto.org/entity/ch/98644>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company AvtoVAZ" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98644> ;
  ammitto:remarks "JSC AvtoVAZ is a Russian State-owned car manufacturing company. The company has created a structural division responsible for supporting its employees that participate in the so-called “special military operation” and their families, offering benefits to them. The Russian authorities have recognised the attention JSC AvtoVAZ offers to its employees who have fought in the war of aggression against Ukraine, and their family members. The company has given cars to plant workers who have fought in the war, and promised to cover the costs of maintenance for them." .
