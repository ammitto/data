  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gasparyan Armen Sumbatovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52333> ;
  ammitto:remarks "Armen Gasparyan runs his own show “Nablyudenye” for Russian media outlet Sputnik and a radio show on “Vesti FM”. He also publishes books and audiobooks and acts as an expert in radio show “Polnyi kontakt” (“Full contact”) of another propagandist Vladimir Solovyov. On 6 April 2023, he was nominated as a member of the Civic Chamber of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1975-07-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1975"^^xsd:integer ] .
