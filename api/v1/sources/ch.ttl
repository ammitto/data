  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dugin Aleksander Gelyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/57103> ;
  ammitto:remarks "Russian political philosopher, political scientist, analyst, strategist and long- standing ideologue of the theories of Russky Mir and Eurasianism. He is a member of the so-called Izborsk Club, a Russian Conservative think tank which specializes in studying Russia’s foreign and domestic policy." ;
