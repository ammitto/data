<https://www.ammitto.org/entity/ch/94999>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pleskachevsky Felix Feliksovych" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94999> ;
  ammitto:remarks "Felix Pleskachevsky is the General Director of JSC Scientific and Production Association “POISK”, a leading Russian manufacturer of weapons and ammunition as well as a leading entity for the development of mechanical, electromechanical and electronic multifunctional fuses for ammunition. The company has well-established cooperation with some of the major Russian defence companies, such as Tekhmash, Air Defence Concern Almaz-Antey and Tactical Missile Weapons Corporation. In recent years, JSC Scientific and Production Association “POISK” has developed over 20 different types of fuse for all types of ammunition used by the Russian army in its war of aggression against Ukraine. Moreover, the company is the developer of the 9E133M safety and actuating mechanism for the 9M723 Iskander-M ballistic missiles." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1967-05-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/94999>
  a ammitto:SanctionEntry ;
