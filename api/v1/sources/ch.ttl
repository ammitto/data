  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kahimbi Delphin" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38132> ;
  ammitto:remarks "Delphin Kahimbi has been assistant Chief of Staff within the FARDC General Staff since Jul 2018, with responsibility for intelligence. Owing to his role, he bears responsibility for the recent human rights violations committed by the FARDC." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-01-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
