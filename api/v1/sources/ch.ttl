<https://www.ammitto.org/entity/ch/23799>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Forces démocratiques de libération du Rwanda (FDLR)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/23799> ;
  ammitto:remarks "The Forces démocratiques de libération du Rwanda (FDLR) is one of the largest foreign armed groups operating in the territory of the Democratic Republic of the Congo (DRC). The group was formed in 2000, and has committed serious violations of international law involving the targeting of women and children in armed conflict, including killing and maiming, sexual violence, and forced displacement." .
<https://www.ammitto.org/entry/ch/consolidated-list/23799>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/ch/23799> ;
