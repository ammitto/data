<https://www.ammitto.org/entity/ch/51290>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Melnichenko Andrey Igorevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51290> ;
  ammitto:remarks "Andrey Melnichenko is a Russian industrialist who continues to control major fertiliser producer EuroChem Group and coal company SUEK. On 9 March 2022, Melnichenko transferred his interests in SUEK and EuroChem Group to his spouse, Aleksandra Melnichenko. Andrey Melnichenko continues to benefit from the wealth he transferred to his wife. His wealth has increased very considerably in recent years." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-03-08"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
