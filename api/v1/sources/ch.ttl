<https://www.ammitto.org/entity/ch/55421>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OJSC Ulyanovsk Automobile Plant (UAZ)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55421> ;
  ammitto:remarks "UAZ is a Russian car manufacturer. It provides the Armed Forces of the Russian Federation with UAZ Patriot vehicles, which were used by the Russian army during the unprovoked and unjustified military aggression against Ukraine. UAZ factory is being modernised thanks to orders from the Ministry of Defense. In September 2022, the company was also, after an audit, included in the military register which harmonises the procedures for access to public procurement in the defense sector." .
<https://www.ammitto.org/entry/ch/consolidated-list/55421>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/ch/55421> ;
