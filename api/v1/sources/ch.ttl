<https://www.ammitto.org/entity/ch/27320>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tsekov Sergey Pavlovych" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/27320> ;
  ammitto:remarks "As Vice Speaker of the Verkhovna Rada of Crimea, Sergey Tsekov initiated, together with Sergey Aksyonov, the unlawful dismissal of the government of the Autonomous “Republic of Crimea” (ARC). He drew Vladimir Konstantinov into this endeavour, threatening him with dismissal. He publicly recognised that the MPs from Crimea were the initiators of inviting Russian soldiers to take over the Verkhovna Rada of Crimea. He was one of the first Crimean Leaders to ask in public for the annexation of Crimea to Russia." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1953-09-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1953"^^xsd:integer ] .
