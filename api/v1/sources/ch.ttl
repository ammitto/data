  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Krasnozavodsky chemical plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/104911> ;
  ammitto:remarks "Joint Stock Company “Krasnozavodsky Chemical Plant” is one of the largest enterprises of the military and industrial complex of Russia, located in the Sergiev Posad city of the Moscow region. The plant specialises in the production of explosives, gunpowder and ammunition components, including products for artillery, multiple launch rocket systems (MLRS) and ballistic missiles including those used in war against Ukraine." .
