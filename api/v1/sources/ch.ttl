  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71994> ;
  ammitto:remarks "Vladimir Mikheychik has been the General Director of Open Joint Stock Company State Airline 224th Flight Detachment since 2018. It is a Russian state-owned enterprise, operating under the Russian Ministry of Defence for the purpose of providing commercial air cargo transport services, including of military cargo. It transports military technology and equipment, operating under the Ministry of Defence, and therefore supports in its actions Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-05-16"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
