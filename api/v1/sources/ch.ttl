  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Savelyev Vitaly Gennadyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50838> ;
  ammitto:remarks "Vitaly Savelyev is Deputy Prime Minister of Russia for Transport, previously having held the position of Minister of Transport of the Russian Federation. He is a member of the Board of Directors of the Russian Railways, appointed to that position by the Government of the Russian Federation, and is currently also the chairman of the Board. He is the former CEO of Aeroflot." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1954-01-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
