<https://www.ammitto.org/entity/ch/13209>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sedaqat Farajollah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13209> ;
  ammitto:remarks "Assistant Secretary of the General Prison Administration in Tehran. Head of Evin's prison, Tehran until Oct 2010 during which time torture took place. He was warden, and threatened and exerted pressure on prisoners numerous times." .
