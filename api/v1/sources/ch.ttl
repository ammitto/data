<https://www.ammitto.org/entity/ch/42942>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Gladys del Valle Requena" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/42942> ;
  ammitto:remarks "Inspector General of the Courts since 27 Apr 2022. Former member of the non-democratically elected National Assembly and former member and the Second Vice-President of the non-recognised National Constituent Assembly (ANC). In her leading role in the non-recognised ANC, she has undermined democracy and the rule of law in Venezuela, including by signing the decree that stripped the president of the National Assembly of Venezuela, Juan Guaidó, of his parliamentary immunity." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1952-11-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1952"^^xsd:integer ] .
