<https://www.ammitto.org/entity/ch/71717>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Research and Production Center BiznesAvtomatiki LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71717> ;
  ammitto:remarks "Research and Production Center BiznesAvtomatiki LLC is a Russian IT company that develops products for the Russian military-industrial complex. The entity ranks amongst the largest IT suppliers for the Russian defence sector. In particular, the entity develops artificial intelligence tools, information security systems, and software to process and analyse big data for, inter alia, the 46th Central Research Institute of the Ministry of Defence of the Russian Federation, which is responsible for the development of high-tech weapons systems for the Russian Armed Forces, as well as the Federal State Budgetary Institution “National Research Center” Institute named after N.E. Zhukovsky." .
