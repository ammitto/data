<https://www.ammitto.org/entity/ch/72978>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ustinov Alexander Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72978> ;
  ammitto:remarks "Alexander Ustinov is a General Director of the Russian military industry company JSC Machine-Building Plant Arsenal. The company is a subject of Russian state defence orders and is engaged in the production of Lotos reconnaissance satellites and AK-176M naval guns. Lotos is used by the Armed Forces of the Russian Federation during Russia’s war of aggression against Ukraine for target identification and AK-176M naval guns are installed in the Russian Navy ships that shell Ukrainian troops." .
