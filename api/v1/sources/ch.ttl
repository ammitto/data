<https://www.ammitto.org/entity/ch/38314>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mohamed Mazen Ali Yousef" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38314> ;
  ammitto:remarks "Former Minister of Industry under the former al-Assad regime. Appointed in January 2018. As a former Government Minister, shares responsibility for the former al-Assad regime’s violent repression of the civilian population." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-05-17"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
