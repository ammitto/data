  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shashkov Alexey Alexeyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93450> ;
  ammitto:remarks "Alexey Shashkov is the General Director of JSC Research Institute of Space Instrumentation, a Russian research and manufacturing company which has won a government procurement contract for developing and producing high-tech electronic components for the Russian defence industry. Therefore, as the General Director of JSC Research Institute of Space Instrumentation, Alexey Shashkov is supporting and benefitting from Russia’s military and industrial complex. He is associated with JSC Research Institute of Space Instrumentation." .
