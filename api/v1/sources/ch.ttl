<https://www.ammitto.org/entity/ch/93639>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Trading House ‘Lobaev Arms’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93639> ;
  ammitto:remarks "LLC “Trading House ‘Lobaev Arms’” (LLC Lobaev Arms) is a retail seller of weapons, including Lobaev Arms rifles, and ammunition. Lobaev Arms rifles are used by the Russian Armed Forces in Russia’s war of aggression against Ukraine. The widespread use of Lobaev Arms rifles has made them one of the symbols of Russia’s war of aggression. LLC Lobaev Arms is therefore supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine. Lobaev Arms rifles are officially purchased by the Ministry of Defence of the Russian Federation, and therefore LLC Lobaev Arms is supporting and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/93639>
  a ammitto:SanctionEntry ;
