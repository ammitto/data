<https://www.ammitto.org/entity/ch/44361>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Faisal Mekdad" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/44361> ;
  ammitto:remarks "Minister of Foreign Affairs under the former al-Assad regime. Appointed in November 2020. As a Government Minister, shares responsibility for the former al-Assad regime’s violent repression against the civilian population." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
