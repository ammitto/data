<https://www.ammitto.org/entity/ch/88819>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bogatyrev Boris Yurievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88819> ;
  ammitto:remarks "Boris Bogatyrev is the General Director of LLC Stan. LLC Stan is a Russian company active in the field of design and production of machine-tool equipment. LLC Stan supplies control drilling and milling machines for high-tech industries, and operates under the management of RT-Capital of the Rostec State Corporation. Its machines (including the VMB 55 model) are provided to companies in the aircraft, engine-building and defence industries. Therefore, LLC Stan supports and benefits from the Government of the Russian Federation. By being the General Director of LLC Stan, Boris Bogatyrev is responsible for the company’s actions and is associated with the company." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-10-10"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
