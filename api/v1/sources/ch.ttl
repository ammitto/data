  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bonyongwe Happyton Mabhuya" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/6112> ;
  ammitto:remarks "Senior security figure with a close association with the ZANU-PF (Zimbabwe African National Union – Patriotic Front) faction of the Government and complicit in forming or directing repressive state policy. Accused of kidnapping, torturing and killing MDC activists in June 2008." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-11-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
