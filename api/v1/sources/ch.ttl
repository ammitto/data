  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4841> ;
  ammitto:remarks "Commander of the Special Regiment of the Ministry of Interior of the City of Minsk. He commanded the troops that repressed a peaceful demonstration on 19 Dec 2010, for which he received an award and an acknowledgement letter from President Lukashenka in February 2011. In June 2011, he also commanded troops that repressed peaceful citizens in Minsk. On 7 May 2014, the regiment under his command received a special recognition flag from the Ministry of Internal Affairs." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1971-08-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
