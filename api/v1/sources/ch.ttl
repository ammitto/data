<https://www.ammitto.org/entity/ch/71434>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC VNIIRT" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71434> ;
  ammitto:remarks "JSC VNIIRT (a.k.a. All-Russian Research Institute of Radio Engineering) is a Russian military-industrial state enterprise that develops radar systems deployed by the Russian Armed Forces, including radar systems used for Russia’s Pantsir-S1 missile system. Moreover, JSC VNIIRT is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." .
