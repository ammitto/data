<https://www.ammitto.org/entity/ch/98935>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Public Joint Stock Company “Energiya”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98935> ;
  ammitto:remarks "PJSC Energiya is one of Russia’s largest producer of chemical power sources, including batteries specifically designed for military applications. The company manufactures batteries used in unmanned aerial vehicles , aviation equipment and naval equipment. The company has significantly increased its production capacity and output, fulfilling substantial State defence orders. The company’s leadership has emphasised the priority of fulfilling State defence contracts. Many of PJSC Energiya’s employees have volunteered to fight in the war against Ukraine." .
