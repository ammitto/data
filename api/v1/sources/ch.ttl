<https://www.ammitto.org/entity/ch/88471>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Novikov Yan Valentinovych" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88471> ;
  ammitto:remarks "Yan Novikov is General Director of JSC Almaz-Antey air and space defence corporation (“Almaz-Antey”). Almaz-Antey is a key company within the Russian military-industrial complex. Companies within the Almaz-Antey holding structure produce various types of defence hardware and equipment in use by the Russian Armed Forces in their war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-10-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
