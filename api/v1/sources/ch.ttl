  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Praliaskouski Aleh Vitoldavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4416> ;
  ammitto:remarks "Former Minister of Information (left office in June 2014), former Deputy Head of the President's Administration, former Head of the General Directorate for Ideology in the President's Administration, former Director of the Centre of Analysis and Information of the President's Administration. He has been one of the main sources and voices of state propaganda and ideological support for the regime. He has been promoted to the position of Minister, and has since continued to be a vocal propagandist and supporter of the acts of the regime towards the democratic opposition and civil society." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-10-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
