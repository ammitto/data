  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dudal Anton Genadzevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77931> ;
  ammitto:remarks "Anton Dudal was a judge who served in the court of the Bobruisk district and the city of Bobruisk. He was appointed by Aliaksandr Lukashenka in 2019. He has issued politically motivated sentences, including against citizens of Belarus who voiced their opinions against the President. He sentenced a citizen for acting in self-defence against law-enforcement brutality. He transferred Andrey Sachevko to prison in Mahiliou." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1986-08-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1986"^^xsd:integer ] .
