<https://www.ammitto.org/entity/ch/75330>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kulikova Elena Aleksandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75330> ;
  ammitto:remarks "Elena Kulikova is the General Director and founder of LLC Inkotech. LLC Inkotech is a Russian supplier of imported electronic components and printed circuit boards of various levels. The company delivers products such as semiconductor and microwave components from abroad to the largest Russian military-industrial complex enterprises that manufacture equipment used in Russia’s war of aggression against Ukraine. By being the General Director and founder of LLC Inkotech, Elena Kulikova is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1983-06-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1983"^^xsd:integer ] .
