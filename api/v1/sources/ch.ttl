<https://www.ammitto.org/entity/ch/72997>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pitikov Sergey Victorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72997> ;
  ammitto:remarks "Sergey Pitikov is the General Director of the JSC RPC KBM. The company supplies weapons to the Russian Armed Forces under Russia’s state defence orders. JSC RPC KBM produces and supplies the Russian Armed Forces with Khrizantema (Chrysanthemum), Tochka-U, Iskander and Kinzhal missile systems. Those weapons are being currently used by the Russian Armed Forces in the Russian war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-02-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
