<https://www.ammitto.org/entity/ch/45386>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Myanma Timber Enterprise" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45386> ;
  ammitto:remarks "Myanma Timber Enterprise (MTE) is a state-owned enterprise operating under the Ministry of Natural Resources and Environmental Conservation (MONREC). MTE has exclusive rights on the production and the export of timber in Myanmar/Burma." .
