  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kalinnik Siarhei Leanidavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/44213> ;
  ammitto:remarks "In his former position as Chief of the Sovetsky District Police Department of Minsk, he was responsible for the repression and intimidation campaign led by the local police force under his command in the wake of the 2020 presidential election, in particular arbitrary arrests and ill-treatment, including torture, of peaceful demonstrators as well as intimidation and violence against journalists. According to witnesses, he personally supervised and took part in torturing unlawfully detained protesters. He remains active in the Lukashenka regime as the Deputy Head of Criminal Police in the Main Internal Affairs Directorate of the Minsk City Executive Committee." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1979-07-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1979"^^xsd:integer ] .
