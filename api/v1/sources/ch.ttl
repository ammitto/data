  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shevchuk Stanislav Petrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72701> ;
  ammitto:remarks "Stanislav Shevchuk held the position of General Director of Federal State Enterprise Avangard (FKP Avangard) until 1 October 2024. FKP Avangard is a Russian defence enterprise that fulfils state defence orders for the disposal of military equipment and weapons. FKP Avangard also carries out research and development work on the creation and modernisation of ammunition. The enterprise is state owned through the Rostec State Corporation and the Federal Agency for State Property Management. The modernisation of the enterprise was covered by a federal targeted programme and the territorial administration of the Federal Agency for State Property Management in Bashkiria provided FKP Avangard with land to expand its production capacity." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-01-26"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
