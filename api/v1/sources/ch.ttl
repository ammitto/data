<https://www.ammitto.org/entity/ch/69044>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sarmad Electronic Sepahan Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69044> ;
  ammitto:remarks "Sarmad Electronic Sepahan Company is an Iranian company that produces the specific components used in Iranian unmanned aerial vehicles (UAVs). Those UAVs are deployed by Russia in its war of aggression against Ukraine. Servomotors and flowmotors in detached Iranian UAVs found on the Ukrainian battlefield have been traced back directly to Sarmad Electronic Sepahan Company. The company itself advertises its activities in Iran by claiming to be active in large sensitive industries in the country, including that of UAVs. It is therefore supporting and involved in Iran’s UAV programme." .
<https://www.ammitto.org/entry/ch/consolidated-list/69044>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/ch/69044> ;
