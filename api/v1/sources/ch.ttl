  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Maung Maung Aye" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60139> ;
  ammitto:remarks "General Maung Maung Aye was the Chief of the General Staff for the Myanmar army, navy, and air force until December 2024. In December 2024, he was appointed Minister of Defence. In those positions, Maung Maung Aye forms part of the regime, which seized power and overthrew legitimately elected leaders in Myanmar/Burma in February 2021." .
