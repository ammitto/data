<https://www.ammitto.org/entity/ch/60533>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kolesnikov Maxim Andreevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60533> ;
  ammitto:remarks "Since November 2024, Maxim Kolesnikov has been First Deputy Minister of the Russian Ministry of Economic Development. M. Kolesnikov was previously Deputy Minister of the Russian Ministry of Economic Development from 2022 until 2024. During his administration, the Ministry of Economic Development has been involved in activities to undermine and threaten the territorial integrity of Ukraine, including measures to explore the economic potential of the annexed Ukrainian regions (Kherson, Zaporozhe, the so-called “Donetsk People’s Republic” and “Luhansk People’s Republic”) as well as activities to support war economy measures of the Russian government." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1987-07-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1987"^^xsd:integer ] .
