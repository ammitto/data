  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kala Naft" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/100417> ;
  ammitto:remarks "Kala Naft is a Manufacturing, Support and Procurement Company and a subsidiary of the National Iranian Oil Company (NIOC). NIOC is a State-owned and operated entity providing substantial financial resources to the Government of Iran. NIOC holds the production, sale and export monopoly for Iranian oil. The revenue generated by NIOC’s oil sales plays a significant role in funding Iran’s military and the IRGC." .
