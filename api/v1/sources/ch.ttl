  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pankov Nikolai Anatolievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72561> ;
  ammitto:remarks "Nikolai Pankov is the CEO of Marine Trans Shipping LLC. Marine Trans Shipping LLC is a Russian shipping company providing logistical support to the Ministry of Defence of the Russian Federation. In particular, Marine Trans Shipping LLC is involved in a military transportation network of Russian cargo vessels shipping North Korean armaments from Pyongyang to military facilities in the Russian port of Dunai. Subsequently, North Korean munitions transported by Marine Trans Shipping LLC are transferred to depots on Russia’s western border to be deployed in Russia’s war of aggression against Ukraine." .
