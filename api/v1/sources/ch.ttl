<https://www.ammitto.org/entity/ch/55451>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Voentekstilprom LLC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55451> ;
  ammitto:remarks "Voentekstilprom manufactures clothing for the needs of the Government of the Russian Federation. It has provided clothing supplies to the Russian military as part of a State defence order. It manufactures field uniforms for the National Guard of Russia and shirts for soldiers of the Russian Navy and the National Guard of Russia." .
<https://www.ammitto.org/entry/ch/consolidated-list/55451>
