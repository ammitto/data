<https://www.ammitto.org/entity/ch/13322>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Tamaddon Morteza" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13322> ;
  ammitto:remarks "Politician closely associated with former Iranian President Ahmadinejad. Board member at Khajeh Nasireddin Tusi University of Technology. Former Head of Tehran provincial Public Security Council. Former IRGC Governor-General of Tehran Province. In his capacity as Governor and Head of Tehran provincial Public Security Council, he bore overall responsibility for all repressive activities undertaken by the IRGC in Tehran Province, including cracking down on political protests since June 2009." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
