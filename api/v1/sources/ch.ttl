<https://www.ammitto.org/entity/ch/76313>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Akmat Kadyrov Foundation" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/76313> ;
  ammitto:remarks "The Akmat Kadyrov Foundation carries out re-education programmes for Ukrainian children and teenagers, subjecting them to militaristic training with the intent of alienating them from their home country and relatives. Furthermore, the Akmat Kadyrov Foundation provides financial incentives to the families of the Chechen fighters involved in Russia’s war of aggression against Ukraine to attract new volunteers and keep those already fighting motivated." .
