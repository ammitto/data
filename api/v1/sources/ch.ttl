  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khudaverdyan Tigran Oganesovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52395> ;
  ammitto:remarks "Tigran Khudaverdyan is former Executive Director and deputy CEO of Yandex N.V., having resigned from those positions following his designation by the Union. He remains among the top managers of Yandex, shaping the activities of the company." ;
