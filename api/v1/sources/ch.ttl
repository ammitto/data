<https://www.ammitto.org/entity/ch/37486>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Propaganda and agitation Department (PAD)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
