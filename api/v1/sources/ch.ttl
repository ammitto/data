<https://www.ammitto.org/entity/ch/32672>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mathias-Joseph Niyonzima" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/32672> ;
  ammitto:remarks "Officer of the National Intelligence Service. Responsible for obstructing the search for a political solution in Burundi by inciting violence and acts of repression during the demonstrations that started on 26 Apr 2015 following the announcement of the presidential candidacy of President Nkurunziza. Responsible for helping to train, coordinate and arm the Imbonerakure paramilitary militias, including outside Burundi, who are responsible for acts of violence, repression and serious human rights abuses in Burundi." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1956-03-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1956"^^xsd:integer ] .
