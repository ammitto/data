<https://www.ammitto.org/entity/ch/93285>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Minsk Wheel Tractor Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93285> ;
  ammitto:remarks "Minsk Wheel Tractor Plant is a Belarusian military industry company that develops military vehicles for the Russian Armed Forces and is supporting Russia’s defence capabilities. In 2024 alone, the total export volume of the company was 306 wagons of military equipment, mostly provided to Russian enterprises belonging to the military and industrial complex of the Russian Federation. The company continued to export military equipment to the Russian Federation in 2025." .
