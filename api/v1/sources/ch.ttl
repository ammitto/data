  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lobaev Vladislav Yevgenyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88785> ;
  ammitto:remarks "Vladislav Lobaev is the Chief Designer of the LLC Design Bureau of Integration Systems (LLC KBIS). He is also one of the founders and shareholders of the Lobaev group of companies (including LLC Trading House Lobaev Arms) and the former President of the Foundation “Lobaev Foundation”. “Lobaev Foundation” is a unit of the Lobaev Group of entities and collects funds to finance the projects of Lobaev Arms. Lobaev Arms rifles are used by the Russian Armed Forces in Russia’s war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-04-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
