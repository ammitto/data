<https://www.ammitto.org/entity/ch/69245>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Temin Gabriel" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69245> ;
  ammitto:remarks "Gabriel Temin is the CEO of two logistic companies, Siberica Oy and Luminor Oy, both established in Finland. Those two companies are involved in the export to Russia of goods falling under Union restrictive measures, in particular drone components. Gabriel Temin has been sentenced by the East Uusimaa Court for the illegal export of military equipment to Russia. Therefore, Gabriel Temin is facilitating infringements of the prohibition against circumvention of the provisions of Decision 2014/512/CFSP and Regulation (EU) No 833/2014." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-02-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
