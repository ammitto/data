  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Holding Company ‘LENINETZ’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88806> ;
  ammitto:remarks "JSC “Holding Company ‘LENINETZ’” is a Russian entity which controls PJSC “Central Scientific and Production Association ‘Leninetz’” (PJSC CSPA Leninetz). PJSC CSPA Leninetz is a Russian company specialised in the development and production of radar and navigation equipment, including to the benefit of the Russian military. In particular, PSJC CSPA Leninetz is involved in the production and development of Zaslon airborne radar, which notably equips MiG-31 aircraft used by the Russian military in Ukraine." .
