  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Maltsau Leanid Siamionavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
