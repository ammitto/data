<https://www.ammitto.org/entity/ch/94594>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Parasca Natalia" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94594> ;
  ammitto:remarks "Natalia Parasca is the leader of the “Renaștere” (Revival) political party, which is one of the successors of the outlawed ȘOR political party, led by listed person Ilan Shor. In April 2024, Ilan Shor launched in Moscow the Victory/Pobeda Political Bloc, which unites the successors of his party, including Renaștere. As the leader of Renaștere, Natalia Parasca represents the party and coordinates its activities." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-02-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
