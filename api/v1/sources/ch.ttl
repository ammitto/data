<https://www.ammitto.org/entity/ch/75914>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Okhlobystin Ivan Ivanovitsch" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75914> ;
  ammitto:remarks "Ivan Okhlobystin is a Russian actor, film director, screenwriter and producer and openly supports the Russian Government’s pro-war propaganda narrative by participating in state-sponsored propaganda events and by visiting and supplying goods to Russian troops and separatist forces deployed in Ukraine. For those actions, Ivan Okhlobystin was awarded a medal from the People’s Militia regiment of the so-called “Donetsk People’s Republic” for participation in Russia’s war of aggression against Ukraine as well as an Order of Merit from the Russian-occupied Zaporozhye Oblast." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-07-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
