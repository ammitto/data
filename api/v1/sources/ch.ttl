<https://www.ammitto.org/entity/ch/93429>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Feodosia Optical Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93429> ;
  ammitto:remarks "JSC “Feodosia Optical Plant” is a producer of optical and optoelectronic devices. It also produces components (including sight-guidance devices and rangefinders) used in military equipment, such as appliances that are part of the 1A40 and 1A40-1 rangefinder sights, which are installed on T-72 tanks used by the Russian military. JSC “Feodosia Optical Plant” is therefore supporting materially Russia’s military and industrial complex, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
