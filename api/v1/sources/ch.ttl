  ammitto:remarks "Sergey Tsivilev is the Minister of Energy of the Russian Federation. He is former governor of the Kemerovo region and a well-known public figure. He is also a member of the Bureau of the Supreme Council of the United Russia party." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-09-21"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
