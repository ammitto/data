<https://www.ammitto.org/entity/ch/69407>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC SPECIAL DESIGN BUREAU OF TRANSPORT MECHANICAL ENGINEERING" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69407> ;
  ammitto:remarks "JSC Special Design Bureau of Transport Mechanical Engineering is one of Russia’s industrial and defence complexes that develops and manufactures military and special purpose vehicles. JSC Special Design Bureau of Transport Mechanical Engineering was founded at the Kirov Plant and possesses all necessary facilities to research, develop and test military vehicles. JSC Special Design Bureau of Transport Mechanical Engineering is indirectly owned by State Corporation Rostec." .
