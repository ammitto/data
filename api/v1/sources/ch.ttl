<https://www.ammitto.org/entity/ch/89109>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Media Group NewsFront”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89109> ;
  ammitto:remarks "LLC Media Group NewsFront (NewsFront) is a Crimea-based outlet presenting distorted interpretations of history and manipulated information, in line with Kremlin messaging. It regularly provides a platform for Russian government representatives and spreads lies and conspiracy theories about Ukraine. NewsFront targets European and global audiences and serves as a reference point for local disinformation outlets in Member States of the Union. NewsFront has ties to the Kremlin and the Russian secret services, namely the Federal Security Service of the Russian Federation." .
