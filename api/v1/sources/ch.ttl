<https://www.ammitto.org/entity/ch/59133>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Research Design Byuro ‘Novator’" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/59133> ;
  ammitto:remarks "JSC RESEARCH DESIGN BYURO “NOVATOR” is a Russian company engaged in the development, production, operation and repair of long-range anti-aircraft missiles, cruise missiles, anti-ballistic missiles and other warfare equipment. JSC “NOVATOR” provides cruise missile model 3M-54 Kalibr (also known as 3M54-1 Kalibr and 3M14 Biryuza) to the Russian Armed Forces, which is used in the war of aggression against Ukraine." .
