  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69199> ;
  ammitto:remarks "Lyudmila Ermakova is the Director of the State Unitary Enterprise of the Republic of Crimea “Solnechnaya Tavrika”. In her capacity as the Director of “Solnechnaya Tavrika”, she is implementing and maintaining policies in the camps/sanatoriums in which deported children from Ukraine are “re-educated”. Moreover, she has received various honorary titles and certificates from the Russian Government for her work in illegally annexed Crimea. Therefore, she is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1954-10-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
