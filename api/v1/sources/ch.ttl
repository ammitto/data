  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chaika Igor Yuryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/62656> ;
  ammitto:remarks "Igor Chaika is a Russian businessman responsible for funnelling money in support of the Russian Federal Security Service (FSB) projects aimed at destabilising the Republic of Moldova. He played the role of Russian “purse”, channelling money to FSB assets in the Republic of Moldova in order to bring the country under the control of the Kremlin." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1988-12-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1988"^^xsd:integer ] .
