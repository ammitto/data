<https://www.ammitto.org/entity/ch/72626>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Krylov Igor Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72626> ;
  ammitto:remarks "Igor Krylov is the General Director of JSC “State Scientific and Production Enterprise ‘Region’”, which is a leading Russian developer and supplier of guided bombs for front-line aviation. JSC Region produces naval and aviation engines and naval and aviation armaments, as well as mine countermeasure systems, for the Russian Ministry of Defence. Moreover, JSC “State Scientific and Production Enterprise ‘Region’” is a subsidiary of JSC Tactical Missile Armament Corporation which significantly contributes to enhancing Russia’s military and defence capabilities." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-07-22"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
