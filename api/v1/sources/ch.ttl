  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Kolomensky Zavod" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69925> ;
  ammitto:remarks "Kolomensky Zavod is a Russian military industry company. It is a supplier of the Armed Forces of the Russian Federation. It manufactures diesel engines for Russian warships and submarines, including project 20380 corvettes, project 20385 corvettes, project 18280 reconnaissance ships, project 11711 large landing ships, project 22350 frigates and project 636 submarines." .
