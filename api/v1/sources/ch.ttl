<https://www.ammitto.org/entity/ch/95419>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Ulyanovsk Machine Tool Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95419> ;
  ammitto:remarks "LLC “Ulyanovsk Machine Tool Plant” is a Russian company specialising in the production of Computer Numerical Control machine tools and therefore active in an important field for Russia’s military and industrial complex. The company was previously owned by the German companies Gildemeister Beteiligungen GmbH and DMG Mori. In February 2024, LLC “Ulyanovsk Machine Tool Plant” was subject to an asset seizure ordered by decree of the President of the Russian Federation and transferred to the Russian Federal Agency for State Property Management (Rosimushchestvo)." .
