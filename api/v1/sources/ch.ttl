<https://www.ammitto.org/entity/ch/3203>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mugaragu Leodomir" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/3203> ;
  ammitto:remarks "According to open source and official reporting, Leodomir Mugaragu is the Chief of Staff of the Forces Combattantes Abucunguzi/Combatant Force for the Liberation of Rwanda (FOCA), the FDLR’s armed wing. According to official reporting Mugaragu is a senior planner for FDLR’s military operations in the eastern DRC." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1954"^^xsd:integer ] .
