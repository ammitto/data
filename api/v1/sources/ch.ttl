<https://www.ammitto.org/entity/ch/9681>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mehr Bank" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/9681> ;
  ammitto:remarks "Mehr Bank is controlled by Bonyad Taavon Sepah and the IRGC. Mehr Bank provides financial services to the IRGC. According to an open source interview with the head of Bonyad Taavon Sepah, Parviz Fattah, Bonyad Taavon Sepah created Mehr Bank to serve the Basij (paramilitary arm of the IRGC)." .
