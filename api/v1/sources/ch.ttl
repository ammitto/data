<https://www.ammitto.org/entity/ch/13245>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ganji Mostafa Barzegar" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13245> ;
  ammitto:remarks "General Director of Inspection Supervision and Performance Evaluation of Courts since Jun 2020. Former Prosecutor General of Qom (2008-2017) and former Head of the Directorate-General for prisons. He was responsible for the arbitrary detention and maltreatment of dozens of offenders in Qom. He was complicit in a grave violation of the right to due process, contributing to the excessive and increasing use of the death penalty and a sharp increase in executions in 2009/2010." .
