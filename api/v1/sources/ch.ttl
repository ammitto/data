<https://www.ammitto.org/entity/ch/71521>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Globus”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71521> ;
  ammitto:remarks "JSC Globus is a specialised enterprise engaged in the development, production and implementation of automated systems for the maintenance and control of weapons and military equipment. The enterprise is engaged in the development and manufacture of complexes, designed to prepare for combat use, and to monitor the technical condition of, airborne guided weapons, missile air and naval defence systems." .
