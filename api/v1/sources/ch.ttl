  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Martynov Andrey Pavlovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85955> ;
  ammitto:remarks "Andrey Martynov is a Russian military serviceman from the 22nd Guards Heavy Bomber Aviation Division based at Engels-2 airbase in Saratov, Russia. In July 2024, a Kh-101 missile strike carried out by that Division hit the Okhmadyt children’s hospital in Kyiv. As a serviceman from the 22nd Guards Heavy Bomber Aviation Division, Andrey Martynov is supporting and implementing actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-08-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
