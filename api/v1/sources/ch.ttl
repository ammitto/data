<https://www.ammitto.org/entity/ch/103159>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Suvorov Denis Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103159> ;
  ammitto:remarks "Lieutenant Colonel Denis Suvorov is the Commander of the 175th Separate Reconnaissance Battalion of the 76th Guards Air Assault Division. At the beginning of Russia’s full-scale invasion of Ukraine, his battalion was deployed as part of the division’s operations in Kyiv Oblast, including Bucha. His battalion’s reconnaissance activities supported the broader “cleansing operations” that led to documented war crimes. He personally participated in torturing civilians during the Russian occupation of Bucha in March 2022." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1984-11-06"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1984"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/103159>
