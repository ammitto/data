<https://www.ammitto.org/entity/ch/4845>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zaitsau Vadzim Iurievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4845> ;
  ammitto:remarks "CEO of the semi-private Cosmos TV since June 2013, appointed by the Government of Belarus as representative of the state. Former Head of the KGB (July 2008 - November 2012). Responsible for transforming the KGB into the main organ of repression of civil society and of the democratic opposition. Responsible for the dissemination, through the media, of false information about the demonstrators on 19 Dec 2010, alleging that they had brought materials to be used as weapons. He personally threatened the lives and health of the wife and child of former presidential candidate, Andrei Sannikov. He is the main initiator of orders for unlawful harassment of democratic opposition, the torture of political opponents and the mistreatment of prisoners." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
