  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “Cheboksary Production Association named after V.I. Chapaev”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98836> ;
  ammitto:remarks "JSC “Cheboksary Production Association named after V.I. Chapaev” is a Russian company whose primary activity is the production of weapons and military equipment. The company is a supplier of Russian defence companies and is owned by JSC “Specchemistry”, a company subject to Union restrictive measures for its role in supplying the Russian military. JSC “Cheboksary Production Association named after V.I. Chapaev” is an executor of the Russian State Armament Programme and State Defence Order." .
