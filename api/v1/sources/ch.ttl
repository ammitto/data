<https://www.ammitto.org/entity/ch/26393>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kakunin Aliaksandr Aliaksandravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/26393> ;
  ammitto:remarks "Head of penal colony IK-2 in Bobruisk, responsible for inhumane treatment of political prisoners A. Sannikau and A. Beliatski in penal colony IK-2 in Bobruisk. Opposition activists were tortured, denied access to lawyers and placed in solitary confinement in the penal colony under his supervision. Kakunin put pressure on A. Beliatski and A. Sannikau in order to force them to sign an appeal for pardon." .
<https://www.ammitto.org/entry/ch/consolidated-list/26393>
  a ammitto:SanctionEntry ;
