  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85193> ;
  ammitto:remarks "Siarhei Biareishyk is the deputy head of Pre-trial Detention Centre No 1 “Voldarka”. In this position, he is responsible for the inhumane treatment of the detainees, including beatings, overcrowding and lack of appropriate medical treatment and sanitary equipment. The majority of inmates are political detainees, such as human rights activist, founder of Belarusian human rights association Viasna and 2022 Nobel Peace Prize Winner Ales Bialiatski, who was detained in “Voldarka” until October 2024." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-10-31"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
