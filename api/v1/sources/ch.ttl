<https://www.ammitto.org/entity/ch/72051>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dyumin Alexey Gennadyevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72051> ;
  ammitto:remarks "Alexey Dyumin has been the Presidential Aide to President of Russian Federation since 14 May 2024, and a member of the Russian Security Council since 30 September 2024. In his role as Presidential Aide, he oversees issues concerning the military-industrial complex, ensures the activities of the State Council, and the development of sports. He was Governor of the Tula Oblast 2016-2024. Previously, he led the Russian military’s Special Operations Forces, overseeing the annexation of Crimea in 2014." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-08-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
