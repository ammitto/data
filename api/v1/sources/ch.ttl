<https://www.ammitto.org/entity/ch/55550>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Remdizel" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/55550> ;
  ammitto:remarks "Remdizel produces and repairs wheeled and tracked vehicles. It manufactures Typhoon K-63968 Mine-Resistant Ambush Protected vehicles, which continue to be used by the Armed Forces of the Russian Federation during Russia’s war of aggression against Ukraine. Remdizel also produces new armoured vehicles such as K-4386 Typhoon VDV and Akhmat to support Russia’s aggression in Ukraine." .
