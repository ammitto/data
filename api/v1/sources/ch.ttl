  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Vyaznikov Alexey Nikolaevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93443> ;
  ammitto:remarks "Alexey Vyaznikov is the General Director of JSC Central Research Institute “Elektron”, a Russian research and manufacturing company, which has won a government procurement contract for developing and producing high-tech electronic components for the Russian defence industry. Therefore, Alexey Nikolaevich Vyaznikov is supporting and benefitting from Russia’s military and industrial complex." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-12-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
