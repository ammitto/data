<https://www.ammitto.org/entity/ch/76079>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Federal State Unitary Enterprise “Novorossiya Railways”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/76079> ;
  ammitto:remarks "The Federal State Unitary Enterprise Novorossiya Railways was created by a decree of the Government of the Russian Federation on 29 May 2023 to consolidate the railways of the territories of Donetsk, Luhansk, Kherson and Zaporizhzhia not under the control of Ukraine’s government and to move them under the control of the Russian authorities." .
