<https://www.ammitto.org/entity/ch/13265>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Heydari Nabiollah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13265> ;
  ammitto:remarks "Head of the Iranian Airport Police Authority. He has been instrumental, since June 2009, in arresting at Imam Khomeini International Airport Iranian protesters who were trying to leave the country after the crackdown started – including inside the international zone." .
<https://www.ammitto.org/entry/ch/consolidated-list/13265>
