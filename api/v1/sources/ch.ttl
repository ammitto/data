<https://www.ammitto.org/entity/ch/62631>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Cavcaliuc Gheorghe Petru" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/62631> ;
  ammitto:remarks "Gheorghe Petru Cavcaliuc is the former Deputy Head of the General Police Inspectorate of the Republic of Moldova. He is known for having organised and participated in the violent protests of Oct 2022, alongside Ilan Shor. He has used his connections within the General Police Inspectorate to recruit former police officers and create a paramilitary group to “protect” the violent demonstrators against the Government of the Republic of Moldova. In this context, he has founded a so-called “shadow government” with the aim of replacing the democratically elected government of the Republic of Moldova." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-10-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
