<https://www.ammitto.org/entity/ch/52866>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pimanov Aleksei Viktorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/52866> ;
  ammitto:remarks "Aleksei Pimanov is a propagandist and the Head of the Krasnaya Zvezda media holding, owned by the Russian Defence Ministry. The Minister of Defence, Sergey Shoygu, personally requested Pimanov to become the Head of the Krasnaya Zvezda. The media holding was established by decree of the Russian Minister of Defence and controls the federal TV channel Zvezda." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-02-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
