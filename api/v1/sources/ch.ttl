<https://www.ammitto.org/entity/ch/28884>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Maalim Salman" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/28884> ;
  ammitto:remarks "Maalim Salman was chosen by al-Shabaab leader Ahmed Abdi aw-Mohamed aka Godane to be the head of African foreign fighters for al-Shabaab. He has trained foreign nationals who were seeking to join al-Shabaab as African foreign fighters, and has been involved in operations in Africa targeting tourists, entertainment establishments, and churches." ;
