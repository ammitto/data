<https://www.ammitto.org/entity/ch/38935>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pogorelov Miroslav Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
