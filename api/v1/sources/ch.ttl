  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45904> ;
  ammitto:remarks "In his former position as Head of the Partizanski District Police Department of Minsk, Dzmitry Burdziuk was responsible for overseeing the severe beatings and torture of peaceful protesters and bystanders in that district in the wake of the 2020 presidential election." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-01-31"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
