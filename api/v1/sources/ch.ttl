  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/51344> ;
  ammitto:remarks "Mikhail Igorevich Poluboyarinov is the former CEO of OJSC Aeroflot. OJSC Aeroflot is the largest airline of the Russian Federation. OJSC Aeroflot not only provides services to the Russian Government, but also generates an important source of revenue for it. Aeroflot operated illegal flights to occupied Crimea." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1966-04-02"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1966"^^xsd:integer ] .
