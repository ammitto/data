  ammitto:remarks "Executive Secretary of the FDLR and Vice-President of the FDLR military high command until his arrest. Political/Military leader of a foreign armed group operating in the Democratic Republic of the Congo, impeding the disarmament and the voluntary repatriation and resettlement of combatants, per Security Council resolution 1857 (2008) OP 4 (b)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1963-07-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
