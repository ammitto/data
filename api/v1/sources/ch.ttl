<https://www.ammitto.org/entity/ch/44837>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sein Win" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/44837> ;
  ammitto:remarks "Lieutenant General Sein Win is a member of Tatmadaw and former Minister of Defence (between 24 August 2015 and 1 February 2021). Since February 2021, he has been the chair of the Myanmar War Veterans Organization." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1956-07-24"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1956"^^xsd:integer ] .
