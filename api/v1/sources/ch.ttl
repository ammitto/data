  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bouali Yadollah" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103593> ;
  ammitto:remarks "Yadollah Bouali is the Commander of the Islamic Revolutionary Guard Corps (IRGC) Fajr Corps in Fars Province. Under his command, the IRGC forces in Fars Province have been involved in the violent repression of demonstrations, including during the nationwide protests in Iran that began in December 2025 where IRGC forces opened fire on protesters, resulting in deaths and injuries." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1965-09-07"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
