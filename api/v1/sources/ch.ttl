  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pinchuk Andrey Yurevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/29301> ;
  ammitto:remarks "Former “State security minister” of the so-called “Donetsk People’s Republic”. Senior officer (Colonel) of the Federal Security Service (FSB). Associated with Vladimir Antyufeyev, who was responsible for the separatist “governmental” activities of the so-called “government of the Donetsk People’s Republic”. He has therefore supported actions and policies which undermine the territorial integrity, sovereignty and independence of Ukraine. Remains active in supporting separatist actions or policies. Executive Director and chairman of the Council of Commanders of the “Union of Donbas volunteers”. Current commander of the battalion “BARS-13”, operating in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-12-27"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
