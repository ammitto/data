  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "State-owned Foreign Trade Unitary Enterprise Belvneshpromservice" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94642> ;
  ammitto:remarks "State-owned Foreign Trade Unitary Enterprise Belvneshpromservice was established in order to promote Belarusian defence products in foreign markets. It specialises in the export of high-tech products for military purposes and has the right to upgrade, repair and supply military goods for the Belarusian Air Defence, Air Force and Land Forces. Therefore, State-owned Foreign Trade Unitary Enterprise Belvneshpromservice is supporting the military and industrial complex of Belarus." .
