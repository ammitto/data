<https://www.ammitto.org/entity/ch/4568>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bortnik Siarhei Aliaksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4568> ;
  ammitto:remarks "Public Prosecutor. In 2006, he dealt with the case of the former presidential candidate Alyaksandr Kazulin who was accused of organising protests in March 2006 against the fraudulent elections. The accusation presented by him was politically motivated and included clear violations of the Code of Criminal Procedure. In April 2012, he also gave his agreement to imposing preventive police supervision for two years on the prominent political activist, Pavel Vinagradau." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1953-05-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1953"^^xsd:integer ] .
