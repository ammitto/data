<https://www.ammitto.org/entity/ch/38230>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Emmanuel Ramazani Shadary" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38230> ;
  ammitto:remarks "As Vice Prime Minister and Minister of the Interior and Security until Feb 2018, Emmanuel Ramazani Shadary was officially responsible for the police and security services and for coordinating the work of provincial governors. In this capacity, he was responsible for the arrests of activists and opposition members, as well as for the disproportionate use of force, such as the violent crackdown on members of the Bundu Dia Kongo (BDK) movement in Kongo Central, the repression in Kinshasa from Jan to Feb 2017 and the disproportionate use of force and violent repression in the Kasai provinces." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1960-11-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1960"^^xsd:integer ] .
