<https://www.ammitto.org/entity/ch/61365>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Boguslayev Vyacheslav Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61365> ;
  ammitto:remarks "Vyacheslav Boguslayev is a former Ukrainian deputy of the pro-Russian party of regions and former President of the company JSC MOTOR SICH, a Ukrainian aircraft engine manufacturer. He is responsible for supplying engines to the Russian army to produce and repair combat helicopters (Mi-8, Mi24, Mi28 and Ka-52), which have been used extensively in Russia’s war of aggression against Ukraine, especially at the beginning of the war. He continued to provide military equipment to Russian troops despite the war, and remains supportive of the Russian armed forces." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1938-10-28"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1938"^^xsd:integer ] .
