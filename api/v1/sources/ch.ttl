<https://www.ammitto.org/entity/ch/3339>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nyakuni James" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/3339> ;
  ammitto:remarks "Trade partnership with Jérôme Kakwavu, particularly smuggling across the DRC/Uganda border, including suspected smuggling of weapons and military material in unchecked trucks. Violation of the arms embargo and provision of assistance to armed groups and militia referred to in paragraph 20 of Res. 1493 (2003), including financial support that allows them to operate militarily." .
