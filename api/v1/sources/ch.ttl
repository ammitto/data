<https://www.ammitto.org/entity/ch/93601>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Chadayev Alexey Viktorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93601> ;
  ammitto:remarks "Alexey Chadayev is the Director of Scientific-Research Centre “Ushkuynik”, a company producing unmanned aerial vehicles (UAVs) to the benefit of the Russian military. Its main product is the close-range fiber-optic electronic warfare resistant UAV named “Kniaz Vandal Novgorodskiy” (KVN), which is used in Russia’s war of aggression against Ukraine. The company also holds permission from the Russian Government to unite and coordinate the efforts of UAV engineers and construction companies in order to create and test new types of UAV in Veliky Novgorod." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-09-30"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
