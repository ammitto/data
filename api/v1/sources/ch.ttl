  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sibanda Jabulani" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/7004> ;
  ammitto:remarks "Ties to the ZANU-PF faction of Government and complicit in forming or directing oppressive state policy. Involved in violence against MDC supporters in Makoni, Bikita, Masvingo and Guto particularly in relation to the implementation of an outreach programme in 2010." ;
