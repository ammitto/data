<https://www.ammitto.org/entity/ch/27297>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Temirgaliev Rustam Ilmirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/27297> ;
  ammitto:remarks "As former Deputy Prime Minister of Crimea, Temirgaliev played a relevant role in the decisions taken by the “Supreme Council” concerning the “referendum” of 16 March 2014 against the territorial integrity of Ukraine. He lobbied actively for the integration of Crimea into the Russian Federation. On 11 June 2014, he resigned from his function as “First Deputy Prime Minister” of the so-called “Republic of Crimea”." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-08-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
