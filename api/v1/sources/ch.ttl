<https://www.ammitto.org/entity/ch/72880>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Epishin Eduard Borisovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72880> ;
  ammitto:remarks "Eduard Epishin is the General Director of JSC Avangard. JSC Avangard is a Russian manufacturer of large-sized fiberglass products, as well as plastic and rubber products, and is part of one of the largest rocket-building holdings in Russia, JSC MIC NPO Mashinostroyenia, which is itself part of JSC Tactical Missile Armament Corporation. JSC Avangard is involved in the production of armoured vehicles and missiles, which are used by the Russian Armed Forces in the war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1971-03-13"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1971"^^xsd:integer ] .
