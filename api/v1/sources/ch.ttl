<https://www.ammitto.org/entity/ch/45365>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Myanma Gems Enterprise" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45365> ;
  ammitto:remarks "Myanmar Gems Enterprise (MGE) is a state-owned enterprise controlled by the Myanmar Armed Forces (Tatmadaw), responsible for drafting rules and regulations and for supervising and granting permits to local private entrepreneurs, organising emporiums and special sales for jade and gems. MGE operates under the instructions of the Ministry of Natural Resources and Environmental Conservation (MONREC), whose Minister has been appointed by the State Administrative Council (SAC)." .
