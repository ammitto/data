<https://www.ammitto.org/entity/ch/95882>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Public Law Company “Territorial Development Fund”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/95882> ;
  ammitto:remarks "The Territorial Development Fund is a public law company operating under the Ministry of Construction of the Russian Federation and founded by the Government of the Russian Federation. In particular, the Territorial Development Fund manages the so-called free economic zone in the illegally occupied territories of Donetsk, Luhansk, Kherson and Zaporizhzhia, which was created by the Government of the Russian Federation to grant benefits and privileges to companies that operate in those illegally occupied territories." .
