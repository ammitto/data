<https://www.ammitto.org/entity/ch/69493>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC “MOSCOW RESEARCH INSTITUTE ‘AGAT’”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69493> ;
  ammitto:remarks "JSC AGAT develops and produces many Russian-made air-to-air missiles in service with the MiG-23, MiG-25, MiG-29, MiG-31 and Su-27 aircraft and their modifications, both in Russia and abroad. Su-30 and MiG-31 fighter jets used in Ukraine by Russian forces are equipped with the JSC AGAT-produced computing system “Regatta”, which is designed to monitor the technical condition of aircraft during flight tests. JSC AGAT is supporting materially actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." .
