<https://www.ammitto.org/entity/ch/98951>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company Shipbuilding Complex “Zvezda”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98951> ;
  ammitto:remarks "LLC Shipbuilding Complex “Zvezda” is a leading Russian company in shipbuilding and ship repairs. It is described as a company of strategic importance for Russia’s domestic shipbuilding industry. The company is building tankers for the export of oil and gas. One of its major customers is Sovcomflot, Russia’s largest shipping company, for which LLC Shipbuilding Complex “Zvezda” is building a large amount of vessels. LLC Shipbuilding Complex “Zvezda” is therefore associated with Sovcomflot, which is supporting, materially and financially, the Government of the Russian Federation. Furthermore, LLC Shipbuilding Complex “Zvezda” is involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation." .
