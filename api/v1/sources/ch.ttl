<https://www.ammitto.org/entity/ch/45358>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Zaw Min Tun" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45358> ;
  ammitto:remarks "Brigadier-General Zaw Min Tun was the Press Team Leader of the State Administrative Council and the Deputy Minister for Information. He was also the Head of the Tatmadaw’s True News Information Team." .
