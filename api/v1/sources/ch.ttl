<https://www.ammitto.org/entity/ch/73755>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Open Joint Stock Company “Orsha Aircraft Repair Plant”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73755> ;
  ammitto:remarks "OJSC Orsha Aircraft Repair Plant is a Belarusian state-owned enterprise that repairs and modernises aircraft. OJSC Orsha Aircraft Repair Plant overhauls and modernises helicopters (Mi-24 and Mi-35) which are used by the Russian Armed Forces in the war of aggression against Ukraine. OJSC Orsha Aircraft Repair Plant is therefore supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
