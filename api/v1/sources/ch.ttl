<https://www.ammitto.org/entity/ch/38190>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mende Lambert" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/38190> ;
  ammitto:remarks "As Communications and Media Minister since 2008, Lambert Mende is responsible for a repressive media policy which breaches the right to freedom of expression and information and undermines a consensual and peaceful solution towards elections in DRC. On 12 Nov 2016, he adopted a decree limiting the possibility for foreign media outlets to broadcast in DRC." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1953-02-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1953"^^xsd:integer ] .
