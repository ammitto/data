<https://www.ammitto.org/entity/ch/13352>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Hosseini Mohammad Dr" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13352> ;
  ammitto:remarks "Vice-president for parliamentary affairs under President Raisi since Aug 2021. Former advisor to President Mahmoud Ahmadinejad and spokesperson for YEKTA, a hard-line political faction. Minister of Culture and Islamic Guidance (2009-2013). Ex-IRGC, he was complicit in the repression of journalists." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1961-07-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1961"^^xsd:integer ] .
