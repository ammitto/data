<https://www.ammitto.org/entity/ch/72317>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ivanov Alexander Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72317> ;
  ammitto:remarks "Alexander Ivanov is the Director of JSC VMP Avitek (a.k.a. Vyatka Machine-Building Enterprise Avitek). JSC VMP Avitek is a Russian military-industrial state enterprise that develops and produces surface-to-air anti-aircraft guided missiles deployed by the Russian Armed Forces. Additionally, JSC VMP Avitek develops and produces ejection seats for fighter jets deployed by the Russian Armed Forces. Notably, JSC VMP Avitek is part of the Almaz-Antey concern, a Russian state-owned arms manufacturer that develops anti-aircraft defence and cruise missile systems for the Russian military." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1959-01-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1959"^^xsd:integer ] .
