<https://www.ammitto.org/entity/ch/94672>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Legmash Plant OJSC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94672> ;
  ammitto:remarks "Legmash Plant OJSC is a Belarusian plant which produces 152-mm and 122-mm shells for cannon artillery (including howitzers D-30, D-20, Msta-B, Giatsint-B, and the self-propelled modifications thereof). The facility also manufactures 122-mm unguided rockets of the 9M22U-1 line for the 9K51 Grad MLRS multiple rocket launcher. Therefore, Legmash Plant OJSC is an entity forming part of the military and industrial complex of Belarus." .
