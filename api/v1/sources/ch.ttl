<https://www.ammitto.org/entity/ch/70549>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Tupolev" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70549> ;
  ammitto:remarks "JSC Tupolev a Russian military industry company. It supplies warplanes to the Armed Forces of the Russian Federation. It has developed the Tu-160 strategic missile carriers and TU-22M3M/TU-22M3 long-range bombers, which are manufactured by its subsidiary company, Kazan Aircraft Production Association. The Tu-160 and the TU-22M3M/TU-22M3 are used by the Russian Air Force in Russia’s war of aggression against Ukraine." .
