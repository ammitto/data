<https://www.ammitto.org/entity/ch/86519>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "The Kaluga Engine Company (PJSC KADVI)" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86519> ;
  ammitto:remarks "The Kaluga Engine Company (PJSC KADVI) is a Russian military industry company delivering tank engines to the other military plants producing T-80 tanks. T-80 tanks have been used during the invasion of Ukraine. Russia has recently decided to commence the serial production of T-80 tanks equipped with GTD-1250 gas turbine engines. Modernised T-80 tanks with GTD-1250 gas turbine engines are being delivered to the frontline in Ukraine." .
