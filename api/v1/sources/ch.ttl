<https://www.ammitto.org/entity/ch/92815>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Public Joint Stock Company Surgutneftegaz" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92815> ;
  ammitto:remarks "PJSC Surgutneftegaz is a company active in the Russian energy sector. The company carries out prospecting, exploration and production of hydrocarbons in three Russian oil and gas provinces, namely Western Siberia, Eastern Siberia and Timan-Pechora. The energy sector, especially oil and gas, provides substantial revenues to the Government of the Russian Federation. Therefore, PJSC Surgutneftegaz is involved in an economic sector providing a substantial source of revenue to the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." .
