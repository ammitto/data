  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC Votkinsk Machine Building Plant" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/58082> ;
  ammitto:remarks "Votkinsk Plant is a factory within the Russian defence industry which manufactures weapons of strategic importance to Russia. It is the only plant of its kind in Russia. It manufactures, inter alia, missiles and ammunition for the Iskander and Tochka- U complexes, which Russia used during the war of aggression against Ukraine." .
