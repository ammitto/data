  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Saulenko Alexandr Fedorovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56143> ;
  ammitto:remarks "So-called head of the provisional administration of Berdyansk and the Berdyansk region and mayor of the city of Berdyansk. He has advocated for changing the control and administration of the Berdyansk region from Ukraine to the Russian Federation. He facilitated the issuance of Russian passports in the city of Berdyansk, as well as publicly supported and participated in the preparations for the illegal referenda in the occupied regions of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1962-05-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1962"^^xsd:integer ] .
