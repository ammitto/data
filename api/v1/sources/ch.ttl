  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Startsev Vadim Valerievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/88872> ;
  ammitto:remarks "Vadim Startsev is the General Manager of JSC NPO “Orion”, a Russian research and manufacturing company which is developing and producing high-tech electronic components, including for the development of the Russian military-industrial complex. JSC NPO “Orion” belongs to the holding JSC Shvabe, which provides manufactured optical and laser systems to the Russian Armed Forces, which are used in the war of aggression against Ukraine. Therefore, as the General Manager of JSC NPO “Orion”, Vadim Valerievich Startsev is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine. Furthermore, he is associated with JSC Shvabe, which is responsible for supporting materially actions and policies which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1970-04-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1970"^^xsd:integer ] .
