<https://www.ammitto.org/entity/ch/72418>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "JSC NPO PRZ" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72418> ;
  ammitto:remarks "By Presidential Decree No. 412 of 23 April 2023, President of the Russian Federation Vladimir Putin established the group Almaz Antey, which has become one of the largest holdings of the Russian military-industrial complex. JSC NPO PRZ is part of that holding." .
