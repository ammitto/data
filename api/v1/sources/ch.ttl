<https://www.ammitto.org/entity/ch/105434>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "LLC “AEROMAKS”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/105434> ;
  ammitto:remarks "LLC “AEROMAKS” develops software for drones to perform various aviation operation including aerial photography, collection, processing, and preparation of cartographic data and space information. It is also a manufacturer of helicopter type drones of SH-3000/-750/-450/-350, and in general develops 11 types of drones. In 2023 the company opened its own Aviation Training Centre approved by the Ministry of Labour of the Russian Federation. By the end of 2024 the company had 13 government contracts signed and Gazprom Neft, Russian Post and Moscow City Department of Information Technology were among its customers." .
<https://www.ammitto.org/entry/ch/consolidated-list/105434>
  a ammitto:SanctionEntry ;
