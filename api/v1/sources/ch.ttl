  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Liaoyang Petrochemical Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98999> ;
  ammitto:remarks "Liaoyang Petrochemical Company is a refinery in the People’s Republic of China, and one of the country’s leading processors of Russian-sourced crude oil. It is China’s only integrated refining and chemical enterprise fully processing Russian crude oil. Liaoyang Petrochemical Company is able to process millions of tons of Russian oil each year." .
