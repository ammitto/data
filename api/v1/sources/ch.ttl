<https://www.ammitto.org/entity/ch/69420>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Mishchenko Oleg Grigorievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/69420> ;
  ammitto:remarks "Oleg Mishchenko is the First Deputy Chairman of the State Military-Industrial Committee of the Republic of Belarus. In his capacity as the First Deputy Chairman of the State Military-Industrial Committee of the Republic of Belarus he increased the supply of military equipment to Russia against the backdrop of its war of aggression against Ukraine. Moreover, a military-technical cooperation programme between Moscow and Minsk until 2025 will be put into effect, which provides for mutual deliveries of military products in the interests of the law enforcement agencies of Belarus and Russia. Therefore, Oleg Mishchenko is supporting materially the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-08-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
