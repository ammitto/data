<https://www.ammitto.org/entity/ch/94584>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Nesterovschi Alexandr" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/94584> ;
  ammitto:remarks "Alexandr Nesterovschi is a politician from the Republic of Moldova who has been involved in bribing schemes organised by listed person Ilan Shor in order to corrupt several politicians from the Republic of Moldova to create an apparently pro-European movement, but that was in fact controlled by Ilan Shor from Moscow. During his criminal trial, Alexandr Nesterovschi received support from Russia and Ilan Shor. He was sentenced to 12 years in prison for political corruption." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1981-01-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1981"^^xsd:integer ] .
