<https://www.ammitto.org/entity/ch/29705>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Akimov Oleg Konstantinovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/29705> ;
  ammitto:remarks "Deputy of the “Luhansk Economic Union” in the “National Council” of the “Luhansk People’s Republic”. Stood as a candidate in the so-called “elections” of 2 November 2014 to the post of so-called “Head” of the “Luhansk People’s Republic”. Those “elections” were in breach of Ukrainian law and therefore illegal. Former “Head” of the so-called “Federation of Trade Unions”. Member of the so-called “People’s Council” of the “Luhansk People’s Republic”. Current Chairman of the Board of the Interregional Public Organisation “Union of Luhansk Communities”, representative of the Integration Committee “Russia-Donbas”." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1981-09-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1981"^^xsd:integer ] .
