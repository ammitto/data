  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rukavishnikova Lyudmila Vasilievna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
