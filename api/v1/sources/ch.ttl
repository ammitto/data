<https://www.ammitto.org/entity/ch/63742>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Pegov Semyon Vladimirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63742> ;
  ammitto:remarks "Semyon Pegov is a Russian military blogger and runs one of the most popular pro-war social media channels in Russia, WarGonzo. He frequently appears in Russian state controlled media. Semyon Pegov and WarGonzo spread anti-Ukrainian propaganda and promote the Russian military and PMC Wagner, depicting Ukrainian forces as Nazis and disseminating false information on NATO biological laboratories in Mariupol." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1985-09-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1985"^^xsd:integer ] .
