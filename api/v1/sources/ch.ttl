<https://www.ammitto.org/entity/ch/63165>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kapustnikova Natalya Aleksandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63165> ;
  ammitto:remarks "Natalya Kapustnikova is the director of the Mariupol Museum of Local History. She discovered the location of artworks from the Kuindzhi Art Museum of Mariupol and gave those works willingly over to the Russian authorities, who facilitated their transfer to the Local History Museum of Donetsk. This was done without the knowledge or consent of the Ukrainian authorities or the Director of the Kuindzhi Art Museum." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1977-08-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1977"^^xsd:integer ] .
