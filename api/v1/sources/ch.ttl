<https://www.ammitto.org/entity/ch/92826>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Finko”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92826> ;
  ammitto:remarks "LLC Finko is a manufacturer of the unmanned aerial vehicles (UAVs) Supercam. It supplies the Government of the Russian Federation. In particular, its UAV “S350 Supercam” is used by the Russian military for aerial monitoring, photography and laser scanning in Russia’s war of aggression against Ukraine." .
