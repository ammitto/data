<https://www.ammitto.org/entity/ch/98629>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company Plant “BUMMASH”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98629> ;
  ammitto:remarks "LLC Plant “BUMMASH” is an industrial enterprise based in Russia. It is officially recognised by the regional authorities of the Udmurt Republic as one of its military-industrial complex enterprises. The company’s production is used by the Russian Armed Forces and it participates in the fulfilment of the Russian State defence order. LLC Plant “BUMMASH” is also engaged in the manufacturing of dual-use equipment, which can be used for military applications. Public statements by regional officials confirm that LLC Plant “BUMMASH” is supporting the war effort of the Russian Federation against Ukraine." .
