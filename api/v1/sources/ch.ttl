<https://www.ammitto.org/entity/ch/44378>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Omar José Prieto Fernández" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/44378> ;
  ammitto:remarks "Former Governor of Zulia State (2017 – 2021). In this position he has undermined democracy and the rule of law in Zulia State. He was sworn in by the non-recognised National Constituent Assembly (ANC), after the legitimate winner of the election refused to be sworn in by the ANC. Omar José Prieto Fernández actively promoted the non-democratic elections for the National Assembly, which took place on 6 Dec 2020. Moreover, in Zulia State he threatened opposition leaders with “house visits” and stated his intention to declare Zulia State independent should an interim government led by Juan Guaidó assume power. Active member of the United Socialist Party of Venezuela (PSUV)." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-05-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/44378>
