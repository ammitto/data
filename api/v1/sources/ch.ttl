<https://www.ammitto.org/entity/ch/56163>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Korolev Sergei Borissovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56163> ;
  ammitto:remarks "Sergei Borissovich Korolev is the First Deputy Director of the Russian FSB, since February 2021. He is reported to be closely associated with FSB Director Alexander Bortnikov, and businessmen Arkadii and Boris Rotenberg. He is indicated as a potential replacement for Bortnikov in the position of Head of the FSB. He is a career officer in the FSB, having served there since the 2000s and having previously served as the director of the FSB’s Economic Security Service. In 2021, Vladimir Putin awarded him the rank of Army General, which is a distinctive senior rank reward. He is therefore supporting and benefitting from Russian decision makers responsible for the annexation of Crimea or the destabilisation of Eastern Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1952-11-09"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1952"^^xsd:integer ] .
