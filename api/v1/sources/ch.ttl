<https://www.ammitto.org/entity/ch/86622>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "ARCLM International Trading Co. Ltd" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/86622> ;
  ammitto:remarks "ARCLM International Trading Co. Ltd is a Hong Kong-based provider for various types of machinery. ARCLM International Trading Co. repeatedly exported products of European origin to Russian companies while those products were subject to Union export restrictions, notably to the company Unimatik, a major actor in the Russian Military-Industrial Complex." .
