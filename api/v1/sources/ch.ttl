<https://www.ammitto.org/entity/ch/60776>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ministry of Emergency Situations of the so-called “Donetsk People’s Republic”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60776> ;
  ammitto:remarks "The so-called “Ministry of Emergency Situations of the Donetsk People’s Republic” is an entity established in 2014 by the Russia-aligned occupying forces in Ukraine’s Donetsk oblast. The so-called “Ministry of Emergency Situations of the Donetsk People’s Republic” has since then\nacted as an unrecognised government entity of the self-proclaimed “Donetsk People’s Republic”. Ministry personnel were directly involved in the forced “filtration” of Ukrainian civilians at multiple sites in the Donetsk region of Ukraine." .
<https://www.ammitto.org/entry/ch/consolidated-list/60776>
  a ammitto:SanctionEntry ;
  ammitto:entityId <https://www.ammitto.org/entity/ch/60776> ;
