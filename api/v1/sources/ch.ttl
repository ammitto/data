<https://www.ammitto.org/entity/ch/28568>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint-Stock Company Almaz-Antey Air and Space Defence Corporation" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/28568> ;
  ammitto:remarks "Almaz-Antey is a Russian State-owned company. It manufactures anti-aircraft weaponry including surface-to-air missiles which it supplies to the Russian army. The Russian authorities have been providing heavy weaponry to separatists in Eastern Ukraine, contributing to the destabilisation of Ukraine. These weapons are used by the separatists, including for shooting down airplanes. As a State-owned company, Almaz-Antey therefore contributes to the destabilisation of Ukraine." .
