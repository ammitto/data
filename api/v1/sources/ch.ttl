  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kusov Ivan Sergeevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/75602> ;
  ammitto:remarks "Ivan Kusov is the Minister of Education and Science of the so-called “Luhansk People’s Republic”. He is involved in child abduction and actively supports the re-education of Ukrainian children with the intent of alienating them from their home country and relatives." ;
