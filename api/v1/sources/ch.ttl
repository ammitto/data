<https://www.ammitto.org/entity/ch/72646>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Avangard”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72646> ;
  ammitto:remarks "JSC Avangard is a Russian manufacturer of large fiberglass products, as well as plastic and rubber products, and is part of one of the largest rocket-building holdings in Russia, JSC MIC NPO Mashinostroyenia, which is part of JSC Tactical Missile Armament Corporation. JSC Avangard is involved in the production of armoured vehicles and missiles, which are used by the Russian Armed Forces in the war of aggression against Ukraine." .
