  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sluchak Pavel Aleksandrovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73388> ;
  ammitto:remarks "Pavel Sluchak is the former General Director of OJSC Orsha Aircraft Repair Plant. OJSC Orsha Aircraft Repair Plant is a Belarusian state-owned enterprise that repairs and modernises aircraft. OJSC Orsha Aircraft Repair Plant overhauls and modernises helicopters (Mi-24 and Mi-35) which are used by the Russian Armed Forces in the war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
