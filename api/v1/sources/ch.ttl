  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Saqr Rustom" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/41331> ;
  ammitto:remarks "Head of the local branch of the National Defence Force in Homs under the former al-Assad regime (a regime militia – Shabiha). Responsible for its participation in the brutal repression of the civilian population in Syria. Through his militia, Saqr Rustom is responsible for multiple war profiteering schemes and is therefore benefitting from and supporting the former al-Assad regime. Associated with designated person Bassam Hassan, his uncle, with whom he established the Damas Real Estate Development and Investment LLC in order to invest in real estate projects." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1947-12-04"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1947"^^xsd:integer ] .
