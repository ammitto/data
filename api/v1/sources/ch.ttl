<https://www.ammitto.org/entity/ch/61355>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Belekhova Yulia Alexandrovna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61355> ;
  ammitto:remarks "Yulia Belekhova is a member of the Presidential Council for Civil Society and Human Rights, and chairwoman of the Council’s working group on the so-called “special military operation” (war of aggression) in Ukraine. She is also head of the Moscow regional branch of the pro-Putin All-Russia People’s Front. She backed Russia’s war of aggression against Ukraine and participated in propaganda events in support of the war." .
