<https://www.ammitto.org/entity/ch/45951>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Makrytski Vital Mikhailavich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45951> ;
  ammitto:remarks "In his former position as Deputy Head of the Oktyabrsky District Police Department of Minsk, Vital Makrytski was responsible for overseeing the severe beatings and torture of peaceful protesters and bystanders detained on the premises of this police department, in the wake of the 2020 presidential election. In Dec 2020 he was promoted to the position of the Head of the Partizanski District Police Department of Minsk. He is therefore responsible for serious violations of human rights and the repression of civil society and democratic opposition." ;
