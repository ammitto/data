<https://www.ammitto.org/entity/ch/61346>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bocharov Oleg Evgenievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/61346> ;
  ammitto:remarks "Oleg Bocharov is First Deputy General Director of the United Aircraft Corporation (OAC UAC Corporation). Before being appointed as First Deputy General Director on 26 February 2025, Oleg Bocharov had been Deputy Minister of the Ministry of Industry and Trade since 2017. The Ministry of Industry and Trade is the federal executive body responsible for the development of state policy and legal regulation in the field of, inter alia, the military-industrial complex, space activities and the development of aviation technology. The Ministry supervises Russia’s weapons and defence industry and plays a crucial role in procuring military equipment used in Russia’s war of aggression against Ukraine. In his capacity as Deputy Minister of the Ministry of Industry and Trade, he was \nresponsible for actions and activities of the Ministry that undermine and threaten the territorial integrity, sovereignty and independence of Ukraine, and he is a natural person supporting the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-06-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
