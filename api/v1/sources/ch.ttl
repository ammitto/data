<https://www.ammitto.org/entity/ch/13124>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Taeb Hossein" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13124> ;
  ammitto:remarks "Since 2022, advisor to the Commander-in-Chief of the Islamic Revolutionary Guard Corps (IRGC), Hossein Salami. Former Head of the IRGC intelligence organisation (October 2009 to June 2022). His responsibilities were expanded in May 2019 with the merging of the Office of the Deputy of Strategic Intelligence of the IRGC and the IRGC’s Intelligence Organisation. Commander of the Basij until October 2009. Forces under his command participated in mass beatings, murders, detentions and tortures of peaceful protestors." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1963"^^xsd:integer ] .
<https://www.ammitto.org/entry/ch/consolidated-list/13124>
