<https://www.ammitto.org/entity/ch/93493>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lobaeva Elena Anatolyevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93493> ;
  ammitto:remarks "Elena Lobaeva is the owner of the LLC Construction Bureau of Integrated Systems (LLC KBIS). LLC KBIS is part of the Lobaev group of entities, which manufactures high-precision rifles. LLC KBIS specialises in the development and pilot production of high-accuracy and long-range weapons, firing systems, and other innovative products. LLC KBIS is the holder of the trademarks “Lobaev Robotics” and “Lobaev Arms”. Lobaev Arms rifles (manufactured by LLC “Trading House ‘Lobaev Arms’”) are used by the Russian Armed Forces in Russia’s war of aggression against Ukraine. Lobaev Arms rifles are officially purchased by the Ministry of Defence of the Russian Federation. Elena Lobaeva is therefore supporting actions which undermine and threaten the territorial integrity, sovereignty and independence of Ukraine, and supporting and benefitting from the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-01-23"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
