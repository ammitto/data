<https://www.ammitto.org/entity/ch/13281>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kamalian Behrouz" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/13281> ;
  ammitto:remarks "Head of the “Ashiyaneh” cyber group linked with the Iranian regime. “Ashiyaneh” Digital Security, founded by Behrouz Kamalian, is responsible for intensive cyber-attacks on both domestic opponents and reformists and foreign institutions. Kamalian’s “Ashiyaneh” organisation’s work has assisted the regime’s crackdown against the opposition, which has involved numerous serious human rights violations." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1983"^^xsd:integer ] .
