<https://www.ammitto.org/entity/ch/60220>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Dynasty International Company Limited" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60220> ;
  ammitto:remarks "Dynasty International Company Limited is a Burmese company that was founded by arms broker Aung Moe Myint. It has been used to facilitate arms deals on behalf of the Burmese military, including the import of aircraft parts in support of the Myanmar air force for air raids against villages and civilian infrastructure." .
