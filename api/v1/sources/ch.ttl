<https://www.ammitto.org/entity/ch/77796>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shvedau Ihar Aliaksandravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77796> ;
  ammitto:remarks "Ihar Shvedau is a judge who has served in the Mahiliou Regional Court since 2020, having been appointed by Aliaksandr Lukashenka. He has issued politically motivated sentences against opponents of the Lukashenka regime, including against journalist Andrei Kuznechyk (6 years in prison), political prisoner Anton Shybut (5 years) and others who criticised the Belarusian authorities." .
