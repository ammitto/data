<https://www.ammitto.org/entity/ch/89580>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Joint Stock Company “Faraday”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/89580> ;
  ammitto:remarks "JSC Faraday is a shoe manufacturer for the Russian Army, as well as for the Russian Ministry of the Interior and for Rosgvardia. JSC Faraday is among the organisations included in the consolidated register of organisations of the Defence-Industrial complex and received subsidies from the Ministry of Industry and Trade to re-equip its factory to serve military requirements. Faraday products were used by Russian forces in Ukraine." .
