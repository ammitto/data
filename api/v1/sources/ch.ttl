<https://www.ammitto.org/entity/ch/72871>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Shautsou Dzmitry Yaŭhienavič" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72871> ;
  ammitto:remarks "Dzmitry Shautsou is the General Secretary of the Belarus Red Cross. In this role, he has been responsible for the illegal deportation of Ukrainian children to the Republic of Belarus. Dzmitry Shautsou is one of the key persons involved in the forcible deportation of Ukrainian children to Belarus and their subsequent illegal adoption by Russian and Belarusian families. He visited children from Ukraine in both Belarus and Russian-occupied Ukraine and wore pro-Russia military apparel with the “Z”. Dzmitry Shautsou uses the Belarus Red Cross to organise and facilitate the movement of Ukrainian children to Belarus. His actions violate the rights of Ukrainian children and infringe Ukrainian law and administrative order." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1973-11-03"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1973"^^xsd:integer ] .
