<https://www.ammitto.org/entity/ch/53144>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Slyusar Yuri Borisovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/53144> ;
  ammitto:remarks "Yuri Slyusar is the current governor of the Rostov region (since 4 November 2024). He is also the former President of United Aircraft Corporation (UAC), former President of Irkut (Yakovlev) society and former Deputy Minister of Industry and Trade. UAC is a Russian largely state-owned aerospace and defence cooperation company within Rostec, originally founded by President Putin. In his position as President of UAC, Yuri Slyusar is one of the leading actors in the Russian industry and defence sector with close ties to the Government of the Russian Federation. Moreover, Slyusar is a member of the State Council of the Russian Federation, and a member of the supreme Council of the United Russia Party. Yuri Slyusar is therefore a leading businessperson involved in economic sectors of the Government of the Russian Federation and has supported and benefitted from the Government of the Russian Federation." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1974-07-20"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1974"^^xsd:integer ] .
