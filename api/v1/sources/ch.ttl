<https://www.ammitto.org/entity/ch/56259>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Kheirbekov Zabit Sabirovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56259> ;
  ammitto:remarks "Zabit Kheirbekov is a Lieutenant General of the Russian Aerospace Forces, Deputy Commander-in-Chief of the Russian Aerospace Forces for Logistics. The Russian Aerospace Forces have delivered strikes on both military and civilian targets in Ukraine. Zabit Kheirbekov therefore is responsible for, supporting and implementing, actions which undermine the territorial integrity, sovereignty and independence of Ukraine and stability and security in Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-06-05"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
