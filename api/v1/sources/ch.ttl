<https://www.ammitto.org/entity/ch/71483>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "FKP AHK" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/71483> ;
  ammitto:remarks "FSE Aleksin Chemical Plant is a Russian enterprise that produces a range of industrial chemicals used in the manufacture of gunpowder and weapons charges. FSE Aleksin Chemical Plant supplies state-owned plants that produce gunpowder, cartridges and ammunition for the Russian Armed Forces. FSE Aleksin Chemical Plant is a major producer and supplier of chemical materials of strategic importance to the Russian defence sector." .
