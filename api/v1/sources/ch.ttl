<https://www.ammitto.org/entity/ch/90879>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Skuratovich Ala" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/90879> ;
  ammitto:remarks "Ala Skuratovich is a Belarusian judge of the court of the Frunzensky district of the city of Minsk. She has issued politically motivated sentences concerning, inter alia, freedom of expression or freedom of assembly against Andrus Asmalousk, Ivan Charavaka, Dzmitry Lapets , Andrei Akushka, Dziana Charnushyna, Andrei Mirashnichenka , and Artur Smaliakou. Ala Skuratovich is therefore responsible for the repression of civil society in Belarus." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1980-10-18"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1980"^^xsd:integer ] .
