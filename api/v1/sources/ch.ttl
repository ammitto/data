  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Bileichyk Aliaksandr Uladzimiravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/4807> ;
  ammitto:remarks "Former first Deputy Minister of Justice (until December 2014), in charge of the judicial services, the civil status and the notaries' services. His functions include the supervision of, and control over, the Legal Bar. He has played a major role in almost systematically debarring lawyers who defended political prisoners." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
