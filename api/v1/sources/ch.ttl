  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sinila Vitali Viktaravich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/85014> ;
  ammitto:remarks "Vitali Sinila is a Belarusian judge and chairman of the court of the Mostovsky district of the Grodno region. He was appointed by Aliaksandr Lukashenka. He issued sentences against a number of citizens of Belarus who voiced their opinions against the President and the regime’s authorities, e.g. Viktor Tsarikevich and Sergei Burak, for the dissent they expressed on social media and offline." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-05-15"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
