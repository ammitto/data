<https://www.ammitto.org/entity/ch/98287>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Sokolov Maksim Yurievich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/98287> ;
  ammitto:remarks "Maksim Sokolov is the President of JSC AvtoVAZ, a Russian State-owned car manufacturing company. The company has created a structural division responsible for supporting its employees that participate in the so-called “special military operation” and their families, offering benefits to them. The Russian authorities have recognised the attention JSC AvtoVAZ offers to its employees who have fought in the war of aggression against Ukraine, and their family members. The company has given cars to plant workers who have fought in the war, and promised to cover the costs of maintenance for them." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1968-09-29"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1968"^^xsd:integer ] .
