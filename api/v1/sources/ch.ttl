  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/63265> ;
  ammitto:remarks "Andrei Malgin is the director of the Central Museum of Taurida in Simferopol, in illegally annexed Crimea. Art works were transferred from the Kherson Fine Art Museum to the Central Museum of Taurida in Simferopol, where they are currently kept under his control." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1965-06-11"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1965"^^xsd:integer ] .
