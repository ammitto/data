<https://www.ammitto.org/entity/ch/70293>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ivanov Serafim Vikentevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/70293> ;
  ammitto:remarks "Serafim Ivanov is the press secretary in the organisation “Volunteer Squad”, which is involved in patriotic education of the youth. He is also Head of the regional headquarters of Yunarmiya VVPOD in the Kherson region. He took an active part in the militarisation of Ukrainian children in the occupied Kherson region. He also spread pro-Russian sentiments and anti-Ukrainian narratives through Yunarmiya and encouraged children to join the organisation, highlighting the military training as one of the advantages." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1996-05-19"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1996"^^xsd:integer ] .
