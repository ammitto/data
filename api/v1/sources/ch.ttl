<https://www.ammitto.org/entity/ch/72345>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Ponomarev Igor Borisovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/72345> ;
  ammitto:remarks "Igor Ponomarev is the former General Director of JSC Concern Granit-Electron, which produces automatic control systems for P-800 Oniks (Yakhont) missiles, which are used by Russian Armed Forces in the war of aggression against Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1964-10-30"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1964"^^xsd:integer ] .
