<https://www.ammitto.org/entity/ch/60478>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Volvach Dmitriy Valer’yevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60478> ;
  ammitto:remarks "Dmitriy Volvach is the former Deputy Minister of the Russian Ministry of Economic Development. During his administration, the Ministry of Economic Development has been involved in activities to undermine and threaten the territorial integrity of Ukraine, including measures to explore the economic potential of the annexed Ukrainian regions (Kherson, Zaporizhzhia, the so-called “Donetsk People’s Republic” and so-called “Luhansk People’s Republic”) as well as activities to support war economy measures of the Russian government. Dmitriy Volvach is therefore responsible for activities which undermine and threaten the territorial integrity of Ukraine. He is a natural person supporting the Government of the Russian Federation, which is responsible for the annexation of Crimea and the destabilisation of Ukraine." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1972-07-08"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1972"^^xsd:integer ] .
