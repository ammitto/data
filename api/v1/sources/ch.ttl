<https://www.ammitto.org/entity/ch/60231>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "International Gateways Group of Company Limited" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/60231> ;
  ammitto:remarks "International Gateways Group of Company Limited (IGGC) is a company co-directed by Naing Htut Aung and which operates in the trading sector. It contributed funds as the single largest donor to the Myanmar Armed Forces (Tatmadaw) in 2017, at fundraising events for the Rakhine ‘clearance operations’ held by Commander in Chief Min Aung Hlaing. In addition, IGGC donated to the Tatmadaw in 2023 on the occasion of the Armed Forces Day." .
