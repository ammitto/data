  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Poly Technologies INC" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93337> ;
  ammitto:remarks "Poly Technologies INC is a Chinese entity, which has been providing components for military helicopters to Russian companies that are part of Russia’s military and industrial complex. Therefore, Poly Technologies INC is supporting Russia’s military and industrial complex, including by being involved in the development, production or supply of military technology and equipment." .
