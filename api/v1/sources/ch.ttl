<https://www.ammitto.org/entity/ch/93274>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "State Unitary Enterprise of the Donetsk People’s Republic “Republican Telecommunications Operator”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93274> ;
  ammitto:remarks "State Unitary Enterprise of the Donetsk People’s Republic “Republican Telecommunications Operator” (SUE DPR “RTO”) is a telecoms operator operating in the illegally occupied region of Ukraine of Donetsk. It was founded by the so-called “Donetsk People’s Republic” on the basis of assets of the Ukrainian telecommunications company “Kyivstar”, which was unlawfully expropriated by the occupying authorities. SUE DPR “RTO” is managed by the Ministry of Communication of the so-called “Donetsk People’s Republic” and provides telecommunications services, including through the brand “Phoenix”." .
