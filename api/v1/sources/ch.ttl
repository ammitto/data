  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Yekta Hossein" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/103480> ;
  ammitto:remarks "Hossein Yekta is a senior Commander of the Islamic Revolutionary Guard Corps (IRGC) who acts as a recruiter and indoctrinator for the IRGC. During the protests that started in December 2025, he publicly supported the shooting of peaceful demonstrators." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1967-11-27"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1967"^^xsd:integer ] .
