  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rogov Vladimir Valeryevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56135> ;
  ammitto:remarks "So-called representative of the main council of Zaporizhzhia region’s military-civil administration. He has advocated against Ukrainian authorities and in favour of the Zaporizhzhia region becoming part of the Russian Federation. He has also facilitated the issuance of Russian passports in the city of Melitopol and actively supported the annexation of the Zaporizhzhia region by the Russian Federation, including through the energy infrastructure." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1976-12-01"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1976"^^xsd:integer ] .
