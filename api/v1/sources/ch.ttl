<https://www.ammitto.org/entity/ch/90928>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "OJSC Planar" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/90928> ;
  ammitto:remarks "OJSC Planar is a state enterprise that specialises in the development and supply of components in the field of microelectronics, which are used for the production of military hardware such as UAVs. It forms part of a state-administered enterprise cluster supervised by the Strategic Projects Council under the direct supervision of the President of Belarus. OJSC Planar also contributes to the Belarusian-Russian technological and military cooperation." .
