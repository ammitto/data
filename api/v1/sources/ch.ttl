  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/45897> ;
  ammitto:remarks "In his former position as the Head of the Oktyabrsky District Police Department of Minsk, Aliandsandr Rydzetski was responsible for the inhuman and degrading treatment, including torture, inflicted by his subordinates on citizens detained in that district in the wake of the 2020 presidential election. He is therefore responsible for serious violations of human rights and the repression of civil society and democratic opposition." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1978-08-14"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1978"^^xsd:integer ] .
