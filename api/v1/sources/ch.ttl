<https://www.ammitto.org/entity/ch/92802>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Insurance Joint Stock Company “VSK”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/92802> ;
  ammitto:remarks "Insurance Joint Stock Company “VSK” (JSC VSK) is a Russian company providing insurance for the Russian energy sector, offering a broad range of insurance and financial services to entities within that sector. In particular, JSC VSK insures Russian logistic operators, including transport vessels, to facilitate the export of Russian oil, which constitutes a key pillar of income for the national budget of the Russian Federation. In addition, JSC VSK is a major contractor of the Russian Government, supporting it by providing insurance services to Russian military and security personnel and for large strategic facilities, such as aircraft belonging to the Russian Ministry of Defence." .
<https://www.ammitto.org/entry/ch/consolidated-list/92802>
  a ammitto:SanctionEntry ;
