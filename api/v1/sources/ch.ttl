<https://www.ammitto.org/entity/ch/73096>
  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Lavrik Valentina Vasilyevna" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73096> ;
  ammitto:remarks "Valentina Lavrik is the so-called “Minister of Education, Science and Youth of the Republic of Crimea” since December 2019. In this role, she ultimately oversees the implementation of the system of militarisation of education for Ukrainian children in illegally annexed Crimea, as well as the suppression of Ukrainian language and culture for such children." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1969-02-25"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1969"^^xsd:integer ] .
