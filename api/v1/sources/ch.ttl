  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Titskiy Anton Robertovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/56853> ;
  ammitto:remarks "Appointed so-called “Minister of Youth Policy of Zaporizhzhia Oblast” by the government of the Russian Federation on 18 July 2022, since January 2024 he has been the so-called “First Deputy Governor of the Zaporizhzhia Oblast”. As such he is part of the so-called “government of the Zaporizhzhia Oblast” responsible for preparing an illegal referendum for Zaporizhzhia to become part of the Russian Federation. He is a member of the Presidium of the Regional Political Council of the United Russia Party. Currently appointed as an advisor to the Governor of the Novgorod Region." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1990-02-12"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1990"^^xsd:integer ] .
