  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Rogashchuk Nikolai Mikhailovich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/50472> ;
  ammitto:remarks "Nikolai Rogashchuk is deputy chief of staff to the president Aliksandr Lukashenka. He is former presidential aide to Aliksandr Lukashenka and the inspector for the Gomel region. In this function, he provided support for the joint Russian-Belarussian military exercises which prepared the Russian military aggression against Ukraine of 24 February 2022." .
