<https://www.ammitto.org/entity/ch/73223>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Favorit” Research and Production Company" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/73223> ;
  ammitto:remarks "LLC Favorit Research and Production Company creates automated information and control systems for monitoring the surface and ground situation of geographically distributed objects, operating on the basis of special software. LLC Favorit Research and Production Company produces situation awareness systems, mobile complexes, stationary automated complexes, optoelectronic equipment, radar stations, lighting equipment and multifunctional navigation system (Azimuth-F), as well as mobile maintenance complex (Arsenal) and special software designed to automate the activities of control bodies." .
