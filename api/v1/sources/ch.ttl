<https://www.ammitto.org/entity/ch/93622>
  a ammitto:OrganizationEntity ;
  ammitto:entityType "organization" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Limited Liability Company “Construction Bureau of Integrated Systems”" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/93622> ;
  ammitto:remarks "LLC Construction Bureau of Integrated Systems (LLC KBIS) is part of the Lobaev group of entities, which manufactures high-precision rifles. LLC KBIS specialises in the development and pilot production of high-accuracy and long-range weapons, firing systems and other innovative products. LLC KBIS is the holder of the trademarks “Lobaev Robotics” and “Lobaev Arms”. Lobaev Arms rifles (manufactured by LLC “Trading House ‘Lobaev Arms’”) are officially purchased by the Ministry of Defence of the Russian Federation and used by the Russian Armed Forces in Russia’s war of aggression against Ukraine." .
