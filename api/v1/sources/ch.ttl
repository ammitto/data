  a ammitto:PersonEntity ;
  ammitto:entityType "person" ;
  ammitto:hasName [ a ammitto:NameVariant ; ammitto:fullName "Khlyszczankau Aliaksey Anatolevich" ; ammitto:isPrimary "true"^^xsd:boolean ] ;
  ammitto:hasSanctionEntry <https://www.ammitto.org/entry/ch/consolidated-list/77883> ;
  ammitto:remarks "Aliaksey Klyshchankau is a judge who served in the Gomel Regional Court between 2019 and 2023, having been appointed by Aliaksandr Lukashenka. He has issued politically motivated sentences against citizens of Belarus who voiced their opinions against the President and the brutality of Belarusian law-enforcement structures. He sentenced Yuri Vlasov, a confidant of presidential candidate Svetlana Tikhanovskaya, to 6,5 years in a maximum-security penal colony." ;
  ammitto:birthInfo [ a ammitto:BirthInfo ; ammitto:date "1982-08-27"^^xsd:date ; ammitto:circa "false"^^xsd:boolean ; ammitto:year "1982"^^xsd:integer ] .
