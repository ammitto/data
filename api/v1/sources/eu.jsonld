    {
      "@id": "https://www.ammitto.org/entity/eu/eu1308338",
      "@type": "OrganizationEntity",
      "entityType": "organization",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "»Ushkuynik« Tudományos Kutatóközpont",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "АНО “НПЦ ‘Ушкуйник’”",
          "script": "Cyrl",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "‚‚Ushkuynik’ – znanstveni i proizvodni centar za ispitivanje i stručnost u području razvoja sustava bespilotnih letjelica i sredstava zaštite od njihove nezakonite uporabe’",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Neovisna neprofitna organizacija ‚Scientific and Production Center for  Testing and Competence in the Field of  Development of Unmanned Aircraft Systems and Means of Protection Against their Illegal Use ‚Ushkuynik’’",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "„Научен и производствен център за  изпитване и компетентност в областта  на разработването на безпилотни  летателни системи и средства за защита срещу тяхното незаконно използване „Ушкуйник““",
          "script": "Cyrl",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Autonomous non-profit Organisation “Scientific and Production Center for Testing and Competence in the Field of Development of Unmanned Aircraft Systems and Means of Protection Against their Illegal Use ‘Ushkuynik’”",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Автономная Некоммерческая организация “Научно-Производственный Центр Испытаний и Компетенций в Сфере Развития Беспилотных Авиационных Систем и Средств Защиты От Их Противоправного Применения ‘Ушкуйник’”",
          "script": "Cyrl",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Scientific-Research Centre “Ushkuynik”",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "»’Ushkuynik’ Tudományos és Gyártóközpont a Pilóta Nélküli  Légijármű-rendszerek és a Jogellenes  Használatuk Elleni Védelmet Szolgáló  Eszközök Teszteléséért és Kompetenciájáért« autonóm nonprofit szervezet",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Organização autónoma sem fins lucrativos “Centro científico e de  produção para ensaios e competências  no domínio do desenvolvimento de  sistemas de aeronaves não tripuladas e meios de proteção contra a sua utilização ilegal ‘Ushkuynik’”",
          "script": "Latn",
          "isPrimary": false
        }
      ],
