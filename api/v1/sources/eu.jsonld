      "names": [
        {
          "@type": "NameVariant",
          "fullName": "Agência Federal para a Comunidade dos Assuntos dos Estados Independentes, os  Compatriotas a Viver no Estrangeiro e a Cooperação Humanitária Internacional",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "det føderale agentur for anliggender vedrørende Fællesskabet af Uafhængige Stater, landsmænd, der er bosat i udlandet, og internationalt humanitært samarbejde",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Россотрудничество",
          "script": "Cyrl",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Федерална агенция по въпросите на Общността на независимите държави, живеещите в чужбина сънародници и международното хуманитарно сътрудничество",
          "script": "Cyrl",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Federální agentura pro společenství věcí nezávislých států, krajany žijící v zahraničí  a mezinárodní humanitární spolupráci",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Agence fédérale pour les affaires de la Communauté des États indépendants, les compatriotes vivant à l'étranger et la coopération humanitaire internationale",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "La Agencia Federal para los  Asuntos de Colaboración con  la Comunidad de Estados  Independientes, Compatriotas  en el Extranjero y  Cooperación Humanitaria  Internacional",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Föderale Agentur für Angelegenheiten der Gemeinschaft Unabhängiger Staaten, der im Ausland lebenden Landsleute und für internationale humanitäre Zusammenarbeit",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Föderaalne SRÜ Riikide Küsimuste, Välismaal Elavate Kaasmaalaste ja Rahvusvahelise Humanitaarkoostöö Amet",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Agenzia federale per gli affari della Comunità di Stati indipendenti, i compatrioti che vivono all'estero e la cooperazione umanitaria internazionale",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Federalinė Nepriklausomų valstybių sandraugos, užsienyje gyvenančių tėvynainių reikalų ir tarptautinio humanitarinio bendradarbiavimo agentūra",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "A Független Államok Közössége, a Külföldön Élő  Honfitársak és a Nemzetközi Humanitárius Együttműködés Szövetségi Ügynöksége",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Het Federaal Agentschap voor het Gemenebest van de Onafhankelijke Staten, Landgenoten in het Buitenland  en Internationale Humanitaire Samenwerking",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Agenția Federală  pentru Afacerile privind  Comunitatea Statelor  Independente, Compatrioții din  Străinătate și Cooperarea  Umanitară Internațională",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Federálna agentúra pre  Spoločenstvo nezávislých  štátov, krajanov žijúcich  v zahraničí a medzinárodnú  humanitárnu spoluprácu",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "The Federal Agency for the Commonwealth of Independent  States Affairs, Compatriots Living Abroad and  International Humanitarian  Cooperation",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Rossotrudnichestvo",
          "script": "Latn",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Федеральное агентство по  делам Содружества  Независимых Государств,  соотечественников,  проживающих за рубежом, и  по международному  гуманитарному  сотрудничеству",
          "script": "Cyrl",
          "isPrimary": false
        },
        {
          "@type": "NameVariant",
          "fullName": "Itsenäisten valtioiden yhteisöä, ulkomailla asuvia venäläisiä ja kansainvälistä humanitaarista yhteistyötä koskevia asioita käsittelevä liittovaltion virasto",
          "script": "Latn",
          "isPrimary": false
        },
