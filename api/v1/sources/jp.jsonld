        {
          "@type": "NameVariant",
          "fullName": "ALI DARASSA",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "アリ・ダラッサ",
          "script": "Jpan",
