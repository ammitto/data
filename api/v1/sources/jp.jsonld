      "names": [
        {
          "@type": "NameVariant",
          "fullName": "Osama Al Kuni Ibrahim （original script：أسامة الكوني ابراهيم）",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "オサマ・アルクーニ・イブラヒム",
