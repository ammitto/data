    {
      "@id": "https://www.ammitto.org/entity/jp/jp-jpmofdrc-individuals2",
      "@type": "PersonEntity",
      "entityType": "person",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "FRANK KAKOLELE BWAMBALE",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "フランク・カコレレ・ブワンバレ",
          "script": "Jpan",
          "isPrimary": false
        }
      ],
      "sourceReferences": [
        {
          "@type": "SourceReference",
