      "names": [
        {
          "@type": "NameVariant",
          "fullName": "ALI BEN TAHER BEN FALEH OUNI HARZI (original script:علي بن الطاهر بن الفالح العوني الحرزي)",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "アリ・ベン・ターヘル・ベン・ファーレフ・オウニー・ハルズィー",
          "script": "Jpan",
          "isPrimary": false
        }
      ],
      "sourceReferences": [
        {
          "@type": "SourceReference",
