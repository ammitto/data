      "entityType": "person",
      "names": [
        {
          "@type": "NameVariant",
          "fullName": "AL-AZHAR BEN KHALIFA BEN AHMED ROUINE (original script: الأزهر بن خليفة بن احمد روين)",
          "script": "Latn",
          "isPrimary": true
        },
        {
          "@type": "NameVariant",
          "fullName": "アル・アズハル・ベン・ハリーファ・ベン・アフメド・ルイン",
          "script": "Jpan",
